---
// src/components/base/PageDecorations.astro
const currentYear = new Date().getFullYear();
const currentDay = String(new Date().getDate()).padStart(2, '0');
const { class: className } = Astro.props;
---

<div class:list={[
  "pointer-events-none fixed inset-0 hidden 2xl:block select-none overflow-hidden z-0",
  className
]}>

  <!-- ==========================================
       LEFT: 精密卡尺风格 (Precision Caliper)
       设计：虚线轨道 + 反色数据标签 + 红色指针
       ========================================== -->
  <div class="absolute left-0 top-0 bottom-0 w-32 flex flex-col">
    
    <!-- 1. 背景参考线 (极细虚线) -->
    <div class="absolute left-1/2 top-0 bottom-0 w-px -translate-x-1/2 border-l border-dashed border-border/40"></div>
    
    <!-- 顶部装饰点 -->
    <div class="absolute top-12 left-1/2 -translate-x-1/2 w-2 h-2 border border-foreground/40 rounded-full bg-background z-10"></div>

    <!-- 2. 动态滑块组 -->
    <div 
      id="scroll-indicator" 
      class="absolute left-1/2 top-0 flex items-center -translate-x-1/2 transition-transform duration-75 will-change-transform z-20"
    >
      <!-- 组合结构：左侧红线 + 右侧黑底标签 -->
      <div class="relative flex items-center gap-2">
        
        <!-- 左侧：红色游标指针 -->
        <div class="w-1.5 h-6 bg-red-600 shadow-[0_0_10px_rgba(220,38,38,0.5)]"></div>
        
        <!-- 右侧：高对比度数据块 -->
        <div class="flex items-baseline gap-1 bg-foreground text-background px-2 py-1 min-w-[3rem] justify-end shadow-xl">
           <span id="scroll-percent" class="font-mono text-sm font-bold tabular-nums leading-none tracking-tight">00</span>
           <span class="text-[8px] opacity-60 font-mono leading-none">%</span>
        </div>

        <!-- 装饰：连接线 (穿过标签的效果) -->
        <div class="absolute top-1/2 left-0 w-full h-px bg-background/20 -z-10 mix-blend-overlay"></div>
      </div>
    </div>

    <!-- 底部装饰：垂直文字 (保持位置，增加样式) -->
    <div class="absolute bottom-12 left-1/2 -translate-x-1/2 bg-background py-2 z-10">
      <div class="writing-vertical text-[9px] font-mono tracking-[0.3em] text-muted-foreground/60 uppercase">
        System_Status: OK
      </div>
    </div>
  </div>


  <!-- ==========================================
       RIGHT: 保持原有设计 (Editorial Style)
       ========================================== -->
  <div class="absolute right-0 top-0 bottom-0 w-48 flex flex-col items-end pr-8">
    
    <!-- 1. 顶部：巨大的日期 -->
    <div class="absolute top-8 right-8 mix-blend-overlay opacity-20 dark:opacity-10 pointer-events-none">
      <span class="text-[140px] font-mono leading-none tracking-tighter text-foreground">{currentDay}</span>
    </div>

    <!-- 2. 中部：摩尔纹装饰条 (条形码风格) -->
    <div class="absolute top-1/2 -translate-y-1/2 right-12 flex flex-col gap-1 opacity-60">
      <div class="w-1 h-12 bg-foreground"></div>
      <div class="w-1 h-2 bg-red-600"></div> <!-- 红色点缀 -->
      <div class="w-1 h-4 bg-foreground"></div>
      <div class="w-1 h-1 bg-transparent"></div>
      <div class="w-1 h-8 bg-foreground"></div>
      <div class="w-1 h-2 bg-foreground"></div>
      <div class="w-1 h-16 bg-red-600"></div> <!-- 红色长条 -->
      <div class="w-1 h-4 bg-foreground"></div>
    </div>
    
    <!-- 伴随摩尔纹的文字 -->
    <div class="absolute top-1/2 -translate-y-1/2 right-20 writing-vertical text-xs font-bold tracking-widest text-foreground/20">
      INDEX /// {currentYear}
    </div>

    <!-- 3. 底部：几何构成 (圆形 + 方块) -->
    <div class="absolute bottom-12 right-8 flex flex-col items-end gap-6">
       <!-- 空心圆 -->
       <div class="w-16 h-16 rounded-full border border-foreground/20 flex items-center justify-center animate-[spin_10s_linear_infinite]">
          <div class="w-full h-px bg-foreground/10"></div>
          <div class="h-full w-px bg-foreground/10 absolute"></div>
       </div>

       <!-- 实心红块 (视觉重心) -->
       <div class="flex items-end gap-2">
         <span class="font-mono text-[9px] text-muted-foreground mb-1">END_OF_PAGE</span>
         <div class="w-8 h-8 bg-red-600"></div>
       </div>
    </div>

  </div>

</div>

<style>
  .writing-vertical {
    writing-mode: vertical-rl;
    text-orientation: mixed;
  }
</style>

<script>
  function initScrollProgress() {
    const indicator = document.getElementById('scroll-indicator');
    const percentText = document.getElementById('scroll-percent');
    
    if (!indicator || !percentText) return;

    const trackElement = indicator.parentElement;
    
    const handleScroll = () => {
      if (!trackElement) return;

      const scrollTop = window.scrollY;
      const docHeight = document.body.scrollHeight - window.innerHeight;
      const scrollPercent = docHeight > 0 ? scrollTop / docHeight : 0;
      const safePercent = Math.min(Math.max(scrollPercent, 0), 1);
      
      const trackHeight = trackElement.offsetHeight;
      
      // Buffer 设置: 上下各留 100px 缓冲，避免撞到装饰元素
      const buffer = 100;
      const availableHeight = trackHeight - (buffer * 2); 
      
      const translateY = buffer + (safePercent * availableHeight);

      // 应用位置 (注意 CSS 中已经是 left-1/2 -translate-x-1/2，这里只控制 Y 轴)
      // 我们需要保持 X 轴的 centering (-50%)
      indicator.style.transform = `translate(-50%, ${translateY}px)`;
      
      // 更新文字
      const displayPercent = Math.round(safePercent * 100);
      percentText.textContent = displayPercent < 10 ? `0${displayPercent}` : `${displayPercent}`;
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    window.addEventListener('resize', handleScroll, { passive: true });
    requestAnimationFrame(handleScroll);
  }

  document.addEventListener('astro:page-load', initScrollProgress);
  document.addEventListener('DOMContentLoaded', initScrollProgress);
</script>