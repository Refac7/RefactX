---
// src/components/base/PageDecorations.astro
---

<div class="pointer-events-none fixed inset-y-0 left-0 z-40 hidden 2xl:flex items-center mx-auto max-w-[1920px]">

  <div class="relative ml-8 h-[80vh] w-16">
    
    <!-- 轨道容器 -->
    <div class="relative h-full w-full">
      
      <!-- 静态轨道线 -->
      <div class="absolute left-[27px] top-0 bottom-0 w-px bg-gradient-to-b from-transparent via-border/60 to-transparent"></div>
      
      <!-- 动态滑块组件 -->
      <div 
        id="scroll-indicator" 
        class="absolute left-0 top-0 flex items-center gap-3 transition-transform duration-100 will-change-transform"
      >
        <!-- 百分比 -->
        <div class="flex h-6 items-center justify-center rounded-full border border-border/60 bg-background/80 px-2 backdrop-blur-sm shadow-sm">
          <span id="scroll-percent" class="font-mono text-[10px] font-medium text-foreground tabular-nums tracking-widest">00%</span>
        </div>

        <!-- 连接线 -->
        <div class="h-px w-2 bg-primary/50"></div>

        <!-- 轨道锚点 -->
        <div class="relative flex h-3 w-3 items-center justify-center">
          <div class="absolute h-full w-full animate-pulse rounded-full bg-primary/20"></div>
          <div class="h-1.5 w-1.5 rounded-full bg-primary shadow-[0_0_8px_rgba(var(--primary),0.6)]"></div>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- 右侧 -->
<div>
  <div class="pointer-events-none fixed right-0 top-0 bottom-0 z-40 hidden 2xl:flex items-center">
    <div class="writing-vertical text-sm text-muted-foreground px-4 py-20">
      &#169; {new Date().getFullYear()} RefactX. All rights reserved in China and other countries.
    </div>
    <div class="block h-full w-8 bg-gradient-to-b from-0% to-red-600/80 blur-lg"></div>
  </div>
</div>

<style>
  /* 竖向排版文字 */
  .writing-vertical {
    writing-mode: vertical-lr;
    letter-spacing: 0.1em;
  }
</style>

<script>
  // 处理滚动逻辑
  function initScrollProgress() {
    const indicator = document.getElementById('scroll-indicator');
    const percentText = document.getElementById('scroll-percent');
    
    if (!indicator || !percentText) return;

    const handleScroll = () => {
      const scrollTop = window.scrollY;
      const docHeight = document.body.scrollHeight - window.innerHeight;
      const scrollPercent = docHeight > 0 ? scrollTop / docHeight : 0;
      
      // 限制在 0-1 之间
      const safePercent = Math.min(Math.max(scrollPercent, 0), 1);
      
      // 计算滑块位置
      // CSS中设置了 py-20 (即上下各 5rem = 80px)，总 padding 为 160px
      const trackHeight = window.innerHeight - 160;
      
      const translateY = safePercent * trackHeight;

      // 更新位置
      indicator.style.transform = `translateY(${translateY}px)`;
      
      // 更新文字 (补零格式化)
      const displayPercent = Math.round(safePercent * 100);
      percentText.textContent = displayPercent < 10 ? `0${displayPercent}%` : `${displayPercent}%`;
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    // 初始化一次
    handleScroll();
  }

  // 支持 Astro 的 View Transitions 和普通加载
  document.addEventListener('astro:page-load', initScrollProgress);
  document.addEventListener('DOMContentLoaded', initScrollProgress);
</script>