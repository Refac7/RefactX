---
// src/components/base/PageDecorations.astro
---

<div class="pointer-events-none fixed inset-0 z-40 hidden 2xl:block mx-auto">

  <div class="absolute left-4 top-0 bottom-0 w-12">
    <!-- 轨道线 -->
    <div class="absolute left-0 top-10 bottom-10 w-px bg-border/40"></div>
    
    <!-- 滚动滑块容器 -->
    <div class="relative h-full w-full py-20">
      <!-- 动态滑块 -->
      <div id="scroll-indicator" class="absolute right-[-4px] top-20 flex items-center gap-2 transition-transform duration-75 will-change-transform">
        <!-- 百分比文字 -->
        <span id="scroll-percent" class="font-mono text-xs text-muted-foreground tabular-nums">00%</span>
        <!-- 滑块方块 -->
        <div class="h-2 w-2 bg-primary/60"></div>
      </div>
      
      <!-- 装饰性刻度背景 -->
      <div class="absolute right-0 top-20 bottom-20 w-px ruler-dots"></div>
    </div>
  </div>
</div>

<div>
  <!-- 左侧竖向文字 -->
  <div class="pointer-events-none fixed left-0 top-0 bottom-0 z-40 hidden 2xl:flex items-center">
    <div class="writing-vertical text-sm text-muted-foreground px-4 py-20">
      Crafted with &#10084; by Refact7
    </div>
  </div>

  <!-- 右侧竖向文字 -->
  <div class="pointer-events-none fixed right-0 top-0 bottom-0 z-40 hidden 2xl:flex items-center">
    <div class="writing-vertical text-sm text-muted-foreground px-4 py-20">
      &#169; {new Date().getFullYear()} RefactX. All rights reserved in China and other countries.
    </div>
    <div class="block h-full w-8 bg-gradient-to-b from-0% to-red-600/80 blur-lg">
  </div>

</div>

<style>
  /* 竖向排版文字 */
  .writing-vertical {
    writing-mode: vertical-lr;
    letter-spacing: 0.1em;
  }

  /* 点状背景 */
  .ruler-dots {
    background-image: radial-gradient(circle, currentColor 1px, transparent 1px);
    background-size: 1px 20px;
    opacity: 0.3;
  }
</style>

<script>
  // 处理滚动逻辑
  function initScrollProgress() {
    const indicator = document.getElementById('scroll-indicator');
    const percentText = document.getElementById('scroll-percent');
    
    if (!indicator || !percentText) return;

    const handleScroll = () => {
      const scrollTop = window.scrollY;
      const docHeight = document.body.scrollHeight - window.innerHeight;
      const scrollPercent = docHeight > 0 ? scrollTop / docHeight : 0;
      
      // 限制在 0-1 之间
      const safePercent = Math.min(Math.max(scrollPercent, 0), 1);
      
      // 计算滑块位置 (top: 20px to bottom: 20px range in CSS, we need to map percentage to height)
      // 这里的计算需要稍微精细一点，基于视口高度减去上下的padding
      const trackHeight = window.innerHeight - 160; // 假设上下padding共160px
      const translateY = safePercent * trackHeight;

      // 更新位置
      indicator.style.transform = `translateY(${translateY}px)`;
      
      // 更新文字 (补零格式化)
      const displayPercent = Math.round(safePercent * 100);
      percentText.textContent = displayPercent < 10 ? `0${displayPercent}%` : `${displayPercent}%`;
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    // 初始化一次
    handleScroll();
  }

  // 确保在 Astro 页面切换或加载时运行
  document.addEventListener('astro:page-load', initScrollProgress);
  // 如果没有使用 ViewTransitions，保留下面这行作为回退
  window.addEventListener('DOMContentLoaded', initScrollProgress);
</script>