---
import type { Page } from 'astro'
import { POSTS_CONFIG } from '~/config'
import { cn } from '~/lib/utils'

interface Props {
  page: Page<any>
  baseUrl: string
  class?: string
}

const { page, baseUrl, class: className = '' } = Astro.props

// 处理大量页码的显示逻辑
const getVisiblePages = (current: number, total: number) => {
  if (total <= 7) return [...Array(total)].map((_, i) => i + 1)

  if (current <= 3) return [1, 2, 3, 4, null, total]
  if (current >= total - 2) return [1, null, total - 3, total - 2, total - 1, total]

  return [1, null, current - 1, current, current + 1, null, total]
}

const visiblePages = getVisiblePages(page.currentPage, page.lastPage)
---

<nav aria-label="Pagination" class={cn('flex flex-col items-center gap-4', className)}>
  <div class="flex items-center gap-1.5 border border-foreground/25 p-1">
    <a
      href={page.url.prev}
      class={`inline-flex h-8 items-center gap-1 px-2 font-mono text-[10px] uppercase tracking-[0.12em] transition-colors sm:px-3 ${
        page.url.prev
          ? 'text-foreground hover:bg-foreground hover:text-background'
          : 'pointer-events-none cursor-not-allowed text-muted-foreground/30'
      }`}
    >
      <span class="icon-[ph--caret-left] size-3"></span>
      <span class="hidden sm:inline">{POSTS_CONFIG.prevPageText}</span>
    </a>

    <div class="flex items-center gap-0.5">
      {
        visiblePages.map((pageNum) =>
          pageNum === null ? (
            <span class="w-6 text-center font-mono text-[10px] text-muted-foreground sm:w-8">...</span>
          ) : (
            <a
              href={pageNum === 1 ? baseUrl : `${baseUrl}/${pageNum}`}
              class={`inline-flex size-7 items-center justify-center font-mono text-[11px] tabular-nums transition-colors sm:size-8 ${
                page.currentPage === pageNum
                  ? 'bg-primary font-semibold text-primary-foreground'
                  : 'text-foreground/80 hover:bg-muted hover:text-foreground'
              }`}
            >
              {pageNum}
            </a>
          )
        )
      }
    </div>

    <a
      href={page.url.next}
      class={`inline-flex h-8 items-center gap-1 px-2 font-mono text-[10px] uppercase tracking-[0.12em] transition-colors sm:px-3 ${
        page.url.next
          ? 'text-foreground hover:bg-foreground hover:text-background'
          : 'pointer-events-none cursor-not-allowed text-muted-foreground/30'
      }`}
    >
      <span class="hidden sm:inline">{POSTS_CONFIG.nextPageText}</span>
      <span class="icon-[ph--caret-right] size-3"></span>
    </a>
  </div>
</nav>
