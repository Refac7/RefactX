<div id="snow-container" aria-hidden="true"></div>

<script>
  const createSnow = () => {
    const container = document.getElementById('snow-container');
    if (!container) return;

    // 清理可能存在的旧雪花（防止 Astro 页面切换时重复堆叠）
    container.innerHTML = '';

    const snowflakeCount = 50; 
    
    for (let i = 0; i < snowflakeCount; i++) {
      const flake = document.createElement('div');
      flake.className = 'snowflake';
      
      const size = Math.random() * 4 + 2 + 'px';
      const left = Math.random() * 100 + 'vw';
      const opacity = Math.random() * 0.6 + 0.2;
      const duration = Math.random() * 10 + 10 + 's';
      const delay = Math.random() * -20 + 's';

      Object.assign(flake.style, {
        width: size,
        height: size,
        left: left,
        opacity: opacity,
        animationDuration: duration,
        animationDelay: delay,
      });

      container.appendChild(flake);
    }
  };

  document.addEventListener('astro:page-load', createSnow);
  createSnow();
</script>

<style is:global>
  #snow-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 50;
    overflow: hidden;
  }

  .snowflake {
    position: absolute;
    top: -10px;
    background: white;
    border-radius: 50%;
    /* 3. 性能关键：移除 blur 和 box-shadow，这两者在移动物体上极其消耗 GPU */
    /* filter: blur(1px); <--- 已移除，提升性能 */
    animation: fall linear infinite;
    /* 4. 性能关键：开启硬件加速 */
    will-change: transform;
  }

  /* 深色模式：纯白点即可，无需阴影 */
  .dark .snowflake {
    background: #fff;
    opacity: 0.8;
  }

  /* 浅色模式：使用淡蓝灰色 */
  :not(.dark) .snowflake {
    background: #cbd5e1; 
  }

  @keyframes fall {
    0% {
      transform: translate3d(0, -10vh, 0);
    }
    25% {
      transform: translate3d(15px, 20vh, 0);
    }
    50% {
      transform: translate3d(-15px, 50vh, 0);
    }
    75% {
      transform: translate3d(15px, 80vh, 0);
    }
    100% {
      transform: translate3d(0, 110vh, 0);
    }
  }
</style>