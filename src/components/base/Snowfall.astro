<div id="snow-container" style="position: absolute; inset: 0; pointer-events: none; z-index: 1; overflow: hidden;" aria-hidden="true"></div>

<script>
  function initSnow() {
    const container = document.getElementById('snow-container');
    if (!container) return;
    
    container.innerHTML = '';
    
    // 增加数量，因为粒子变小了，需要多一点才显得丰富
    const count = 60; 
    const fragment = document.createDocumentFragment();

    for (let i = 0; i < count; i++) {
      const flake = document.createElement('div');
      flake.className = 'digital-dust'; // 改名：数字尘埃
      
      // 1. 极小尺寸：2px - 5px (像素点风格)
      const size = Math.random() * 3 + 2; 
      
      // 2. 随机位置
      const left = Math.random() * 100;
      
      // 3. 随机速度：慢速漂浮
      const duration = Math.random() * 20 + 10; // 10s - 30s
      
      // 4. 随机延迟
      const delay = Math.random() * -30;

      // 5. 随机初始透明度 (0.1 - 0.5) - 更加隐约
      const opacity = Math.random() * 0.4 + 0.1;

      Object.assign(flake.style, {
        position: 'absolute',
        width: `${size}px`,
        height: `${size}px`,
        left: `${left}%`,
        opacity: `${opacity}`,
        animationDuration: `${duration}s`,
        animationDelay: `${delay}s`,
        // 传递随机变量给闪烁动画
        '--twinkle-duration': `${Math.random() * 5 + 2}s`
      });

      fragment.appendChild(flake);
    }
    
    container.appendChild(fragment);
  }

  initSnow();
  document.addEventListener('astro:page-load', initSnow);
</script>

<style is:global>
  .digital-dust {
    position: absolute;
    top: -10px;
    
    /* 
       【关键风格】
       1. 不设圆角 -> 正方形像素点 (Square Pixels)
       2. 纯色填充 -> 硬朗科技感
    */
    background-color: var(--dust-color);
    
    /* 复合动画：缓慢下落 + 忽明忽暗 (闪烁) */
    animation-name: digital-fall, twinkle;
    animation-timing-function: linear, ease-in-out;
    animation-iteration-count: infinite, infinite;
  }

  /* 
     === 颜色配置 (极简主义) ===
  */
  :root {
    /* 浅色模式：极淡的蓝灰色，像屏幕坏点或灰尘，非常含蓄 */
    --dust-color: rgba(71, 85, 105, 0.4); 
  }

  :root.dark, html.dark {
    /* 深色模式：微弱的白色噪点 */
    --dust-color: rgba(255, 255, 255, 0.3);
  }

  /* 
     === 动画定义 ===
  */
  
  /* 垂直下落 */
  @keyframes digital-fall {
    0% { transform: translateY(0); }
    100% { transform: translateY(110vh); }
  }

  /* 闪烁呼吸效果：模拟信号不稳 */
  @keyframes twinkle {
    0%, 100% { opacity: 0.2; }
    50% { opacity: 0.8; }
  }
</style>