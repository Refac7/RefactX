<div id="snow-container" aria-hidden="true"></div>

<script>
  const createSnow = () => {
    const container = document.getElementById('snow-container');
    if (!container) return;

    container.innerHTML = '';

    // 1. 数量：大幅减少，只有 12 片大雪花
    const snowflakeCount = 12; 
    
    for (let i = 0; i < snowflakeCount; i++) {
      const flake = document.createElement('div');
      flake.className = 'snowflake';
      
      // 2. 尺寸：大幅增加，15px 到 30px 之间
      const size = Math.random() * 15 + 15 + 'px';
      const left = Math.random() * 100 + 'vw';
      
      // 透明度：因为雪花大且快，透明度要低一点，否则会抢视觉重点
      const opacity = Math.random() * 0.15 + 0.05; 
      
      // 3. 速度：明显加快，3秒到8秒之间落地
      const duration = Math.random() * 5 + 3 + 's'; 
      const delay = Math.random() * -10 + 's';

      Object.assign(flake.style, {
        width: size,
        height: size,
        left: left,
        opacity: opacity,
        animationDuration: duration,
        animationDelay: delay,
      });

      container.appendChild(flake);
    }
  };

  document.addEventListener('astro:page-load', createSnow);
  createSnow();
</script>

<style is:global>
  #snow-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    /* 保持在底层，大雪花如果遮住文字会非常干扰阅读，必须置底 */
    z-index: -1; 
    overflow: hidden;
  }

  .snowflake {
    position: absolute;
    top: -40px; /* 因为雪花变大了，起始位置要更靠上 */
    border-radius: 50%;
    animation: fall linear infinite;
    will-change: transform;
  }

  /* 
     4. 样式优化：大雪花使用径向渐变，模拟蓬松感 
     中心亮，边缘透明，避免像贴了贴纸一样的生硬感
  */
  
  /* 深色模式 */
  .dark .snowflake {
    background: radial-gradient(circle, rgba(255,255,255,1) 0%, rgba(255,255,255,0) 70%);
  }

  /* 浅色模式：使用极淡的蓝灰色渐变 */
  :not(.dark) .snowflake {
    background: radial-gradient(circle, rgba(203, 213, 225, 1) 0%, rgba(203, 213, 225, 0) 70%);
  }

  @keyframes fall {
    0% {
      transform: translate3d(0, -40px, 0);
    }
    25% {
      /* 速度快了，左右摇摆幅度稍微加大一点点更有动感 */
      transform: translate3d(20px, 20vh, 0); 
    }
    50% {
      transform: translate3d(-20px, 50vh, 0);
    }
    75% {
      transform: translate3d(20px, 80vh, 0);
    }
    100% {
      transform: translate3d(0, 110vh, 0);
    }
  }
</style>