---
import pkg from '../../../package.json'
import { BUILD_INFO_CONFIG } from '~/config'
import { cn } from '~/lib/utils'
import type { BuildComponent } from '~/types'

interface Props {
  components: BuildComponent[]
  totalWords?: number
}

const { components, totalWords }: Props = Astro.props

const { SHOW_BUILD_TIME, SHOW_RUNTIME, SHOW_TOTAL_WORDS } = BUILD_INFO_CONFIG

const deps: Record<string, string> = { ...pkg.dependencies, ...pkg.devDependencies }
const resolveVersion = (packageName?: string) => {
  if (!packageName) return '—'
  const raw = deps[packageName]
  return raw ? raw.replace(/^[\^~]/, '') : '—'
}

const buildTime = new Date().toLocaleString('sv-SE', { timeZone: 'Asia/Shanghai' }).slice(0, 16)
const runtime = `Node ${process.version.replace(/^v/, '')}`
const buildTarget = 'Static · Vercel'
const formattedTotalWords = (totalWords ?? 0).toLocaleString('en-US')
const showTotalWords = SHOW_TOTAL_WORDS && totalWords !== undefined
---

<div class="mb-6 overflow-hidden rounded-2xl border border-border bg-card shadow-soft">
  <div class="overflow-hidden">
    <div class="-mr-px -mb-px grid grid-cols-1 sm:grid-cols-2 2xl:grid-cols-3">
      {
        components.map((component) => (
          <div class="group flex items-center justify-between gap-4 border-r border-b border-border/70 p-4 transition-colors hover:bg-accent/50">
            <div class="flex min-w-0 items-center gap-3">
              <div class="flex size-9 shrink-0 items-center justify-center rounded-xl border border-primary/15 bg-primary/10 text-primary transition-colors group-hover:border-primary/40">
                <span class={cn('size-4', component.icon)} />
              </div>
              <div class="min-w-0">
                <div class="truncate text-sm font-semibold tracking-[-0.01em] text-foreground">{component.name}</div>
                <div class="text-[9px] font-medium tracking-[0.12em] text-muted-foreground/60 uppercase">{component.category}</div>
              </div>
            </div>
            <div class="flex shrink-0 flex-col items-end gap-1">
              <span class="font-mono text-[10px] font-medium tabular-nums text-foreground">v{resolveVersion(component.packageName)}</span>
              <span class="inline-flex items-center gap-1.5">
                <span class={cn('size-1.5 rounded-full', component.status === 'Active' ? 'bg-success' : 'bg-primary/50')} />
                <span class="font-mono text-[9px] uppercase tracking-[0.12em] text-muted-foreground/70">
                  {component.status || 'Stable'}
                </span>
              </span>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  {
    (SHOW_BUILD_TIME || SHOW_RUNTIME || showTotalWords) && (
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 border-t border-border/70 px-4 py-3 text-[10px] font-medium tracking-[0.1em] text-muted-foreground/70 uppercase">
        {showTotalWords && (
          <span class="inline-flex items-center gap-2">
            <span class="icon-[ph--article] size-3.5" />
            {formattedTotalWords} Words
          </span>
        )}
        {SHOW_BUILD_TIME && (
          <span class="inline-flex items-center gap-2">
            <span class="icon-[ph--clock] size-3.5" />
            Build {buildTime} UTC+8
          </span>
        )}
        {SHOW_RUNTIME && (
          <span class="inline-flex items-center gap-2">
            <span class="icon-[ph--cpu] size-3.5" />
            {runtime}
          </span>
        )}
        <span class="inline-flex items-center gap-2">
          <span class="icon-[ph--cube] size-3.5" />
          {buildTarget}
        </span>
      </div>
    )
  }
</div>
