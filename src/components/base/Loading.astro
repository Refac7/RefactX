---
// src/components/base/Loading.astro
---

<div 
  id="system-loader" 
  class="fixed inset-0 z-[9999] bg-background flex flex-col items-center justify-center transition-opacity duration-300 opacity-100 pointer-events-auto"
  aria-hidden="false"
>
  
  {/* 1. 背景网格装饰 (与Layout保持一致) */}
  <div class="absolute inset-0 z-0 opacity-[0.03]" 
       style="background-image: linear-gradient(currentColor 1px, transparent 1px), linear-gradient(to right, currentColor 1px, transparent 1px); background-size: 40px 40px;">
  </div>

  {/* 2. 装饰性十字准星 (四个角落) */}
  <div class="absolute top-8 left-8 w-4 h-4 border-t border-l border-foreground/20"></div>
  <div class="absolute top-8 right-8 w-4 h-4 border-t border-r border-foreground/20"></div>
  <div class="absolute bottom-8 left-8 w-4 h-4 border-b border-l border-foreground/20"></div>
  <div class="absolute bottom-8 right-8 w-4 h-4 border-b border-r border-foreground/20"></div>

  <div class="relative z-10 flex flex-col items-center gap-8">
    
    {/* 3. 核心 Logo 区域 */}
    <div class="relative">
        {/* 外框 */}
        <div class="w-20 h-20 border border-border bg-muted/5 flex items-center justify-center relative overflow-hidden group">
            
            {/* 扫描线动画 */}
            <div class="absolute top-0 left-0 w-full h-[2px] bg-primary/50 animate-[scan_2s_linear_infinite]"></div>

            <span class="font-mono text-3xl font-black text-foreground tracking-tighter">
                R<span class="text-primary">X</span>
            </span>
            
            {/* 四角装饰 (Corner Accents) */}
            <div class="absolute top-0 left-0 w-1.5 h-1.5 bg-primary"></div>
            <div class="absolute top-0 right-0 w-1.5 h-1.5 border-t border-r border-foreground/30"></div>
            <div class="absolute bottom-0 left-0 w-1.5 h-1.5 border-b border-l border-foreground/30"></div>
            <div class="absolute bottom-0 right-0 w-1.5 h-1.5 bg-foreground/10"></div>
        </div>
        
        {/* 侧边装饰数字 */}
        <div class="absolute -right-6 top-0 text-[9px] font-mono text-muted-foreground/40 vertical-text">
           SYS.64
        </div>
    </div>

    {/* 4. 加载状态与进度条 */}
    <div class="flex flex-col items-center gap-2 w-48">
        <div class="w-full flex justify-between text-[10px] font-mono uppercase tracking-widest text-muted-foreground/60">
            <span id="loader-text">INITIALIZING</span>
            <span class="text-primary animate-pulse">_</span>
        </div>
        
        {/* 硬朗风格进度条 */}
        <div class="w-full h-1 bg-border/30 relative overflow-hidden">
             <div class="absolute left-0 top-0 h-full w-1/3 bg-primary animate-[loading_1s_ease-in-out_infinite]"></div>
        </div>
    </div>
  </div>

  {/* 底部版权/版本号 */}
  <div class="absolute bottom-8 flex flex-col items-center gap-1 text-[9px] font-mono text-muted-foreground/30 uppercase tracking-[0.3em]">
    <span>System_Kernel_V1.7.0</span>
    <span>Memory_Check: OK</span>
  </div>
</div>

<style>
  .loader-hidden {
    opacity: 0 !important;
    pointer-events: none !important;
  }

  .vertical-text {
    writing-mode: vertical-rl;
    text-orientation: mixed;
  }

  @keyframes scan {
    0% { top: 0%; opacity: 0; }
    50% { opacity: 1; }
    100% { top: 100%; opacity: 0; }
  }

  /* 进度条动画：左右来回移动的方块 */
  @keyframes loading {
    0% { left: -30%; }
    50% { left: 100%; }
    100% { left: 100%; }
  }
</style>

<script>
  function setupLoader() {
    const loader = document.getElementById('system-loader');
    const textElement = document.getElementById('loader-text');
    // 使用更具有技术感的词汇
    const texts = ['MOUNTING...', 'SYNCING...', 'RENDER_UI'];
    
    if (!loader) return;

    let step = 0;
    // 稍微加快文字跳动速度
    const textInterval = setInterval(() => {
        if(textElement && step < texts.length) {
            textElement.innerText = texts[step];
            step++;
        }
    }, 120);

    const hide = () => {
      clearInterval(textInterval);
      loader.classList.add('loader-hidden');
      setTimeout(() => {
        loader.style.display = 'none';
      }, 300); // 缩短隐藏时间，让体验更干脆
    };

    const safetyTimeout = setTimeout(() => {
        hide();
    }, 5000);

    // Astro View Transitions 通常很快，500ms 足够展示动画
    setTimeout(() => {
      clearTimeout(safetyTimeout);
      hide();
    }, 500);
  }

  document.addEventListener('astro:page-load', () => {
    setupLoader();
  });

  document.addEventListener('astro:before-preparation', () => {
    const loader = document.getElementById('system-loader');
    if (loader) {
      loader.style.display = 'flex';
      // 强制重绘，确保 transition 生效
      loader.offsetHeight; 
      requestAnimationFrame(() => {
        loader.classList.remove('loader-hidden');
      });
      
      const textElement = document.getElementById('loader-text');
      if (textElement) textElement.innerText = 'LOADING...';
    }
  });
</script>