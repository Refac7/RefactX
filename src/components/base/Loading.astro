---
// src/components/base/Loading.astro
---

<div 
  id="system-loader" 
  class="fixed inset-0 z-[9999] bg-background flex flex-col items-center transition-opacity duration-500 opacity-100 pointer-events-auto overflow-hidden cursor-wait"
  aria-hidden="false"
>

  <div class="relative z-10 w-full h-full max-w-6xl mx-auto 2xl:ml-[15rem] border-x border-border/60 bg-background flex flex-col justify-between">
    
    {/* --- 顶部区域 --- */}
    <div class="p-6 sm:p-12 border-b border-border/60">
        <div class="flex justify-between items-start">
            <span class="font-mono text-[10px] uppercase tracking-widest text-muted-foreground">
                // System_Boot_Sequence
            </span>
            <span class="font-mono text-[10px] uppercase tracking-widest text-foreground font-bold">
                REFAC7_OS <span class="opacity-50">V.3.5</span>
            </span>
        </div>
    </div>

    <div class="flex-1 flex flex-col justify-center px-6 sm:px-12">
        
        {/* 状态文本 */}
        <div class="mb-4 overflow-hidden">
            <span id="loader-text" class="block font-mono text-xs sm:text-sm font-bold uppercase tracking-[0.1em] text-muted-foreground">
                INITIALIZING...
            </span>
        </div>

        {/* 巨型百分比数字 (Helvetica Style) */}
        <div class="relative border-t-1 border-foreground pt-2 pb-8 w-full max-w-4xl">
            <span id="loader-percent" class="block text-6xl sm:text-9xl leading-[0.8] font-black tracking-tighter text-foreground tabular-nums -ml-1 sm:-ml-2">
                000
            </span>
            
            {/* 实体进度条 (Solid Bar) */}
            <div class="absolute bottom-0 left-0 w-full h-px bg-border/40 overflow-hidden">
                <div id="progress-bar" class="h-full bg-foreground w-0 transition-all duration-75 ease-linear"></div>
            </div>
        </div>

        {/* 辅助信息网格 */}
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-8 mt-8 max-w-2xl border-t border-border/60 pt-4 opacity-60">
            <div>
                <span class="block text-[9px] font-mono text-muted-foreground uppercase tracking-widest mb-1">Status</span>
                <span class="block text-xs font-mono text-foreground">LOADING_ASSETS</span>
            </div>
            <div>
                <span class="block text-[9px] font-mono text-muted-foreground uppercase tracking-widest mb-1">Memory</span>
                <span class="block text-xs font-mono text-foreground">ALLOCATED</span>
            </div>
            <div class="hidden sm:block">
                <span class="block text-[9px] font-mono text-muted-foreground uppercase tracking-widest mb-1">Network</span>
                <span class="block text-xs font-mono text-foreground">CONNECTED</span>
            </div>
        </div>
    </div>

    {/* --- 底部区域 --- */}
    <div class="p-6 sm:p-12 border-t border-border/60 flex justify-between items-end">
        <div class="flex gap-px h-3">
            {/* 动态生成的装饰块 */}
            <div id="decor-blocks" class="flex gap-1"></div>
        </div>
        <span class="font-mono text-[9px] text-muted-foreground uppercase tracking-widest">
            © {new Date().getFullYear()} / ALL SYSTEMS NORMAL
        </span>
    </div>

  </div>
</div>

<style>
  .loader-hidden {
    opacity: 0 !important;
    pointer-events: none !important;
  }
</style>

<script>
  function setupLoader() {
    const loader = document.getElementById('system-loader');
    const percentElement = document.getElementById('loader-percent');
    const progressBar = document.getElementById('progress-bar');
    const textElement = document.getElementById('loader-text');
    const decorContainer = document.getElementById('decor-blocks');
    
    if (!loader) return;

    // 1. 初始化装饰块 (Decoration Blocks)
    if (decorContainer && decorContainer.childElementCount === 0) {
        for(let i=0; i<8; i++) {
            const div = document.createElement('div');
            div.className = 'w-1 sm:w-2 h-full bg-foreground/20';
            decorContainer.appendChild(div);
        }
    }

    const texts = [
        'MOUNTING_FILE_SYSTEM...', 
        'PARSING_DOM_TREE...', 
        'HYDRATING_COMPONENTS...', 
        'READY_TO_LAUNCH'
    ];

    let percent = 0;
    let step = 0;

    // 2. 文字轮播 (Text Ticker)
    const textInterval = setInterval(() => {
        if(textElement && step < texts.length) {
            textElement.innerText = texts[step];
            step++;
        }
    }, 180);

    // 3. 进度动画 (Progress Animation)
    const percentInterval = setInterval(() => {
        if (percentElement && progressBar) {
            // 随机增量，模拟非线性加载
            const increment = Math.floor(Math.random() * 5) + 2;
            percent += increment;
            
            if (percent > 100) percent = 100;
            
            // 更新数字 (补零)
            percentElement.innerText = percent.toString().padStart(3, '0');
            
            // 更新进度条宽度
            progressBar.style.width = `${percent}%`;

            // 装饰块动画
            if (decorContainer) {
                const blocks = decorContainer.children;
                const activeIndex = Math.floor((percent / 100) * blocks.length);
                if (blocks[activeIndex]) {
                    blocks[activeIndex].classList.remove('bg-foreground/20');
                    blocks[activeIndex].classList.add('bg-foreground'); // 变成实色
                }
            }

            if (percent === 100) {
                clearInterval(percentInterval);
            }
        }
    }, 25);

    // 4. 隐藏逻辑
    const hide = () => {
      clearInterval(textInterval);
      clearInterval(percentInterval);
      
      if(percentElement) percentElement.innerText = '100';
      if(progressBar) progressBar.style.width = '100%';
      if(textElement) textElement.innerText = 'EXECUTING...';

      // 延迟一点点让用户看到 100%
      setTimeout(() => {
          loader.classList.add('loader-hidden');
          // 动画结束后彻底移除，释放资源
          setTimeout(() => {
            loader.style.display = 'none';
          }, 500);
      }, 200);
    };

    const safetyTimeout = setTimeout(() => {
        hide();
    }, 5000);

    setTimeout(() => {
      clearTimeout(safetyTimeout);
      hide();
    }, 400);
  }

  // --- Astro Events ---

  document.addEventListener('astro:page-load', () => {
    setupLoader();
  });

  document.addEventListener('astro:before-preparation', () => {
    const loader = document.getElementById('system-loader');
    const percentElement = document.getElementById('loader-percent');
    const progressBar = document.getElementById('progress-bar');
    const decorContainer = document.getElementById('decor-blocks');
    
    if (loader) {
      loader.style.display = 'flex';
      // 强制重绘
      loader.offsetHeight;
      
      // 重置状态
      if(percentElement) percentElement.innerText = '000';
      if(progressBar) progressBar.style.width = '0%';
      if(decorContainer) {
          Array.from(decorContainer.children).forEach(el => {
              el.classList.remove('bg-foreground');
              el.classList.add('bg-foreground/20');
          });
      }
      
      requestAnimationFrame(() => {
        loader.classList.remove('loader-hidden');
      });
    }
  });
</script>