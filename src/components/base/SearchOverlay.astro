<div id="search-mask" class="fixed inset-0 z-200 hidden bg-border opacity-0 backdrop-blur-sm transition-opacity duration-200">
  <div class="absolute left-1/2 top-[10%] -translate-x-1/2 transition-all duration-200 -translate-y-4 search-panel-show w-[94%] max-w-3xl">
    <div id="search-panel" class="flex max-h-[75vh] w-full flex-col overflow-hidden rounded-3xl border border-border bg-card shadow-lift">
      <div id="search-bar" class="flex shrink-0 items-center gap-3 border-b border-border px-5 py-4">
        <span class="size-2 shrink-0 rounded-full bg-primary"></span>
        <span class="hidden text-[10px] font-semibold tracking-[0.12em] text-muted-foreground uppercase sm:inline">Search</span>
        <label class="sr-only" for="search-input">Search</label>
        <input
          type="search"
          id="search-input"
          class="w-full bg-transparent text-[15px] font-medium text-foreground outline-none placeholder:text-muted-foreground/45"
          placeholder="Type to search..."
          autocomplete="off"
        />
        <button
          id="search-exact"
          class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-border px-3 py-1.5 text-[10px] font-medium tracking-[0.06em] text-muted-foreground transition-colors select-none hover:border-primary/40 hover:text-foreground"
          aria-pressed="false"
          title="Exact Match"
        >
          <span class="icon-[material-symbols--format-quote] size-3.5"></span>
          Exact
        </button>
        <kbd
          class="hidden h-7 shrink-0 items-center justify-center rounded-md border border-border bg-muted/60 px-2 text-[10px] font-semibold text-muted-foreground sm:inline-flex"
          >ESC</kbd
        >
      </div>

      <div id="search-results" class="custom-scrollbar flex-1 overflow-y-auto overscroll-contain p-0" data-base="/"></div>
    </div>
  </div>
</div>

<script>
  // 使用事件委托 + 每次实时查询节点，兼容 View Transitions 替换 DOM 的情况。
  ;(function () {
    if ((window as any).__refactxSearchInitialized) return
    ;(window as any).__refactxSearchInitialized = true

    const getMask = () => document.getElementById('search-mask')
    const getInput = () => document.getElementById('search-input') as HTMLInputElement | null
    const getResults = () => document.getElementById('search-results')
    const getPanel = () => document.querySelector('.search-panel-show') as HTMLElement | null
    const getExactToggle = () => document.getElementById('search-exact') as HTMLButtonElement | null

    const EMPTY_STATE = `
      <div class="flex select-none flex-col items-center justify-center gap-3 py-16 text-center">
        <span class="icon-[ph--magnifying-glass] size-9 text-muted-foreground/35"></span>
        <div>
          <p class="text-sm font-medium text-muted-foreground">Search across articles, notes and pages</p>
          <p class="mt-1 text-[11px] text-muted-foreground/60">Press Esc to close · Ctrl / Cmd + K to reopen</p>
        </div>
      </div>
    `

    let searchReqId = 0
    let isPagefindLoaded = false
    let isPagefindLoading = false

    let exactMode = false
    try {
      exactMode = localStorage.getItem('search-exact') === '1'
    } catch {}

    const updateExactUI = () => {
      const exactToggle = getExactToggle()
      if (!exactToggle) return
      exactToggle.setAttribute('aria-pressed', exactMode ? 'true' : 'false')
      if (exactMode) {
        exactToggle.classList.add('bg-foreground', 'text-background', 'border-foreground')
        exactToggle.classList.remove('text-muted-foreground', 'bg-transparent')
      } else {
        exactToggle.classList.remove('bg-foreground', 'text-background', 'border-foreground')
        exactToggle.classList.add('text-muted-foreground', 'bg-transparent')
      }
    }

    // 按需加载 Pagefind 引擎
    const initPagefind = async () => {
      if (isPagefindLoaded || isPagefindLoading || !import.meta.env.PROD) return

      isPagefindLoading = true
      const input = getInput()
      if (input) input.placeholder = 'Initializing search engine...'

      try {
        // 核心修复：通过拼接字符串绕过 Vite 静态依赖解析，防止开发环境报错
        const path = '/pagefind/' + 'pagefind.js'
        const pagefind = await import(/* @vite-ignore */ path)

        await pagefind.options({
          excerptLength: 25,
          showSubResults: true,
        })
        await pagefind.init()
        ;(window as any).pagefind = pagefind
        isPagefindLoaded = true

        const freshInput = getInput()
        if (freshInput) {
          freshInput.placeholder = 'Search documentation...'
          if (freshInput.value.trim() !== '') {
            freshInput.dispatchEvent(new Event('input'))
          }
        }
      } catch (e) {
        console.error('Failed to load pagefind:', e)
        const freshInput = getInput()
        if (freshInput) freshInput.placeholder = 'Engine failed to load'
      } finally {
        isPagefindLoading = false
      }
    }

    const openSearch = () => {
      const mask = getMask()
      const panel = getPanel()
      // 批量修改 CSS 类，避免多次重排
      mask?.classList.remove('hidden')
      // 使用 requestAnimationFrame 将样式变化和重排分离
      requestAnimationFrame(() => {
        mask?.classList.remove('opacity-0')
        panel?.classList.remove('-translate-y-4')
        panel?.classList.add('translate-y-0')
      })
      const results = getResults()
      if (results && results.innerHTML.trim() === '') results.innerHTML = EMPTY_STATE
      getInput()?.focus()

      // 打开面板的瞬间去加载庞大的 WASM
      initPagefind()
    }

    const closeSearch = () => {
      const mask = getMask()
      const panel = getPanel()
      mask?.classList.add('opacity-0')
      panel?.classList.remove('translate-y-0')
      panel?.classList.add('-translate-y-4')
      setTimeout(() => {
        getMask()?.classList.add('hidden')
        const input = getInput()
        if (input) input.value = ''
        const results = getResults()
        if (results) results.innerHTML = ''
      }, 300)
    }

    const handleInput = async (e: Event) => {
      const results = getResults()
      if (results) results.innerHTML = ''
      const target = e.target as HTMLInputElement
      const q = target.value.trim()
      const reqId = ++searchReqId

      if (q === '') {
        results?.insertAdjacentHTML(
          'beforeend',
          `
        <div class="py-16 flex flex-col items-center justify-center gap-3 select-none opacity-50">
          <span class="icon-[ph--keyboard] size-10 text-muted-foreground"></span>
          <span class="text-sm font-medium text-muted-foreground">Type to start searching</span>
        </div>
      `
        )
        return
      }

      if (import.meta.env.PROD) {
        if (!isPagefindLoaded) return

        const pagefindQuery = exactMode ? `"${q}"` : q
        const search = await (window as any).pagefind.debouncedSearch(pagefindQuery)

        if (reqId !== searchReqId || getInput()?.value.trim() !== q) return

        if (!search?.results || search.results.length === 0) {
          results?.insertAdjacentHTML(
            'beforeend',
            `
          <div class="py-16 flex flex-col items-center justify-center gap-3 select-none opacity-60">
            <span class="icon-[ph--magnifying-glass-minus] size-10 text-muted-foreground"></span>
            <span class="text-sm font-medium text-muted-foreground">No results found for "${q}"</span>
          </div>
        `
          )
          return
        }

        for (const result of search.results) {
          const data = await result.data()

          const resultItem = document.createElement('a')
          resultItem.href = data.url
          resultItem.className = 'group block border-b border-border/50 px-5 py-4 transition-colors last:border-b-0 hover:bg-accent/60'
          resultItem.innerHTML = `
          <h3 class="mb-1.5 font-serif text-lg font-medium tracking-[-0.02em] text-foreground transition-colors group-hover:text-primary">${data.meta.title}</h3>
          <p class="line-clamp-2 text-sm leading-relaxed text-muted-foreground">${data.excerpt}</p>
        `
          results?.appendChild(resultItem)

          if (data.sub_results) {
            for (const subResult of data.sub_results) {
              if (subResult.excerpt === data.excerpt) continue
              const cleanTitle = subResult.title.replace(/\s*[Hh][1-6]$/g, '')
              if (!cleanTitle) continue

              const subItem = document.createElement('a')
              subItem.href = subResult.url
              subItem.className =
                'group block border-b border-border/40 bg-muted/25 py-2.5 pr-4 pl-7 transition-colors last:border-b-0 hover:bg-accent/60'
              subItem.innerHTML = `
              <h4 class="mb-0.5 text-[13px] font-semibold tracking-[-0.01em] text-foreground transition-colors group-hover:text-primary">${cleanTitle}</h4>
              <p class="line-clamp-1 text-xs text-muted-foreground/80">${subResult.excerpt}</p>
            `
              results?.appendChild(subItem)
            }
          }
        }
      } else {
        results?.insertAdjacentHTML(
          'beforeend',
          `
        <div class="py-16 flex flex-col items-center justify-center gap-3 select-none opacity-60">
          <span class="icon-[ph--warning-circle] size-10 text-warning/80"></span>
          <span class="text-sm font-medium text-muted-foreground text-center">Search requires Pagefind.<br/>Not available in dev mode.</span>
        </div>
      `
        )
      }
    }

    // 事件委托：即使 View Transitions 替换了按钮/输入框节点也能正常工作
    document.addEventListener('click', (e) => {
      const target = e.target instanceof Element ? e.target : null
      if (!target) return

      if (target.closest('#search-switch')) {
        openSearch()
        return
      }

      if (target.closest('#search-exact')) {
        exactMode = !exactMode
        try {
          localStorage.setItem('search-exact', exactMode ? '1' : '0')
        } catch {}
        updateExactUI()
        getInput()?.dispatchEvent(new Event('input'))
        return
      }

      // 点击搜索结果时关闭面板
      if (target.closest('#search-results a')) {
        closeSearch()
        return
      }

      if (target.id === 'search-mask') closeSearch()
    })

    document.addEventListener('input', (e) => {
      const target = e.target as HTMLElement | null
      if (target && target.id === 'search-input') handleInput(e)
    })

    const handleKeydown = (e: KeyboardEvent) => {
      const mask = getMask()
      if (e.key === 'Escape' && !mask?.classList.contains('hidden')) {
        closeSearch()
      }
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault()
        if (mask?.classList.contains('hidden')) {
          openSearch()
        } else {
          closeSearch()
        }
      }
    }
    document.addEventListener('keydown', handleKeydown)

    // 页面切换后同步新节点的状态（如 Exact 按钮）
    const sync = () => updateExactUI()
    sync()
    document.addEventListener('astro:after-swap', sync)
    document.addEventListener('astro:page-load', sync)
  })()
</script>
