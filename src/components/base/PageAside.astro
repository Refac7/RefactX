---
import { SITE } from '~/config'

export interface StatItem { value: string; label: string }
export interface IdentityTag { icon: string; label: string }

interface Props {
  statusText: string
  statusHasPing?: boolean
  statusVariant?: 'emerald' | 'primary'
  title: string
  subtitleIcon?: string
  subtitleText?: string
  identityTags?: IdentityTag[]
  intro?: string
  statsLabel?: string
  statsMeta?: string
  stats: StatItem[]
}

const {
  statusText,
  statusHasPing = true,
  statusVariant = 'emerald',
  title,
  subtitleIcon,
  subtitleText,
  identityTags = [],
  intro,
  statsLabel = '// SYSTEM STATUS',
  statsMeta,
  stats,
} = Astro.props as Props

const dotColor = statusVariant === 'emerald' ? 'bg-emerald-500' : 'bg-primary'
const pingColor = statusVariant === 'emerald' ? 'bg-emerald-400' : 'bg-primary/60'
const visibleIdentityTags = identityTags.slice(0, 2)
---

<aside class="w-full lg:w-1/3 lg:sticky lg:top-0 lg:h-screen flex flex-col lg:border-r border-border/40 z-20 bg-background relative overflow-hidden">
  <div class="absolute -top-24 -left-24 size-72 rounded-full bg-primary/5 blur-3xl pointer-events-none" />

  <div class="relative z-10 flex flex-1 flex-col">
    <header class="px-6 pt-6 lg:px-8 lg:pt-8 xl:px-12">
      <div class="flex items-center justify-between border-b border-border/40 pb-4">
        <div class="flex items-center gap-3 select-none">
          <span class="icon-[ph--terminal-window] size-5 text-primary" />
          <div>
            <div class="text-xs font-semibold tracking-tight text-foreground">{SITE.title || 'Digital Hub'}</div>
            <div class="font-mono text-[9px] uppercase tracking-[0.16em] text-muted-foreground/50">Interface / {SITE.version}</div>
          </div>
        </div>
      </div>
    </header>

    <section class="flex flex-1 flex-col justify-center px-6 py-12 lg:px-8 xl:px-12">
      <div class="mb-5 flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.16em] text-muted-foreground/60 select-none">
        <span class="relative flex size-1.5">
          {statusHasPing && <span class={`absolute inset-0 animate-ping rounded-full opacity-60 ${pingColor}`} />}
          <span class={`relative size-1.5 rounded-full ${dotColor}`} />
        </span>
        {statusText}
      </div>
      <h1 class="text-4xl font-bold leading-[1.05] tracking-[-0.04em] text-foreground sm:text-5xl xl:text-6xl select-none">{title}</h1>

      {subtitleIcon && subtitleText && (
        <div class="mt-5 flex items-center gap-2 text-sm text-muted-foreground">
          <span class={`${subtitleIcon} size-4 text-primary/70`} />
          <span>{subtitleText}</span>
        </div>
      )}

      {visibleIdentityTags.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-x-3 gap-y-2 font-mono text-[11px] text-muted-foreground/70">
          {visibleIdentityTags.map((tag, i) => (
            <span class="inline-flex items-center gap-1.5">
              {i > 0 && <span class="text-border">/</span>}
              <span class={`${tag.icon} size-3.5`} />
              {tag.label}
            </span>
          ))}
        </div>
      )}

      {intro && (
        <div class="mt-8 max-w-md border-l border-primary/40 pl-4">
          <p class="text-sm leading-7 text-muted-foreground">{intro}</p>
        </div>
      )}
    </section>
  </div>

  <footer class="relative z-10 hidden shrink-0 border-t border-border/40 lg:block">
    <div class="flex items-center justify-between px-6 py-3 lg:px-8 xl:px-12">
      <span class="font-mono text-[9px] uppercase tracking-[0.16em] text-muted-foreground/50">{statsLabel}</span>
      {statsMeta && <span class="font-mono text-[9px] uppercase tracking-[0.16em] text-muted-foreground/40">{statsMeta}</span>}
    </div>
    <div class="grid" style={`grid-template-columns: repeat(${Math.min(stats.length, 3)}, minmax(0, 1fr))`}>
      {stats.map((stat, i) => (
        <div class={`min-w-0 px-6 py-5 lg:px-8 xl:px-10 ${i < stats.length - 1 ? 'border-r border-border/40' : ''} hover:bg-muted/20 transition-colors`}>
          <div class="truncate text-lg font-semibold tracking-tight text-foreground">{stat.value}</div>
          <div class="mt-1 truncate text-[10px] uppercase tracking-wider text-muted-foreground/60">{stat.label}</div>
        </div>
      ))}
    </div>
  </footer>
</aside>
