---
import { SITE } from '~/config'

export interface StatItem {
  value: string
  label: string
}

export interface IdentityTag {
  icon: string
  label: string
}

interface Props {
  /** Main heading */
  title: string
  /** Icon class for the subtitle line */
  subtitleIcon?: string
  /** Text for the subtitle line */
  subtitleText?: string
  /** Identity tags shown below the title */
  identityTags?: IdentityTag[]
  /** Intro / description paragraph */
  intro?: string
  /** @deprecated Kept for backwards-compatible page configuration. */
  statusText?: string
  /** @deprecated Kept for backwards-compatible page configuration. */
  statusHasPing?: boolean
  /** @deprecated Kept for backwards-compatible page configuration. */
  statusVariant?: 'emerald' | 'primary'
  /** @deprecated Bottom stats were removed from the shared aside. */
  statsLabel?: string
  /** @deprecated Bottom stats were removed from the shared aside. */
  statsMeta?: string
  /** @deprecated Bottom stats were removed from the shared aside. */
  stats?: StatItem[]
}

const { title, subtitleIcon, subtitleText, identityTags = [], intro } = Astro.props as Props
---

<aside
  class="w-full lg:w-1/3 lg:sticky lg:top-0 lg:h-screen flex flex-col xl:border-r border-border/40 z-20 bg-background/50 backdrop-blur-sm relative overflow-hidden"
>
  <div
    class="absolute top-0 left-0 w-full h-96 bg-primary/5 rounded-full blur-3xl -z-10 translate-x-[-20%] translate-y-[-20%] pointer-events-none"
  />

  <!-- Shared brand header: intentionally identical across every page. -->
  <header class="shrink-0 p-6 lg:p-8 xl:p-10 flex items-center justify-between gap-4 fade-up">
    <div class="flex items-center gap-3 select-none min-w-0">
      <div class="size-9 rounded-lg bg-primary/10 border border-primary/20 flex items-center justify-center text-primary shrink-0">
        <span class="icon-[ph--terminal-window-duotone] size-5" />
      </div>
      <div class="min-w-0">
        <div class="text-sm font-bold tracking-tight truncate">{SITE.title || 'Digital Hub'}</div>
        <div class="text-[10px] text-muted-foreground uppercase tracking-widest font-mono">v{SITE.version}</div>
      </div>
    </div>
    <span class="text-[10px] font-mono text-muted-foreground shrink-0">Astro</span>
  </header>

  <!-- Page identity: no status badge or secondary metrics. -->
  <div class="flex-1 flex flex-col justify-center p-6 lg:p-8 xl:p-10 pb-10 fade-up animation-delay-100">
    <div class="max-w-xl">
      {subtitleIcon && subtitleText && (
        <div class="flex items-center gap-2 text-sm text-muted-foreground mb-3">
          <span class={`${subtitleIcon} size-4`} />
          <span>{subtitleText}</span>
        </div>
      )}

      <h1 class="text-4xl sm:text-5xl xl:text-6xl font-bold tracking-tight text-foreground leading-[1.1] mb-5 select-none">
        {title}
      </h1>

      {identityTags.length > 0 && (
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-muted-foreground mb-6 font-mono">
          {identityTags.map((tag, i) => (
            <span class="flex items-center gap-1.5">
              {i > 0 && <span class="w-1 h-1 rounded-full bg-border mr-1.5" />}
              <span class={`${tag.icon} size-3.5`} />
              {tag.label}
            </span>
          ))}
        </div>
      )}

      {intro && (
        <div class="relative pl-4 border-l-2 border-primary/30">
          <p class="text-sm md:text-base text-muted-foreground leading-relaxed">{intro}</p>
        </div>
      )}
    </div>
  </div>
</aside>
