---
import { SITE, SOCIAL_LINKS } from '~/config'

export interface StatItem {
  value: string
  label: string
}

export interface IdentityTag {
  icon: string
  label: string
}

interface Props {
  /** Status badge text */
  statusText?: string
  /** Show the animated ping dot */
  statusHasPing?: boolean
  /** Badge color variant */
  statusVariant?: 'success' | 'primary'
  /** Main heading */
  title?: string
  /** Icon class for the subtitle line */
  subtitleIcon?: string
  /** Text for the subtitle line */
  subtitleText?: string
  /** Identity tags shown below the title */
  identityTags?: IdentityTag[]
  /** Intro / description paragraph */
  intro?: string
  /** Label for the bottom stats section */
  statsLabel?: string
  /** Right-side metadata for the stats section header (auto-derived from social links if omitted) */
  statsMeta?: string
  /** Stats cells in the bottom bar (2–3 items) */
  stats?: StatItem[]
  /** Built-in social link list (defaults to site config) */
  socialLinks?: typeof SOCIAL_LINKS
  /** Toggle the built-in social link list when no slot overrides it (opt-in) */
  showSocialLinks?: boolean
}

const {
  statusText = 'Building & Exploring',
  statusHasPing = true,
  statusVariant = 'primary',
  title = 'Overview',
  subtitleIcon = 'icon-[ph--house]',
  subtitleText = 'Home Overview',
  identityTags = [
    { icon: 'icon-[ph--code]', label: 'Developer' },
    { icon: 'icon-[ph--pen-nib]', label: 'Creator' },
  ],
  intro = '欢迎光临喵～ (・ω・)ノ，本站基于 Astro v6 构建，记录技术、分享生活。',
  statsLabel = 'Connect Portals',
  statsMeta,
  stats = [],
  socialLinks = SOCIAL_LINKS,
  showSocialLinks = false,
} = Astro.props as Props

const dotColor = statusVariant === 'success' ? 'bg-success' : 'bg-primary'
const pingColor = statusVariant === 'success' ? 'bg-success/70' : 'bg-primary/60'
const visibleIdentityTags = identityTags.slice(0, 2)
const hasBottomSlot = Astro.slots.has('bottom')
const hasMobileSlot = Astro.slots.has('mobile')

const hasBuiltinSocial = showSocialLinks && socialLinks.length > 0
const resolvedStatsMeta = statsMeta ?? `${socialLinks.length} ACTIVE`
---

<aside
  class="relative z-20 flex w-full min-w-0 flex-col border-b border-border bg-background lg:sticky lg:top-[76px] lg:h-[calc(100vh-76px)] lg:w-1/2 lg:basis-1/2 lg:shrink-0 lg:grow-0 lg:border-r lg:border-b-0"
>
  <div class="relative z-10 flex flex-1 flex-col lg:overflow-y-auto scrollbar-hide">
    <!-- Brand header -->
    <header class="flex shrink-0 items-center justify-between gap-3 px-6 pt-7 pb-5 lg:px-10 lg:py-6">
      <div class="flex min-w-0 items-center gap-3 select-none">
        <div
          class="brand-mark flex size-10 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary ring-1 ring-primary/15"
        >
          <span class="icon-[ph--asterisk-bold] size-5"></span>
        </div>

        <div class="min-w-0">
          <div class="truncate text-[14px] font-semibold tracking-[-0.01em] text-foreground">
            {SITE.title || 'Digital Hub'}
          </div>
          <div class="mt-0.5 truncate text-[11px] text-muted-foreground">Independent / Digital</div>
        </div>
      </div>

      <span aria-hidden="true" class="mt-1 inline shrink-0 text-[11px] tabular-nums text-muted-foreground/60"> 01—01 </span>
    </header>

    <!-- Hero -->
    <section
      class="editorial-hero swiss-grid relative flex min-h-[46vh] flex-1 flex-col justify-start overflow-hidden px-6 py-10 sm:min-h-[40vh] sm:px-8 sm:py-12 lg:min-h-0 lg:px-10 lg:py-12 xl:px-12"
    >
      <span
        aria-hidden="true"
        class="pointer-events-none absolute -right-10 top-16 font-serif text-[13rem] leading-none text-primary/[0.055] select-none lg:text-[17rem]"
        >✳</span
      >

      <!-- Status -->
      <div class="relative z-10 flex items-center justify-between gap-4">
        <div
          class="inline-flex w-fit items-center gap-2 rounded-full border border-border bg-card/80 px-3 py-1.5 text-[11px] font-medium text-muted-foreground backdrop-blur-sm select-none"
        >
          {
            statusHasPing && (
              <span class="relative flex size-1.5">
                <span class={`absolute inline-flex size-full animate-ping rounded-full opacity-75 ${pingColor}`} />
                <span class={`relative inline-flex size-1.5 rounded-full ${dotColor}`} />
              </span>
            )
          }
          {statusText}
        </div>
        <span class="text-[11px] font-medium tracking-[0.08em] text-muted-foreground/50 uppercase">Fig. 01</span>
      </div>

      <!-- Kicker -->
      <div class="relative z-10 mt-10 flex items-center gap-2.5 text-[11px] font-semibold tracking-[0.16em] text-primary uppercase">
        <span class="h-px w-7 bg-primary"></span>
        <span>Independent / Digital</span>
      </div>

      <!-- Title -->
      <div class="relative z-10 mt-5">
        <h1 class="editorial-title relative w-fit max-w-full text-foreground select-none">
          <span class="editorial-title-text">{title}</span>
          <span aria-hidden="true" class="editorial-title-period">.</span>
        </h1>
      </div>

      <!-- Subtitle -->
      {
        subtitleIcon && subtitleText && (
          <div class="relative z-10 mt-6 flex items-center gap-2 text-[12px] font-medium text-muted-foreground">
            <span class={`${subtitleIcon} size-4 shrink-0 text-primary/80`} />
            <span>{subtitleText}</span>
          </div>
        )
      }

      <!-- Identity tags -->
      {
        visibleIdentityTags.length > 0 && (
          <div class="relative z-10 mt-3 flex flex-wrap items-center gap-2">
            {visibleIdentityTags.map((tag) => (
              <span class="inline-flex items-center gap-1.5 rounded-full border border-border/80 bg-card/60 px-2.5 py-1 text-[11px] font-medium text-muted-foreground">
                <span class={`${tag.icon} size-3.5 shrink-0 text-primary/70`} />
                {tag.label}
              </span>
            ))}
          </div>
        )
      }

      <!-- Intro -->
      {
        intro && (
          <div class="editorial-intro relative z-10 mt-10 max-w-[31rem] rounded-2xl border border-border/80 bg-card/65 p-5 backdrop-blur-sm lg:mt-auto">
            <div class="mb-2 text-[10px] font-semibold tracking-[0.16em] text-muted-foreground/60 uppercase">Abstract</div>
            <p class="text-[14px] leading-relaxed text-muted-foreground md:text-[15px]">
              {intro.split('\n').map((line, i) => (
                <>
                  {i > 0 && <br />}
                  {line}
                </>
              ))}
            </p>
          </div>
        )
      }

      <!-- Bottom editorial marker -->
      <div
        aria-hidden="true"
        class="relative z-10 mt-8 flex items-center gap-3 text-[10px] font-medium tracking-[0.14em] text-muted-foreground/50 uppercase"
      >
        <span class="h-px w-7 bg-border"></span>
        <span>Scroll to explore</span>
        <span class="ml-auto">↓</span>
      </div>
    </section>
  </div>

  <!-- Mobile slot / built-in mobile social links -->
  {
    (hasMobileSlot || hasBuiltinSocial) && (
      <div class="shrink-0 border-t border-border bg-background select-none lg:hidden">
        {hasMobileSlot ? (
          <slot name="mobile" />
        ) : (
          <div class="p-6">
            <div class="flex items-center justify-between text-[11px] font-medium text-muted-foreground">
              <span class="flex items-center gap-2">
                <span class="size-1.5 rounded-full bg-primary" />
                {statsLabel}
              </span>
              <span>{resolvedStatsMeta}</span>
            </div>
            <div class="mt-4 grid grid-cols-2 gap-2.5">
              {socialLinks.map((item) => (
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-center gap-2.5 rounded-xl border border-border bg-card px-3.5 py-3 text-foreground transition-colors hover:border-primary/40 hover:bg-accent-soft"
                >
                  <span class={`${item.icon} size-4 shrink-0 text-primary`} />
                  <span class="truncate text-[12px] font-medium">{item.name}</span>
                  <span class="icon-[ph--arrow-up-right] ml-auto size-3.5 shrink-0 text-muted-foreground/50 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    )
  }

  <!-- Bottom stats / built-in social links -->
  <footer class="relative hidden shrink-0 border-t border-border bg-background select-none lg:block">
    <div
      class="flex items-center justify-between border-b border-border/70 px-6 py-3 text-[10px] font-semibold tracking-[0.13em] text-muted-foreground uppercase lg:px-10 xl:px-12"
    >
      <span class="flex items-center gap-2">
        <span class="size-1.5 rounded-full bg-primary"></span>
        {statsLabel}
      </span>
      {resolvedStatsMeta && <span class="tabular-nums">{resolvedStatsMeta}</span>}
    </div>

    {
      hasBottomSlot ? (
        <slot name="bottom" />
      ) : hasBuiltinSocial ? (
        <div class="grid grid-cols-1 gap-2 p-3">
          {socialLinks.map((item) => (
            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex h-12 items-center gap-3.5 rounded-xl px-3.5 text-left transition-colors hover:bg-accent-soft"
            >
              <span class={`${item.icon} size-4 shrink-0 text-primary`} />
              <span class="text-[13px] font-medium text-foreground">{item.name || 'Link'}</span>
              <span class="icon-[ph--arrow-up-right] ml-auto size-3.5 text-muted-foreground/50 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
            </a>
          ))}
        </div>
      ) : (
        <>
          {stats.length === 2 && (
            <div class="grid grid-cols-2 gap-2 p-3">
              {stats.map((stat) => (
                <div class="stat-cell group flex flex-col items-start justify-center rounded-xl border border-border/70 bg-card/60 px-4 py-5 transition-colors hover:border-primary/30 hover:bg-accent-soft/60">
                  <span class="stat-value font-serif font-medium tracking-[-0.02em] text-foreground">{stat.value}</span>
                  <span class="mt-2 text-[10px] font-semibold tracking-[0.12em] text-muted-foreground uppercase">{stat.label}</span>
                </div>
              ))}
            </div>
          )}

          {stats.length === 3 && (
            <div class="flex flex-col gap-2 p-3">
              <div class="grid grid-cols-2 gap-2">
                {stats.slice(0, 2).map((stat) => (
                  <div class="stat-cell group flex flex-col items-start justify-center rounded-xl border border-border/70 bg-card/60 px-4 py-5 transition-colors hover:border-primary/30 hover:bg-accent-soft/60">
                    <span class="stat-value font-serif font-medium tracking-[-0.02em] text-foreground">{stat.value}</span>
                    <span class="mt-2 text-[10px] font-semibold tracking-[0.12em] text-muted-foreground uppercase">{stat.label}</span>
                  </div>
                ))}
              </div>

              <div class="group flex items-center justify-between rounded-xl border border-border/70 bg-card/60 px-4 py-3.5 transition-colors hover:border-primary/30 hover:bg-accent-soft/60">
                <span class="text-[10px] font-semibold tracking-[0.12em] text-muted-foreground uppercase">{stats[2].label}</span>
                <span class="text-[13px] font-semibold tabular-nums text-foreground">{stats[2].value}</span>
              </div>
            </div>
          )}
        </>
      )
    }
  </footer>
</aside>

<style>
  .editorial-hero {
    isolation: isolate;
  }

  .editorial-title {
    font-family: var(--font-serif);
    font-size: clamp(3.25rem, 10vw, 5rem);
    line-height: 0.96;
    font-weight: 500;
    letter-spacing: -0.045em;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .editorial-title-period {
    color: hsl(var(--primary));
    letter-spacing: -0.06em;
  }

  .stat-value {
    font-size: clamp(1.75rem, 2.8vw, 2.75rem);
    line-height: 1;
    overflow-wrap: anywhere;
  }

  /* Editorial typography scales up with the available width. */
  @media (min-width: 1024px) {
    .editorial-title {
      font-size: clamp(4rem, 6vw, 6.5rem);
      line-height: 0.93;
      letter-spacing: -0.05em;
    }
  }

  /* Short browser windows: preserve the oversized title without
     forcing the entire sidebar to exceed the viewport unnecessarily. */
  @media (min-width: 1024px) and (max-height: 760px) {
    .editorial-title {
      font-size: clamp(3rem, 4.6vw, 4.75rem);
    }

    .editorial-hero {
      padding-top: 1.75rem;
      padding-bottom: 1.75rem;
    }

    .stat-cell {
      padding-top: 1rem;
      padding-bottom: 1rem;
    }
  }

  @media (min-width: 1024px) and (max-height: 620px) {
    .editorial-title {
      font-size: clamp(2.5rem, 3.8vw, 3.5rem);
    }

    .editorial-hero {
      padding-top: 1rem;
      padding-bottom: 1rem;
    }

    .editorial-hero > .editorial-intro p {
      font-size: 0.8125rem;
      line-height: 1.5;
    }

    .stat-value {
      font-size: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .editorial-aside *,
    .editorial-aside *::before,
    .editorial-aside *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
