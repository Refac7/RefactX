---
import { SITE } from '~/config'

export interface StatItem {
  value: string
  label: string
}

export interface IdentityTag {
  icon: string
  label: string
}

interface Props {
  /** Status badge text (e.g. "Alive", "Live Sync") */
  statusText: string
  /** Show the animated ping dot */
  statusHasPing?: boolean
  /** Badge color variant */
  statusVariant?: 'emerald' | 'primary'
  /** Main heading */
  title: string
  /** Icon class for the subtitle line */
  subtitleIcon?: string
  /** Text for the subtitle line */
  subtitleText?: string
  /** Identity tags shown below the title (icon + label with dot separators) */
  identityTags?: IdentityTag[]
  /** Intro / description paragraph */
  intro?: string
  /** Label for the bottom stats section */
  statsLabel?: string
  /** Right-side metadata for the stats section header */
  statsMeta?: string
  /** Stats cells in the bottom bar (2–3 items) */
  stats: StatItem[]
}

const {
  statusText,
  statusHasPing = true,
  statusVariant = 'emerald',
  title,
  subtitleIcon,
  subtitleText,
  identityTags = [],
  intro,
  statsLabel = '// SYSTEM STATUS',
  statsMeta,
  stats,
} = Astro.props as Props

const dotColor = statusVariant === 'emerald' ? 'bg-emerald-500' : 'bg-primary'
const pingColor = statusVariant === 'emerald' ? 'bg-emerald-400' : 'bg-primary/60'
const visibleIdentityTags = identityTags.slice(0, 2)
---

<aside
  class="lg:blueprint-hatch w-full lg:w-1/3 lg:sticky lg:top-0 lg:h-screen flex flex-col lg:border-r border-border/40 z-20 bg-background/50 backdrop-blur-sm relative overflow-hidden"
>
  <!-- Blueprint guide lines (desktop only) -->
  <div class="hidden lg:block absolute inset-0 pointer-events-none" aria-hidden="true">
    <!-- Drawing frame -->
    <div class="absolute inset-2.5 border border-dashed border-border/70"></div>
    <!-- Frame corner crosshairs -->
    <div class="blueprint-mark absolute left-1.5 top-1.5 size-5"></div>
    <div class="blueprint-mark absolute right-1.5 top-1.5 size-5"></div>
    <div class="blueprint-mark absolute left-1.5 bottom-1.5 size-5"></div>
    <div class="blueprint-mark absolute right-1.5 bottom-1.5 size-5"></div>
    <!-- Center guide lines -->
    <div class="absolute left-2.5 right-2.5 top-1/2 border-t border-dashed border-border/40"></div>
    <div class="absolute top-2.5 bottom-2.5 left-1/2 border-l border-dashed border-border/40"></div>
    <!-- Guide line endpoint crosshairs -->
    <div class="blueprint-mark absolute left-1/2 top-2.5 size-3"></div>
    <div class="blueprint-mark absolute left-1/2 bottom-2.5 size-3"></div>
    <div class="blueprint-mark absolute left-2.5 top-1/2 size-3"></div>
    <div class="blueprint-mark absolute right-2.5 top-1/2 size-3"></div>
  </div>

  <div class="flex flex-1 lg:overflow-y-auto scrollbar-hide flex-col relative z-10">
    <!-- Logo / brand header -->
    <div
      class="p-6 lg:p-8 xl:p-12 pb-0 lg:pb-4 shrink-0 fade-up flex justify-between items-start lg:border-b lg:border-dashed lg:border-border/60"
    >
      <div class="flex items-center gap-3 select-none">
        <div class="size-10 bg-primary/10 border border-primary/20 flex items-center justify-center text-primary">
          <span class="icon-[ph--terminal-window-duotone] size-6"></span>
        </div>
        <div>
          <div class="text-sm font-bold tracking-tight">{SITE.title || 'Digital Hub'}</div>
          <div class="text-[10px] text-muted-foreground uppercase tracking-widest font-mono">System Online</div>
        </div>
      </div>
      <span
        class="inline-flex items-center border border-primary/20 bg-primary/5 px-2.5 py-1 text-[10px] font-mono text-primary select-none"
      >
        v{SITE.version} / Astro
      </span>
    </div>

    <!-- Hero area: status + title + identity tags -->
    <div class="flex-1 flex flex-col justify-center p-6 lg:p-8 xl:p-12 min-h-[50vh] lg:min-h-0 fade-up animation-delay-100">
      <!-- Mobile: original pre-blueprint layout (no boxes), square corners -->
      <div class="lg:hidden">
        <!-- Status badge -->
        <div
          class="inline-flex items-center gap-2 px-3 py-1.5 bg-muted/30 border border-border/50 text-xs font-medium text-muted-foreground mb-8 w-fit select-none"
        >
          {
            statusHasPing && (
              <span class="relative flex size-2">
                <span class={`animate-ping absolute inline-flex h-full w-full rounded-full opacity-75 ${pingColor}`} />
                <span class={`relative inline-flex rounded-full size-2 ${dotColor}`} />
              </span>
            )
          }
          {statusText}
        </div>

        <!-- Main title -->
        <h1 class="text-[2.5rem] sm:text-5xl font-bold tracking-tight text-foreground leading-[1.15] mb-4 select-none">
          {title}
        </h1>

        <!-- Subtitle -->
        {
          subtitleIcon && subtitleText && (
            <div class="flex items-center gap-2 text-sm text-muted-foreground mb-4">
              <span class={`${subtitleIcon} size-4`} />
              <span>{subtitleText}</span>
            </div>
          )
        }

        <!-- Identity tags -->
        {
          visibleIdentityTags.length > 0 && (
            <div class="flex flex-wrap items-center gap-4 text-sm text-muted-foreground mb-8 font-mono">
              {visibleIdentityTags.map((tag, i) => (
                <>
                  {i > 0 && <span class="w-1 h-1 rounded-full bg-border" />}
                  <span class="flex items-center gap-1.5">
                    <span class={`${tag.icon} size-4`} />
                    {tag.label}
                  </span>
                </>
              ))}
            </div>
          )
        }

        <!-- Intro text with left border accent -->
        {
          intro && (
            <div class="relative pl-4 border-l-2 border-primary/30 fade-up animation-delay-150">
              <p class="text-sm md:text-base text-muted-foreground leading-relaxed">{intro}</p>
            </div>
          )
        }
      </div>

      <!-- Desktop: blueprint design (boxed text + corner ticks) -->
      <div class="hidden lg:flex flex-col gap-5">
        <!-- Status badge -->
        <div
          class="blueprint-box inline-flex items-center gap-2 px-3 py-1.5 bg-muted/30 border border-border/60 text-xs font-medium text-muted-foreground w-fit select-none"
        >
          {
            statusHasPing && (
              <span class="relative flex size-2">
                <span class={`animate-ping absolute inline-flex h-full w-full rounded-full opacity-75 ${pingColor}`} />
                <span class={`relative inline-flex rounded-full size-2 ${dotColor}`} />
              </span>
            )
          }
          {statusText}
        </div>

        <!-- Main title -->
        <div class="blueprint-box border border-border/60 bg-background/70 px-4 py-4">
          <span class="blueprint-label">// TITLE</span>
          <h1 class="text-[2.5rem] sm:text-5xl xl:text-6xl font-bold tracking-tight text-foreground leading-[1.15] select-none">
            {title}
          </h1>
        </div>

        <!-- Subtitle + identity tags -->
        {
          (subtitleText || visibleIdentityTags.length > 0) && (
            <div class="blueprint-box border border-border/60 bg-background/70 px-4 py-3">
              <span class="blueprint-label">// META</span>
              {subtitleIcon && subtitleText && (
                <div class="flex items-center gap-2 text-sm text-muted-foreground mb-2">
                  <span class={`${subtitleIcon} size-4`} />
                  <span>{subtitleText}</span>
                </div>
              )}
              {visibleIdentityTags.length > 0 && (
                <div class="flex flex-wrap items-center gap-4 text-sm text-muted-foreground font-mono">
                  {visibleIdentityTags.map((tag, i) => (
                    <>
                      {i > 0 && <span class="w-1 h-1 rounded-full bg-border" />}
                      <span class="flex items-center gap-1.5">
                        <span class={`${tag.icon} size-4`} />
                        {tag.label}
                      </span>
                    </>
                  ))}
                </div>
              )}
            </div>
          )
        }

        <!-- Intro text -->
        {
          intro && (
            <div class="blueprint-box border border-border/60 bg-background/70 px-4 py-3 fade-up animation-delay-150">
              <span class="blueprint-label">// INTRO</span>
              <p class="text-sm md:text-base text-muted-foreground leading-relaxed">{intro}</p>
            </div>
          )
        }
      </div>
    </div>
  </div>

  <!-- Bottom stats bar -->
  <div
    class="hidden lg:block shrink-0 border-t border-dashed border-border/50 bg-background/50 select-none fade-up animation-delay-200 relative"
  >
    <div class="blueprint-mark absolute left-2.5 top-2 size-3"></div>
    <div class="blueprint-mark absolute right-2.5 top-2 size-3"></div>
    <div class="blueprint-mark absolute left-2.5 bottom-2 size-3"></div>
    <div class="blueprint-mark absolute right-2.5 bottom-2 size-3"></div>
    <div
      class="p-4 flex items-center justify-between text-xs text-muted-foreground font-mono border-b border-dashed border-border/50 px-6 lg:px-8 xl:px-12"
    >
      <span>{statsLabel}</span>
      {statsMeta && <span>{statsMeta}</span>}
    </div>

    {
      stats.length === 2 && (
        <div class="flex">
          {stats.map((stat, i) => (
            <div
              class={`flex-1 flex flex-col items-start justify-center p-6 lg:p-8 xl:p-10 bg-background/50 hover:bg-primary/5 transition-colors ${i < stats.length - 1 ? 'border-r border-border/40' : ''}`}
            >
              <span class="text-2xl font-semibold text-foreground tracking-tight">{stat.value}</span>
              <span class="text-xs text-muted-foreground mt-1">{stat.label}</span>
            </div>
          ))}
        </div>
      )
    }

    {
      stats.length === 3 && (
        <div class="flex flex-col">
          <div class="flex">
            {stats.slice(0, 2).map((stat, i) => (
              <div
                class={`flex-1 flex flex-col items-start justify-center p-6 lg:p-8 xl:p-10 bg-background/50 border-b border-border/40 hover:bg-primary/5 transition-colors ${i === 0 ? 'border-r border-border/40' : ''}`}
              >
                <span class="text-2xl font-semibold text-foreground tracking-tight">{stat.value}</span>
                <span class="text-xs text-muted-foreground mt-1">{stat.label}</span>
              </div>
            ))}
          </div>
          <div class="flex items-center justify-between p-5 lg:p-6 bg-background/50 hover:bg-primary/5 transition-colors">
            <span class="text-xs text-muted-foreground font-medium">{stats[2].label}</span>
            <span class="text-sm font-semibold text-foreground">{stats[2].value}</span>
          </div>
        </div>
      )
    }
  </div>
</aside>
