---
import { SOCIAL_LINKS } from '~/config'

export interface StatItem {
  value: string
  label: string
}

export interface IdentityTag {
  icon: string
  label: string
}

interface Props {
  /** Status badge text */
  statusText?: string
  /** Show the animated ping dot */
  statusHasPing?: boolean
  /** Badge color variant */
  statusVariant?: 'success' | 'primary'
  /** Main heading */
  title?: string
  /** Icon class for the subtitle line */
  subtitleIcon?: string
  /** Text for the subtitle line */
  subtitleText?: string
  /** Identity tags shown below the title */
  identityTags?: IdentityTag[]
  /** Intro / description paragraph */
  intro?: string
  /** Label for the stats section */
  statsLabel?: string
  /** Right-side metadata for the stats section (auto-derived from social links if omitted) */
  statsMeta?: string
  /** Stats cells (2–3 items) */
  stats?: StatItem[]
  /** Built-in social link list */
  socialLinks?: typeof SOCIAL_LINKS
  /** Toggle the built-in social link list */
  showSocialLinks?: boolean
  /** Optional hero background image */
  image?: string
}

const {
  statusText = 'Building & Exploring',
  statusHasPing = true,
  statusVariant = 'primary',
  title = 'Overview',
  subtitleIcon = 'icon-[ph--house]',
  subtitleText = 'Home Overview',
  identityTags = [
    { icon: 'icon-[ph--code]', label: 'Developer' },
    { icon: 'icon-[ph--pen-nib]', label: 'Creator' },
  ],
  intro,
  statsLabel = 'Overview',
  statsMeta,
  stats = [],
  socialLinks = SOCIAL_LINKS,
  showSocialLinks = false,
  image = '/photos/240809-2.webp',
} = Astro.props as Props

const dotColor = statusVariant === 'success' ? 'bg-success' : 'bg-primary'
const pingColor = statusVariant === 'success' ? 'bg-success/70' : 'bg-primary/60'
const visibleIdentityTags = identityTags.slice(0, 4)
const visibleStats = stats.slice(0, 3)
const resolvedStatsMeta = statsMeta ?? `${socialLinks.length} ACTIVE`
---

<section class="page-hero">
  <div class="page-hero__media" aria-hidden="true">
    <img src={image} alt="" loading="eager" fetchpriority="high" decoding="async" onload="this.classList.add('is-loaded')" />
    <div class="page-hero__veil"></div>
    <div class="page-hero__grain"></div>
  </div>

  <div class="container-page page-hero__content">
    <div class="page-hero__status">
      {
        statusHasPing && (
          <span class="relative flex size-2">
            <span class={`absolute inline-flex size-full animate-ping rounded-full opacity-75 ${pingColor}`} />
            <span class={`relative inline-flex size-2 rounded-full ${dotColor}`} />
          </span>
        )
      }
      {statusText}
    </div>

    <div class="page-hero__headline">
      <span class="page-hero__eyebrow">RefactX · Journal</span>
      <h1 class="page-hero__title">
        {title}<span class="page-hero__period">.</span>
      </h1>
      {
        subtitleIcon && subtitleText && (
          <div class="page-hero__subtitle">
            <span class={`${subtitleIcon} size-4 shrink-0`} />
            <span>{subtitleText}</span>
          </div>
        )
      }
    </div>

    {
      intro && (
        <p class="page-hero__intro">
          {intro.split('\n').map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))}
        </p>
      )
    }

    {
      visibleIdentityTags.length > 0 && (
        <div class="page-hero__tags">
          {visibleIdentityTags.map((tag) => (
            <span class="page-hero__tag">
              <span class={`${tag.icon} size-3.5`} />
              {tag.label}
            </span>
          ))}
        </div>
      )
    }
  </div>

  {
    (visibleStats.length > 0 || showSocialLinks) && (
      <div class="container-page page-hero__stats-wrap">
        <div class="page-hero__stats">
          {showSocialLinks && socialLinks.length > 0 ? (
            <>
              <div class="page-hero__stats-head">
                <span>{statsLabel}</span>
                <span>{resolvedStatsMeta}</span>
              </div>
              <div class="page-hero__social-grid">
                {socialLinks.map((item) => (
                  <a href={item.url} target="_blank" rel="noopener noreferrer" class="page-hero__social">
                    <span class={`${item.icon} size-4`} />
                    <span>{item.name}</span>
                    <span class="icon-[ph--arrow-up-right] ml-auto size-3.5 opacity-40" />
                  </a>
                ))}
              </div>
            </>
          ) : (
            <>
              <div class="page-hero__stats-head">
                <span>{statsLabel}</span>
                <span>{resolvedStatsMeta}</span>
              </div>
              <div class="page-hero__stat-grid">
                {visibleStats.map((stat) => (
                  <div class="page-hero__stat">
                    <span class="page-hero__stat-value">{stat.value}</span>
                    <span class="page-hero__stat-label">{stat.label}</span>
                  </div>
                ))}
              </div>
            </>
          )}
        </div>
      </div>
    )
  }
</section>
