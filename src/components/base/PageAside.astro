---
import { SITE } from '~/config'

export interface StatItem {
  value: string
  label: string
}

export interface IdentityTag {
  icon: string
  label: string
}

interface Props {
  /** Status badge text (e.g. "Alive", "Live Sync") */
  statusText: string
  /** Show the animated ping dot */
  statusHasPing?: boolean
  /** Badge color variant */
  statusVariant?: 'emerald' | 'primary'
  /** Main heading */
  title: string
  /** Icon class for the subtitle line */
  subtitleIcon?: string
  /** Text for the subtitle line */
  subtitleText?: string
  /** Identity tags shown below the title */
  identityTags?: IdentityTag[]
  /** Intro / description paragraph */
  intro?: string
  /** Label for the bottom stats section */
  statsLabel?: string
  /** Right-side metadata for the stats section header */
  statsMeta?: string
  /** Stats cells in the bottom bar (2–3 items) */
  stats: StatItem[]
}

const {
  statusText,
  statusHasPing = true,
  statusVariant = 'emerald',
  title,
  subtitleIcon,
  subtitleText,
  identityTags = [],
  intro,
  statsLabel = '// SYSTEM STATUS',
  statsMeta,
  stats,
} = Astro.props as Props

const dotColor = statusVariant === 'emerald' ? 'bg-emerald-500' : 'bg-primary'
const pingColor = statusVariant === 'emerald' ? 'bg-emerald-400' : 'bg-primary/60'
const visibleIdentityTags = identityTags.slice(0, 3)
---

<aside class="w-full lg:w-1/3 lg:sticky lg:top-0 lg:h-screen flex flex-col lg:border-r border-border/40 z-20 bg-background relative overflow-hidden">
  <!-- Quiet grid texture keeps the visual language technical without competing with content. -->
  <div
    class="absolute inset-0 opacity-[0.035] pointer-events-none"
    style="background-image: linear-gradient(to right, currentColor 1px, transparent 1px), linear-gradient(to bottom, currentColor 1px, transparent 1px); background-size: 32px 32px;"
  ></div>
  <div class="absolute -top-40 -left-40 size-96 rounded-full bg-primary/10 blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 right-0 size-72 rounded-full bg-primary/5 blur-3xl pointer-events-none"></div>

  <!-- Brand / system header -->
  <header class="relative z-10 px-6 pt-6 lg:px-8 lg:pt-8 xl:px-12 xl:pt-10 shrink-0 fade-up">
    <div class="flex items-center justify-between gap-4 pb-5 border-b border-border/40">
      <div class="flex items-center gap-3 min-w-0 select-none">
        <div class="size-9 shrink-0 rounded-lg border border-border/50 bg-muted/30 flex items-center justify-center text-primary">
          <span class="icon-[ph--terminal-window-duotone] size-5"></span>
        </div>
        <div class="min-w-0">
          <div class="text-xs font-bold tracking-tight truncate">{SITE.title || 'Digital Hub'}</div>
          <div class="text-[9px] text-muted-foreground uppercase tracking-[0.18em] font-mono mt-0.5">Personal System</div>
        </div>
      </div>
      <div class="flex items-center gap-2 shrink-0 text-[9px] font-mono text-muted-foreground/60 uppercase tracking-wider">
        <span class={`size-1.5 rounded-full ${dotColor}`}></span>
        <span>Online</span>
      </div>
    </div>
  </header>

  <!-- Main identity panel -->
  <div class="relative z-10 flex-1 flex flex-col justify-center px-6 py-10 lg:px-8 xl:px-12 lg:py-12 min-h-[50vh] lg:min-h-0 fade-up animation-delay-100">
    <div class="mb-7 flex items-center justify-between gap-4 select-none">
      <div class="inline-flex items-center gap-2 rounded-md border border-border/50 bg-background/70 px-2.5 py-1.5 text-[10px] font-mono text-muted-foreground">
        {statusHasPing && (
          <span class="relative flex size-1.5">
            <span class={`animate-ping absolute inset-0 rounded-full opacity-75 ${pingColor}`}></span>
            <span class={`relative rounded-full size-1.5 ${dotColor}`}></span>
          </span>
        )}
        <span>{statusText}</span>
      </div>
      <span class="text-[9px] font-mono text-muted-foreground/40 tracking-widest">// 01</span>
    </div>

    <div class="relative">
      <div class="absolute -left-3 top-1 h-10 w-0.5 bg-primary/50"></div>
      <h1 class="text-[2.75rem] sm:text-5xl xl:text-6xl font-bold tracking-[-0.035em] text-foreground leading-[1.05] mb-5 select-none">
        {title}
      </h1>
    </div>

    {
      subtitleIcon && subtitleText && (
        <div class="flex items-center gap-2 text-sm text-muted-foreground mb-5">
          <span class={`${subtitleIcon} size-4 text-primary/70`} />
          <span>{subtitleText}</span>
        </div>
      )
    }

    {
      visibleIdentityTags.length > 0 && (
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mb-7 font-mono text-[11px] text-muted-foreground">
          {visibleIdentityTags.map((tag, i) => (
            <>
              {i > 0 && <span class="size-1 rounded-full bg-border/80"></span>}
              <span class="flex items-center gap-1.5 hover:text-foreground transition-colors">
                <span class={`${tag.icon} size-3.5`} />
                {tag.label}
              </span>
            </>
          ))}
        </div>
      )
    }

    {
      intro && (
        <div class="relative rounded-lg border border-border/40 bg-muted/20 px-4 py-4 fade-up animation-delay-150">
          <div class="absolute left-0 top-3 bottom-3 w-0.5 rounded-full bg-primary/40"></div>
          <p class="pl-2 text-sm md:text-[15px] text-muted-foreground leading-7">{intro}</p>
        </div>
      )
    }
  </div>

  <!-- Compact information rail -->
  <div class="hidden lg:block relative z-10 shrink-0 border-t border-border/40 bg-background/80 backdrop-blur-sm select-none fade-up animation-delay-200">
    <div class="flex items-center justify-between px-6 py-3 lg:px-8 xl:px-12 border-b border-border/30">
      <span class="text-[9px] text-muted-foreground/60 font-mono tracking-widest uppercase">{statsLabel}</span>
      {statsMeta && <span class="text-[9px] text-muted-foreground/40 font-mono">{statsMeta}</span>}
    </div>

    {
      stats.length === 2 && (
        <div class="grid grid-cols-2">
          {stats.map((stat, i) => (
            <div class={`group relative px-6 py-5 lg:px-8 xl:px-10 ${i === 0 ? 'border-r border-border/30' : ''} hover:bg-muted/20 transition-colors`}>
              <span class="block text-xl xl:text-2xl font-semibold tracking-tight text-foreground truncate group-hover:text-primary transition-colors">{stat.value}</span>
              <span class="block mt-1.5 text-[10px] font-mono uppercase tracking-wider text-muted-foreground/60 truncate">{stat.label}</span>
            </div>
          ))}
        </div>
      )
    }

    {
      stats.length === 3 && (
        <div class="grid grid-cols-2">
          {stats.slice(0, 2).map((stat, i) => (
            <div class={`group relative px-6 py-5 lg:px-8 ${i === 0 ? 'border-r border-border/30' : ''} hover:bg-muted/20 transition-colors`}>
              <span class="block text-xl font-semibold tracking-tight text-foreground truncate group-hover:text-primary transition-colors">{stat.value}</span>
              <span class="block mt-1.5 text-[10px] font-mono uppercase tracking-wider text-muted-foreground/60 truncate">{stat.label}</span>
            </div>
          ))}
          <div class="col-span-2 flex items-center justify-between gap-4 border-t border-border/30 px-6 py-3.5 lg:px-8 hover:bg-muted/20 transition-colors">
            <span class="text-[10px] font-mono uppercase tracking-wider text-muted-foreground/60 truncate">{stats[2].label}</span>
            <span class="text-xs font-semibold text-foreground truncate">{stats[2].value}</span>
          </div>
        </div>
      )
    }
  </div>
</aside>
