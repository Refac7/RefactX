---
import { SITE, SOCIAL_LINKS } from '~/config'

export interface StatItem {
  value: string
  label: string
}

export interface IdentityTag {
  icon: string
  label: string
}

interface Props {
  /** Status badge text */
  statusText?: string
  /** Show the animated ping dot */
  statusHasPing?: boolean
  /** Badge color variant */
  statusVariant?: 'success' | 'primary'
  /** Main heading */
  title?: string
  /** Icon class for the subtitle line */
  subtitleIcon?: string
  /** Text for the subtitle line */
  subtitleText?: string
  /** Identity tags shown below the title */
  identityTags?: IdentityTag[]
  /** Intro / description paragraph */
  intro?: string
  /** Label for the bottom stats section */
  statsLabel?: string
  /** Right-side metadata for the stats section header (auto-derived from social links if omitted) */
  statsMeta?: string
  /** Stats cells in the bottom bar (2–3 items) */
  stats?: StatItem[]
  /** Built-in social link list (defaults to site config) */
  socialLinks?: typeof SOCIAL_LINKS
  /** Toggle the built-in social link list when no slot overrides it (opt-in) */
  showSocialLinks?: boolean
}

const {
  statusText = 'Building & Exploring',
  statusHasPing = true,
  statusVariant = 'primary',
  title = 'Overview',
  subtitleIcon = 'icon-[ph--house]',
  subtitleText = 'Home Overview',
  identityTags = [
    { icon: 'icon-[ph--code]', label: 'Developer' },
    { icon: 'icon-[ph--pen-nib]', label: 'Creator' },
  ],
  intro = '欢迎光临喵～ (・ω・)ノ，本站基于 Astro v6 构建，记录技术、分享生活。',
  statsLabel = 'Connect Portals',
  statsMeta,
  stats = [],
  socialLinks = SOCIAL_LINKS,
  showSocialLinks = false,
} = Astro.props as Props

const dotColor = statusVariant === 'success' ? 'bg-success' : 'bg-primary'
const pingColor = statusVariant === 'success' ? 'bg-success/70' : 'bg-primary/60'
const visibleIdentityTags = identityTags.slice(0, 2)
const hasBottomSlot = Astro.slots.has('bottom')
const hasMobileSlot = Astro.slots.has('mobile')

const hasBuiltinSocial = showSocialLinks && socialLinks.length > 0
const resolvedStatsMeta = statsMeta ?? `${socialLinks.length} ACTIVE`
---

<aside
  class="relative z-20 flex w-full min-w-0 flex-col border-b-2 border-foreground/20 bg-background lg:sticky lg:top-[76px] lg:h-[calc(100vh-76px)] lg:w-1/2 lg:basis-1/2 lg:shrink-0 lg:grow-0 lg:border-b-0 lg:border-r-2 lg:border-foreground"
>
  <div class="relative z-10 flex flex-1 flex-col lg:overflow-y-auto scrollbar-hide">
    <!-- Brand header -->
    <header class="flex shrink-0 items-start justify-between gap-3 border-b-2 border-foreground px-6 pb-5 pt-6 lg:px-10 lg:py-5">
      <div class="flex min-w-0 select-none items-center gap-3">
        <div class="brand-mark flex size-10 shrink-0 items-center justify-center bg-primary text-primary-foreground">
          <span class="icon-[ph--dot-outline-fill] size-6"></span>
        </div>

        <div class="min-w-0">
          <div class="truncate text-[13px] font-bold uppercase tracking-[0.14em] text-foreground">
            {SITE.title || 'Digital Hub'}
          </div>
          <div class="mt-1 truncate font-mono text-[9px] uppercase tracking-[0.24em] text-muted-foreground">You & Radiance</div>
        </div>
      </div>

      <span aria-hidden="true" class="mt-1 inline shrink-0 font-mono text-[9px] tracking-[0.16em] text-muted-foreground"> 01—01 </span>
    </header>

    <!-- Hero -->
    <section
      class="editorial-hero swiss-grid relative flex min-h-[46vh] flex-1 flex-col justify-start px-6 py-10 sm:min-h-[40vh] sm:px-8 sm:py-12 lg:min-h-0 lg:px-10 lg:py-12 xl:px-12"
    >
      <!-- Status -->
      <div class="relative z-10 flex items-center justify-between gap-4">
        <div
          class="inline-flex w-fit select-none items-center gap-2 border border-foreground/30 px-2.5 py-1.5 font-mono text-[9px] uppercase tracking-[0.18em] text-muted-foreground"
        >
          {
            statusHasPing && (
              <span class="relative flex size-1.5">
                <span class={`absolute inline-flex size-full animate-ping opacity-75 ${pingColor}`} />
                <span class={`relative inline-flex size-1.5 ${dotColor}`} />
              </span>
            )
          }
          {statusText}
        </div>
        <span class="font-mono text-[9px] uppercase tracking-[0.18em] text-muted-foreground/60">Fig. 01</span>
      </div>

      <!-- Kicker -->
      <div class="relative z-10 mt-10 flex items-center gap-3 font-mono text-[10px] uppercase tracking-[0.2em] text-primary">
        <span class="h-[2px] w-8 bg-primary"></span>
        <span>Independent / Digital</span>
      </div>

      <!-- Title -->
      <div class="relative z-10 mt-5">
        <h1 class="editorial-title relative w-fit max-w-full select-none text-foreground">
          <span class="editorial-title-text">{title}</span>
          <span aria-hidden="true" class="editorial-title-period">.</span>
        </h1>
      </div>

      <!-- Subtitle -->
      {
        subtitleIcon && subtitleText && (
          <div class="relative z-10 mt-5 flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.18em] text-muted-foreground">
            <span class={`${subtitleIcon} size-3.5 shrink-0`} />
            <span>{subtitleText}</span>
          </div>
        )
      }

      <!-- Identity tags -->
      {
        visibleIdentityTags.length > 0 && (
          <div class="relative z-10 mt-3 flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-[10px] uppercase tracking-[0.14em] text-muted-foreground">
            {visibleIdentityTags.map((tag, i) => (
              <>
                {i > 0 && <span aria-hidden="true" class="h-3 w-px bg-foreground/25" />}
                <span class="flex items-center gap-1.5">
                  <span class={`${tag.icon} size-3.5 shrink-0`} />
                  {tag.label}
                </span>
              </>
            ))}
          </div>
        )
      }

      <!-- Intro -->
      {
        intro && (
          <div class="editorial-intro relative z-10 mt-10 max-w-[30rem] border-t-2 border-foreground pt-4 lg:mt-auto">
            <div class="mb-2 font-mono text-[9px] uppercase tracking-[0.2em] text-muted-foreground/60">Abstract</div>
            <p class="text-sm leading-relaxed text-muted-foreground md:text-[15px]">
              {intro.split('\n').map((line, i) => (
                <>
                  {i > 0 && <br />}
                  {line}
                </>
              ))}
            </p>
          </div>
        )
      }

      <!-- Bottom editorial marker -->
      <div
        aria-hidden="true"
        class="relative z-10 mt-8 flex items-center gap-3 font-mono text-[9px] uppercase tracking-[0.2em] text-muted-foreground/60"
      >
        <span class="h-px w-8 bg-foreground/30"></span>
        <span>Scroll to explore</span>
        <span class="ml-auto">↓</span>
      </div>
    </section>
  </div>

  <!-- Mobile slot / built-in mobile social links -->
  {
    (hasMobileSlot || hasBuiltinSocial) && (
      <div class="shrink-0 select-none border-t-2 border-foreground bg-background lg:hidden">
        {hasMobileSlot ? (
          <slot name="mobile" />
        ) : (
          <div class="p-6">
            <div class="flex items-center justify-between font-mono text-[9px] uppercase tracking-[0.18em] text-muted-foreground">
              <span class="flex items-center gap-2">
                <span class="size-1.5 bg-primary" />
                {statsLabel}
              </span>
              <span>{resolvedStatsMeta}</span>
            </div>
            <div class="mt-4 grid grid-cols-2 gap-2">
              {socialLinks.map((item) => (
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-center gap-2.5 border border-foreground/25 px-3 py-3 transition-colors hover:border-primary hover:bg-primary hover:text-primary-foreground"
                >
                  <span class={`${item.icon} size-4 shrink-0 text-current`} />
                  <span class="truncate font-mono text-[10px] uppercase tracking-[0.1em]">{item.name}</span>
                  <span class="icon-[ph--arrow-up-right] ml-auto size-3.5 shrink-0 opacity-40 transition-opacity group-hover:opacity-100" />
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    )
  }

  <!-- Bottom stats / built-in social links -->
  <footer class="relative hidden shrink-0 select-none border-t-2 border-foreground bg-background lg:block">
    <div
      class="flex items-center justify-between border-b border-foreground/20 px-6 py-3 font-mono text-[9px] uppercase tracking-[0.18em] text-muted-foreground lg:px-10 xl:px-12"
    >
      <span class="flex items-center gap-2">
        <span class="size-1.5 bg-primary"></span>
        {statsLabel}
      </span>
      {resolvedStatsMeta && <span class="tabular-nums">{resolvedStatsMeta}</span>}
    </div>

    {
      hasBottomSlot ? (
        <slot name="bottom" />
      ) : hasBuiltinSocial ? (
        <div class="grid grid-cols-1">
          {socialLinks.map((item) => (
            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex h-12 items-center gap-4 border-b border-foreground/15 px-6 text-left transition-colors last:border-b-0 hover:bg-primary hover:text-primary-foreground lg:px-10 xl:px-12"
            >
              <span class={`${item.icon} size-4 shrink-0 text-current`} />
              <span class="font-mono text-[10px] font-medium uppercase tracking-[0.14em] text-current">{item.name || 'Link'}</span>
              <span class="icon-[ph--arrow-up-right] ml-auto size-3.5 text-current opacity-40 transition-opacity group-hover:opacity-100" />
            </a>
          ))}
        </div>
      ) : (
        <>
          {stats.length === 2 && (
            <div class="grid grid-cols-2 divide-x divide-foreground/20">
              {stats.map((stat) => (
                <div class="stat-cell group flex flex-col items-start justify-center px-6 py-6 transition-colors hover:bg-foreground hover:text-background lg:px-10 lg:py-8 xl:px-12">
                  <span class="stat-value font-bold tabular-nums text-current">{stat.value}</span>
                  <span class="mt-2 font-mono text-[9px] uppercase tracking-[0.16em] text-muted-foreground group-hover:text-background/60">
                    {stat.label}
                  </span>
                </div>
              ))}
            </div>
          )}

          {stats.length === 3 && (
            <div class="flex flex-col">
              <div class="grid grid-cols-2 divide-x divide-foreground/20 border-b border-foreground/20">
                {stats.slice(0, 2).map((stat) => (
                  <div class="stat-cell group flex flex-col items-start justify-center px-6 py-6 transition-colors hover:bg-foreground hover:text-background lg:px-10 lg:py-8 xl:px-12">
                    <span class="stat-value font-bold tabular-nums text-current">{stat.value}</span>
                    <span class="mt-2 font-mono text-[9px] uppercase tracking-[0.16em] text-muted-foreground group-hover:text-background/60">
                      {stat.label}
                    </span>
                  </div>
                ))}
              </div>

              <div class="group flex items-center justify-between px-6 py-4 transition-colors hover:bg-primary hover:text-primary-foreground lg:px-10 lg:py-5 xl:px-12">
                <span class="font-mono text-[9px] uppercase tracking-[0.16em] text-muted-foreground group-hover:text-primary-foreground/70">
                  {stats[2].label}
                </span>
                <span class="text-sm font-bold tabular-nums tracking-tight text-current">{stats[2].value}</span>
              </div>
            </div>
          )}
        </>
      )
    }
  </footer>
</aside>

<style>
  .editorial-hero {
    isolation: isolate;
  }

  .editorial-title {
    font-size: clamp(3rem, 10vw, 4.5rem);
    line-height: 0.86;
    font-weight: 800;
    letter-spacing: -0.06em;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .editorial-title-period {
    color: hsl(var(--primary));
    letter-spacing: -0.08em;
  }

  .stat-value {
    font-size: clamp(2rem, 3.2vw, 3.25rem);
    line-height: 0.9;
    overflow-wrap: anywhere;
  }

  /* Editorial typography scales up with the available width. */
  @media (min-width: 1024px) {
    .editorial-title {
      font-size: clamp(3.75rem, 6.2vw, 7rem);
      line-height: 0.82;
      letter-spacing: -0.07em;
    }
  }

  /* Short browser windows: preserve the oversized title without
     forcing the entire sidebar to exceed the viewport unnecessarily. */
  @media (min-width: 1024px) and (max-height: 760px) {
    .editorial-title {
      font-size: clamp(3rem, 4.6vw, 5rem);
    }

    .editorial-hero {
      padding-top: 1.75rem;
      padding-bottom: 1.75rem;
    }

    .stat-cell {
      padding-top: 1rem;
      padding-bottom: 1rem;
    }
  }

  @media (min-width: 1024px) and (max-height: 620px) {
    .editorial-title {
      font-size: clamp(2.5rem, 3.8vw, 3.75rem);
    }

    .editorial-hero {
      padding-top: 1rem;
      padding-bottom: 1rem;
    }

    .editorial-hero > .editorial-intro p {
      font-size: 0.8125rem;
      line-height: 1.5;
    }

    .stat-value {
      font-size: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .editorial-aside *,
    .editorial-aside *::before,
    .editorial-aside *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
