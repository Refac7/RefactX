---
import { SOCIAL_LINKS } from '~/config'

export interface StatItem {
  value: string
  label: string
}

export interface IdentityTag {
  icon: string
  label: string
}

interface Props {
  /** Status badge text */
  statusText?: string
  /** Show the animated ping dot */
  statusHasPing?: boolean
  /** Badge color variant */
  statusVariant?: 'success' | 'primary'
  /** Main heading */
  title?: string
  /** Icon class for the subtitle line */
  subtitleIcon?: string
  /** Text for the subtitle line */
  subtitleText?: string
  /** Identity tags shown below the title */
  identityTags?: IdentityTag[]
  /** Intro / description paragraph */
  intro?: string
  /** Label for the stats section */
  statsLabel?: string
  /** Right-side metadata for the stats section (auto-derived from social links if omitted) */
  statsMeta?: string
  /** Stats cells (2–3 items) */
  stats?: StatItem[]
  /** Built-in social link list */
  socialLinks?: typeof SOCIAL_LINKS
  /** Toggle the built-in social link list */
  showSocialLinks?: boolean
  /** Optional hero background image */
  image?: string
}

const {
  statusText = 'Building & Exploring',
  statusHasPing = true,
  statusVariant = 'primary',
  title = 'Overview',
  subtitleIcon = 'icon-[ph--house]',
  subtitleText = 'Home Overview',
  identityTags = [
    { icon: 'icon-[ph--code]', label: 'Developer' },
    { icon: 'icon-[ph--pen-nib]', label: 'Creator' },
  ],
  intro,
  statsLabel = 'Overview',
  statsMeta,
  stats = [],
  socialLinks = SOCIAL_LINKS,
  showSocialLinks = false,
  image = '/photos/240809-2.webp',
} = Astro.props as Props

const dotColor = statusVariant === 'success' ? 'bg-success' : 'bg-primary'
const pingColor = statusVariant === 'success' ? 'bg-success/70' : 'bg-primary/60'
const visibleIdentityTags = identityTags.slice(0, 4)
const visibleStats = stats.slice(0, 3)
const resolvedStatsMeta = statsMeta ?? `${socialLinks.length} ACTIVE`
---

<section class="page-hero">
  <div class="page-hero__media" aria-hidden="true">
    <img src={image} alt="" loading="eager" fetchpriority="high" decoding="async" onload="this.classList.add('is-loaded')" />
    <div class="page-hero__veil"></div>
    <div class="page-hero__grain"></div>
  </div>

  <div class="container-page page-hero__content">
    <div class="page-hero__status">
      {
        statusHasPing && (
          <span class="relative flex size-2">
            <span class={`absolute inline-flex size-full animate-ping rounded-full opacity-75 ${pingColor}`} />
            <span class={`relative inline-flex size-2 rounded-full ${dotColor}`} />
          </span>
        )
      }
      {statusText}
    </div>

    <div class="page-hero__headline">
      <span class="page-hero__eyebrow">RefactX · Journal</span>
      <h1 class="page-hero__title">
        {title}<span class="page-hero__period">.</span>
      </h1>
      {
        subtitleIcon && subtitleText && (
          <div class="page-hero__subtitle">
            <span class={`${subtitleIcon} size-4 shrink-0`} />
            <span>{subtitleText}</span>
          </div>
        )
      }
    </div>

    {
      intro && (
        <p class="page-hero__intro">
          {intro.split('\n').map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))}
        </p>
      )
    }

    {
      visibleIdentityTags.length > 0 && (
        <div class="page-hero__tags">
          {visibleIdentityTags.map((tag) => (
            <span class="page-hero__tag">
              <span class={`${tag.icon} size-3.5`} />
              {tag.label}
            </span>
          ))}
        </div>
      )
    }
  </div>

  {
    (visibleStats.length > 0 || showSocialLinks) && (
      <div class="container-page page-hero__stats-wrap">
        <div class="page-hero__stats">
          {showSocialLinks && socialLinks.length > 0 ? (
            <>
              <div class="page-hero__stats-head">
                <span>{statsLabel}</span>
                <span>{resolvedStatsMeta}</span>
              </div>
              <div class="page-hero__social-grid">
                {socialLinks.map((item) => (
                  <a href={item.url} target="_blank" rel="noopener noreferrer" class="page-hero__social">
                    <span class={`${item.icon} size-4`} />
                    <span>{item.name}</span>
                    <span class="icon-[ph--arrow-up-right] ml-auto size-3.5 opacity-40" />
                  </a>
                ))}
              </div>
            </>
          ) : (
            <>
              <div class="page-hero__stats-head">
                <span>{statsLabel}</span>
                <span>{resolvedStatsMeta}</span>
              </div>
              <div class="page-hero__stat-grid">
                {visibleStats.map((stat) => (
                  <div class="page-hero__stat">
                    <span class="page-hero__stat-value">{stat.value}</span>
                    <span class="page-hero__stat-label">{stat.label}</span>
                  </div>
                ))}
              </div>
            </>
          )}
        </div>
      </div>
    )
  }
</section>

<style>
  .page-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-bottom-left-radius: 2.5rem;
    border-bottom-right-radius: 2.5rem;
    color: #fff;
  }

  .page-hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(120deg, hsl(var(--card)), hsl(var(--primary) / 0.2), hsl(var(--card)));
    background-size: 220% 100%;
    animation: heroShimmer 2.2s linear infinite;
  }

  .page-hero__media img {
    opacity: 0;
    filter: blur(22px);
    transform: scale(1.08);
    transition:
      opacity 900ms ease,
      filter 1100ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 1200ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .page-hero__media img.is-loaded {
    opacity: 1;
    filter: blur(0);
    transform: scale(1.02);
  }

  @keyframes heroShimmer {
    0% {
      background-position: 0% 50%;
    }
    100% {
      background-position: 220% 50%;
    }
  }

  .page-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 62%;
  }

  .page-hero__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(10 16 28 / 0.46) 0%, rgb(10 16 28 / 0.5) 40%, hsl(var(--background)) 100%),
      linear-gradient(90deg, rgb(10 16 28 / 0.52), transparent 68%);
  }

  .page-hero__grain {
    position: absolute;
    inset: 0;
    opacity: 0.16;
    background-image: radial-gradient(rgb(255 255 255 / 0.5) 0.5px, transparent 0.5px);
    background-size: 5px 5px;
    mix-blend-mode: soft-light;
    pointer-events: none;
  }

  .page-hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: clamp(24rem, 50vh, 36rem);
    padding-top: clamp(5rem, 12vh, 8rem);
    padding-bottom: 3rem;
  }

  .page-hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    margin-bottom: 1.6rem;
    padding: 0.42rem 0.8rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.22);
    background: rgb(255 255 255 / 0.1);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    font-family: var(--font-geist-mono);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .page-hero__headline {
    max-width: 48rem;
  }

  .page-hero__eyebrow {
    display: inline-block;
    margin-bottom: 0.6rem;
    font-family: var(--font-geist-mono);
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: hsl(var(--primary));
  }

  .page-hero__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.9rem, 8vw, 6.2rem);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: -0.065em;
    color: #fff;
    text-wrap: balance;
    text-shadow: 0 10px 40px rgb(8 14 24 / 0.28);
  }

  .page-hero__period {
    color: hsl(var(--primary));
    letter-spacing: -0.1em;
  }

  .page-hero__subtitle {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1rem;
    font-family: var(--font-geist-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.72);
  }

  .page-hero__intro {
    max-width: 38rem;
    margin-top: 1.4rem;
    font-size: clamp(0.92rem, 1.3vw, 1.05rem);
    line-height: 1.8;
    color: rgb(255 255 255 / 0.78);
  }

  .page-hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1.5rem;
  }

  .page-hero__tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.36rem 0.7rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.18);
    background: rgb(255 255 255 / 0.08);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    font-size: 0.7rem;
    color: rgb(255 255 255 / 0.82);
  }

  .page-hero__stats-wrap {
    position: relative;
    z-index: 2;
    padding-bottom: 1.5rem;
  }

  .page-hero__stats {
    overflow: hidden;
    border-radius: 1.5rem;
    border: 1px solid hsl(var(--border) / 0.8);
    background: hsl(var(--card) / 0.94);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    box-shadow: 0 30px 60px -40px hsl(218 30% 12% / 0.55);
  }

  .page-hero__stats-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.8rem 1.2rem;
    border-bottom: 1px solid hsl(var(--border) / 0.7);
    font-family: var(--font-geist-mono);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
  }

  .page-hero__stat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
  }

  .page-hero__stat {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 1.2rem;
    border-right: 1px solid hsl(var(--border) / 0.6);
  }

  .page-hero__stat:last-child {
    border-right: 0;
  }

  .page-hero__stat-value {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    color: hsl(var(--foreground));
    overflow-wrap: anywhere;
  }

  .page-hero__stat-label {
    font-family: var(--font-geist-mono);
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
  }

  .page-hero__social-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 0;
  }

  .page-hero__social {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 1rem 1.2rem;
    border-right: 1px solid hsl(var(--border) / 0.6);
    font-size: 0.8rem;
    color: hsl(var(--foreground) / 0.8);
    text-decoration: none;
    transition:
      color 180ms ease,
      background-color 180ms ease;
  }

  .page-hero__social:hover {
    color: hsl(var(--accent-foreground));
    background: hsl(var(--accent) / 0.5);
  }

  @media (max-width: 639px) {
    .page-hero {
      border-bottom-left-radius: 1.75rem;
      border-bottom-right-radius: 1.75rem;
    }
    .page-hero__content {
      min-height: 30rem;
      padding-bottom: 2rem;
    }
    .page-hero__stat {
      border-right: 0;
      border-bottom: 1px solid hsl(var(--border) / 0.6);
    }
    .page-hero__stat:last-child {
      border-bottom: 0;
    }
    .page-hero__social {
      border-right: 0;
      border-bottom: 1px solid hsl(var(--border) / 0.6);
    }
    .page-hero__social:last-child {
      border-bottom: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-hero *,
    .page-hero *::before,
    .page-hero *::after {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
