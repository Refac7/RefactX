---
import { HOLIDAY_THEMES } from '~/config'
---

<style is:global>
  html.theme-mourning {
    transition: filter 0s !important;
    animation: none !important;
  }
</style>

<script define:vars={{ HOLIDAY_THEMES }} is:inline>
  ;(function () {
    function applyHolidayTheme() {
      const date = new Date()

      const todayStr = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`

      const holiday = HOLIDAY_THEMES[todayStr]

      let activeTheme = null
      let themeMsg = ''

      if (holiday) {
        activeTheme = holiday.theme
        themeMsg = holiday.message
      }

      const overrideDate = localStorage.getItem('disable-holiday-theme')

      document.documentElement.classList.remove('theme-mourning', 'theme-red', 'theme-green', 'theme-gold')

      if (activeTheme && overrideDate !== todayStr) {
        document.documentElement.classList.add(activeTheme)

        window.__HOLIDAY_ACTIVE__ = true
        window.__HOLIDAY_MSG__ = themeMsg
        window.__HOLIDAY_CLASS__ = activeTheme
        window.__TODAY_STR__ = todayStr
      } else {
        window.__HOLIDAY_ACTIVE__ = false
      }
    }

    applyHolidayTheme()
    document.addEventListener('astro:after-swap', applyHolidayTheme)
  })()
</script>

<div
  id="holiday-banner"
  class="holiday-banner hidden fixed bottom-0 left-0 right-0 z-100 bg-primary text-primary-foreground shadow-[0_-4px_24px_rgba(0,0,0,0.15)]"
>
  <div
    id="holiday-banner-inner"
    class="flex flex-col sm:flex-row justify-center sm:justify-between items-center gap-1 sm:gap-3 px-3 sm:px-6 py-2 text-xs sm:text-sm overflow-hidden"
  >
    <div class="flex items-center gap-2 min-w-0 w-full sm:w-auto justify-center sm:justify-start overflow-hidden">
      <span class="icon-[mdi--information-outline] text-base shrink-0"></span>
      <span id="holiday-msg" class="truncate font-medium whitespace-nowrap"></span>
    </div>

    <div class="flex items-center gap-2 shrink-0">
      <button
        id="collapse-holiday-btn"
        class="shrink-0 hover:bg-background/20 px-2 py-1 transition-colors font-mono text-[10px] uppercase tracking-wider border border-primary-foreground/20 cursor-pointer"
      >
        收起
      </button>
      <button
        id="restore-holiday-btn"
        class="shrink-0 hover:bg-background/20 px-2 py-1 transition-colors font-mono text-[10px] uppercase tracking-wider border border-primary-foreground/20 cursor-pointer"
      >
        恢复默认
      </button>
    </div>
  </div>
</div>

<button
  id="holiday-reopen-btn"
  class="holiday-reopen hidden fixed bottom-5 right-5 z-100 flex items-center gap-1.5 rounded-full bg-primary text-primary-foreground px-3 py-2 text-xs font-medium shadow-lg hover:opacity-90 transition-opacity cursor-pointer"
>
  <span class="icon-[mdi--information-outline] text-sm"></span>
  <span>节日提示</span>
</button>

<style is:global>
  .holiday-banner {
    --holiday-banner-h: 92px;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transform: translateY(100%);
    padding-bottom: env(safe-area-inset-bottom);
    transition:
      transform 260ms ease,
      max-height 260ms ease,
      opacity 200ms ease;
  }

  @media (min-width: 640px) {
    .holiday-banner {
      --holiday-banner-h: 64px;
    }
  }

  .holiday-banner.is-open {
    max-height: var(--holiday-banner-h);
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script is:inline>
  ;(function () {
    const COLLAPSE_KEY = 'holiday-banner-collapsed'

    let openBanner = null

    function hideBanner(banner) {
      banner.classList.remove('is-open')
      banner.classList.add('hidden')
    }

    function initHolidayBanner() {
      const banner = document.getElementById('holiday-banner')
      const msgEl = document.getElementById('holiday-msg')
      const collapseBtn = document.getElementById('collapse-holiday-btn')
      const restoreBtn = document.getElementById('restore-holiday-btn')
      const reopenBtn = document.getElementById('holiday-reopen-btn')

      if (!banner || !msgEl || !collapseBtn || !restoreBtn || !reopenBtn) return

      const showReopen = () => {
        reopenBtn.classList.remove('hidden')
        reopenBtn.classList.add('flex')
      }
      const hideReopen = () => {
        reopenBtn.classList.add('hidden')
        reopenBtn.classList.remove('flex')
      }

      openBanner = function () {
        msgEl.textContent = window.__HOLIDAY_MSG__
        banner.classList.remove('hidden')
        hideReopen()
        requestAnimationFrame(() => {
          banner.classList.add('is-open')
        })
        localStorage.removeItem(COLLAPSE_KEY)
      }

      if (!window.__HOLIDAY_ACTIVE__) {
        hideBanner(banner)
        hideReopen()
        return
      }

      if (localStorage.getItem(COLLAPSE_KEY) === window.__TODAY_STR__) {
        hideBanner(banner)
        showReopen()
      } else {
        openBanner()
      }

      collapseBtn.onclick = () => {
        hideBanner(banner)
        showReopen()
        localStorage.setItem(COLLAPSE_KEY, window.__TODAY_STR__)
      }

      restoreBtn.onclick = () => {
        document.documentElement.classList.remove(window.__HOLIDAY_CLASS__)

        hideBanner(banner)
        hideReopen()
        localStorage.setItem('disable-holiday-theme', window.__TODAY_STR__)

        window.__HOLIDAY_ACTIVE__ = false
      }

      reopenBtn.onclick = openBanner
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHolidayBanner)
    } else {
      initHolidayBanner()
    }

    document.addEventListener('astro:after-swap', initHolidayBanner)
  })()
</script>
