---
import { HOLIDAY_THEMES } from '~/config'
---

<style is:global>
  html.theme-mourning {
    transition: filter 0s !important;
    animation: none !important;
  }
</style>

<script define:vars={{ HOLIDAY_THEMES }} is:inline>
  ;(function () {
    const getOverrideDate = () => {
      try {
        return localStorage.getItem('disable-holiday-theme')
      } catch {
        return null
      }
    }

    const disableHolidayTheme = (date) => {
      try {
        localStorage.setItem('disable-holiday-theme', date)
      } catch {
        // Firefox private/restricted storage can reject both reads and writes.
      }
    }

    function applyHolidayTheme() {
      const date = new Date()
      const todayStr = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`
      const holiday = HOLIDAY_THEMES[todayStr]

      const activeTheme = holiday?.theme ?? null
      const themeMsg = holiday?.message ?? ''
      const overrideDate = getOverrideDate()

      document.documentElement.classList.remove('theme-mourning', 'theme-red', 'theme-green', 'theme-gold')

      if (activeTheme && overrideDate !== todayStr) {
        document.documentElement.classList.add(activeTheme)

        window.__HOLIDAY_ACTIVE__ = true
        window.__HOLIDAY_MSG__ = themeMsg
        window.__HOLIDAY_CLASS__ = activeTheme
        window.__TODAY_STR__ = todayStr
      } else {
        window.__HOLIDAY_ACTIVE__ = false
      }
    }

    applyHolidayTheme()
    document.addEventListener('astro:after-swap', applyHolidayTheme)

    window.__DISABLE_HOLIDAY_THEME__ = disableHolidayTheme
  })()
</script>

<div
  id="holiday-banner"
  class="hidden relative w-full z-100 bg-primary text-primary-foreground px-4 py-2.5 text-xs sm:text-sm justify-between items-center shadow-md"
>
  <div class="flex items-center gap-2 overflow-hidden">
    <span class="icon-[mdi--information-outline] text-base shrink-0"></span>
    <span id="holiday-msg" class="truncate font-medium"></span>
  </div>

  <button
    id="close-holiday-btn"
    class="shrink-0 ml-4 hover:bg-background/20 px-2 py-1 transition-colors font-mono text-[10px] uppercase tracking-wider border border-primary-foreground/20 cursor-pointer"
  >
    恢复默认
  </button>
</div>

<script is:inline>
  ;(function () {
    function initHolidayBanner() {
      const banner = document.getElementById('holiday-banner')
      const msgEl = document.getElementById('holiday-msg')
      const closeBtn = document.getElementById('close-holiday-btn')

      if (window.__HOLIDAY_ACTIVE__ && banner && msgEl && closeBtn) {
        msgEl.textContent = window.__HOLIDAY_MSG__

        banner.classList.remove('hidden')
        banner.classList.add('flex')

        closeBtn.onclick = () => {
          const holidayClass = window.__HOLIDAY_CLASS__
          if (holidayClass) document.documentElement.classList.remove(holidayClass)

          banner.classList.add('hidden')
          banner.classList.remove('flex')

          window.__DISABLE_HOLIDAY_THEME__?.(window.__TODAY_STR__)
          window.__HOLIDAY_ACTIVE__ = false
        }
      } else if (banner) {
        banner.classList.add('hidden')
        banner.classList.remove('flex')
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHolidayBanner, { once: true })
    } else {
      initHolidayBanner()
    }

    document.addEventListener('astro:after-swap', initHolidayBanner)
  })()
</script>
