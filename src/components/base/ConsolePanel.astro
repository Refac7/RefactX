---
// src/components/ConsolePanel.astro
import ThemeToggle from '~/components/theme/ThemeToggle'

const QUICK_LINKS = [
  { label: 'HOME', href: '/' },
  { label: 'BLOG', href: '/posts' },
  { label: 'PROJECTS', href: '/projects' },
  { label: 'FRIENDS', href: '/friends' },
]
---

<div id="console-panel-root" class="fixed bottom-6 right-6 md:bottom-8 md:right-8 z-60 font-mono flex flex-col items-end pointer-events-none">
  
  {/* ================= 面板主体 ================= */}
  <div 
    id="console-main" 
    class="pointer-events-auto bg-background/90 backdrop-blur-xl border border-border shadow-2xl w-[calc(100vw-3rem)] sm:w-[360px] transition-all duration-100 opacity-0 translate-y-4 scale-95 origin-bottom-right invisible mb-4 overflow-hidden"
  >
    {/* 头部 */}
    <div class="flex items-center justify-between px-4 py-3 border-b border-border bg-muted/30">
      <div class="flex items-center gap-2 text-[10px] font-bold tracking-wider text-muted-foreground">
        <span class="w-2 h-2 bg-primary animate-pulse"></span>
        <span>SYS_PANEL</span>
      </div>
      <button id="close-console" class="text-muted-foreground hover:text-primary transition-colors p-1">
        <span class="icon-[ph--x-bold] text-base"></span>
      </button>
    </div>

    {/* 内容区域 */}
    <div class="p-4 grid grid-cols-2 gap-3">
      
      {/* 1. 时间显示 */}
      <div class="col-span-2 2xl:col-span-1 p-3 bg-muted/10 border border-border/50 flex flex-col justify-center">
        <div class="text-xl font-bold text-foreground tabular-nums tracking-tight" id="console-time">00:00:00</div>
        <div class="text-[10px] text-muted-foreground mt-1" id="console-date">YYYY-MM-DD</div>
      </div>

      {/* 2. 布局切换 */}
      <button id="layout-toggle-btn" class="col-span-1 p-3 bg-muted/10 border border-border/50 hover:bg-primary/5 hover:border-primary/30 transition-all hidden 2xl:flex flex-col justify-center items-start group text-left">
        <span class="text-[9px] text-muted-foreground/60 mb-1">LAYOUT</span>
        <div class="flex items-center gap-2 text-foreground group-hover:text-primary transition-colors">
            <span id="layout-icon" class="icon-[ph--align-left-simple-bold] text-sm"></span>
            <span id="layout-text" class="text-xs font-bold">OFFSET</span>
        </div>
      </button>

      {/* 3. 系统信息 & 主题 */}
      <div class="col-span-2 p-3 bg-muted/10 border border-border/50 flex items-center justify-between gap-4">
        <div class="flex flex-col gap-1 min-w-0 flex-1">
            <span class="text-[9px] text-muted-foreground/60">SYSTEM INFO</span>
            <div class="text-[10px] text-muted-foreground truncate flex gap-2">
                <span id="console-screen">Loading...</span>
                <span class="opacity-30">|</span>
                <span id="console-ua" class="truncate max-w-[120px]">UA...</span>
            </div>
        </div>
        <div class="shrink-0 scale-90">
             <ThemeToggle client:visible />
        </div>
      </div>

      {/* 4. 快速导航 */}
      <div class="col-span-2 grid grid-cols-4 gap-2 mt-1">
        {QUICK_LINKS.map(link => (
            <a href={link.href} class="flex items-center justify-center py-2 px-1 bg-muted/20 hover:bg-primary hover:text-primary-foreground text-[10px] font-bold text-muted-foreground transition-all">
                {link.label}
            </a>
        ))}
      </div>

    </div>
    
    {/* 底部状态 */}
    <div class="px-4 py-1.5 bg-muted/50 border-t border-border flex justify-between text-[9px] text-muted-foreground/50 uppercase">
        <span>v2.1.0</span>
        <span>Online</span>
    </div>
  </div>


  {/* ================= 触发按钮 ================= */}
  <button 
    id="console-toggle" 
    class="pointer-events-auto hidden lg:flex items-center justify-center w-10 h-10 md:w-12 md:h-12 bg-red-600 hover:bg-red-600/80 text-white shadow-lg transition-all"
    aria-label="Toggle Console"
  >
    <span class="icon-[ph--terminal-window-bold] text-lg md:text-xl"></span>
  </button>

</div>

<script is:inline>
    function applyLayoutState() {
        const mode = localStorage.getItem('site_layout_mode') || 'offset';
        const mainContent = document.getElementById('main-content');
        const postBtns = document.getElementById('backToTopDesktopGroup');
        const layoutText = document.getElementById('layout-text');
        const layoutIcon = document.getElementById('layout-icon');

        // 处理主内容
        if (mainContent) {
            if (mode === 'center') {
                mainContent.classList.remove('2xl:ml-[15rem]');
                mainContent.classList.add('mx-auto');
            } else {
                mainContent.classList.add('2xl:ml-[15rem]');
                mainContent.classList.remove('mx-auto'); 
            }
        }

        // 处理悬浮按钮
        if (postBtns) {
            if (mode === 'center') {
                postBtns.classList.remove('left-[77rem]', 'translate-x-full');
                postBtns.classList.add('left-[50%]', 'ml-[38rem]');
            } else {
                postBtns.classList.add('left-[77rem]', 'translate-x-full');
                postBtns.classList.remove('left-[50%]', 'ml-[38rem]');
            }
        }

        // 更新 UI
        if (layoutText && layoutIcon) {
            if (mode === 'center') {
                layoutText.textContent = "CENTER";
                layoutIcon.className = "icon-[ph--align-center-horizontal-simple-bold] text-sm";
            } else {
                layoutText.textContent = "OFFSET";
                layoutIcon.className = "icon-[ph--align-left-simple-bold] text-sm";
            }
        }
    }

    // 初始化交互
    function initConsole() {
        const toggleBtn = document.getElementById('console-toggle');
        const closeBtn = document.getElementById('close-console');
        const panel = document.getElementById('console-main');
        const layoutBtn = document.getElementById('layout-toggle-btn');
        let isOpen = false;

        function togglePanel(forceState) {
            isOpen = forceState !== undefined ? forceState : !isOpen;
            if (isOpen) {
                panel?.classList.remove('opacity-0', 'translate-y-4', 'scale-95', 'invisible');
                panel?.classList.add('opacity-100', 'translate-y-0', 'scale-100', 'visible');
            } else {
                panel?.classList.add('opacity-0', 'translate-y-4', 'scale-95', 'invisible');
                panel?.classList.remove('opacity-100', 'translate-y-0', 'scale-100', 'visible');
            }
        }

        // 事件绑定
        toggleBtn?.addEventListener('click', (e) => { e.stopPropagation(); togglePanel(); });
        closeBtn?.addEventListener('click', (e) => { e.stopPropagation(); togglePanel(false); });
        
        document.addEventListener('click', (e) => {
            if (isOpen && panel && !panel.contains(e.target) && !toggleBtn.contains(e.target)) {
                togglePanel(false);
            }
        });

        // 布局切换
        layoutBtn?.addEventListener('click', () => {
            const currentMode = localStorage.getItem('site_layout_mode') || 'offset';
            const newMode = currentMode === 'offset' ? 'center' : 'offset';
            localStorage.setItem('site_layout_mode', newMode);
            applyLayoutState();
        });

        // 定时器更新 (时间)
        function updateInfo() {
            const now = new Date();
            const timeEl = document.getElementById('console-time');
            const dateEl = document.getElementById('console-date');
            
            if(timeEl) timeEl.textContent = now.toLocaleTimeString('en-GB', { hour12: false });
            if(dateEl) dateEl.textContent = now.toLocaleDateString('en-CA'); 
        }

        // 系统信息 (仅更新一次)
        const uaEl = document.getElementById('console-ua');
        const screenEl = document.getElementById('console-screen');
        if(uaEl) uaEl.textContent = navigator.userAgent;
        if(screenEl) screenEl.textContent = `${window.innerWidth} x ${window.innerHeight}`;

        if (window['consoleInterval']) clearInterval(window['consoleInterval']);
        window['consoleInterval'] = setInterval(updateInfo, 1000);
        updateInfo();

        applyLayoutState();
    }

    document.addEventListener('astro:page-load', initConsole);
    document.addEventListener('astro:after-swap', applyLayoutState);
</script>