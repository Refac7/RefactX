---
// src/components/base/LocationCard.astro
---

<div id="location-card" class="fixed top-24 right-8 hidden 2xl:flex flex-col items-end pointer-events-none select-none">
  
  {/* 装饰线：连接到屏幕边缘 */}
  <div class="h-8 w-px bg-border/60 mb-2 mr-4"></div>

  {/* 卡片主体 */}
  <div class="pointer-events-auto bg-background/85 backdrop-blur-md border border-border/60 p-1 w-[240px] transition-all duration-300 hover:border-primary/50 group shadow-lg shadow-black/5">
    
    {/* 内部容器 */}
    <div class="relative bg-background p-3 overflow-hidden">

      {/* 标题栏 */}
      <div class="flex justify-between items-center mb-3 border-b border-dashed border-border/40 pb-2">
        <span class="text-[10px] font-mono uppercase tracking-widest text-muted-foreground/60">
          // SYS_LOC
        </span>
        <div class="flex items-center gap-2">
           {/* 数据源指示器：NET 或 MEM */}
           <span id="data-source" class="text-[9px] font-mono font-bold text-muted-foreground/50 transition-colors">
              WAIT
           </span>
           <span id="ping-indicator" class="w-1.5 h-1.5 bg-gray-400 rounded-none"></span>
        </div>
      </div>

      {/* 内容区域 */}
      <div class="flex flex-col gap-4">
        
        {/* 城市信息 */}
        <div class="flex items-baseline justify-between">
           <span class="text-[10px] text-muted-foreground font-mono">SECTOR:</span>
           <span id="loc-city" class="text-sm font-bold text-foreground font-sans tracking-tight">
             INITIALIZING...
           </span>
        </div>

        {/* 坐标数据 */}
        <div class="flex items-center justify-between mt-1 text-[10px] font-mono text-muted-foreground/70">
           <span>COORDS:</span>
           <span id="loc-coords" class="group-hover:text-primary transition-colors">
             --.--, --.--
           </span>
        </div>

        {/* 时间显示 */}
        <div class="flex items-center justify-between mt-1 pt-2 border-t border-border/20 text-[10px] font-mono">
            <span class="text-muted-foreground/50">LOCAL_TIME:</span>
            <span id="loc-time" class="text-foreground">
              00:00:00
            </span>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  // 使用 IIFE 避免变量污染全局作用域
  (function() {
    const CACHE_KEY = 'sys_loc_data_v1';
    const CACHE_EXPIRY = 24 * 60 * 60 * 1000; // 24小时缓存

    function initLocation() {
      const cityEl = document.getElementById('loc-city');
      const coordsEl = document.getElementById('loc-coords');
      const timeEl = document.getElementById('loc-time');
      const pingEl = document.getElementById('ping-indicator');
      const sourceEl = document.getElementById('data-source');
      
      if(!cityEl || !coordsEl || !timeEl) return;

      // 1. 时间更新逻辑 (每秒刷新)
      const updateTime = () => {
          const now = new Date();
          timeEl.innerText = now.toLocaleTimeString('en-US', { hour12: false });
      };
      // 清除旧的 interval 防止 astro 页面切换堆积
      if (window.locInterval) clearInterval(window.locInterval);
      window.locInterval = setInterval(updateTime, 1000);
      updateTime();

      // UI 更新辅助函数
      const updateUI = (data, source) => {
          cityEl.innerText = `${data.city.toUpperCase()}, ${data.country_code}`;
          coordsEl.innerText = `${parseFloat(data.latitude).toFixed(2)}N, ${parseFloat(data.longitude).toFixed(2)}E`;
          
          if (sourceEl) {
            sourceEl.innerText = source === 'cache' ? 'SRC: MEM' : 'SRC: NET';
            sourceEl.className = source === 'cache' 
                ? "text-[9px] font-mono font-bold text-amber-500/80" // 缓存显示橙色/琥珀色
                : "text-[9px] font-mono font-bold text-emerald-500/80"; // 网络显示绿色
          }

          if (pingEl) {
             pingEl.classList.remove('bg-gray-400');
             pingEl.classList.add(source === 'cache' ? 'bg-amber-500' : 'bg-emerald-500');
             if (source === 'network') pingEl.classList.add('animate-pulse');
          }
      };

      // 2. 检查缓存
      const checkCache = () => {
          const cached = localStorage.getItem(CACHE_KEY);
          if (cached) {
              try {
                  const parsed = JSON.parse(cached);
                  const now = Date.now();
                  // 如果缓存未过期 (24小时内)
                  if (now - parsed.timestamp < CACHE_EXPIRY) {
                      console.log('[System] Location loaded from MEMORY');
                      updateUI(parsed.data, 'cache');
                      return true; // 缓存有效
                  }
              } catch (e) {
                  localStorage.removeItem(CACHE_KEY);
              }
          }
          return false; // 缓存无效或不存在
      };

      // 3. 发起网络请求
      const fetchLocation = async () => {
          // 如果缓存有效，直接跳过
          if (checkCache()) return;

          try {
              if (sourceEl) sourceEl.innerText = "CONN...";
              
              // 使用 ipapi.co
              const response = await fetch('https://ipapi.co/json/');
              
              // 处理 429 错误 (Too Many Requests)
              if (response.status === 429) {
                  console.warn('[System] API Rate limit exceeded.');
                  cityEl.innerText = "RATE_LIMIT";
                  coordsEl.innerText = "OFFLINE";
                  if (pingEl) pingEl.className = "w-1.5 h-1.5 bg-red-500 rounded-none";
                  return;
              }

              const data = await response.json();

              if (data.city) {
                  // 保存到缓存
                  const cacheObj = {
                      timestamp: Date.now(),
                      data: {
                          city: data.city,
                          country_code: data.country_code,
                          latitude: data.latitude,
                          longitude: data.longitude
                      }
                  };
                  localStorage.setItem(CACHE_KEY, JSON.stringify(cacheObj));
                  
                  updateUI(cacheObj.data, 'network');
                  console.log('[System] Location loaded from NETWORK');
              } else {
                   throw new Error("Invalid Data");
              }
          } catch (e) {
              cityEl.innerText = "UNKNOWN_SECTOR";
              coordsEl.innerText = "00.00, 00.00";
              if (pingEl) pingEl.className = "w-1.5 h-1.5 bg-red-500 rounded-none";
          }
      };

      // 执行
      fetchLocation();
    }

    // Astro View Transitions 兼容
    document.addEventListener('astro:page-load', initLocation);
    // 普通加载兼容
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initLocation);
    } else {
      initLocation();
    }
  })();
</script>