---
import { SITE, SOCIAL_LINKS } from '~/config'
---

<aside class="w-full lg:w-1/3 lg:sticky lg:top-0 lg:h-screen flex flex-col lg:border-r border-border/40 z-20 bg-background relative overflow-hidden">
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute -top-40 -left-40 size-96 rounded-full bg-primary/5 blur-3xl"></div>
    <div class="absolute inset-x-0 top-1/2 h-px bg-border/20"></div>
    <div class="absolute bottom-0 right-0 size-64 opacity-40 bg-[radial-gradient(circle_at_center,theme(colors.primary)/0.08_1px,transparent_1px)] [background-size:18px_18px]"></div>
  </div>

  <div class="relative z-10 flex flex-1 flex-col">
    <header class="px-6 pt-6 lg:px-8 lg:pt-8 xl:px-12">
      <div class="flex items-center justify-between border-b border-border/40 pb-4">
        <div class="flex items-center gap-3 select-none">
          <div class="flex size-9 items-center justify-center rounded-lg border border-border/50 bg-muted/20 text-primary">
            <span class="icon-[ph--terminal-window] size-5"></span>
          </div>
          <div>
            <div class="text-xs font-semibold tracking-tight text-foreground">{SITE.title || 'Digital Hub'}</div>
            <div class="font-mono text-[9px] uppercase tracking-[0.18em] text-muted-foreground/60">Home / Index</div>
          </div>
        </div>
        <span class="font-mono text-[9px] uppercase tracking-wider text-muted-foreground/50 select-none">v{SITE.version}</span>
      </div>
    </header>

    <section class="flex flex-1 flex-col justify-center px-6 py-12 lg:px-8 xl:px-12 lg:py-16">
      <div class="mb-6 flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.16em] text-muted-foreground/60 select-none">
        <span class="relative flex size-1.5"><span class="absolute inset-0 animate-ping rounded-full bg-emerald-400 opacity-50"></span><span class="relative size-1.5 rounded-full bg-emerald-500"></span></span>
        Building & Exploring
      </div>

      <h1 class="text-5xl font-bold leading-none tracking-[-0.05em] text-foreground xl:text-7xl select-none">Home</h1>

      <div class="mt-6 flex items-center gap-2 text-sm text-muted-foreground">
        <span class="icon-[ph--house] size-4 text-primary/70"></span>
        <span>Home Overview</span>
      </div>

      <div class="mt-5 flex flex-wrap gap-x-3 gap-y-2 font-mono text-[11px] text-muted-foreground/70">
        <span class="inline-flex items-center gap-1.5"><span class="icon-[ph--code] size-3.5"></span>Developer</span>
        <span class="text-border">/</span>
        <span class="inline-flex items-center gap-1.5"><span class="icon-[ph--pen-nib] size-3.5"></span>Creator</span>
      </div>

      <div class="mt-9 max-w-md border-l border-primary/50 pl-4">
        <p class="text-sm leading-7 text-muted-foreground md:text-base">欢迎访问此站点，<br />基于 Astro v6 构建，记录技术、分享生活。</p>
      </div>
    </section>

    <footer class="hidden shrink-0 lg:block">
      <div class="flex items-center justify-between border-t border-border/40 px-6 py-3 lg:px-8 xl:px-12">
        <span class="font-mono text-[9px] uppercase tracking-[0.16em] text-muted-foreground/50">// CONNECT</span>
        <span class="font-mono text-[9px] uppercase tracking-[0.16em] text-muted-foreground/40">{SOCIAL_LINKS.length} PORTALS</span>
      </div>
      <div class="border-t border-border/20">
        {SOCIAL_LINKS.map((item) => (
          <a href={item.url} target="_blank" rel="noopener noreferrer" class="group flex h-12 items-center gap-3 border-b border-border/20 px-6 transition-colors last:border-b-0 hover:bg-muted/20 lg:px-8 xl:px-12">
            <span class={`${item.icon} size-4 text-muted-foreground/60 transition-colors group-hover:text-primary`}></span>
            <span class="font-mono text-[10px] uppercase tracking-wider text-muted-foreground transition-colors group-hover:text-foreground">{item.name || 'Link'}</span>
            <span class="ml-auto icon-[ph--arrow-up-right] size-3 text-muted-foreground/20 transition-all group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-primary"></span>
          </a>
        ))}
      </div>
    </footer>
  </div>
</aside>
