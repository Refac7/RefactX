---
import { cn } from '~/lib/utils'

type Props = {
  href: string
  class?: string
  background?: boolean
  [key: string]: any
}

const { href, class: className, background, ...props }: Props = Astro.props
const isActive = Astro.url.pathname.startsWith(href)
---

<a
  {href}
  class={cn(
    'inline-flex items-center gap-2 text-sm px-4 h-9 rounded-full font-medium transition-colors',
    background && 'text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface',
    isActive && 'bg-secondary-container text-on-secondary-container font-semibold',
    className
  )}
  rel="prefetch"
  {...props}
>
  <slot />
</a>
