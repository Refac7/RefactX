---
import { cn } from '~/lib/utils'

type Props = {
  href: string
  class?: string
  background?: boolean
  [key: string]: any
}

const { href, class: className, background, ...props }: Props = Astro.props
const pathname = Astro.url.pathname
const isActive = href === '/' ? pathname === '/' : pathname.startsWith(href)
---

<a
  {href}
  class={cn(
    'relative inline-flex shrink-0 items-center whitespace-nowrap border-b-2 border-transparent px-2.5 py-2 font-mono text-[10px] font-semibold uppercase tracking-[0.16em] transition-colors sm:px-3',
    background && 'text-muted-foreground hover:bg-muted hover:text-foreground',
    isActive && 'text-foreground border-primary',
    className
  )}
  rel="prefetch"
  {...props}
>
  <slot />
</a>
