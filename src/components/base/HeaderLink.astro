---
import { cn } from '~/lib/utils'

type Props = {
  href: string
  class?: string
  background?: boolean
  [key: string]: any
}

const { href, class: className, background, ...props }: Props = Astro.props
const isActive = Astro.url.pathname.startsWith(href)
---

<a
  {href}
  class={cn(
    'text-sm px-4 py-2 font-semibold rounded-full',
    background && 'transition-colors text-foreground/80 hover:bg-accent hover:text-primary',
    isActive && 'text-primary bg-accent',
    className
  )}
  rel="prefetch"
  {...props}
>
  <slot />
</a>
