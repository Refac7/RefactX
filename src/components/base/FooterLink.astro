---
import { cn } from '~/lib/utils'

type Props = {
  href: string
  class?: string
  [key: string]: any
}

const { href, class: className, ...props }: Props = Astro.props
---

<a
  {href}
  class={cn(
    'group relative flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-muted-foreground transition-colors hover:text-primary py-1',
    className
  )}
  {...props}
>
  {/* Hover 时左侧出现的装饰块 */}
  <span class="h-1.5 w-1.5 bg-primary opacity-0 group-hover:opacity-100 transition-opacity duration-200"></span>
  <span class="relative z-10 border-b border-transparent group-hover:border-primary/50 transition-colors">
    <slot />
  </span>
</a>
