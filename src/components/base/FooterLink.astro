---
import { cn } from '~/lib/utils'

type Props = {
  href: string
  class?: string
  [key: string]: any
}

const { href, class: className, ...props }: Props = Astro.props
---

<a
  {href}
  class={cn('group relative flex items-center gap-2 text-sm text-on-surface-variant transition-colors hover:text-primary py-1', className)}
  {...props}
>
  <span class="h-1.5 w-1.5 rounded-full bg-primary opacity-0 group-hover:opacity-100 transition-opacity duration-200"></span>
  <span class="relative z-10">
    <slot />
  </span>
</a>
