---
import type { PhotoData } from '~/types'
import { cn } from '~/lib/utils'
import PolaroidStack from './PolaroidStack'
import TimelineIcon from './TimelineIcon.astro'

interface Props {
  photoData: PhotoData[]
  class?: string
}

const { photoData, class: className } = Astro.props
---

<div class={cn("relative space-y-8 pb-12", className)}>
  
  {/* 连接线 - 仅在桌面端显示 */}
  <div class="absolute left-[27px] top-4 bottom-0 w-px border-l border-dashed border-border/40 z-0 hidden sm:block"></div>

  {
    photoData.map((timeline, index) => {
      const indexId = index.toString().padStart(2, '0');
      
      return (
        <div 
          class="timeline-item relative group opacity-0 animate-slide-down" 
          style={`animation-delay: ${index * 0.15}s`}
        >
          {/* 布局容器: 移动端上下，桌面端左右 */}
          <div class="flex flex-col sm:flex-row sm:gap-x-8">
            
            {/* 左侧：图标与时间轴节点 */}
            <div class="relative z-10 flex flex-col items-start sm:items-center shrink-0">
              <div class="size-14 flex justify-center items-center bg-background border border-border/40 group-hover:border-primary/60 group-hover:bg-muted/10 transition-colors duration-300 relative z-20 rounded-sm shadow-sm">
                 <div class="absolute top-0 right-0 size-1 bg-primary opacity-0 group-hover:opacity-100 transition-opacity"></div>
                 <TimelineIcon icon={timeline.icon} index={index} />
              </div>
              
              {/* 移动端连接线 */}
              <div class="h-6 ml-7 w-px border-l border-dashed border-border/40 sm:hidden"></div>
              
              {/* 桌面端垂直装饰字 */}
              <div class="hidden sm:block mt-3 font-mono text-[10px] text-muted-foreground/40 writing-vertical-lr tracking-widest select-none">
                LOG_{indexId}
              </div>
            </div>

            {/* 右侧：主要内容区域 */}
            <div class="grow relative min-w-0">
              
              {/* 桌面端横向连接线 */}
              <div class="absolute top-7 -left-8 w-8 h-px bg-border/40 hidden sm:block"></div>

              {/* 卡片主体 */}
              <div class="border border-border/40 bg-background p-1 group-hover:border-border/80 transition-colors duration-300 shadow-sm">
                <div class="relative p-5 sm:p-6 bg-muted/5 group-hover:bg-muted/10 transition-colors duration-300">
                  
                  {/* 角落装饰 */}
                  <div class="absolute top-0 left-0 size-2 border-t border-l border-primary/20 group-hover:border-primary transition-colors"></div>
                  <div class="absolute bottom-0 right-0 size-2 border-b border-r border-primary/20 group-hover:border-primary transition-colors"></div>

                  {/* 标题与日期 */}
                  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 mb-4 border-b border-border/40 pb-3">
                    <h2 class="font-sans text-lg font-bold uppercase tracking-tight text-foreground flex items-center gap-2">
                      <span class="w-1.5 h-4 bg-primary/80 block"></span>
                      {timeline.title}
                    </h2>
                    <span class="font-mono text-xs text-muted-foreground bg-muted/50 px-2 py-0.5 border border-border/30 rounded-sm">
                      {timeline.date}
                    </span>
                  </div>

                  {/* 描述文本 */}
                  {timeline.description && (
                    <p class="text-sm text-muted-foreground leading-relaxed font-sans mb-6 max-w-prose">
                      {timeline.description}
                    </p>
                  )}

                  {/* 图片展示区域 (Stack) */}
                  {/* 修改点: relative 容器，去除 strict overflow，增加 padding 避免 hover 裁剪 */}
                  <div class="mt-4 relative bg-background border border-border/40 rounded-sm">
                    
                    {/* 背景网格纹理 */}
                    <div class="absolute inset-0 opacity-[0.04] pointer-events-none" 
                         style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 10px 10px;">
                    </div>
                    
                    {/* 装饰标签 */}
                    <div class="absolute top-2 left-3 text-[9px] font-mono text-muted-foreground/40 uppercase tracking-widest pointer-events-none z-0">
                      IMG_SET_{indexId}
                    </div>

                    {/* Stack 组件容器 - padding 确保内容不贴边，且高度自适应 */}
                    <div class="relative z-10 p-6 pt-8 sm:p-8 sm:pt-10">
                       <PolaroidStack 
                         photos={timeline.photos} 
                         title={timeline.title} 
                         description={timeline.description} 
                         client:visible 
                       />
                    </div>
                  </div>
                
                </div>
              </div>
            </div>
          </div>
        </div>
      )
    })
  }
</div>