---
import type { PhotoData } from '~/types'
import { cn } from '~/lib/utils'
import PolaroidStack from './PolaroidStack'
import TimelineIcon from './TimelineIcon.astro'

interface Props {
  photoData: PhotoData[]
  class?: string
}

const { photoData, class: className } = Astro.props
---

<div class={cn("relative space-y-6", className)}>
  
  <div class="absolute left-[27px] top-0 bottom-0 w-px bg-border/40 z-0 hidden sm:block"></div>

  {
    photoData.map((timeline, index) => {
      return (
        <div 
          class="timeline-item relative group opacity-0 animate-slide-down" 
          style={`animation-delay: ${index * 0.1}s`}
        >
          <div class="flex flex-col sm:flex-row sm:gap-x-6">
            
            <div class="relative z-10 flex flex-col items-start sm:items-center shrink-0">
              <div class="size-14 flex justify-center items-center rounded-full bg-background border border-border/60 shadow-xs group-hover:border-border group-hover:bg-muted/10 transition-colors duration-300 relative z-20">
                 <TimelineIcon icon={timeline.icon} index={index} />
              </div>
              <div class="h-4 ml-7 w-px bg-border/40 sm:hidden"></div>
            </div>

            <div class="grow pb-6 relative min-w-0">
              <div class="absolute top-7 -left-6 w-6 h-px bg-border/40 hidden sm:block"></div>

              <div class="rounded-md border border-border/40 bg-background/50 group-hover:shadow-xs group-hover:border-border/60 transition-all duration-300 overflow-hidden">
                <div class="p-6">
                  
                  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
                    <h2 class="font-sans text-xl font-semibold tracking-tight text-foreground">
                      {timeline.title}
                    </h2>
                    <span class="text-xs font-medium text-muted-foreground bg-muted/50 px-2.5 py-1 rounded-full">
                      {timeline.date}
                    </span>
                  </div>

                  {timeline.description && (
                    <p class="text-sm text-muted-foreground leading-relaxed font-sans mb-6">
                      {timeline.description}
                    </p>
                  )}

                  <div class="mt-4 relative bg-muted/10 rounded-md border border-border/40 p-6 overflow-hidden">
                    <div class="relative z-10 transform sm:translate-y-2">
                       <PolaroidStack photos={timeline.photos} title={timeline.title} description={timeline.description} client:load />
                    </div>
                  </div>
                
                </div>
              </div>
            </div>
          </div>
        </div>
      )
    })
  }
</div>