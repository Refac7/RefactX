---
import { formatDate } from '~/lib/utils'
import PostTag from '~/components/posts/base/PostTag.astro'
import type { CardProps } from './List.astro'

interface Props extends CardProps {}

const { post }: Props = Astro.props
---

<article class="group relative pl-8 sm:pl-12 py-2">
  <!-- 工业风时间轴：左侧导轨 -->
  <div class="absolute left-0 top-0 h-full flex flex-col items-center w-8 sm:w-12">
    <!-- 节点：方形锚点 -->
    <div class="h-3 w-3 border-2 border-muted-foreground/40 bg-background group-hover:border-primary group-hover:bg-primary transition-all duration-300 z-10 mt-6 relative">
        <!-- 装饰：选中时的内部发光点 -->
        <div class="absolute inset-0 m-auto w-1 h-1 bg-background opacity-0 group-hover:opacity-100 transition-opacity"></div>
    </div>
    <!-- 连线：虚线刻度风格 -->
    <div class="flex-1 w-px border-l-2 border-dashed border-muted-foreground/20 group-hover:border-primary/30 transition-colors h-full"></div>
  </div>

  <!-- 主体卡片：方正边框容器 -->
  <div class="relative border border-border/60 hover:border-primary/50 transition-all duration-300 p-5 sm:p-6">
    
    <!-- 装饰性角落标记 -->
    <div class="absolute top-0 right-0 w-3 h-3 border-t border-r border-primary/40 opacity-50"></div>
    <div class="absolute bottom-0 left-0 w-3 h-3 border-b border-l border-primary/40 opacity-50"></div>

    <!-- 头部元数据：工程标签风格 -->
    <div class="flex flex-wrap items-center justify-between gap-y-2 mb-3 border-b border-dashed border-border/60 pb-3">
      <div class="flex items-center gap-3">
        <!-- 日期：使用等宽字体，模仿系统日志 -->
        <div class="flex items-center gap-1.5 font-mono text-xs text-muted-foreground">
          <span class="text-primary/60">[</span>
          <time datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate)}
          </time>
          <span class="text-primary/60">]</span>
        </div>
        
        {post.data.updatedDate && (
          <div class="flex items-center gap-1.5 font-mono text-xs text-muted-foreground/70 sm:flex">
             <span class="text-primary/40">::</span>
             <span>UPD</span>
             <time>{formatDate(post.data.updatedDate)}</time>
          </div>
        )}
      </div>

      <!-- 移动端显示的更新时间 -->
      {post.data.updatedDate && (
        <div class="sm:hidden font-mono text-xs text-muted-foreground/60">
           UPD: {formatDate(post.data.updatedDate)}
        </div>
      )}
    </div>

    <!-- 内容区域 -->
    <div class="flex flex-col">
      <a href={`/posts/${post.slug}`} class="block group/title outline-none">
        <h2 class="text-lg sm:text-xl font-bold text-foreground/90 group-hover:text-primary transition-colors tracking-tight leading-tight">
          {post.data.title}
        </h2>
        
        {post.data.description && (
          <p class="mt-3 text-sm sm:text-base text-muted-foreground/80 line-clamp-2 leading-relaxed font-light border-l-2 border-primary/10 pl-3">
            {post.data.description}
          </p>
        )}
      </a>

      <!-- 底部标签栏 -->
      {post.data.tags?.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2 items-center">
          <span class="icon-[ph--hash] w-3 h-3 text-muted-foreground/40"></span>
          {post.data.tags.slice(0, 3).map((tag) => (
            <div class="transform scale-90 origin-left">
                <PostTag tag={tag} size="sm" class="rounded-none border-primary/20 bg-secondary/30 text-xs font-mono" />
            </div>
          ))}
          {post.data.tags.length > 3 && (
            <span class="text-[10px] font-mono border border-border px-1 py-0.5 text-muted-foreground/60 bg-muted/30">
              +{post.data.tags.length - 3}
            </span>
          )}
        </div>
      )}
    </div>
  </div>
</article>