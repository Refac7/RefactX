---
import { formatDate } from '~/lib/utils'
import PostTag from '~/components/posts/base/PostTag.astro'
import type { CardProps } from './List.astro'

interface Props extends CardProps {}

const { post }: Props = Astro.props
---

<article class="group relative pl-8 sm:pl-10 py-4 w-full">
  
  <div class="absolute left-0 top-0 h-full w-8 sm:w-10 flex justify-center z-10">
    <div class="h-full w-px bg-border/40 group-hover:bg-primary/30 transition-colors duration-500"></div>
    <div class="absolute top-[2.1rem] w-2.5 h-2.5 rounded-full bg-background border-2 border-border/80 group-hover:border-primary transition-colors duration-300"></div>
  </div>

  <div class="relative bg-background/50 border border-border/40 rounded-md hover:border-border/80 hover:bg-muted/20 hover:shadow-xs transition-all duration-300 p-5 sm:p-6 w-full flex flex-col gap-3">

    <div class="flex flex-wrap items-center gap-2 text-xs font-medium text-muted-foreground">
      <time datetime={post.data.pubDate.toISOString()}>
        {formatDate(post.data.pubDate)}
      </time>
      
      {post.data.updatedDate && (
        <div class="flex items-center gap-2">
          <span class="text-border">•</span>
          <span class="icon-[ph--clock-clockwise] size-3.5"></span>
          <time>{formatDate(post.data.updatedDate)}</time>
        </div>
      )}
    </div>

    <div class="flex flex-col gap-2">
      <a href={`/posts/${post.id}`} class="block outline-none" target="_self">
        <h2 class="text-lg sm:text-xl font-semibold text-foreground group-hover:text-primary transition-colors tracking-tight leading-tight">
          {post.data.title}
        </h2>
        {post.data.description && (
          <p class="mt-2 text-sm text-muted-foreground leading-relaxed line-clamp-2 pr-4">
            {post.data.description}
          </p>
        )}
      </a>
    </div>

    <div class="mt-2 pt-4 flex flex-wrap items-center justify-between gap-4 border-t border-border/40">
      
      <div class="flex items-center gap-2">
        {post.data.tags?.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {post.data.tags.slice(0, 3).map((tag) => (
              <PostTag 
                tag={tag} 
                size="sm" 
                class="rounded-xs border-border/40 bg-muted/50 text-xs text-muted-foreground px-2.5 py-1 transition-colors" 
              />
            ))}
            {post.data.tags.length > 3 && (
              <span class="text-xs text-muted-foreground/60 self-center">
                +{post.data.tags.length - 3}
              </span>
            )}
          </div>
        )}
      </div>

    </div>

  </div>
</article>