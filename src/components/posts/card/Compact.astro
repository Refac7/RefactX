---
// 保留原所有导入、类型定义，无任何业务逻辑修改
import { formatDate } from '~/lib/utils'
import PostTag from '~/components/posts/base/PostTag.astro'
import type { CardProps } from './List.astro'

// 保留原Props继承，完全兼容父组件传参
interface Props extends CardProps {}

const { post }: Props = Astro.props
---


<div class="group relative block p-6 border border-border/60 bg-background hover:border-primary/50 hover:bg-muted/5 transition-all duration-300 rounded-none overflow-hidden">
  
  <div class="absolute top-0 left-0 w-2 h-2 border-t border-l border-primary/0 group-hover:border-primary/50 transition-colors z-10"></div>
  <div class="absolute bottom-0 right-0 w-2 h-2 border-b border-r border-primary/0 group-hover:border-primary/50 transition-colors z-10"></div>

  
  <article class="relative z-10 flex flex-col gap-3">
    
    <div class="flex sm:items-center flex-wrap gap-2 text-xs text-muted-foreground/60 font-mono uppercase tracking-wider">
      <span class="inline-flex items-center gap-1.5">
        <span class="icon-[ph--calendar-blank-bold] size-3.5"></span>
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
      </span>
      {post.data.updatedDate && (
        <>
          <span class="text-primary/40">/</span>
          <span class="inline-flex items-center gap-1.5">
            <span class="icon-[ph--clock-clockwise-bold] size-3.5" />
            <time datetime={post.data.updatedDate.toISOString()}>
              {formatDate(post.data.updatedDate)}
            </time>
          </span>
        </>
      )}
    </div>

    
    <a href={`/posts/${post.slug}`} class="block group/title outline-none">
      <h3 class="text-base sm:text-lg font-bold text-foreground font-sans group-hover/title:text-primary transition-colors tracking-tight">
        {post.data.title}
      </h3>
      {post.data.description && (
        <p class="mt-2 text-sm text-muted-foreground/70 line-clamp-2 leading-relaxed">
          {post.data.description}
        </p>
      )}
    </a>

    
    {post.data.tags?.length > 0 && (
      <div class="flex flex-wrap gap-2 mt-3 pt-2 border-t border-border/40 border-dashed">
        {post.data.tags.slice(0, 4).map((tag) => (
          <PostTag 
            tag={tag} 
            size="sm"
            class="rounded-none border-primary/30 bg-muted/5 text-xs font-mono px-2 py-1" 
          />
        ))}
        {post.data.tags.length > 4 && (
          <span class="text-xs font-mono border border-border/60 px-2 py-1 text-muted-foreground/60 bg-background self-center">
            [+{post.data.tags.length - 4}]
          </span>
        )}
      </div>
    )}
  </article>

  
  {post.data.recommend && (
    <span class="absolute right-4 bottom-4 text-primary/10 icon-[solar--star-rainbow-bold-duotone] size-12 opacity-80 group-hover:text-primary/40 transition-colors z-0" />
  )}

  
  <div class="absolute left-0 top-0 bottom-0 w-px bg-border/60 group-hover:bg-primary transition-colors duration-300 z-0"></div>
</div>
