---
import { formatDate } from '~/lib/utils'
import PostTag from '~/components/posts/base/PostTag.astro'
import type { CardProps } from './List.astro'

interface Props extends CardProps {}

const { post }: Props = Astro.props
---

<div class="group relative block p-6 border border-border/40 bg-background/50 hover:bg-muted/20 hover:shadow-xs transition-all duration-300 rounded-lg hover:-translate-y-0.5">
  
  <article class="relative z-10 flex flex-col gap-3">
    
    <div class="flex sm:items-center flex-wrap gap-2 text-xs text-muted-foreground font-medium">
      <time datetime={post.data.pubDate.toISOString()}>
        {formatDate(post.data.pubDate)}
      </time>
      {post.data.updatedDate && (
        <>
          <span class="text-border">•</span>
          <span class="inline-flex items-center gap-1.5">
            <span class="icon-[ph--clock-clockwise] size-3.5" />
            <time datetime={post.data.updatedDate.toISOString()}>
              {formatDate(post.data.updatedDate)}
            </time>
          </span>
        </>
      )}
    </div>

    <a href={`/posts/${post.id}`} class="block group/title outline-none">
      <h3 class="text-lg font-semibold text-foreground group-hover/title:text-primary transition-colors tracking-tight">
        {post.data.title}
      </h3>
      {post.data.description && (
        <p class="mt-2 text-sm text-muted-foreground leading-relaxed line-clamp-2">
          {post.data.description}
        </p>
      )}
    </a>

    {post.data.tags?.length > 0 && (
      <div class="flex flex-wrap gap-2 mt-3">
        {post.data.tags.slice(0, 4).map((tag) => (
          <PostTag 
            tag={tag} 
            size="sm"
            class="rounded-xs border-border/40 bg-muted/50 text-xs text-muted-foreground hover:bg-muted px-2.5 py-1" 
          />
        ))}
        {post.data.tags.length > 4 && (
          <span class="text-xs text-muted-foreground/60 self-center">
            +{post.data.tags.length - 4} more
          </span>
        )}
      </div>
    )}
  </article>

  {post.data.recommend && (
    <span class="absolute right-4 top-4 text-amber-500/80 icon-[ph--star-fill] size-5 transition-colors z-0" />
  )}
</div>