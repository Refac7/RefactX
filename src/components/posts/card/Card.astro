---
import { formatDate } from '~/lib/utils'
import { POSTS_CONFIG } from '~/config'
import PostTag from '~/components/posts/base/PostTag.astro'
import RecommendBadge from '~/components/posts/base/RecommendBadge.astro'
import type { CardProps } from './List.astro'

interface Props extends CardProps {}

const { post, heroImageLayout }: Props = Astro.props
const hasImage = post.data.heroImage !== 'none'
const showImage = Astro.props.showImage
const imagePosition = post.data.heroImageLayout || heroImageLayout || 'right'
const isReverse = imagePosition === 'right'
const defaultHeroImage = POSTS_CONFIG.defaultHeroImage
const sideWidthClass = 'md:w-[280px] lg:w-[320px]'
---

<article
  class="group relative flex flex-col md:flex-row bg-background/70 border border-primary/15 rounded-3xl hover:border-primary/40 transition-all duration-300 overflow-hidden h-full hover:-translate-y-1"
>
  {
    hasImage && showImage && (
      <div
        class={`
	        hidden md:flex flex-col relative shrink-0 h-auto
	        ${sideWidthClass}
	        ${isReverse ? 'md:order-2' : 'md:order-1'}
	      `}
      >
        <a href={`/posts/${post.id}`} class="block w-full h-full relative overflow-hidden bg-muted group/img">
          <img
            src={post.data.heroImage || defaultHeroImage}
            alt={post.data.title}
            loading="eager"
            decoding="async"
            class="absolute inset-0 w-full h-full object-cover transition-all duration-500 ease-out group-hover/img:scale-110 group-hover/img:rotate-1"
          />
        </a>
      </div>
    )
  }

  {
    !hasImage && showImage && (
      <a
        href={`/posts/${post.id}`}
        class={`
	        hidden md:flex shrink-0 h-auto relative overflow-hidden flex-col items-center justify-center p-6 bg-accent/40
	        ${sideWidthClass}
	        ${isReverse ? 'md:order-2' : 'md:order-1'}
	        group/placeholder hover:bg-accent/70 transition-all duration-300 cursor-pointer
	      `}
      >
        <span class="icon-[ph--image-broken] size-12 text-primary/30 mb-3 group-hover/placeholder:scale-110 group-hover/placeholder:rotate-6 transition-transform duration-500 ease-out" />
        <span class="text-xs font-semibold text-primary/60">No Media</span>
      </a>
    )
  }

  <div
    class={`
	      flex flex-col w-full p-6 flex-1
	      ${hasImage && showImage && isReverse ? 'md:order-1' : 'md:order-1'}
	    `}
  >
    <div class="flex items-center justify-between mb-2">
      <div class="flex items-center gap-2 text-sm font-medium text-muted-foreground leading-6.5">
        <time>{formatDate(post.data.pubDate)}</time>
        {post.data.updatedDate && <span class="text-primary/30">&bull;</span>}
        {
          post.data.updatedDate && (
            <time class="flex items-center gap-1">
              <span class="icon-[ph--clock-clockwise] size-3.5" />
              {formatDate(post.data.updatedDate)}
            </time>
          )
        }
        {
          post.data.author && (
            <>
              <>
                <span class="text-primary/30">&bull;</span>
                <a href={`/authors/${post.data.author}`} class="hover:text-primary hover:underline transition-colors">
                  {post.data.author}
                </a>
              </>
            </>
          )
        }
      </div>
      {post.data.recommend && <RecommendBadge />}
    </div>
    <a href={`/posts/${post.id}`} class="group/title block mb-4 outline-none">
      <h2 class="text-xl font-bold leading-tight text-foreground transition-colors group-hover/title:text-primary tracking-tight">
        {post.data.title}
      </h2>
      {
        post.data.description && (
          <p class="mt-3 text-xs text-muted-foreground leading-relaxed line-clamp-2 max-w-[65ch]">{post.data.description}</p>
        )
      }
    </a>
    <div class="mt-auto flex flex-wrap items-center gap-2">
      {post.data.tags?.slice(0, 3).map((tag) => <PostTag tag={tag} class="border-primary/20 bg-accent/60 text-primary px-2.5 py-1" />)}
      {post.data.tags && post.data.tags.length > 3 && <span class="text-xs text-muted-foreground/60">+{post.data.tags.length - 3}</span>}
    </div>
  </div>
</article>
