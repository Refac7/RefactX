---
import { formatDate } from '~/lib/utils'
import { POSTS_CONFIG } from '~/config'
import PostTag from '~/components/posts/base/PostTag.astro'
import RecommendBadge from '~/components/posts/base/RecommendBadge.astro'
import type { CardProps } from './List.astro'

interface Props extends CardProps {}

const { post, heroImageLayout, index = 0, showIndex = false }: Props = Astro.props
const showImage = Astro.props.showImage
const hasImage = Boolean(post.data.heroImage) && post.data.heroImage !== 'none'
const imagePosition = post.data.heroImageLayout || heroImageLayout || 'left'
const isReverse = imagePosition === 'right'
const watermarkIndex = String(index).padStart(2, '0')
const firstTag = post.data.tags?.[0]
---

<article class="post-card lift group">
  {
    hasImage && showImage && (
      <a
        href={`/posts/${post.id}`}
        class:list={['post-card__media', isReverse && 'post-card__media--reverse']}
        aria-label={post.data.title}
      >
        <img
          src={post.data.heroImage || ''}
          alt={post.data.title}
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer"
          onerror="this.closest('.post-card__media')?.remove()"
        />
        {firstTag && <span class="post-card__media-tag">#{firstTag}</span>}
        <span class="post-card__media-shade" aria-hidden="true" />
      </a>
    )
  }

  <div class="post-card__body">
    {
      showIndex && (
        <span class="post-card__index" aria-hidden="true">
          {watermarkIndex}
        </span>
      )
    }

    <div class="post-card__meta">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      {
        post.data.author && (
          <>
            <span class="post-card__dot" aria-hidden="true" />
            <a href={`/authors/${post.data.author}`}>{post.data.author}</a>
          </>
        )
      }
      {post.data.recommend && <RecommendBadge class="ml-auto" />}
    </div>

    <a href={`/posts/${post.id}`} class="post-card__title-link">
      <h2 class="post-card__title">{post.data.title}</h2>
      {post.data.description && <p class="post-card__desc">{post.data.description}</p>}
    </a>

    <div class="post-card__footer">
      <div class="flex flex-wrap items-center gap-2">
        {post.data.tags?.slice(0, 3).map((tag) => <PostTag tag={tag} class="chip" />)}
        {
          post.data.tags && post.data.tags.length > 3 && (
            <span class="text-[0.68rem] text-muted-foreground">+{post.data.tags.length - 3}</span>
          )
        }
      </div>
      <span class="post-card__more">
        {POSTS_CONFIG.readMoreText}
        <span class="icon-[ph--arrow-right] transition-transform duration-300 group-hover:translate-x-1"></span>
      </span>
    </div>
  </div>
</article>

<style>
  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    min-width: 0;
    border: 1px solid hsl(var(--border) / 0.78);
    border-radius: 1.5rem;
    background: hsl(var(--card));
    box-shadow: 0 1px 2px hsl(218 20% 20% / 0.04);
  }

  .post-card__media {
    position: relative;
    display: block;
    flex-shrink: 0;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: hsl(var(--muted));
  }

  .post-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .post-card:hover .post-card__media img {
    transform: scale(1.045);
  }

  .post-card__media-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, rgb(18 13 7 / 0.32));
    pointer-events: none;
  }

  .post-card__media-tag {
    position: absolute;
    left: 1rem;
    top: 1rem;
    z-index: 1;
    padding: 0.34rem 0.65rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.92);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    font-family: var(--font-geist-mono);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: hsl(220 30% 14%);
  }

  .post-card__body {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.4rem 1.35rem 1.3rem;
    min-width: 0;
  }

  .post-card__index {
    position: absolute;
    right: 1.1rem;
    top: 0.6rem;
    font-family: var(--font-display);
    font-size: 4.4rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.08em;
    color: hsl(var(--foreground) / 0.045);
    pointer-events: none;
    transition: color 300ms ease;
  }

  .post-card:hover .post-card__index {
    color: hsl(var(--primary) / 0.16);
  }

  .post-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.8rem;
    font-family: var(--font-geist-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
  }

  .post-card__meta a {
    color: inherit;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .post-card__meta a:hover {
    color: hsl(var(--accent-foreground));
  }

  .post-card__dot {
    width: 3px;
    height: 3px;
    border-radius: 999px;
    background: hsl(var(--border));
  }

  .post-card__title-link {
    text-decoration: none;
  }

  .post-card__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.28rem, 2.4vw, 1.62rem);
    font-weight: 750;
    line-height: 1.25;
    letter-spacing: -0.032em;
    color: hsl(var(--foreground));
    transition: color 200ms ease;
  }

  .post-card:hover .post-card__title {
    color: hsl(var(--accent-foreground));
  }

  .post-card__desc {
    margin: 0.7rem 0 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 0.86rem;
    line-height: 1.7;
    color: hsl(var(--muted-foreground));
  }

  .post-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    margin-top: auto;
    padding-top: 1.2rem;
  }

  .post-card__more {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    flex-shrink: 0;
    font-size: 0.74rem;
    font-weight: 600;
    color: hsl(var(--muted-foreground));
    transition: color 200ms ease;
  }

  .post-card:hover .post-card__more {
    color: hsl(var(--accent-foreground));
  }

  @media (min-width: 768px) {
    .post-card {
      flex-direction: row;
    }

    .post-card__media {
      width: 40%;
      aspect-ratio: auto;
      min-height: 15.5rem;
      border-right: 1px solid hsl(var(--border) / 0.7);
    }

    .post-card__media--reverse {
      order: 2;
      border-right: 0;
      border-left: 1px solid hsl(var(--border) / 0.7);
    }

    .post-card__body {
      padding: 1.65rem 1.7rem 1.5rem;
    }
  }

  @media (max-width: 767px) {
    .post-card__title {
      font-size: 1.32rem;
    }
  }
</style>
