---
import { formatDate } from '~/lib/utils'
import { POSTS_CONFIG } from '~/config'
import PostTag from '~/components/posts/base/PostTag.astro'
import RecommendBadge from '~/components/posts/base/RecommendBadge.astro'
import type { CardProps } from './List.astro'

interface Props extends CardProps {}

const { post, heroImageLayout }: Props = Astro.props
const showImage = Astro.props.showImage
const hasImage = Boolean(post.data.heroImage) && post.data.heroImage !== 'none'
const imagePosition = post.data.heroImageLayout || heroImageLayout || 'right'
const isReverse = imagePosition === 'right'
const sideWidthClass = 'md:w-[280px] lg:w-[320px]'
---

<article
  class="group relative flex flex-col md:flex-row bg-background/50 border border-border/40 overflow-hidden h-full transition-all duration-300 hover:border-primary/30 hover:shadow-sm hover:-translate-y-0.5"
>
  {
    hasImage && showImage && (
      <div
        class={`
	        hidden md:flex flex-col relative shrink-0 h-auto
	        ${sideWidthClass}
	        ${isReverse ? 'md:order-2 border-l border-border/40' : 'md:order-1 border-r border-border/40'}
	      `}
      >
        <a href={`/posts/${post.id}`} class="block w-full h-full relative overflow-hidden bg-muted group/img rounded-none">
          <img
            src={post.data.heroImage || ''}
            alt={post.data.title}
            loading="eager"
            decoding="async"
            class="absolute inset-0 w-full h-full object-cover grayscale transition-all duration-700 ease-out group-hover/img:grayscale-0 group-hover/img:scale-105 rounded-none"
          />
        </a>
      </div>
    )
  }

  <div class="flex flex-col w-full p-6 flex-1">
    <!-- Meta row -->
    <div class="flex items-center justify-between gap-4 mb-4">
      <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 font-mono text-[11px] tracking-wide text-muted-foreground/70">
        <time>{formatDate(post.data.pubDate)}</time>
        {
          post.data.updatedDate && (
            <>
              <span class="text-border">/</span>
              <time class="flex items-center gap-1">
                <span class="icon-[ph--clock-clockwise] size-3" />
                {formatDate(post.data.updatedDate)}
              </time>
            </>
          )
        }
        {
          post.data.author && (
            <>
              <span class="text-border">/</span>
              <a href={`/authors/${post.data.author}`} class="transition-colors hover:text-primary">
                {post.data.author}
              </a>
            </>
          )
        }
      </div>
      {post.data.recommend && <RecommendBadge />}
    </div>

    <!-- Title + description -->
    <a href={`/posts/${post.id}`} class="group/title block outline-none">
      <h2
        class="text-xl md:text-2xl font-bold leading-snug tracking-tight text-foreground transition-colors group-hover/title:text-primary"
      >
        {post.data.title}
      </h2>
      {
        post.data.description && (
          <p class="mt-3 text-sm text-muted-foreground leading-relaxed line-clamp-2 max-w-[68ch]">{post.data.description}</p>
        )
      }
    </a>

    <!-- Footer: tags + read more -->
    <div class="mt-auto flex flex-wrap items-center justify-between gap-3 pt-6">
      <div class="flex flex-wrap items-center gap-2">
        {
          post.data.tags
            ?.slice(0, 3)
            .map((tag) => <PostTag tag={tag} class="border-border/40 bg-muted/50 text-xs text-muted-foreground px-2.5 py-1" />)
        }
        {post.data.tags && post.data.tags.length > 3 && <span class="text-xs text-muted-foreground/60">+{post.data.tags.length - 3}</span>}
      </div>
      <span
        class="inline-flex shrink-0 items-center gap-1 text-xs font-medium text-muted-foreground transition-colors group-hover:text-primary"
      >
        {POSTS_CONFIG.readMoreText}
        <span class="icon-[ph--arrow-right] transition-transform duration-300 group-hover:translate-x-1"></span>
      </span>
    </div>
  </div>
</article>
