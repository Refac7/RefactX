---
import { formatDate } from '~/lib/utils'
import { POSTS_CONFIG } from '~/config'
import PostTag from '~/components/posts/base/PostTag.astro'
import RecommendBadge from '~/components/posts/base/RecommendBadge.astro'
import type { CardProps } from './List.astro'

interface Props extends CardProps {}

const { post, heroImageLayout, index = 0, showIndex = false }: Props = Astro.props
const showImage = Astro.props.showImage
const hasImage = Boolean(post.data.heroImage) && post.data.heroImage !== 'none'
const imagePosition = post.data.heroImageLayout || heroImageLayout || 'right'
const isReverse = imagePosition === 'right'
const sideWidthClass = 'md:w-[260px] lg:w-[300px]'
const watermarkIndex = String(index).padStart(2, '0')
---

<article
  class="group relative flex h-full flex-col border-b border-foreground/25 bg-background transition-colors duration-200 before:absolute before:inset-y-0 before:left-0 before:z-10 before:w-[3px] before:bg-primary before:opacity-0 before:transition-opacity before:content-[''] hover:bg-muted/40 hover:before:opacity-100 md:flex-row"
>
  {
    hasImage && showImage && (
      <div
        class={`
	        relative hidden shrink-0 md:flex md:flex-col
	        ${sideWidthClass}
	        ${isReverse ? 'order-2 border-l border-foreground/25' : 'order-1 border-r border-foreground/25'}
	      `}
      >
        <a href={`/posts/${post.id}`} class="relative block size-full overflow-hidden bg-muted">
          <img
            src={post.data.heroImage || ''}
            alt={post.data.title}
            loading="eager"
            decoding="async"
            class="absolute inset-0 size-full object-cover grayscale transition-all duration-500 ease-out group-hover:grayscale-0"
          />
        </a>
      </div>
    )
  }

  <div class="relative flex w-full flex-1 flex-col overflow-hidden p-5 lg:p-6">
    <!-- Ghost index watermark -->
    {
      showIndex && (
        <span
          aria-hidden="true"
          class="pointer-events-none absolute -bottom-6 right-1 hidden select-none font-bold leading-none tracking-[-0.08em] text-foreground/[0.05] transition-colors duration-200 group-hover:text-primary/[0.09] md:block md:text-[7rem]"
        >
          {watermarkIndex}
        </span>
      )
    }

    <!-- Meta row -->
    <div class="relative z-10 flex items-center justify-between gap-4">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[10px] uppercase tracking-[0.12em] text-muted-foreground">
        {
          showIndex && (
            <>
              <span class="font-semibold text-primary">{watermarkIndex}</span>
              <span class="h-2.5 w-px bg-foreground/25" />
            </>
          )
        }
        <time class="tabular-nums">{formatDate(post.data.pubDate)}</time>
        {
          post.data.updatedDate && (
            <>
              <span class="text-foreground/25">/</span>
              <time class="flex items-center gap-1 tabular-nums">
                <span class="icon-[ph--clock-clockwise] size-3" />
                {formatDate(post.data.updatedDate)}
              </time>
            </>
          )
        }
        {
          post.data.author && (
            <>
              <span class="text-foreground/25">/</span>
              <a href={`/authors/${post.data.author}`} class="transition-colors hover:text-primary">
                {post.data.author}
              </a>
            </>
          )
        }
      </div>
      {post.data.recommend && <RecommendBadge />}
    </div>

    <!-- Title + description -->
    <a href={`/posts/${post.id}`} class="group/title relative z-10 mt-4 block outline-none">
      <h2
        class="text-xl font-bold leading-[1.08] tracking-[-0.035em] text-foreground transition-colors group-hover/title:text-primary md:text-2xl"
      >
        {post.data.title}
      </h2>
      {
        post.data.description && (
          <p class="mt-2.5 line-clamp-2 max-w-[68ch] text-sm leading-relaxed text-muted-foreground">{post.data.description}</p>
        )
      }
    </a>

    <!-- Footer: tags + read more -->
    <div class="relative z-10 mt-auto flex flex-wrap items-center justify-between gap-3 pt-5">
      <div class="flex flex-wrap items-center gap-1.5">
        {
          post.data.tags
            ?.slice(0, 3)
            .map((tag) => (
              <PostTag
                tag={tag}
                class="border border-foreground/25 bg-transparent px-2 py-0.5 font-mono text-[10px] text-muted-foreground hover:border-primary hover:bg-primary hover:text-primary-foreground"
              />
            ))
        }
        {
          post.data.tags && post.data.tags.length > 3 && (
            <span class="font-mono text-[10px] text-muted-foreground/60">+{post.data.tags.length - 3}</span>
          )
        }
      </div>
      <span
        class="inline-flex shrink-0 items-center gap-1.5 font-mono text-[10px] uppercase tracking-[0.14em] text-muted-foreground transition-colors group-hover:text-primary"
      >
        {POSTS_CONFIG.readMoreText}
        <span class="icon-[ph--arrow-right] transition-transform duration-200 group-hover:translate-x-1"></span>
      </span>
    </div>
  </div>
</article>
