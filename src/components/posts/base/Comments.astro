---
import { WALINE_CONFIG } from "~/config";

interface Props { class?: string; }
const { class: className } = Astro.props;
---

<div class={`waline-wrapper ${className || ''} relative z-10`}>
  
  <div class="mb-10 group select-none flex flex-col gap-2">
    <h2 class="text-2xl font-semibold tracking-tight text-foreground">
      Comments
    </h2>
    <p class="text-sm text-muted-foreground">Join the conversation below.</p>
  </div>

  {
    WALINE_CONFIG.enableComment ? (
      <div id="waline-container" class="waline-lazy relative min-h-[150px]">
        <div class="waline-loading absolute inset-0 flex flex-col items-center justify-center bg-transparent z-0">
            <span class="icon-[ph--spinner-gap] size-6 text-muted-foreground animate-spin mb-3"></span>
            <span class="text-xs font-medium text-muted-foreground/60">Loading comments...</span>
        </div>
      </div>
    ) : (
      <div class="rounded-xl border border-border/40 bg-muted/10 p-8 text-center flex flex-col items-center justify-center">
        <span class="icon-[ph--chat-teardrop-slash] size-8 text-muted-foreground/40 mb-3 block mx-auto"></span>
        <p class="text-foreground font-medium mb-1">Comments Disabled</p>
        <p class="text-muted-foreground text-sm">The comment system is currently offline.</p>
      </div>
    )
  }
</div>

{
  WALINE_CONFIG.enableComment && (
    <>
      <link rel="stylesheet" href="/css/waline.css" />

      <style is:global>
        #waline {
          --waline-font-size: 0.95rem !important;
          --waline-line-height: 1.6 !important;
          --waline-font-family: theme('fontFamily.sans') !important;
          --waline-theme-color: hsl(var(--primary)) !important;
          --waline-active-color: hsl(var(--primary)) !important;
          --waline-bgcolor: hsl(var(--background)) !important;
          --waline-bgcolor-light: hsl(var(--muted) / 0.5) !important;
          --waline-bgcolor-hover: hsl(var(--muted) / 0.8) !important;
          --waline-border-color: hsl(var(--border) / 0.4) !important;
          --waline-disable-bg-color: hsl(var(--muted)) !important;
          --waline-disable-color: hsl(var(--muted-foreground)) !important;
          --waline-color: hsl(var(--foreground)) !important;
          --waline-info-color: hsl(var(--muted-foreground)) !important;
          --waline-code-bg-color: hsl(var(--muted) / 0.5) !important;
          --waline-box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05) !important;
          --waline-avatar-radius: 50% !important; 
          --waline-border: 1px solid var(--waline-border-color) !important;
          --waline-border-radius: 0.75rem !important;
        }

        #waline .wl-panel { 
            border: 1px solid hsl(var(--border) / 0.4) !important; 
            background: hsl(var(--background) / 0.5) !important; 
            border-radius: 1rem !important; 
            margin: 0 !important; 
            transition: all 0.3s ease; 
            overflow: hidden;
        }
        #waline .wl-panel:focus-within { 
            border-color: hsl(var(--border)) !important; 
            background: hsl(var(--background)) !important; 
            box-shadow: 0 4px 12px hsl(0 0% 0% / 0.05) !important;
        }

        #waline .wl-header { display: flex; border-bottom: 1px solid hsl(var(--border) / 0.4) !important; background: hsl(var(--muted) / 0.3) !important; }
        #waline .wl-header-item { flex: 1; padding: 0.75rem 1rem !important; display: flex !important; align-items: center !important; }
        #waline .wl-header label { font-size: 0.75rem !important; font-weight: 500; color: hsl(var(--muted-foreground)) !important; margin-right: 0.5rem !important; }
        #waline .wl-input { background: transparent !important; color: hsl(var(--foreground)) !important; height: auto !important; font-size: 0.875rem !important; }

        #waline .wl-editor { padding: 1rem 1.25rem !important; min-height: 8rem; color: hsl(var(--foreground)) !important; background: transparent !important; resize: vertical; font-size: 0.95rem !important; }
        
        #waline .wl-footer { 
          display: flex !important; 
          align-items: center !important; 
          border-top: 1px solid hsl(var(--border) / 0.4) !important; 
          background: hsl(var(--muted) / 0.2) !important; 
          padding: 0.75rem 1rem !important; 
        }

        #waline .wl-footer .wl-actions { display: flex !important; align-items: center !important; gap: 0.75rem !important; margin: 0 !important; position: relative !important; }
        #waline .wl-footer .wl-actions button { display: inline-flex !important; align-items: center !important; cursor: pointer; border-radius: 0.5rem !important; padding: 0.25rem !important; transition: background 0.2s; }
        #waline .wl-footer .wl-actions button:hover { background: hsl(var(--muted)) !important; }
        #waline .wl-footer .wl-actions svg { width: 18px !important; height: 18px !important; color: hsl(var(--muted-foreground)) !important; transition: color 0.2s; }
        #waline .wl-footer .wl-actions button:hover svg { color: hsl(var(--foreground)) !important; }

        #waline .wl-info { margin-left: auto !important; font-size: 0.75rem !important; color: hsl(var(--muted-foreground) / 0.8) !important; }
        #waline .wl-btns { display: flex !important; align-items: center !important; gap: 0.5rem !important; }

        #waline .wl-btn { 
          background: hsl(var(--foreground)) !important; 
          color: hsl(var(--background)) !important; 
          border: none !important; 
          border-radius: 0.5rem !important;
          font-size: 0.875rem !important; 
          font-weight: 500 !important; 
          padding: 0.5rem 1.25rem !important; 
          transition: opacity 0.2s; 
          cursor: pointer;
        }
        #waline .wl-btn:hover { opacity: 0.9; }

        #waline .wl-cards { margin-top: 2rem !important; }
        #waline .wl-card { border: none !important; border-bottom: 1px solid hsl(var(--border) / 0.3) !important; padding: 1.5rem 0 !important; margin: 0 !important; }
        #waline .wl-card:last-child { border-bottom: none !important; }

        #waline .wl-head { display: flex !important; align-items: center !important; gap: 0.75rem !important; margin-bottom: 0.5rem; }
        #waline .wl-user-avatar { width: 2.25rem !important; height: 2.25rem !important; border-radius: 50% !important; overflow: hidden; background: hsl(var(--muted)) !important; }
        #waline .wl-nick { font-size: 0.9rem !important; font-weight: 600 !important; color: hsl(var(--foreground)) !important; }
        #waline .wl-badge { border: 1px solid hsl(var(--primary) / 0.5) !important; border-radius: 1rem !important; color: hsl(var(--primary)) !important; background: hsl(var(--primary)/0.05) !important; font-size: 0.65rem !important; padding: 0.1rem 0.4rem !important; margin-left: 0.5rem !important; }

        #waline .wl-content { font-size: 0.95rem !important; color: hsl(var(--foreground) / 0.9) !important; line-height: 1.6 !important; word-break: break-word; }
        #waline .wl-quote { border-left: 3px solid hsl(var(--border)) !important; border-radius: 0 0.5rem 0.5rem 0 !important; background: hsl(var(--muted) / 0.3) !important; color: hsl(var(--muted-foreground)) !important; padding: 0.75rem 1rem !important; margin-bottom: 0.75rem !important; }

        #waline .wl-meta { display: flex !important; align-items: center !important; margin-top: 0.75rem !important; }
        #waline .wl-meta .wl-actions { display: flex !important; align-items: center !important; gap: 0.75rem !important; margin-left: auto !important; position: relative !important; }
        #waline .wl-action, #waline .wl-reply, #waline .wl-like, #waline .wl-edit { display: inline-flex !important; align-items: center !important; gap: 0.25rem !important; font-size: 0.75rem !important; color: hsl(var(--muted-foreground)) !important; transition: color 0.2s; visibility: visible !important; cursor: pointer; }
        #waline .wl-action svg, #waline .wl-reply svg, #waline .wl-like svg { width: 14px !important; height: 14px !important; }
        #waline .wl-action:hover, #waline .wl-reply:hover, #waline .wl-like:hover { color: hsl(var(--foreground)) !important; }
        #waline .wl-like.active { color: hsl(var(--primary)) !important; }
        .wl-gif-tab, .wl-power { display: none !important; }

        .kaomoji-popup { display: none; background: hsl(var(--background)); border: 1px solid hsl(var(--border)); border-radius: 0.75rem; z-index: 50; user-select: none; overflow: hidden; box-shadow: 0 10px 25px -5px rgb(0 0 0 / 0.1); }
        .kaomoji-popup.active { display: flex; flex-direction: column; }
        .kaomoji-header { background: hsl(var(--muted) / 0.5); border-bottom: 1px solid hsl(var(--border) / 0.5); padding: 10px 14px; font-size: 0.75rem; font-weight: 500; color: hsl(var(--muted-foreground)); display: flex; justify-content: space-between; align-items: center; }
        .kaomoji-grid { padding: 8px; display: grid; overflow-y: auto; scrollbar-width: thin; scrollbar-color: hsl(var(--muted-foreground) / 0.3) transparent; }
        .kaomoji-item { font-family: sans-serif; color: hsl(var(--foreground)); text-align: center; cursor: pointer; transition: all 0.2s; white-space: nowrap; overflow: hidden; display: flex; align-items: center; justify-content: center; border-radius: 0.5rem; }
        .kaomoji-item:hover { background: hsl(var(--muted)); color: hsl(var(--foreground)); }

        @media (min-width: 641px) {
          .kaomoji-popup { position: absolute; bottom: calc(100% + 8px); left: 0; width: 320px; }
          .kaomoji-grid { grid-template-columns: repeat(auto-fill, minmax(60px, 1fr)); gap: 4px; max-height: 200px; }
          .kaomoji-item { font-size: 13px; padding: 8px 4px; }
        }

        @media (max-width: 640px) {
          #waline input, #waline textarea { font-size: 16px !important; } 
          #waline .wl-header { flex-direction: column; }
          #waline .wl-header-item { border-bottom: 1px solid hsl(var(--border) / 0.4) !important; padding: 0.75rem !important; }
          #waline .wl-footer { flex-wrap: wrap !important; gap: 0.75rem !important; }
          #waline .wl-info { display: none !important; } 
          #waline .wl-btns { flex: 1 !important; justify-content: flex-end !important; }

          .kaomoji-popup { position: fixed; left: 0; right: 0; bottom: 0; width: 100vw; max-height: 40vh; margin: 0; border: none; border-radius: 1rem 1rem 0 0; border-top: 1px solid hsl(var(--border)); transform: translateY(100%); transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1); }
          .kaomoji-popup.active { transform: translateY(0); }
          .kaomoji-grid { grid-template-columns: repeat(4, 1fr); gap: 6px; padding: 16px; padding-bottom: env(safe-area-inset-bottom, 20px); max-height: 35vh; }
          .kaomoji-item { font-size: 14px; padding: 12px 0; background: hsl(var(--muted) / 0.5); }
        }
      </style>

      <script is:inline src="/js/waline.umd.js" defer></script>
      <script is:inline define:vars={{ serverURL: WALINE_CONFIG.serverURL, uploadToken: WALINE_CONFIG.uploadToken, imgbedURL: WALINE_CONFIG.imgbedURL, enableImgUpload: WALINE_CONFIG.enableImgUpload }}>
        const KAOMOJI_LIST =[
          "(¬_¬)", "(='X'=)", "( ಠ_ಠ)", "(>_<)", "(*^▽^*)", "(￣▽￣)\"", "(o_o)", "(O_O)", 
          "(ToT)", "(>_>)", "(<_<)", "( ° ▽、° )", "╮(╯_╰)╭", "_(:з」∠)_", "(°ー°〃)", "( ఠ ͟ʖ ఠ)",
          "(｡•ˇ‸ˇ•｡)", "( •̀ ω •́ )y", "(ง •_•)ง", "(*/ω＼*)", "w(ﾟДﾟ)w", "∑( 口 ||", "(´･ω･`)", "Wait...",
          "(╯°□°）╯︵ ┻━┻", "┬─┬ ノ( ゜-゜ノ)", "(ノへ￣、)", "(;´༎ຶД༎ຶ`)", "φ(゜▽゜*)♪", "( •̀ .̫ •́ )✧", "(⊙_⊙)？"
        ];

        if (!window.__kaomojiGlobalClick) {
          document.addEventListener('click', (e) => {
            if (!e.target.closest('.kaomoji-popup') && !e.target.closest('.hijacked-emoji')) {
              document.querySelectorAll('.kaomoji-popup.active').forEach(p => p.classList.remove('active'));
            }
          });
          window.__kaomojiGlobalClick = true;
        }

        function createPopup() {
          const popup = document.createElement('div');
          popup.className = 'kaomoji-popup';
          popup.innerHTML = `
            <div class="kaomoji-header">
              <span>Emoticons</span>
              <button class="close-kaomoji" style="padding:4px 8px;border:none;background:transparent;color:currentColor;cursor:pointer;">×</button>
            </div>
            <div class="kaomoji-grid">${KAOMOJI_LIST.map(k => `<div class="kaomoji-item">${k}</div>`).join('')}</div>
          `;
          return popup;
        }

        function hijackEmojiButton(scope = document) {
          scope.querySelectorAll('.wl-actions').forEach(actionsContainer => {
            const originalBtn = actionsContainer.querySelector('button[title="表情"]');
            if (!originalBtn || originalBtn.classList.contains('hijacked-emoji')) return;

            const clonedBtn = originalBtn.cloneNode(true);
            clonedBtn.classList.add('hijacked-emoji');
            clonedBtn.style.display = 'inline-flex';
            
            const popup = createPopup();
            originalBtn.replaceWith(clonedBtn);
            actionsContainer.appendChild(popup);

            clonedBtn.addEventListener('click', (e) => {
              e.stopPropagation(); e.preventDefault();
              const isActive = popup.classList.contains('active');
              document.querySelectorAll('.kaomoji-popup.active').forEach(p => p.classList.remove('active'));
              if(!isActive) popup.classList.add('active');
            });

            popup.querySelector('.close-kaomoji').addEventListener('click', (e) => {
              e.stopPropagation(); e.preventDefault(); popup.classList.remove('active');
            });

            popup.addEventListener('click', (e) => {
              if (e.target.classList.contains('kaomoji-item')) {
                e.preventDefault(); e.stopPropagation();
                const textarea = actionsContainer.closest('.wl-panel')?.querySelector('textarea') || document.querySelector('#waline textarea.wl-editor');
                if(textarea) {
                  insertText(textarea, e.target.innerText);
                  popup.classList.remove('active');
                }
              }
            });
          });
        }

        function insertText(textarea, text) {
          const start = textarea.selectionStart || 0, end = textarea.selectionEnd || 0, value = textarea.value;
          textarea.value = value.substring(0, start) + text + value.substring(end);
          textarea.selectionStart = textarea.selectionEnd = start + text.length;
          textarea.dispatchEvent(new Event('input', { bubbles: true }));
          textarea.focus();
        }

        async function handleImageUpload(file) {
          try {
            const MAX_SIZE = 1024 * 1024; 
            let fileToUpload = file.size > MAX_SIZE ? await compressImage(file, MAX_SIZE) : file;
            const formData = new FormData();
            formData.append('file', fileToUpload);

            const response = await fetch(imgbedURL, { method: 'POST', headers: { Authorization: `Bearer ${uploadToken}` }, body: formData });
            if (!response.ok) throw new Error(`Upload failed: ${response.status}`);
            return (await response.json()).url;
          } catch (error) {
            console.error('[Waline] Upload error:', error);
            alert('Upload Failed. Check console.'); throw error;
          }
        }

        function compressImage(file, maxSize) {
          return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.readAsDataURL(file);
            reader.onload = (e) => {
              const img = new Image();
              img.src = e.target.result;
              img.onload = () => {
                const canvas = document.createElement('canvas');
                let { width, height } = img;
                if (width > 1920 || height > 1920) {
                  const ratio = Math.min(1920 / width, 1920 / height);
                  width = Math.round(width * ratio); height = Math.round(height * ratio);
                }
                canvas.width = width; canvas.height = height;
                canvas.getContext('2d').drawImage(img, 0, 0, width, height);
                
                let quality = 0.8;
                const attempt = () => canvas.toBlob(blob => {
                  if(!blob) return reject(new Error('Canvas error'));
                  if(blob.size <= maxSize || quality <= 0.2) {
                    resolve(new File([blob], file.name, { type: 'image/jpeg' }));
                  } else {
                    quality -= 0.15; attempt();
                  }
                }, 'image/jpeg', quality);
                attempt();
              };
              img.onerror = () => reject(new Error('Image load failed'));
            };
            reader.onerror = () => reject(new Error('File read failed'));
          });
        }

        function initWaline() {
          const container = document.querySelector('#waline-container');
          if (!container || window.__walineInstance) return;
          container.innerHTML = '';
          const walineEl = document.createElement('div');
          walineEl.id = 'waline';
          container.appendChild(walineEl);

          try {
            window.__walineInstance = window.Waline.init({
              el: walineEl, serverURL, lang: 'en', dark: 'html.dark', emoji:[], search: false,
              imageUploader: enableImgUpload ? handleImageUpload : null, locale: { placeholder: 'Write a comment...' }
            });

            const waitTimer = setInterval(() => {
              if (document.querySelector('#waline .wl-actions button[title="表情"]')) {
                clearInterval(waitTimer); hijackEmojiButton(document.getElementById('waline')); setupMutationObserver();
              }
            }, 100);
            setTimeout(() => clearInterval(waitTimer), 5000);
          } catch (e) { console.error(e); }
        }

        function setupMutationObserver() {
          const walineRoot = document.getElementById('waline');
          if (!walineRoot) return;
          const observer = new MutationObserver((mutations) => {
            for (const mutation of mutations) {
              if (mutation.addedNodes.length > 0 && mutation.target.classList && mutation.target.classList.contains('wl-cards')) {
                hijackEmojiButton(walineRoot);
              }
            }
          });
          observer.observe(walineRoot, { childList: true, subtree: true });
          window.__walineDOMObserver = observer;
        }

        function setupObserver() {
          const container = document.querySelector('#waline-container');
          if (!container) return;
          if (window.__walineObserver) window.__walineObserver.disconnect();
          window.__walineObserver = new IntersectionObserver((entries) => {
            if (entries[0].isIntersecting) {
              const check = setInterval(() => { if (window.Waline) { clearInterval(check); initWaline(); } }, 100);
              window.__walineObserver.disconnect();
            }
          }, { rootMargin: '200px' });
          window.__walineObserver.observe(container);
        }

        setupObserver();
        document.addEventListener('astro:page-load', () => setTimeout(setupObserver, 0));
        document.addEventListener('astro:before-swap', () => {
          if (window.__walineDOMObserver) window.__walineDOMObserver.disconnect();
          if (window.__walineInstance) { try { window.__walineInstance.destroy(); } catch(e){} }
          window.__walineDOMObserver = null; window.__walineInstance = null;
        });
      </script>
    </>
  )
}