---
import { WALINE_CONFIG } from '~/config'

interface Props {
  class?: string
}
const { class: className } = Astro.props
---

<div class={`waline-wrapper ${className || ''} relative z-10 w-full`}>
  {
    WALINE_CONFIG.enableComment ? (
      <div id="waline-container" class="waline-lazy relative min-h-50 w-full">
        <div class="waline-loading absolute inset-0 flex flex-col items-center justify-center bg-transparent z-0">
          <span class="icon-[ph--spinner-gap] size-6 text-muted-foreground animate-spin mb-3" />
          <span class="text-xs font-mono text-muted-foreground/50 uppercase tracking-widest">Loading comments...</span>
        </div>
      </div>
    ) : (
      <div class="flex flex-col items-center justify-center rounded-2xl border border-border bg-card p-10 text-center shadow-soft">
        <span class="icon-[ph--chat-teardrop-slash] mb-3 block size-8 text-muted-foreground/40" />
        <p class="mb-1 font-bold text-foreground">Comments Disabled</p>
        <p class="text-[11px] font-medium tracking-[0.1em] text-muted-foreground uppercase">The comment system is currently offline.</p>
      </div>
    )
  }
</div>

{
  WALINE_CONFIG.enableComment && (
    <>
      <link rel="stylesheet" href="/css/waline.css" />
      <link rel="stylesheet" href="/css/waline-custom.css" />
      <script is:inline src="/js/waline.umd.js" defer />
      <script is:inline src="/js/waline-init.js" defer />
      <script
        is:inline
        define:vars={{
          serverURL: WALINE_CONFIG.serverURL,
          uploadToken: WALINE_CONFIG.uploadToken,
          imgbedURL: WALINE_CONFIG.imgbedURL,
          enableImgUpload: WALINE_CONFIG.enableImgUpload,
          enableCaptcha: WALINE_CONFIG.enableCaptcha,
        }}
      >
        window.__walineServerUrl = serverURL; window.__walineUploadToken = uploadToken; window.__walineImgBedUrl = imgbedURL;
        window.__walineEnableImgUpload = enableImgUpload; window.__walineEnableCaptcha = enableCaptcha;
      </script>
    </>
  )
}
