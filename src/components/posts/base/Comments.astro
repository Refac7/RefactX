---
// ~/components/posts/base/Comments.astro
import { WALINE_CONFIG } from "~/config";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class={`waline-wrapper ${className || ''} relative z-10`}>
  <!-- 头部装饰保持不变 -->
  <div class="flex items-center justify-between mb-8 text-[10px] font-mono uppercase tracking-widest text-muted-foreground/60 select-none">
    <span>// USER_FEEDBACK // DATA_STREAM</span>
    <div class="flex items-center gap-2 text-primary">
       <span class="relative flex h-1.5 w-1.5">
         <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
         <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-600"></span>
       </span>
       <span class="font-bold text-foreground">LIVE_LINK</span>
    </div>
  </div>

  <div class="mb-10 group select-none">
    <h2 class="text-3xl sm:text-4xl font-bold tracking-tighter text-foreground leading-none flex items-end">
      Comments<span class="text-primary animate-pulse">_</span>
    </h2>
    <div class="h-px w-full bg-gradient-to-r from-border via-border/50 to-transparent mt-4"></div>
  </div>

  <!-- Waline 容器 -->
  <div id="waline-container" class="waline-lazy relative min-h-[200px]">
    <div class="waline-loading absolute inset-0 flex flex-col items-center justify-center border border-dashed border-border bg-muted/5">
        <div class="mb-4 size-10 flex items-center justify-center border border-dashed border-border/60 rounded-none animate-[spin_3s_linear_infinite]">
            <span class="icon-[ph--spinner] size-5 text-muted-foreground"></span>
        </div>
        <div class="flex flex-col items-center gap-1">
          <span class="font-mono text-xs uppercase tracking-[0.2em] text-muted-foreground/80">
              Initializing_Protocol
          </span>
        </div>
    </div>
  </div>
</div>

<link rel="stylesheet" href="/css/waline.css" />

<style is:global>
  /* =========================================
     核心样式 (保持你的工业风设置)
     ========================================= */
  #waline {
    --waline-font-size: 0.95rem !important;
    --waline-line-height: 1.8 !important;
    --waline-font-family: theme('fontFamily.sans') !important;
    --waline-mono-font: theme('fontFamily.mono') !important;
    --waline-theme-color: hsl(var(--primary)) !important;
    --waline-active-color: hsl(var(--primary)) !important;
    --waline-bgcolor: hsl(var(--background)) !important;
    --waline-bgcolor-light: hsl(var(--muted) / 0.3) !important;
    --waline-bgcolor-hover: hsl(var(--muted) / 0.5) !important;
    --waline-border-color: hsl(var(--border)) !important;
    --waline-disable-bg-color: hsl(var(--muted)) !important;
    --waline-disable-color: hsl(var(--muted-foreground)) !important;
    --waline-color: hsl(var(--foreground)) !important;
    --waline-info-color: hsl(var(--muted-foreground)) !important;
    --waline-code-bg-color: hsl(var(--muted) / 0.3) !important;
    --waline-box-shadow: none !important;
    --waline-avatar-radius: 0 !important; 
    --waline-border: 1px solid var(--waline-border-color) !important;
  }

  /* 通用重置 */
  #waline * { border-radius: 0 !important; }

  /* 输入框 */
  #waline .wl-panel {
    border: 1px solid hsl(var(--border)) !important;
    background: hsl(var(--card) / 0.5) !important;
    margin: 0 !important;
    position: relative;
    transition: border-color 0.3s ease;
  }
  #waline .wl-panel:focus-within {
    border-color: hsl(var(--primary) / 0.5) !important;
    background: hsl(var(--background)) !important;
  }
  
  /* 输入框四角装饰 */
  #waline .wl-panel::before, #waline .wl-panel::after {
    content: ''; position: absolute; width: 8px; height: 8px;
    border-color: hsl(var(--primary)); border-style: solid;
    opacity: 0; transition: 0.3s; pointer-events: none; z-index: 20;
  }
  #waline .wl-panel::before { top: -1px; left: -1px; border-width: 2px 0 0 2px; }
  #waline .wl-panel::after { bottom: -1px; right: -1px; border-width: 0 2px 2px 0; }
  #waline .wl-panel:focus-within::before, #waline .wl-panel:focus-within::after { opacity: 1; }

  /* 头部输入 */
  #waline .wl-header { display: flex; border-bottom: 1px dashed hsl(var(--border)) !important; background: hsl(var(--muted) / 0.1) !important; }
  #waline .wl-header-item { flex: 1; border-right: 1px dashed hsl(var(--border)) !important; padding: 0.75rem 1rem !important; }
  #waline .wl-header-item:last-child { border-right: none !important; }
  #waline .wl-header label { font-family: var(--waline-mono-font) !important; font-size: 0.65rem !important; font-weight: 700; color: hsl(var(--muted-foreground) / 0.7) !important; }
  #waline .wl-input { font-family: var(--waline-mono-font) !important; background: transparent !important; color: hsl(var(--foreground)) !important; }

  /* 编辑器 */
  #waline .wl-editor { padding: 1rem 1.25rem !important; min-height: 10rem; color: hsl(var(--foreground)) !important; background: transparent !important; }

  /* 底部操作栏 */
  #waline .wl-footer { border-top: 1px dashed hsl(var(--border)) !important; background: hsl(var(--muted) / 0.05) !important; padding: 0.75rem 1rem !important; }

  /* 提交按钮 */
  #waline .wl-btn {
    background: hsl(var(--primary)) !important; color: hsl(var(--primary-foreground)) !important;
    border: 1px solid hsl(var(--primary)) !important; font-family: var(--waline-mono-font) !important;
    font-size: 0.7rem !important; font-weight: 800 !important; letter-spacing: 0.15em;
    padding: 0.6rem 1.5rem !important; text-transform: uppercase; margin-left: 1rem;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 10% 100%, 0 80%);
  }
  #waline .wl-btn:hover { background: hsl(var(--primary) / 0.9) !important; transform: translate(-1px, -1px); }

  /* 评论列表 */
  #waline .wl-cards { margin-top: 3rem !important; }
  #waline .wl-card { border: none !important; border-left: 1px solid hsl(var(--border) / 0.5) !important; padding: 0 0 1.5rem 1.5rem !important; margin: 0 !important; position: relative; }
  #waline .wl-card::before { content: ''; position: absolute; left: -3px; top: 1.7rem; width: 5px; height: 5px; background: hsl(var(--border)); transition: 0.3s; }
  #waline .wl-card:hover::before { background: hsl(var(--primary)); }
  #waline .wl-card:hover { border-left-color: hsl(var(--primary) / 0.3) !important; }

  /* 头像与徽章 */
  #waline .wl-head { display: flex !important; align-items: center !important; gap: 0.75rem !important; margin-bottom: 0.5rem; flex-wrap: wrap !important; }
  #waline .wl-user-avatar { width: 2.25rem !important; height: 2.25rem !important; padding: 2px !important; border: 1px solid hsl(var(--border)) !important; background: hsl(var(--muted) / 0.1) !important; position: relative !important; overflow: visible !important; margin: 0 !important; }
  #waline .wl-user-avatar > img:first-child { width: 100% !important; height: 100% !important; object-fit: cover !important; }
  #waline .wl-user-avatar > img:not(:first-child), #waline .wl-user-avatar .wl-icon { width: 14px !important; height: 14px !important; position: absolute !important; bottom: -4px !important; right: -4px !important; background: hsl(var(--background)) !important; border: 1px solid hsl(var(--primary)) !important; padding: 1px !important; z-index: 10 !important; }
  #waline .wl-nick { font-size: 0.9rem !important; font-weight: 700 !important; color: hsl(var(--foreground)) !important; margin: 0 !important; }
  #waline .wl-badge { border: 1px solid hsl(var(--primary)) !important; color: hsl(var(--primary)) !important; background: transparent !important; font-size: 0.6rem !important; padding: 1px 5px !important; margin: 0 !important; display: inline-flex !important; align-items: center; }

  /* 内容与引用 */
  #waline .wl-content { font-size: 0.95rem !important; color: hsl(var(--foreground) / 0.9) !important; line-height: 1.75 !important; word-break: break-all; }
  #waline .wl-quote { border-left: 2px solid hsl(var(--primary) / 0.5) !important; background: hsl(var(--muted) / 0.1) !important; color: hsl(var(--muted-foreground)) !important; font-family: var(--waline-mono-font) !important; padding: 0.5rem 1rem !important; }

  /* Meta 与 按钮 */
  #waline .wl-meta { display: flex !important; align-items: center !important; border-top: 1px dashed hsl(var(--border) / 0.4) !important; padding-top: 0.75rem !important; margin-top: 0.5rem !important; flex-wrap: wrap !important; gap: 0.25rem !important; }
  #waline .wl-meta > span:not(.wl-actions) { font-family: var(--waline-mono-font) !important; font-size: 0.65rem !important; color: hsl(var(--muted-foreground) / 0.8) !important; background: hsl(var(--muted) / 0.3) !important; padding: 2px 6px !important; margin-right: 4px !important; border: none !important; }
  
  /* 操作区 */
  #waline .wl-actions { display: flex !important; align-items: center !important; gap: 1rem !important; margin-left: auto !important; position: relative; } /* position relative 为面板定位做准备 */
  
  /* 通用 Action 按钮样式 (原生和被我们劫持的) */
  #waline .wl-action, 
  #waline .wl-reply, 
  #waline .wl-like, 
  #waline .wl-edit {
    display: inline-flex !important; /* 强制显示 */
    align-items: center !important;
    gap: 0.4rem !important;
    font-family: var(--waline-mono-font) !important;
    font-size: 0.8rem !important; 
    color: hsl(var(--muted-foreground)) !important;
    background: transparent !important;
    border: none !important;
    padding: 0 !important;
    margin: 0 !important;
    text-transform: uppercase;
    font-weight: 600;
    transition: all 0.2s;
    float: none !important;
    line-height: 1 !important;
    visibility: visible !important; /* 防止被隐藏 */
  }

  /* 劫持的按钮也要确保图标大小一致 */
  #waline .wl-action svg,
  #waline .wl-reply svg, 
  #waline .wl-like svg {
    width: 16px !important;
    height: 16px !important;
  }

  #waline .wl-action:hover, 
  #waline .wl-reply:hover, 
  #waline .wl-like:hover {
    color: hsl(var(--primary)) !important;
    transform: translateY(-1px);
  }

  #waline .wl-like.active { color: hsl(var(--primary)) !important; }
  
  /* 隐藏不需要的 GIF/Power */
  .wl-gif-tab, .wl-power { display: none !important; }

  /* =========================================
     颜文字面板样式
     ========================================= */
  #kaomoji-popup {
    display: none;
    position: absolute;
    bottom: 100%;
    right: 0; /* 对齐右侧 */
    z-index: 100;
    width: 320px;
    max-width: 80vw;
    background: hsl(var(--background));
    border: 1px solid hsl(var(--primary));
    box-shadow: 4px 4px 0 0 hsl(var(--muted-foreground) / 0.1);
    margin-bottom: 10px;
    user-select: none;
    animation: slide-up 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  #kaomoji-popup.active { display: flex; flex-direction: column; }
  
  @keyframes slide-up {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .kaomoji-header {
    background: hsl(var(--muted) / 0.2);
    border-bottom: 1px dashed hsl(var(--border));
    padding: 6px 10px;
    font-family: var(--waline-mono-font);
    font-size: 10px;
    color: hsl(var(--muted-foreground));
    letter-spacing: 1px;
    display: flex;
    justify-content: space-between;
  }

  .kaomoji-grid {
    padding: 8px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(70px, 1fr));
    gap: 4px;
    max-height: 200px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: hsl(var(--primary) / 0.3) transparent;
  }
  
  .kaomoji-item {
    font-family: sans-serif;
    font-size: 12px;
    color: hsl(var(--foreground));
    padding: 6px 2px;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .kaomoji-item:hover {
    background: hsl(var(--muted) / 0.3);
    border-color: hsl(var(--primary) / 0.4);
    color: hsl(var(--primary));
  }

  @media (max-width: 640px) {
    #waline .wl-header { flex-direction: column; }
    #waline .wl-header-item { border-right: none !important; border-bottom: 1px dashed hsl(var(--border)) !important; }
    #waline .wl-card { padding-left: 1rem !important; }
    #kaomoji-popup { width: 260px; }
  }
</style>

<script is:inline src="/js/waline.umd.js" defer></script>
<script is:inline define:vars={{ serverURL: WALINE_CONFIG.serverURL, uploadToken: WALINE_CONFIG.uploadToken }}>
  const KAOMOJI_LIST = [
    "(¬_¬)", "(='X'=)", "( ಠ_ಠ)", "(>_<)", 
    "(*^▽^*)", "(￣▽￣)\"", "(o_o)", "(O_O)", 
    "(ToT)", "(>_>)", "(<_<)", "( ° ▽、° )",
    "╮(╯_╰)╭", "_(:з」∠)_", "(°ー°〃)", "( ఠ ͟ʖ ఠ)",
    "(｡•ˇ‸ˇ•｡)", "( •̀ ω •́ )y", "(ง •_•)ง", "(*/ω＼*)",
    "w(ﾟДﾟ)w", "∑( 口 ||", "(´･ω･`)", "Wait..."
  ];

  // === 核心逻辑：劫持原生按钮 ===
  function hijackEmojiButton() {
    const actionsContainer = document.querySelector('#waline .wl-actions');
    if (!actionsContainer) return;
    
    // 1. 寻找原生表情按钮 (通过 title 属性查找)
    // Waline 默认中文 title 为 "表情"
    const originalBtn = actionsContainer.querySelector('button[title="表情"]');
    
    // 如果找不到，或者已经被劫持过(包含我们自定义的 class)，则退出
    if (!originalBtn || originalBtn.classList.contains('hijacked-emoji')) return;

    // 2. 克隆按钮
    // cloneNode(true) 会复制节点但【不会】复制原生绑定的 EventListeners
    // 这就是我们去除 Waline 原生表情面板事件的关键
    const clonedBtn = originalBtn.cloneNode(true);
    
    // 3. 标记并确保显示
    clonedBtn.classList.add('hijacked-emoji');
    clonedBtn.style.display = 'inline-flex'; // 强制去除 style="display:none"
    
    // 4. 创建颜文字面板
    const popup = document.createElement('div');
    popup.id = 'kaomoji-popup';
    popup.innerHTML = `
      <div class="kaomoji-header">
        <span>// TEXT_EMOTION_PACK</span>
        <span style="opacity:0.5">V1.0</span>
      </div>
      <div class="kaomoji-grid">
        ${KAOMOJI_LIST.map(k => `<div class="kaomoji-item">${k}</div>`).join('')}
      </div>
    `;

    // 5. 替换 DOM
    originalBtn.parentNode.replaceChild(clonedBtn, originalBtn);
    // 将面板插入到 actions 容器中
    actionsContainer.appendChild(popup);

    // 6. 绑定新事件
    clonedBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      popup.classList.toggle('active');
    });

    popup.addEventListener('click', (e) => {
      if (e.target.classList.contains('kaomoji-item')) {
        insertText(e.target.innerText);
        popup.classList.remove('active');
      }
    });

    document.addEventListener('click', (e) => {
      if (!popup.contains(e.target) && !clonedBtn.contains(e.target)) {
        popup.classList.remove('active');
      }
    });
  }

  function insertText(text) {
    const textarea = document.querySelector('#waline textarea');
    if (!textarea) return;
    const start = textarea.selectionStart;
    const end = textarea.selectionEnd;
    const value = textarea.value;
    textarea.value = value.substring(0, start) + text + value.substring(end);
    textarea.selectionStart = textarea.selectionEnd = start + text.length;
    textarea.focus();
    textarea.dispatchEvent(new Event('input', { bubbles: true }));
  }

 // === 4. 图片上传处理 ===
  async function handleImageUpload(file) {
    try {
      const MAX_SIZE = 1024 * 1024; // 1MB
      let fileToUpload = file;
      if (file.size > MAX_SIZE) {
        fileToUpload = await compressImage(file, MAX_SIZE);
      }
      const formData = new FormData();
      formData.append('file', fileToUpload);
      
      const response = await fetch('https://img.refact.cc/upload', {
        method: 'POST',
        headers: { Authorization: `Bearer ${uploadToken}` },
        body: formData,
      });
      
      if (!response.ok) throw new Error(`Upload failed: ${response.status}`);
      const data = await response.json();
      return data.url;
    } catch (error) {
      console.error('[Waline] Upload error:', error);
      alert('UPLOAD_FAILED: Check console.');
      throw error;
    }
  }

  function compressImage(file, maxSize) {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.readAsDataURL(file);
      reader.onload = (e) => {
        const img = new Image();
        img.src = e.target.result;
        img.onload = () => {
          const canvas = document.createElement('canvas');
          let { width, height } = img;
          const maxDim = 1920;
          if (width > maxDim || height > maxDim) {
             const ratio = Math.min(maxDim / width, maxDim / height);
             width = Math.round(width * ratio);
             height = Math.round(height * ratio);
          }
          canvas.width = width;
          canvas.height = height;
          const ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0, width, height);
          
          let quality = 0.8;
          const attempt = () => {
            canvas.toBlob(blob => {
              if(!blob) return reject(new Error('Canvas error'));
              if(blob.size <= maxSize || quality < 0.2) {
                resolve(new File([blob], file.name, { type: 'image/jpeg' }));
              } else {
                quality -= 0.1;
                attempt();
              }
            }, 'image/jpeg', quality);
          };
          attempt();
        };
        img.onerror = () => reject(new Error('Image load failed'));
      };
      reader.onerror = () => reject(new Error('File read failed'));
    });
  }

  function initWaline() {
    const container = document.querySelector('#waline-container');
    if (!container || window.__walineInstance) return;

    container.innerHTML = '';
    const walineEl = document.createElement('div');
    walineEl.id = 'waline';
    container.appendChild(walineEl);

    try {
      window.__walineInstance = window.Waline.init({
        el: walineEl,
        serverURL: serverURL,
        lang: 'zh-CN',
        dark: 'html.dark',
        // 【关键】必须设为空数组，不能是 false。
        // false 会直接把 DOM 移除，空数组会保留 DOM 但内容为空，方便我们劫持
        emoji: [], 
        search: false,
        imageUploader: handleImageUpload,
        locale: { placeholder: 'INPUT_STREAM_READY...' }
      });

      // 轮询等待 DOM 生成，然后执行劫持
      const waitTimer = setInterval(() => {
        if (document.querySelector('#waline .wl-actions button[title="表情"]')) {
          clearInterval(waitTimer);
          hijackEmojiButton();
        }
      }, 100);
      setTimeout(() => clearInterval(waitTimer), 5000);

    } catch (e) { console.error(e); }
  }

  function setupObserver() {
    const container = document.querySelector('#waline-container');
    if (!container) return;
    if (window.__walineObserver) window.__walineObserver.disconnect();
    window.__walineObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
            if(window.Waline) initWaline();
            else {
                const check = setInterval(() => { if(window.Waline) { clearInterval(check); initWaline(); } }, 100);
            }
            window.__walineObserver.disconnect();
        }
      });
    }, { rootMargin: '200px' });
    window.__walineObserver.observe(container);
  }

  setupObserver();
  document.addEventListener('astro:page-load', () => setTimeout(setupObserver, 0));
  document.addEventListener('astro:before-swap', () => {
    if (window.__walineInstance) { try { window.__walineInstance.destroy(); } catch(e){} window.__walineInstance = null; }
  });
</script>