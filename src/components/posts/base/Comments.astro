---
import { WALINE_CONFIG } from "~/config";
import Waline from '~/components/ui/Waline';

interface Props { class?: string; }
const { class: className } = Astro.props;
---
<div class={`waline-wrapper ${className || ''} relative z-10 w-full`}>
  <div class="mb-10 flex flex-col gap-1.5 select-none">
    <h2 class="text-2xl font-bold tracking-tight text-foreground">
      Comments
    </h2>
    <p class="text-sm text-muted-foreground">Join the conversation below.</p>
  </div>

  {
    WALINE_CONFIG.enableComment ? (
      <div class="relative min-h-[200px] w-full">
        <!-- 核心！利用 client:visible 懒加载统一的 React 组件 -->
        <Waline path={Astro.url.pathname} client:visible />
      </div>
    ) : (
      <div class="rounded-xl border border-border/40 bg-muted/10 p-10 text-center flex flex-col items-center justify-center">
        <span class="icon-[ph--chat-teardrop-slash] size-8 text-muted-foreground/40 mb-3 block mx-auto"></span>
        <p class="text-foreground font-medium mb-1">Comments Disabled</p>
        <p class="text-muted-foreground text-sm">The comment system is currently offline.</p>
      </div>
    )
  }
</div>