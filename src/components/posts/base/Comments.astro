---
import { WALINE_CONFIG } from "~/config";
---

{WALINE_CONFIG.enableComment && (
  <>
    <div id="waline-container" class="waline-lazy">
      <div class="waline-loading">加载评论中...</div>
    </div>

    <link
      rel="stylesheet"
      href="/css/waline.css"
    />

    <style is:global>
      #waline-container {
        width: 100%;
      }

      .waline-lazy {
        min-height: 200px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-muted-foreground);
      }

      .waline-lazy:has(#waline) {
        display: block;
        min-height: unset;
      }

      #waline .wl-editor,
      #waline .wl-input,
      #waline span.wl-badge,
      #waline .wl-btn,
      #waline .wl-comment,
      #waline .wl-card,
      #waline .wl-panel,
      #waline .wl-header,
      #waline .wl-gif-popup,
      #waline .wl-emoji-popup,
      #waline .wl-footer {
        border-radius: 0 !important;
        font-family: 'ShangguSansSC Variable', system-ui, -apple-system, sans-serif !important;
      }

      .wl-gif-tab {
        display: none !important;
      }

      .wl-content,
      .wl-content * {
        white-space: normal !important;
        word-break: break-word !important;
        overflow-wrap: anywhere !important;
      }

      /* 浅色模式 */
      #waline {
        --waline-theme-color: #000000 !important;
        --waline-active-color: #dc2626 !important;
        --waline-font-size: 1rem !important;
        --waline-font-family: 'Onest Variable', 'Geist Variable', 'ShangguSansSC Variable', system-ui, -apple-system, sans-serif !important;
        --waline-border-color: #F0F1F5 !important;
      }

      /* 为输入框和评论卡片设置边框颜色 */
      #waline .wl-editor,
      #waline .wl-input,
      #waline .wl-card,
      #waline .wl-panel {
        border-color: var(--waline-border-color) !important;
      }

      /* 深色模式 */
      html.dark #waline {
        --waline-theme-color: #ffffff !important;
        --waline-active-color: #dc2626 !important;
        --waline-border-color: #18181B !important;
      }

      html.dark #waline .wl-panel {
        --waline-bgcolor: #09090B !important;
        background-color: #09090B !important;
      }

      /* 禁用输入框聚焦样式 */
      #waline .wl-editor:focus,
      #waline .wl-editor:focus-within,
      #waline .wl-input:focus {
        background-color: var(--waline-bgcolor) !important;
        box-shadow: none !important;
        outline: none !important;
        border-color: var(--waline-border-color) !important;
      }
    </style>

    <script src="/js/waline.umd.js" defer></script>
    <script define:vars={{ serverURL: WALINE_CONFIG.serverURL }}>
      // 使用 Intersection Observer 实现延迟加载
      function initWalineLazyLoad() {
        const container = document.querySelector('#waline-container');
        if (!container) return;

        // 检查是否已经初始化过这个容器
        if (container.hasAttribute('data-waline-init')) {
          return;
        }
        container.setAttribute('data-waline-init', 'true');

        // 重置页面切换时的加载状态
        window.__walineLoaded = false;
        
        let observer = null;
        
        // 设置交叉观察器，当评论区滚入视口时加载
        const setupObserver = () => {
          observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting && !window.__walineLoaded) {
                  window.__walineLoaded = true;
                  observer.disconnect();
                  
                  // 直接加载 Waline，不延迟
                  loadWaline();
                }
              }
            },
            { rootMargin: '300px' } // 提前加载，提高响应速度
          );
          
          observer.observe(container);
        };

        // 如果 Waline 还没加载，等待它加载
        if (!window.Waline) {
          const checkWaline = setInterval(() => {
            if (window.Waline) {
              clearInterval(checkWaline);
              setupObserver();
            }
          }, 50);
          
          // 设置超时，防止无限等待
          setTimeout(() => {
            clearInterval(checkWaline);
            if (window.Waline) {
              setupObserver();
            }
          }, 5000);
        } else {
          setupObserver();
        }
      }

      function loadWaline() {
        const container = document.querySelector('#waline-container');
        if (!container || !window.Waline) return;

        // 完全清空旧实例 - 不尝试调用 destroy，直接清空并重建
        // 这避免了 Waline destroy 过程中的 DOM 操作错误
        container.innerHTML = '';
        
        // 创建新的 Waline 容器
        const walineDiv = document.createElement('div');
        walineDiv.id = 'waline';
        container.appendChild(walineDiv);
        
        // 丢弃旧实例引用，让垃圾回收处理
        window.__walineInstance = null;

        // 初始化新实例
        try {
          window.__walineInstance = window.Waline.init({
            el: walineDiv,
            serverURL: serverURL,
            path: location.pathname.replace(/\/$/, ''),
            lang: 'zh-CN',
            pageview: true,
            dark: 'html.dark',
            requiredMeta: ['nick', 'mail'],
            locale: { placeholder: '写点什么吧…' },
            emoji: [],
            imageUploader: async (file) => {
              const formData = new FormData();
              formData.append('file', file);
              
              try {
                const response = await fetch('https://img.refact.cc/upload', {
                  method: 'POST',
                  body: formData,
                });
                
                if (!response.ok) throw new Error('上传失败');
                
                const data = await response.json();
                return data.url;
              } catch (error) {
                console.error('图片上传失败:', error);
                throw error;
              }
            },
            search: false,
            upload: false,
          });
        } catch (error) {
          console.error('Waline 初始化失败:', error);
        }
      }

      // 页面加载完成后初始化
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initWalineLazyLoad);
      } else {
        initWalineLazyLoad();
      }
      
      // 支持 astro 页面切换 - 重置状态以允许重新初始化
      document.addEventListener('astro:page-load', () => {
        const container = document.querySelector('#waline-container');
        if (container) {
          container.removeAttribute('data-waline-init');
          // 重置加载状态
          window.__walineLoaded = false;
          // 重新恢复加载提示
          container.innerHTML = '<div class="waline-loading">加载评论中...</div>';
        }
        initWalineLazyLoad();
      });
    </script>
  </>
)}

