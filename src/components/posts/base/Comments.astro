---
import { WALINE_CONFIG } from "~/config";
---

{WALINE_CONFIG.enableComment && (
  <>
    <div id="waline-container" class="waline-lazy">
      <div class="waline-loading">加载评论中...</div>
    </div>

    <link
      rel="stylesheet"
      href="/css/waline.css"
    />

    <style is:global>
      #waline-container {
        width: 100%;
      }

      .waline-lazy {
        min-height: 200px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-muted-foreground);
      }

      .waline-lazy:has(#waline) {
        display: block;
        min-height: unset;
      }

      #waline .wl-editor,
      #waline .wl-input,
      #waline span.wl-badge,
      #waline .wl-btn,
      #waline .wl-comment,
      #waline .wl-card,
      #waline .wl-panel,
      #waline .wl-header,
      #waline .wl-gif-popup,
      #waline .wl-emoji-popup,
      #waline .wl-footer {
        border-radius: 0 !important;
        font-family: 'ShangguSansSC Variable', system-ui, -apple-system, sans-serif !important;
      }

      .wl-gif-tab {
        display: none !important;
      }

      .wl-content,
      .wl-content * {
        white-space: normal !important;
        word-break: break-word !important;
        overflow-wrap: anywhere !important;
      }

      /* 浅色模式 */
      #waline {
        --waline-theme-color: #000000 !important;
        --waline-active-color: #dc2626 !important;
        --waline-font-size: 1rem !important;
        --waline-font-family: 'Onest Variable', 'Geist Variable', 'ShangguSansSC Variable', system-ui, -apple-system, sans-serif !important;
        --waline-border-color: #F0F1F5 !important;
      }

      /* 为输入框和评论卡片设置边框颜色 */
      #waline .wl-editor,
      #waline .wl-input,
      #waline .wl-card,
      #waline .wl-panel {
        border-color: var(--waline-border-color) !important;
      }

      /* 深色模式 */
      html.dark #waline {
        --waline-theme-color: #ffffff !important;
        --waline-active-color: #dc2626 !important;
        --waline-border-color: #18181B !important;
      }

      html.dark #waline .wl-panel {
        --waline-bgcolor: #09090B !important;
        background-color: #09090B !important;
      }

      /* 禁用输入框聚焦样式 */
      #waline .wl-editor:focus,
      #waline .wl-editor:focus-within,
      #waline .wl-input:focus {
        background-color: var(--waline-bgcolor) !important;
        box-shadow: none !important;
        outline: none !important;
        border-color: var(--waline-border-color) !important;
      }
    </style>

    <script is:inline src="/js/waline.umd.js" defer></script>
    <script is:inline define:vars={{ serverURL: WALINE_CONFIG.serverURL, uploadToken: WALINE_CONFIG.uploadToken }}>
      // 使用 Intersection Observer 实现延迟加载
      function initWalineLazyLoad() {
        const container = document.querySelector('#waline-container');
        if (!container) return;

        // 检查是否已经初始化过这个容器
        if (container.hasAttribute('data-waline-init')) {
          return;
        }
        container.setAttribute('data-waline-init', 'true');

        // 重置页面切换时的加载状态
        window.__walineLoaded = false;
        
        let observer = null;
        
        // 设置交叉观察器，当评论区滚入视口时加载
        const setupObserver = () => {
          observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting && !window.__walineLoaded) {
                  window.__walineLoaded = true;
                  observer.disconnect();
                  
                  // 直接加载 Waline，不延迟
                  loadWaline();
                }
              }
            },
            { rootMargin: '300px' } // 提前加载，提高响应速度
          );
          
          observer.observe(container);
        };

        // 如果 Waline 还没加载，等待它加载
        if (!window.Waline) {
          const checkWaline = setInterval(() => {
            if (window.Waline) {
              clearInterval(checkWaline);
              setupObserver();
            }
          }, 50);
          
          // 设置超时，防止无限等待
          setTimeout(() => {
            clearInterval(checkWaline);
            if (window.Waline) {
              setupObserver();
            }
          }, 5000);
        } else {
          setupObserver();
        }
      }

      // 压缩图片的辅助函数
      async function compressImage(file, maxSize = 1024 * 1024) {
        return new Promise((resolve, reject) => {
          // 检查文件大小是否超过限制
          if (file.size <= maxSize) {
            resolve(file);
            return;
          }

          const reader = new FileReader();
          reader.readAsDataURL(file);
          
          reader.onload = (event) => {
            const img = new Image();
            img.src = event.target.result;
            
            img.onload = () => {
              const canvas = document.createElement('canvas');
              let width = img.width;
              let height = img.height;
              
              // 计算最大尺寸（如果图片太大）
              const maxDimension = 1920;
              if (width > maxDimension || height > maxDimension) {
                const ratio = Math.min(maxDimension / width, maxDimension / height);
                width = Math.round(width * ratio);
                height = Math.round(height * ratio);
              }
              
              canvas.width = width;
              canvas.height = height;
              
              const ctx = canvas.getContext('2d');
              ctx.fillStyle = '#fff';
              ctx.fillRect(0, 0, width, height);
              ctx.drawImage(img, 0, 0, width, height);
              
              // 按质量压缩
              let quality = 0.8;
              const tryCompress = () => {
                canvas.toBlob(
                  (blob) => {
                    if (blob.size <= maxSize || quality <= 0.1) {
                      // 生成新的 File 对象
                      const compressedFile = new File([blob], file.name, {
                        type: 'image/jpeg',
                        lastModified: Date.now(),
                      });
                      resolve(compressedFile);
                    } else {
                      quality -= 0.1;
                      tryCompress();
                    }
                  },
                  'image/jpeg',
                  quality
                );
              };
              
              tryCompress();
            };
            
            img.onerror = () => {
              reject(new Error('图片加载失败'));
            };
          };
          
          reader.onerror = () => {
            reject(new Error('文件读取失败'));
          };
        });
      }

      function loadWaline() {
        const container = document.querySelector('#waline-container');
        if (!container || !window.Waline) return;

        // 销毁旧实例
        destroyWaline();

        // 完全清空旧实例
        container.innerHTML = '';
        
        // 创建新的 Waline 容器
        const walineDiv = document.createElement('div');
        walineDiv.id = 'waline';
        container.appendChild(walineDiv);

        // 初始化新实例
        try {
          window.__walineInstance = window.Waline.init({
            el: walineDiv,
            serverURL: serverURL,
            path: location.pathname.replace(/\/$/, ''),
            lang: 'zh-CN',
            pageview: true,
            dark: 'html.dark',
            requiredMeta: ['nick', 'mail'],
            locale: { placeholder: 'Successfully established a secure connection and ready to send...' },
            emoji: [],
            imageUploader: async (file) => {
              try {
                // 压缩图片到 1MB 以内
                const compressedFile = await compressImage(file, 1024 * 1024);
                console.log(`原始大小: ${(file.size / 1024).toFixed(2)}KB, 压缩后: ${(compressedFile.size / 1024).toFixed(2)}KB`);
                
                const formData = new FormData();
                formData.append('file', compressedFile);
                
                const response = await fetch('https://img.refact.cc/upload', {
                  method: 'POST',
                  headers: {
                    // 关键：带上和 Worker 对应的 Token
                    Authorization: `Bearer ${uploadToken}`,
                  },
                  body: formData,
                });
                
                if (!response.ok) throw new Error('上传失败');
                
                const data = await response.json();
                return data.url;
              } catch (error) {
                console.error('图片上传失败:', error);
                throw error;
              }
            },
            search: false,
            upload: false,
          });
        } catch (error) {
          console.error('Waline 初始化失败:', error);
        }
      }

      // 销毁 Waline 实例的辅助函数
      function destroyWaline() {
        const walineEl = document.querySelector('#waline');
        if (walineEl && window.__walineInstance) {
          try {
            // 尝试调用销毁方法（如果存在）
            if (typeof window.__walineInstance.destroy === 'function') {
              window.__walineInstance.destroy();
            }
          } catch (e) {
            console.warn('Waline destroy 方法出错:', e);
          }
        }
        window.__walineInstance = null;
      }

      // 页面加载完成后初始化
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initWalineLazyLoad);
      } else {
        initWalineLazyLoad();
      }
      
      // 支持 astro 页面切换 - 重置状态以允许重新初始化
      document.addEventListener('astro:page-load', () => {
        const container = document.querySelector('#waline-container');
        if (container) {
          // 先销毁旧实例
          destroyWaline();
          
          // 等待一帧后再重置，确保 DOM 清理完毕
          requestAnimationFrame(() => {
            container.removeAttribute('data-waline-init');
            window.__walineLoaded = false;
            container.innerHTML = '<div class="waline-loading">加载评论中...</div>';
            initWalineLazyLoad();
          });
        }
      });
      
      // 页面卸载时清理实例，防止内存泄漏
      document.addEventListener('astro:before-swap', () => {
        destroyWaline();
      });
    </script>
  </>
)}

