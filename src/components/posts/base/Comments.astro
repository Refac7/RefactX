---
// ~/components/posts/base/Comments.astro
import { WALINE_CONFIG } from "~/config";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class={`waline-wrapper ${className || ''} relative z-10`}>
  
  <div class="flex items-center justify-between mb-8 text-[10px] font-mono uppercase tracking-widest text-muted-foreground/60 select-none">
    <span>// USER_FEEDBACK // DATA_STREAM</span>
    <div class="flex items-center gap-2 text-primary">
       <span class="relative flex h-1.5 w-1.5">
         <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
         <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-600"></span>
       </span>
       <span class="font-bold text-foreground">LIVE_LINK</span>
    </div>
  </div>

  <div class="mb-10 group select-none">
    <h2 class="text-3xl sm:text-4xl font-bold tracking-tighter text-foreground leading-none flex items-end">
      Comments<span class="text-primary animate-pulse">_</span>
    </h2>
    <div class="h-px w-full bg-gradient-to-r from-border via-border/50 to-transparent mt-4"></div>
  </div>

  {
    WALINE_CONFIG.enableComment ? (
      <div id="waline-container" class="waline-lazy relative min-h-[200px]">
        <div class="waline-loading absolute inset-0 flex flex-col items-center justify-center border border-dashed border-border bg-muted/5 z-0">
            <div class="mb-4 size-10 flex items-center justify-center border border-dashed border-border/60 rounded-none animate-[spin_3s_linear_infinite]">
                <span class="icon-[ph--spinner] size-5 text-muted-foreground"></span>
            </div>
            <div class="flex flex-col items-center gap-1">
              <span class="font-mono text-xs uppercase tracking-[0.2em] text-muted-foreground/80">
                  Initializing
              </span>
            </div>
        </div>
      </div>
    ) : (
      <div class="border border-dashed border-border bg-muted/10 p-8 text-center">
        <div class="mb-4 size-16 mx-auto flex items-center justify-center border border-dashed border-border/60 rounded-none">
          <span class="icon-[ph--chat] size-8 text-muted-foreground"></span>
        </div>
        <div class="flex flex-col items-center gap-2">
          <span class="font-mono text-sm uppercase tracking-[0.2em] text-muted-foreground/80">
            // COMMENT_SYS IS DISABLED
          </span>
          <p class="text-muted-foreground/70 text-sm max-w-md">
            评论系统当前已禁用。如有需要，请联系管理员。
          </p>
        </div>
      </div>
    )
  }
</div>

{
  WALINE_CONFIG.enableComment && (
    <>
      <link rel="stylesheet" href="/css/waline.css" />

      <style is:global>
        /* =========================================
           Waline 核心样式重置 (工业风)
           ========================================= */
        #waline {
          --waline-font-size: 0.95rem !important;
          --waline-line-height: 1.8 !important;
          --waline-font-family: theme('fontFamily.sans') !important;
          --waline-mono-font: theme('fontFamily.mono') !important;
          --waline-theme-color: hsl(var(--primary)) !important;
          --waline-active-color: hsl(var(--primary)) !important;
          --waline-bgcolor: hsl(var(--background)) !important;
          --waline-bgcolor-light: hsl(var(--muted) / 0.3) !important;
          --waline-bgcolor-hover: hsl(var(--muted) / 0.5) !important;
          --waline-border-color: hsl(var(--border)) !important;
          --waline-disable-bg-color: hsl(var(--muted)) !important;
          --waline-disable-color: hsl(var(--muted-foreground)) !important;
          --waline-color: hsl(var(--foreground)) !important;
          --waline-info-color: hsl(var(--muted-foreground)) !important;
          --waline-code-bg-color: hsl(var(--muted) / 0.3) !important;
          --waline-box-shadow: none !important;
          --waline-avatar-radius: 0 !important; 
          --waline-border: 1px solid var(--waline-border-color) !important;
        }

        #waline * { border-radius: 0 !important; }

        /* 输入框防放大 */
        @media (max-width: 640px) {
          #waline input, #waline textarea { font-size: 16px !important; }
        }

        /* 输入面板 */
        #waline .wl-panel {
          border: 1px solid hsl(var(--border)) !important;
          background: hsl(var(--card) / 0.5) !important;
          margin: 0 !important;
          position: relative;
          transition: border-color 0.3s ease;
        }
        #waline .wl-panel:focus-within {
          border-color: hsl(var(--primary) / 0.5) !important;
          background: hsl(var(--background)) !important;
        }
        
        /* 面板装饰角 */
        #waline .wl-panel::before, #waline .wl-panel::after {
          content: ''; position: absolute; width: 8px; height: 8px;
          border-color: hsl(var(--primary)); border-style: solid;
          opacity: 0; transition: 0.3s; pointer-events: none; z-index: 20;
        }
        #waline .wl-panel::before { top: -1px; left: -1px; border-width: 2px 0 0 2px; }
        #waline .wl-panel::after { bottom: -1px; right: -1px; border-width: 0 2px 2px 0; }
        #waline .wl-panel:focus-within::before, #waline .wl-panel:focus-within::after { opacity: 1; }

        /* 头部输入区 */
        #waline .wl-header { display: flex; border-bottom: 1px dashed hsl(var(--border)) !important; background: hsl(var(--muted) / 0.1) !important; }
        #waline .wl-header-item { 
          flex: 1; 
          border-right: 1px dashed hsl(var(--border)) !important; 
          padding: 0.75rem 1rem !important; 
          display: flex !important; align-items: center !important;
        }
        #waline .wl-header-item:last-child { border-right: none !important; }
        #waline .wl-header label { font-family: var(--waline-mono-font) !important; font-size: 0.65rem !important; font-weight: 700; color: hsl(var(--muted-foreground) / 0.7) !important; margin-right: 0.5rem !important; }
        #waline .wl-input { font-family: var(--waline-mono-font) !important; background: transparent !important; color: hsl(var(--foreground)) !important; height: auto !important; }

        /* 编辑器 */
        #waline .wl-editor { padding: 1rem 1.25rem !important; min-height: 8rem; color: hsl(var(--foreground)) !important; background: transparent !important; resize: vertical; }

        /* 底部栏 */
        #waline .wl-footer { border-top: 1px dashed hsl(var(--border)) !important; background: hsl(var(--muted) / 0.05) !important; padding: 0.5rem 1rem !important; position: relative; }

        /* 提交按钮 */
        #waline .wl-btn {
          background: hsl(var(--primary)) !important; color: hsl(var(--primary-foreground)) !important;
          border: 1px solid hsl(var(--primary)) !important; font-family: var(--waline-mono-font) !important;
          font-size: 0.7rem !important; font-weight: 800 !important; letter-spacing: 0.15em;
          padding: 0.6rem 1.5rem !important; text-transform: uppercase; margin-left: 1rem; margin-right: -0.5rem;
        }
        #waline .wl-btn:hover { background: hsl(var(--primary) / 0.9) !important; transform: translate(-1px, -1px); }

        /* 评论列表 (PC默认) */
        #waline .wl-cards { margin-top: 3rem !important; margin-left: -0.5rem !important; margin-right: -0.5rem !important; }
        #waline .wl-card { border: none !important; border-left: 1px solid hsl(var(--border) / 0.5) !important; padding: 0 0 1.5rem 1.5rem !important; margin: 0 !important; position: relative; overflow: visible !important; }
        #waline .wl-card::before { content: ''; position: absolute; left: -3px; top: 1.7rem; width: 5px; height: 5px; background: hsl(var(--border)); transition: 0.3s; }
        #waline .wl-card:hover::before { background: hsl(var(--primary)); }
        #waline .wl-card:hover { border-left-color: hsl(var(--primary) / 0.3) !important; }

        /* 用户信息 */
        #waline .wl-head { display: flex !important; align-items: center !important; gap: 0.75rem !important; margin-bottom: 0.5rem; flex-wrap: wrap !important; }
        #waline .wl-user-avatar { 
          width: 2.25rem !important; height: 2.25rem !important; padding: 2px !important; 
          border: 1px solid hsl(var(--border)) !important; background: hsl(var(--muted) / 0.1) !important; 
          position: relative !important; overflow: visible !important; margin: 0 !important;
          display: flex !important; align-items: center !important; justify-content: center !important;
        }
        #waline .wl-user-avatar > img:first-child { width: 100% !important; height: 100% !important; object-fit: cover !important; display: block !important; }
        #waline .wl-user-avatar > img:not(:first-child), #waline .wl-user-avatar .wl-icon { width: 14px !important; height: 14px !important; position: absolute !important; bottom: -4px !important; right: -4px !important; background: hsl(var(--background)) !important; border: 1px solid hsl(var(--primary)) !important; padding: 1px !important; z-index: 10 !important; }
        #waline .wl-nick { font-size: 0.9rem !important; font-weight: 700 !important; color: hsl(var(--foreground)) !important; margin: 0 !important; }
        #waline .wl-badge { border: 1px solid hsl(var(--primary)) !important; color: hsl(var(--primary)) !important; background: transparent !important; font-size: 0.6rem !important; padding: 1px 5px !important; margin: 0 !important; display: inline-flex !important; align-items: center; }

        /* 内容与引用 */
        #waline .wl-content { font-size: 0.95rem !important; color: hsl(var(--foreground) / 0.9) !important; line-height: 1.75 !important; word-break: break-all; }
        #waline .wl-quote { border-left: 2px solid hsl(var(--primary) / 0.5) !important; background: hsl(var(--muted) / 0.1) !important; color: hsl(var(--muted-foreground)) !important; font-family: var(--waline-mono-font) !important; padding: 0.5rem 1rem !important; margin-bottom: 0.5rem !important; }
        #waline .wl-quote:empty { display: none !important; }

        /* 动作栏 */
        #waline .wl-meta { display: flex !important; align-items: center !important; border-top: 1px dashed hsl(var(--border) / 0.4) !important; padding-top: 0.75rem !important; margin-top: 0.5rem !important; flex-wrap: wrap !important; gap: 0.25rem !important; }
        #waline .wl-actions { display: flex !important; align-items: center !important; gap: 0.5rem !important; margin-left: auto !important; position: static !important; }
        @media (min-width: 641px) { #waline .wl-actions { position: relative !important; } }

        #waline .wl-action, #waline .wl-reply, #waline .wl-like, #waline .wl-edit {
          display: inline-flex !important; align-items: center !important; gap: 0.2rem !important;
          font-family: var(--waline-mono-font) !important; font-size: 0.8rem !important;
          color: hsl(var(--muted-foreground)) !important; background: transparent !important; border: none !important;
          padding: 0.2rem !important; margin: 0 !important; text-transform: uppercase; font-weight: 600;
          transition: all 0.2s; float: none !important; line-height: 1 !important; visibility: visible !important;
        }
        #waline .wl-action svg, #waline .wl-reply svg, #waline .wl-like svg { width: 16px !important; height: 16px !important; }
        #waline .wl-action:hover, #waline .wl-reply:hover, #waline .wl-like:hover { color: hsl(var(--primary)) !important; transform: translateY(-1px); }
        #waline .wl-like.active { color: hsl(var(--primary)) !important; }
        .wl-gif-tab, .wl-power { display: none !important; }

        /* 颜文字面板 */
        #kaomoji-popup { display: none; background: hsl(var(--background)); border: 1px solid hsl(var(--primary)); z-index: 9999; user-select: none; box-shadow: 4px 4px 0 0 hsl(var(--muted-foreground) / 0.1); }
        #kaomoji-popup.active { display: flex; flex-direction: column; }
        .kaomoji-header { background: hsl(var(--muted) / 0.2); border-bottom: 1px dashed hsl(var(--border)); padding: 8px 12px; font-family: var(--waline-mono-font); font-size: 10px; color: hsl(var(--muted-foreground)); letter-spacing: 1px; display: flex; justify-content: space-between; align-items: center; }
        .kaomoji-grid { padding: 8px; display: grid; overflow-y: auto; scrollbar-width: thin; scrollbar-color: hsl(var(--primary) / 0.3) transparent; }
        .kaomoji-item { font-family: sans-serif; color: hsl(var(--foreground)); text-align: center; cursor: pointer; transition: all 0.2s; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; border: 1px solid transparent; display: flex; align-items: center; justify-content: center; }
        .kaomoji-item:hover, .kaomoji-item:active { background: hsl(var(--muted) / 0.3); border-color: hsl(var(--primary) / 0.4); color: hsl(var(--primary)); }

        @media (min-width: 641px) {
          #kaomoji-popup { position: absolute; bottom: 100%; right: 0; width: 340px; margin-bottom: 10px; animation: slide-up 0.2s cubic-bezier(0.16, 1, 0.3, 1); }
          .kaomoji-grid { grid-template-columns: repeat(auto-fill, minmax(70px, 1fr)); gap: 4px; max-height: 220px; }
          .kaomoji-item { font-size: 12px; padding: 6px 4px; }
          @keyframes slide-up { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }
        }

        /* =========================================
           移动端样式优化 (Clean Mobile)
           ========================================= */
        @media (max-width: 640px) {
          #waline .wl-header { flex-direction: column; }
          #waline .wl-header-item { border-right: none !important; border-bottom: 1px dashed hsl(var(--border)) !important; padding: 0.5rem 0.75rem !important; }
          
          /* 1. 扁平化布局：移除列表缩进，最大化利用空间 */
          #waline .wl-cards, #waline .wl-cards .wl-cards { padding: 0 !important; }

          /* 2. 移除左侧装饰线，改用底部虚线分隔，消除杂乱感 */
          #waline .wl-card { 
            padding-left: 0 !important; 
            padding-right: 0 !important;
            border-left: none !important; /* 移除左侧实线 */
            border-bottom: 1px dashed hsl(var(--border) / 0.3) !important; /* 改为底部弱分隔 */
            margin-top: 1rem !important;
            padding-bottom: 1rem !important;
          }
          #waline .wl-card:last-child { border-bottom: none !important; }

          /* 3. 隐藏左侧装饰性方块 */
          #waline .wl-card::before { display: none !important; }

          /* 4. 颜文字弹窗优化 */
          #kaomoji-popup { position: fixed; left: 0; right: 0; bottom: 0; width: 100vw; height: auto; max-height: 40vh; margin: 0; border: none; box-shadow: 0 -4px 20px hsl(0 0% 0% / 0.1); transform: translateY(100%); transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
          #kaomoji-popup.active { transform: translateY(0); }
          .kaomoji-grid { grid-template-columns: repeat(3, 1fr); gap: 8px; padding: 12px; padding-bottom: env(safe-area-inset-bottom, 20px); max-height: 35vh; }
          .kaomoji-item { font-size: 14px; padding: 12px 0; border: 1px dashed hsl(var(--border) / 0.5); }
          
          #waline .wl-btn { padding: 0.2rem 0.5rem !important; margin-left: 1.5rem; margin-right: -0.8rem }
        }
      </style>

      <script is:inline src="/js/waline.umd.js" defer></script>
      <script is:inline define:vars={{ serverURL: WALINE_CONFIG.serverURL, uploadToken: WALINE_CONFIG.uploadToken, imgbedURL: WALINE_CONFIG.imgbedURL, enableImgUpload: WALINE_CONFIG.enableImgUpload }}>
        const KAOMOJI_LIST = [
          "(¬_¬)", "(='X'=)", "( ಠ_ಠ)", "(>_<)", 
          "(*^▽^*)", "(￣▽￣)\"", "(o_o)", "(O_O)", 
          "(ToT)", "(>_>)", "(<_<)", "( ° ▽、° )",
          "╮(╯_╰)╭", "_(:з」∠)_", "(°ー°〃)", "( ఠ ͟ʖ ఠ)",
          "(｡•ˇ‸ˇ•｡)", "( •̀ ω •́ )y", "(ง •_•)ง", "(*/ω＼*)",
          "w(ﾟДﾟ)w", "∑( 口 ||", "(´･ω･`)", "Wait...",
          "(╯°□°）╯︵ ┻━┻", "┬─┬ ノ( ゜-゜ノ)", "(ノへ￣、)",
          "(;´༎ຶД༎ຶ`)", "φ(゜▽゜*)♪", "( •̀ .̫ •́ )✧", "(⊙_⊙)？"
        ];

        function createPopup() {
          const popup = document.createElement('div');
          popup.id = 'kaomoji-popup';
          popup.innerHTML = `
            <div class="kaomoji-header">
              <span>// EMOTION_PACK</span>
              <button id="close-kaomoji" style="padding:4px 8px;border:none;background:transparent;color:currentColor;cursor:pointer;font-weight:bold;">×</button>
            </div>
            <div class="kaomoji-grid">
              ${KAOMOJI_LIST.map(k => `<div class="kaomoji-item">${k}</div>`).join('')}
            </div>
          `;
          return popup;
        }

        function hijackEmojiButton(scope = document) {
          const actionsLists = scope.querySelectorAll('.wl-actions');
          actionsLists.forEach(actionsContainer => {
            const originalBtn = actionsContainer.querySelector('button[title="表情"]');
            if (!originalBtn || originalBtn.classList.contains('hijacked-emoji')) return;

            const clonedBtn = originalBtn.cloneNode(true);
            clonedBtn.classList.add('hijacked-emoji');
            clonedBtn.style.display = 'inline-flex';
            const popup = createPopup();
            originalBtn.parentNode.replaceChild(clonedBtn, originalBtn);
            actionsContainer.appendChild(popup);

            clonedBtn.addEventListener('click', (e) => {
              e.stopPropagation(); e.preventDefault();
              const isActive = popup.classList.contains('active');
              document.querySelectorAll('#kaomoji-popup.active').forEach(p => p.classList.remove('active'));
              if(!isActive) popup.classList.add('active');
            });

            popup.querySelector('#close-kaomoji').addEventListener('click', (e) => {
              e.stopPropagation(); e.preventDefault(); popup.classList.remove('active');
            });

            popup.addEventListener('click', (e) => {
              if(e.target.classList.contains('kaomoji-item')) {
                 e.preventDefault(); e.stopPropagation();
              }
              if (e.target.classList.contains('kaomoji-item')) {
                let panel = actionsContainer.closest('.wl-panel');
                let textarea = panel ? panel.querySelector('textarea') : null;
                if (!textarea) {
                    const walineRoot = document.getElementById('waline');
                    if (walineRoot) textarea = walineRoot.querySelector('textarea.wl-editor');
                }
                if(textarea) {
                  insertText(textarea, e.target.innerText);
                  popup.classList.remove('active');
                }
              }
            });
            
            document.addEventListener('click', (e) => {
              if (!popup.contains(e.target) && !clonedBtn.contains(e.target)) popup.classList.remove('active');
            });
          });
        }

        function insertText(textarea, text) {
          const start = textarea.selectionStart || 0;
          const end = textarea.selectionEnd || 0;
          const value = textarea.value;
          textarea.value = value.substring(0, start) + text + value.substring(end);
          textarea.selectionStart = textarea.selectionEnd = start + text.length;
          textarea.dispatchEvent(new Event('input', { bubbles: true }));
          textarea.focus();
        }

        async function handleImageUpload(file) {
          try {
            const MAX_SIZE = 1024 * 1024; 
            let fileToUpload = file;
            if (file.size > MAX_SIZE) fileToUpload = await compressImage(file, MAX_SIZE);
            const formData = new FormData();
            formData.append('file', fileToUpload);

            const response = await fetch(imgbedURL, {
              method: 'POST',
              headers: { Authorization: `Bearer ${uploadToken}` },
              body: formData,
            });
            if (!response.ok) throw new Error(`Upload failed: ${response.status}`);
            const data = await response.json();
            return data.url;
          } catch (error) {
            console.error('[Waline] Upload error:', error);
            alert('UPLOAD_FAILED');
            throw error;
          }
        }

        function compressImage(file, maxSize) {
          return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.readAsDataURL(file);
            reader.onload = (e) => {
              const img = new Image();
              img.src = e.target.result;
              img.onload = () => {
                const canvas = document.createElement('canvas');
                let { width, height } = img;
                const maxDim = 1920;
                if (width > maxDim || height > maxDim) {
                  const ratio = Math.min(maxDim / width, maxDim / height);
                  width = Math.round(width * ratio);
                  height = Math.round(height * ratio);
                }
                canvas.width = width;
                canvas.height = height;
                const ctx = canvas.getContext('2d');
                ctx.drawImage(img, 0, 0, width, height);
                let quality = 0.8;
                const attempt = () => {
                  canvas.toBlob(blob => {
                    if(!blob) return reject(new Error('Canvas error'));
                    if(blob.size <= maxSize || quality < 0.2) {
                      resolve(new File([blob], file.name, { type: 'image/jpeg' }));
                    } else {
                      quality -= 0.1;
                      attempt();
                    }
                  }, 'image/jpeg', quality);
                };
                attempt();
              };
              img.onerror = () => reject(new Error('Image load failed'));
            };
            reader.onerror = () => reject(new Error('File read failed'));
          });
        }

        function initWaline() {
          const container = document.querySelector('#waline-container');
          if (!container || window.__walineInstance) return;
          container.innerHTML = '';
          const walineEl = document.createElement('div');
          walineEl.id = 'waline';
          container.appendChild(walineEl);

          try {
            window.__walineInstance = window.Waline.init({
              el: walineEl,
              serverURL: serverURL,
              lang: 'zh-CN',
              dark: 'html.dark',
              emoji: [], 
              search: false,
              imageUploader: enableImgUpload ? handleImageUpload : null,
              locale: { placeholder: 'INPUT_STREAM_READY...' }
            });

            const waitTimer = setInterval(() => {
              const mainBtn = document.querySelector('#waline .wl-actions button[title="表情"]');
              if (mainBtn) {
                clearInterval(waitTimer);
                hijackEmojiButton(document.getElementById('waline'));
                setupMutationObserver();
              }
            }, 100);
            setTimeout(() => clearInterval(waitTimer), 5000);
          } catch (e) { console.error(e); }
        }

        function setupMutationObserver() {
          const walineRoot = document.getElementById('waline');
          if (!walineRoot) return;
          const observer = new MutationObserver((mutations) => {
            mutations.forEach((mutation) => {
              if (mutation.addedNodes.length > 0) {
                mutation.addedNodes.forEach((node) => {
                  if (node.nodeType === 1) {
                    if (node.querySelector && node.querySelector('.wl-actions button[title="表情"]')) hijackEmojiButton(node); 
                    if (node.classList && node.classList.contains('wl-actions')) hijackEmojiButton(node.parentElement);
                  }
                });
              }
            });
          });
          observer.observe(walineRoot, { childList: true, subtree: true });
          window.__walineDOMObserver = observer;
        }

        function setupObserver() {
          const container = document.querySelector('#waline-container');
          if (!container) return;
          if (window.__walineObserver) window.__walineObserver.disconnect();
          window.__walineObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                  if(window.Waline) initWaline();
                  else {
                      const check = setInterval(() => { if(window.Waline) { clearInterval(check); initWaline(); } }, 100);
                  }
                  window.__walineObserver.disconnect();
              }
            });
          }, { rootMargin: '200px' });
          window.__walineObserver.observe(container);
        }

        setupObserver();
        document.addEventListener('astro:page-load', () => setTimeout(setupObserver, 0));
        document.addEventListener('astro:before-swap', () => {
          if (window.__walineDOMObserver) { window.__walineDOMObserver.disconnect(); window.__walineDOMObserver = null; }
          if (window.__walineInstance) { try { window.__walineInstance.destroy(); } catch(e){} window.__walineInstance = null; }
        });
      </script>
    </>
  )
}