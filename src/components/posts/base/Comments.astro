---
import { WALINE_CONFIG } from "~/config";
---

{WALINE_CONFIG.enableComment && (
  <>
    <div class="waline-section-title mx-2">
      <span class="prefix text-4xl">// COMMENT_SYSTEM_</span>
    </div>

    <div id="waline-container" class="waline-lazy">
      <div class="waline-loading font-mono">Loading...</div>
    </div>

    <link
      rel="stylesheet"
      href="/css/waline.css"
    />

    <style is:global>
      /* =========================================
         新增：标题样式
         ========================================= */
      .waline-section-title {
        width: 100%;
        margin-top: 3rem;       /* 与上方内容的间距 */
        margin-bottom: 1rem;    /* 与评论区的间距 */
        padding-bottom: 0.5rem; /* 文字与下划线的距离 */

        /* 字体与排版 */
        font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Monaco, Consolas, monospace;
        font-size: 0.875rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        
        /* 默认浅色模式颜色 (与下方 #waline 变量对应) */
        color: #333333; 
        border-bottom: 1px solid #e0e0e0;
      }
      
      .waline-section-title .prefix {
        color: #888888; /* 符号颜色稍淡 */
        margin-right: 0.5em;
      }

      /* 深色模式标题适配 */
      html.dark .waline-section-title {
        color: #d4d4d8;
        border-bottom: 1px solid #2e2e2e;
      }
      html.dark .waline-section-title .prefix {
        color: #71717a;
      }

      /* =========================================
         全局容器设置
         ========================================= */
      #waline-container {
        width: 100%;
        position: relative;
        /* 核心变量：极细实线 */
        --industrial-line: 1px solid var(--waline-border-color);
      }

      /* 懒加载占位 */
      .waline-lazy {
        min-height: 200px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--waline-color);
        font-family: ui-monospace, SFMono-Regular, monospace;
        font-size: 0.875rem;
        letter-spacing: 1px;
        background: transparent;
        border: 1px dashed var(--waline-border-color);
      }

      .waline-lazy:has(#waline) {
        display: block;
        min-height: unset;
        border: none;
      }

      /* =========================================
         核心变量定义
         ========================================= */
      #waline {
        /* 基础排版 */
        --waline-font-size: 15px !important;
        --waline-line-height: 1.6 !important; /* 行高稍微收紧 */
        
        /* 字体 */
        --waline-font-family: 'ShangguSansSC Variable', system-ui, -apple-system, sans-serif !important;
        --waline-mono-font: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Monaco, Consolas, monospace !important;

        /* 浅色模式 - 纸张感 */
        --waline-theme-color: #000000 !important;
        --waline-active-color: #000000 !important;
        --waline-bgcolor: #ffffff !important;
        --waline-bgcolor-light: #fafafa !important;
        --waline-bgcolor-hover: #f0f0f0 !important;
        --waline-border-color: #e0e0e0 !important; /* 稍微加深一点点灰，保证细线可见 */
        --waline-disable-bg-color: #fafafa !important;
        --waline-disable-color: #ccc !important;
        --waline-code-bg-color: #f9f9f9 !important;
        
        /* 文本颜色 */
        --waline-color: #333333 !important;
        --waline-info-color: #888888 !important;

        /* 结构重置 - 移除圆角和阴影 */
        --waline-box-shadow: none !important;
        --waline-avatar-radius: 0 !important; 
        --waline-border: var(--industrial-line) !important;
      }

      /* 深色模式 - CAD 界面感 */
      html.dark #waline {
        --waline-theme-color: #ffffff !important;
        --waline-active-color: #ffffff !important;
        --waline-bgcolor: #09090b !important;
        --waline-bgcolor-light: #121212 !important;
        --waline-bgcolor-hover: #27272a !important;
        --waline-border-color: #2e2e2e !important;
        --waline-color: #d4d4d8 !important;
        --waline-info-color: #71717a !important;
        --waline-code-bg-color: #121212 !important;
      }

      /* =========================================
         组件样式重写
         ========================================= */

      /* 1. 全局直角化 */
      #waline .wl-panel,
      #waline .wl-user-avatar,
      #waline .wl-login-nick,
      #waline .wl-input,
      #waline .wl-btn,
      #waline .wl-card,
      #waline .wl-header,
      #waline .wl-editor,
      #waline .wl-gif-popup,
      #waline .wl-emoji-popup,
      #waline .wl-content pre,
      #waline .wl-meta span {
        border-radius: 0 !important;
      }

      /* 2. 输入面板 (.wl-panel) - 紧凑型 */
      #waline .wl-panel {
        border: var(--industrial-line) !important;
        background: var(--waline-bgcolor) !important;
      }

      /* 头部信息栏 */
      #waline .wl-header {
        border-bottom: var(--industrial-line) !important;
        background: var(--waline-bgcolor-light) !important;
        display: flex;
      }

      #waline .wl-header-item {
        border-right: var(--industrial-line) !important;
        flex: 1;
      }
      
      #waline .wl-header-item:last-child {
        border-right: none !important;
      }

      #waline .wl-header label {
        color: var(--waline-info-color) !important;
        font-weight: 500;
        font-family: var(--waline-mono-font) !important;
        font-size: 0.75rem !important;
        text-transform: uppercase;
      }

      #waline .wl-input {
        font-family: var(--waline-mono-font) !important;
        font-size: 0.85rem !important;
        padding: 0.5rem 0.75rem !important; /* 稍微紧凑的内边距 */
      }

      /* 编辑器 */
      #waline .wl-editor {
        min-height: 8rem; /* 高度适中 */
        padding: 0.75rem !important;
        background: var(--waline-bgcolor) !important;
        font-family: var(--waline-font-family) !important;
        font-size: 0.95rem !important;
        line-height: 1.75;
        resize: vertical;
        color: var(--waline-color) !important;
      }
      
      #waline .wl-editor:focus,
      #waline .wl-input:focus {
        background: transparent !important;
        box-shadow: none !important;
      }

      /* 底部操作栏 */
      #waline .wl-footer {
        margin: 0 !important;
        padding: 0.5rem !important;
        border-top: var(--industrial-line) !important;
        background: var(--waline-bgcolor-light) !important;
      }

      #waline .wl-btn {
        border: var(--industrial-line) !important;
        color: var(--waline-color) !important;
        background: var(--waline-bgcolor) !important;
        font-family: var(--waline-mono-font) !important;
        font-size: 0.75rem !important;
        padding: 0.25em 1em !important; /* 按钮变薄一点 */
        margin-left: 0.5em;
      }

      /* 按钮交互 */
      #waline .wl-btn:not(:disabled):hover {
        background: var(--waline-theme-color) !important;
        color: var(--waline-bgcolor) !important;
        border-color: var(--waline-theme-color) !important;
      }

      /* 图标 */
      #waline .wl-action {
        width: 22px;
        height: 22px;
        color: var(--waline-info-color) !important;
      }
      #waline .wl-action:hover {
        color: var(--waline-theme-color) !important;
      }
      .wl-gif-tab { display: none !important; }

      /* =========================================
         评论列表布局修正 (重点修改区域)
         ========================================= */
      
      /* 列表项 */
      #waline .wl-card {
        border-bottom: var(--industrial-line) !important;
        padding: 1.25rem 0 !important; /* 减小垂直间距 */
        margin: 0 !important;
      }
      #waline .wl-card:last-child {
        border-bottom: none !important;
      }

      /* 1. 头像区域 (.wl-user) - 缩减右侧外边距 */
      #waline .wl-cards .wl-user {
        margin-inline-end: 0.6rem !important; /* 核心修正：大幅减小头像与内容的距离 */
        width: auto !important; /* 防止容器过大 */
        flex-shrink: 0; /* 防止头像被压缩 */
      }

      /* 2. 头像图片本身 */
      #waline .wl-user-avatar {
        width: 2.25rem !important; /* 稍微调小头像，更精致 */
        height: 2.25rem !important;
        background: var(--waline-bgcolor-light);
        border: var(--industrial-line);
        margin: 0 !important; /* 移除头像本身的边距 */
      }
      
      #waline .wl-user-avatar img {
        border: none !important;
        transform: scale(0.92); /* 边框留白 */
      }

      /* 3. 右侧内容区域 */
      #waline .wl-card-item .wl-card {
        padding-bottom: 0 !important; /* 移除内部多余padding */
        border: none !important; /* 内部不需要边框 */
      }

      /* 昵称 */
      #waline .wl-nick {
        font-weight: 600;
        color: var(--waline-theme-color) !important;
        font-size: 0.9rem !important;
        margin-right: 0.5rem !important;
      }

      /* 标签与元数据 - 紧凑排列 */
      #waline .wl-head {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        line-height: 1.2;
        margin-bottom: 0.25rem;
      }

      #waline .wl-badge {
        border: none !important;
        background: var(--waline-theme-color) !important;
        color: var(--waline-bgcolor) !important;
        font-size: 0.65rem !important;
        padding: 1px 3px !important;
        margin-right: 0.5rem !important;
      }

      #waline .wl-meta > span {
        background: transparent !important;
        border: var(--industrial-line) !important;
        color: var(--waline-info-color) !important;
        font-family: var(--waline-mono-font) !important;
        font-size: 0.65rem !important;
        padding: 0px 4px !important;
        margin-right: 0.4rem !important;
        text-transform: uppercase;
      }

      /* 时间 */
      #waline .wl-time {
        font-family: var(--waline-mono-font) !important;
        color: var(--waline-info-color) !important;
        font-size: 0.75rem !important;
        margin-left: auto !important; /* 靠右对齐 */
      }

      /* 引用块 */
      #waline .wl-quote {
        border-left: 1px solid var(--waline-theme-color) !important;
        background: transparent !important;
        padding-left: 0.75rem !important;
        margin: 0.5rem 0 !important;
        color: var(--waline-info-color) !important;
        font-size: 0.9em;
      }

      /* 评论正文 */
      #waline .wl-content {
        font-size: 0.95rem !important;
        color: var(--waline-color) !important;
        line-height: 1.75 !important;
        margin-top: 0.25rem;
      }

      /* 代码块 */
      #waline .wl-content pre {
        background: var(--waline-code-bg-color) !important;
        border: var(--industrial-line);
        padding: 0.75rem;
        margin: 0.75rem 0;
        font-size: 0.85em;
      }

      /* 移动端适配 */
      @media (max-width: 580px) {
        #waline .wl-header {
          display: block;
        }
        #waline .wl-header-item {
          border-right: none !important;
          border-bottom: var(--industrial-line) !important;
        }
        /* 移动端头像更近 */
        #waline .wl-cards .wl-user {
          margin-inline-end: 0.5rem !important;
        }
        #waline .wl-time {
          width: 100%;
          margin-top: 0.25rem;
        }
      }
    </style>

    <script is:inline src="/js/waline.umd.js" defer></script>
    <script is:inline define:vars={{ serverURL: WALINE_CONFIG.serverURL, uploadToken: WALINE_CONFIG.uploadToken }}>
      // 使用 Intersection Observer 实现延迟加载
      function initWalineLazyLoad() {
        const container = document.querySelector('#waline-container');
        if (!container) return;

        // 检查是否已经初始化过这个容器
        if (container.hasAttribute('data-waline-init')) {
          return;
        }
        container.setAttribute('data-waline-init', 'true');

        // 重置页面切换时的加载状态
        window.__walineLoaded = false;
        
        let observer = null;
        
        // 设置交叉观察器，当评论区滚入视口时加载
        const setupObserver = () => {
          observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting && !window.__walineLoaded) {
                  window.__walineLoaded = true;
                  observer.disconnect();
                  
                  // 直接加载 Waline，不延迟
                  loadWaline();
                }
              }
            },
            { rootMargin: '300px' } // 提前加载，提高响应速度
          );
          
          observer.observe(container);
        };

        // 如果 Waline 还没加载，等待它加载
        if (!window.Waline) {
          const checkWaline = setInterval(() => {
            if (window.Waline) {
              clearInterval(checkWaline);
              setupObserver();
            }
          }, 50);
          
          // 设置超时，防止无限等待
          setTimeout(() => {
            clearInterval(checkWaline);
            if (window.Waline) {
              setupObserver();
            }
          }, 5000);
        } else {
          setupObserver();
        }
      }

      // 压缩图片的辅助函数
      async function compressImage(file, maxSize = 1024 * 1024) {
        return new Promise((resolve, reject) => {
          // 检查文件大小是否超过限制
          if (file.size <= maxSize) {
            resolve(file);
            return;
          }

          const reader = new FileReader();
          reader.readAsDataURL(file);
          
          reader.onload = (event) => {
            const img = new Image();
            img.src = event.target.result;
            
            img.onload = () => {
              const canvas = document.createElement('canvas');
              let width = img.width;
              let height = img.height;
              
              // 计算最大尺寸（如果图片太大）
              const maxDimension = 1920;
              if (width > maxDimension || height > maxDimension) {
                const ratio = Math.min(maxDimension / width, maxDimension / height);
                width = Math.round(width * ratio);
                height = Math.round(height * ratio);
              }
              
              canvas.width = width;
              canvas.height = height;
              
              const ctx = canvas.getContext('2d');
              ctx.fillStyle = '#fff';
              ctx.fillRect(0, 0, width, height);
              ctx.drawImage(img, 0, 0, width, height);
              
              // 按质量压缩
              let quality = 0.8;
              const tryCompress = () => {
                canvas.toBlob(
                  (blob) => {
                    if (blob.size <= maxSize || quality <= 0.1) {
                      // 生成新的 File 对象
                      const compressedFile = new File([blob], file.name, {
                        type: 'image/jpeg',
                        lastModified: Date.now(),
                      });
                      resolve(compressedFile);
                    } else {
                      quality -= 0.1;
                      tryCompress();
                    }
                  },
                  'image/jpeg',
                  quality
                );
              };
              
              tryCompress();
            };
            
            img.onerror = () => {
              reject(new Error('图片加载失败'));
            };
          };
          
          reader.onerror = () => {
            reject(new Error('文件读取失败'));
          };
        });
      }

      function loadWaline() {
        const container = document.querySelector('#waline-container');
        if (!container || !window.Waline) return;

        // 销毁旧实例
        destroyWaline();

        // 完全清空旧实例
        container.innerHTML = '';
        
        // 创建新的 Waline 容器
        const walineDiv = document.createElement('div');
        walineDiv.id = 'waline';
        container.appendChild(walineDiv);

        // 初始化新实例
        try {
          window.__walineInstance = window.Waline.init({
            el: walineDiv,
            serverURL: serverURL,
            path: location.pathname.replace(/\/$/, ''),
            lang: 'zh-CN',
            pageview: true,
            dark: 'html.dark',
            requiredMeta: ['nick', 'mail'],
            locale: { placeholder: 'Successfully established a secure connection and ready to send...' },
            emoji: [],
            imageUploader: async (file) => {
              try {
                // 压缩图片到 1MB 以内
                const compressedFile = await compressImage(file, 1024 * 1024);
                console.log(`原始大小: ${(file.size / 1024).toFixed(2)}KB, 压缩后: ${(compressedFile.size / 1024).toFixed(2)}KB`);
                
                const formData = new FormData();
                formData.append('file', compressedFile);
                
                const response = await fetch('https://img.refact.cc/upload', {
                  method: 'POST',
                  headers: {
                    // 关键：带上和 Worker 对应的 Token
                    Authorization: `Bearer ${uploadToken}`,
                  },
                  body: formData,
                });
                
                if (!response.ok) throw new Error('上传失败');
                
                const data = await response.json();
                return data.url;
              } catch (error) {
                console.error('图片上传失败:', error);
                throw error;
              }
            },
            search: false,
            upload: false,
          });
        } catch (error) {
          console.error('Waline 初始化失败:', error);
        }
      }

      // 销毁 Waline 实例的辅助函数
      function destroyWaline() {
        const walineEl = document.querySelector('#waline');
        if (walineEl && window.__walineInstance) {
          try {
            // 尝试调用销毁方法（如果存在）
            if (typeof window.__walineInstance.destroy === 'function') {
              window.__walineInstance.destroy();
            }
          } catch (e) {
            console.warn('Waline destroy 方法出错:', e);
          }
        }
        window.__walineInstance = null;
      }

      // 页面加载完成后初始化
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initWalineLazyLoad);
      } else {
        initWalineLazyLoad();
      }
      
      // 支持 astro 页面切换 - 重置状态以允许重新初始化
      document.addEventListener('astro:page-load', () => {
        const container = document.querySelector('#waline-container');
        if (container) {
          // 先销毁旧实例
          destroyWaline();
          
          // 等待一帧后再重置，确保 DOM 清理完毕
          requestAnimationFrame(() => {
            container.removeAttribute('data-waline-init');
            window.__walineLoaded = false;
            container.innerHTML = '<div class="waline-loading">加载评论中...</div>';
            initWalineLazyLoad();
          });
        }
      });
      
      // 页面卸载时清理实例，防止内存泄漏
      document.addEventListener('astro:before-swap', () => {
        destroyWaline();
      });
    </script>
  </>
)}

