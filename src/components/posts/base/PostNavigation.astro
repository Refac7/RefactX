---
import type { CollectionEntry } from 'astro:content'
import { POSTS_CONFIG } from '~/config'

interface Props {
  prev: CollectionEntry<'posts'> | null
  next: CollectionEntry<'posts'> | null
}

const { prev, next } = Astro.props
---

<nav class="mt-14 grid grid-cols-1 gap-4 border-t border-border/60 pt-8 sm:grid-cols-2">
  {
    next ? (
      <a href={`/posts/${next.id}`} class="post-nav group">
        <span class="post-nav__label">
          <span class="icon-[ph--arrow-left] size-3.5 transition-transform group-hover:-translate-x-0.5" />
          {POSTS_CONFIG.prevPostText}
        </span>
        <span class="post-nav__title">{next.data.title}</span>
      </a>
    ) : (
      <div class="hidden sm:block" />
    )
  }

  {
    prev ? (
      <a href={`/posts/${prev.id}`} class="post-nav post-nav--next group">
        <span class="post-nav__label">
          {POSTS_CONFIG.nextPostText}
          <span class="icon-[ph--arrow-right] size-3.5 transition-transform group-hover:translate-x-0.5" />
        </span>
        <span class="post-nav__title">{prev.data.title}</span>
      </a>
    ) : (
      <div class="hidden sm:block" />
    )
  }
</nav>
