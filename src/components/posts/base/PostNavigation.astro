---
import type { CollectionEntry } from 'astro:content'
import { POSTS_CONFIG } from '~/config'

interface Props {
  prev: CollectionEntry<'posts'> | null
  next: CollectionEntry<'posts'> | null
}

const { prev, next } = Astro.props
---

<nav class="mt-16 grid grid-cols-1 gap-px border border-foreground/25 bg-foreground/25 sm:grid-cols-2">
  {
    next ? (
      <a href={`/posts/${next.id}`} class="group relative bg-background p-5 transition-colors hover:bg-foreground hover:text-background">
        <div class="mb-2 flex items-center gap-2">
          <span class="icon-[ph--arrow-left] size-3.5 text-primary" />
          <span class="font-mono text-[9px] uppercase tracking-[0.18em] text-muted-foreground group-hover:text-background/55">
            {POSTS_CONFIG.prevPostText}
          </span>
        </div>
        <p class="line-clamp-1 text-sm font-semibold tracking-[-0.01em] text-foreground transition-colors group-hover:text-background">
          {next.data.title}
        </p>
      </a>
    ) : (
      <div class="hidden bg-background sm:block" />
    )
  }

  {
    prev ? (
      <a
        href={`/posts/${prev.id}`}
        class="group relative bg-background p-5 text-right transition-colors hover:bg-foreground hover:text-background"
      >
        <div class="mb-2 flex items-center justify-end gap-2">
          <span class="font-mono text-[9px] uppercase tracking-[0.18em] text-muted-foreground group-hover:text-background/55">
            {POSTS_CONFIG.nextPostText}
          </span>
          <span class="icon-[ph--arrow-right] size-3.5 text-primary" />
        </div>
        <p class="line-clamp-1 text-sm font-semibold tracking-[-0.01em] text-foreground transition-colors group-hover:text-background">
          {prev.data.title}
        </p>
      </a>
    ) : (
      <div class="hidden bg-background sm:block" />
    )
  }
</nav>
