---
import type { CollectionEntry } from 'astro:content'
import { POSTS_CONFIG } from '~/config'

interface Props {
  prev: CollectionEntry<'posts'> | null
  next: CollectionEntry<'posts'> | null
}

const { prev, next } = Astro.props
---

<nav class="flex flex-col sm:flex-row justify-between gap-4 mt-16 pt-8 border-t border-outline-variant">
  {
    next && (
      <a href={`/posts/${next.id}`} class="group flex-1 relative">
        <div class="rounded-2xl border border-outline-variant bg-surface-container-low p-5 hover:bg-surface-container hover:border-primary/40 hover:shadow-md transition-all duration-300 group-hover:-translate-x-0.5">
          <div class="flex items-center gap-2 mb-2">
            <span class="icon-[ph--arrow-left] size-3.5 text-on-surface-variant/60 group-hover:text-primary group-hover:-translate-x-0.5 transition-all" />
            <span class="text-[10px] font-mono uppercase tracking-widest text-on-surface-variant/60">{POSTS_CONFIG.prevPostText}</span>
          </div>
          <p class="font-sans text-sm text-on-surface/90 group-hover:text-primary transition-colors line-clamp-1">{next.data.title}</p>
        </div>
      </a>
    )
  }

  {
    prev && (
      <a href={`/posts/${prev.id}`} class="group flex-1 relative">
        <div class="rounded-2xl border border-outline-variant bg-surface-container-low p-5 hover:bg-surface-container hover:border-primary/40 hover:shadow-md transition-all duration-300 text-right group-hover:translate-x-0.5">
          <div class="flex items-center justify-end gap-2 mb-2">
            <span class="text-[10px] font-mono uppercase tracking-widest text-on-surface-variant/60">{POSTS_CONFIG.nextPostText}</span>
            <span class="icon-[ph--arrow-right] size-3.5 text-on-surface-variant/60 group-hover:text-primary group-hover:translate-x-0.5 transition-all" />
          </div>
          <p class="font-sans text-sm text-on-surface/90 group-hover:text-primary transition-colors line-clamp-1">{prev.data.title}</p>
        </div>
      </a>
    )
  }

  {!next && <div class="flex-1" />}
  {!prev && <div class="flex-1" />}
</nav>
