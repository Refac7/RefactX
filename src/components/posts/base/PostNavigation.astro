---
import type { CollectionEntry } from 'astro:content'
import { POSTS_CONFIG } from '~/config'

interface Props {
  prev: CollectionEntry<'posts'> | null
  next: CollectionEntry<'posts'> | null
}

const { prev, next } = Astro.props
---

<nav class="flex flex-col sm:flex-row justify-between gap-4 mt-16 pt-8 border-t border-border/40">
  {
    next && (
      <a href={`/posts/${next.id}`} class="group flex-1 relative">
        <div class="border border-primary/15 bg-background/70 p-5 rounded-2xl hover:bg-accent/50 hover:border-primary/40  transition-all duration-300 group-hover:-translate-x-1">
          <div class="flex items-center gap-2 mb-2">
            <span class="icon-[ph--arrow-left] size-3.5 text-primary/60 group-hover:text-primary group-hover:-translate-x-0.5 transition-all" />
            <span class="text-[10px] font-semibold tracking-widest text-primary/60">{POSTS_CONFIG.prevPostText}</span>
          </div>
          <p class="font-serif text-sm text-foreground/80 group-hover:text-primary transition-colors line-clamp-1">{next.data.title}</p>
        </div>
      </a>
    )
  }

  {
    prev && (
      <a href={`/posts/${prev.id}`} class="group flex-1 relative">
        <div class="border border-primary/15 bg-background/70 p-5 rounded-2xl hover:bg-accent/50 hover:border-primary/40  transition-all duration-300 text-right group-hover:translate-x-1">
          <div class="flex items-center justify-end gap-2 mb-2">
            <span class="text-[10px] font-semibold tracking-widest text-primary/60">{POSTS_CONFIG.nextPostText}</span>
            <span class="icon-[ph--arrow-right] size-3.5 text-primary/60 group-hover:text-primary group-hover:translate-x-0.5 transition-all" />
          </div>
          <p class="font-serif text-sm text-foreground/80 group-hover:text-primary transition-colors line-clamp-1">{prev.data.title}</p>
        </div>
      </a>
    )
  }

  {!next && <div class="flex-1" />}
  {!prev && <div class="flex-1" />}
</nav>
