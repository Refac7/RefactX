---
import type { CollectionEntry } from 'astro:content'
import { POSTS_CONFIG } from '~/config'

interface Props {
  prev: CollectionEntry<'posts'> | null
  next: CollectionEntry<'posts'> | null
}

const { prev, next } = Astro.props
---

<nav class="mt-14 grid grid-cols-1 gap-4 border-t border-border/60 pt-8 sm:grid-cols-2">
  {
    next ? (
      <a href={`/posts/${next.id}`} class="post-nav group">
        <span class="post-nav__label">
          <span class="icon-[ph--arrow-left] size-3.5 transition-transform group-hover:-translate-x-0.5" />
          {POSTS_CONFIG.prevPostText}
        </span>
        <span class="post-nav__title">{next.data.title}</span>
      </a>
    ) : (
      <div class="hidden sm:block" />
    )
  }

  {
    prev ? (
      <a href={`/posts/${prev.id}`} class="post-nav post-nav--next group">
        <span class="post-nav__label">
          {POSTS_CONFIG.nextPostText}
          <span class="icon-[ph--arrow-right] size-3.5 transition-transform group-hover:translate-x-0.5" />
        </span>
        <span class="post-nav__title">{prev.data.title}</span>
      </a>
    ) : (
      <div class="hidden sm:block" />
    )
  }
</nav>

<style>
  .post-nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.1rem 1.25rem;
    border-radius: 1.25rem;
    border: 1px solid hsl(var(--border) / 0.8);
    background: hsl(var(--card));
    text-decoration: none;
    transition:
      transform 220ms ease,
      border-color 220ms ease,
      background-color 220ms ease;
  }

  .post-nav:hover {
    transform: translateY(-2px);
    border-color: hsl(var(--primary) / 0.42);
    background: hsl(var(--accent) / 0.35);
  }

  .post-nav--next {
    text-align: right;
  }

  .post-nav__label {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-geist-mono);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
  }

  .post-nav--next .post-nav__label {
    justify-content: flex-end;
  }

  .post-nav__title {
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 650;
    line-height: 1.4;
    color: hsl(var(--foreground));
    transition: color 180ms ease;
  }

  .post-nav:hover .post-nav__title {
    color: hsl(var(--accent-foreground));
  }
</style>
