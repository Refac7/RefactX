---
import { cn } from '~/lib/utils'

interface Props {
  tag: string
  class?: string
  variant?: 'default' | 'subtle' | 'outline'
  size?: 'sm' | 'md'
}

const { tag, class: className, variant = 'default', size = 'sm' }: Props = Astro.props

const sizeClasses = {
  sm: 'text-[10px] px-2 py-0.5 gap-0.5',
  md: 'text-xs px-2.5 py-1 gap-1',
}

const variantClasses = {
  default:
    'border border-foreground/25 bg-transparent text-muted-foreground hover:border-primary hover:bg-primary hover:text-primary-foreground',
  subtle: 'border border-primary/30 bg-primary/5 text-primary hover:bg-primary hover:text-primary-foreground',
  outline: 'border border-foreground/30 bg-transparent text-muted-foreground hover:border-foreground hover:text-foreground',
}
---

<a
  href={`/tags/${tag}`}
  aria-label={`View posts tagged with ${tag}`}
  class={cn(
    'inline-flex items-center font-mono uppercase tracking-[0.08em] transition-colors duration-150',
    sizeClasses[size],
    variantClasses[variant],
    className
  )}
>
  <span class="opacity-50">#</span>
  {tag}
</a>
