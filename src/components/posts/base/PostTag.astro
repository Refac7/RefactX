---
import { cn } from '~/lib/utils'

interface Props {
  tag: string
  class?: string
  variant?: 'default' | 'subtle' | 'outline'
  size?: 'sm' | 'md'
}

const { tag, class: className, variant = 'default', size = 'sm' }: Props = Astro.props

const sizeClasses = {
  sm: 'text-xs px-2.5 py-1 gap-1',
  md: 'text-sm px-3 py-1.5 gap-1.5',
}

const variantClasses = {
  default: 'bg-accent/60 text-primary hover:bg-accent border border-primary/20',
  subtle: 'bg-primary/10 text-primary hover:bg-primary/20 border border-primary/20',
  outline: 'bg-background/50 text-muted-foreground border border-primary/20 hover:bg-accent hover:text-primary',
}
---

<a
  href={`/tags/${tag}`}
  aria-label={`View posts tagged with ${tag}`}
  class={cn(
    'inline-flex items-center font-semibold rounded-full transition-all duration-200 hover:-translate-y-0.5',
    sizeClasses[size],
    variantClasses[variant],
    className
  )}
>
  <span class="icon-[ph--hash] opacity-70"></span>
  {tag}
</a>
