---
import { cn } from '~/lib/utils'

interface Props {
  tag: string
  class?: string
  variant?: 'default' | 'subtle' | 'outline'
  size?: 'sm' | 'md'
}

const { tag, class: className, variant = 'default', size = 'sm' }: Props = Astro.props

const sizeClasses = {
  sm: 'text-[10px] px-2.5 py-0.5 gap-0.5',
  md: 'text-[11px] px-3 py-1 gap-1',
}

const variantClasses = {
  default: 'border border-border bg-tag-bg text-muted-foreground hover:border-primary/40 hover:bg-accent-soft hover:text-accent-foreground',
  subtle: 'border border-primary/20 bg-accent-soft text-accent-foreground hover:border-primary/40',
  outline: 'border border-border bg-transparent text-muted-foreground hover:border-primary/40 hover:text-foreground',
}
---

<a
  href={`/tags/${tag}`}
  aria-label={`View posts tagged with ${tag}`}
  class={cn(
    'inline-flex items-center rounded-full font-medium transition-colors duration-150',
    sizeClasses[size],
    variantClasses[variant],
    className
  )}
>
  <span class="opacity-50">#</span>
  {tag}
</a>
