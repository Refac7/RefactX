---
import { POSTS_CONFIG } from '~/config'
import { cn } from '~/lib/utils'

interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<div class={cn('markdown', className)} data-pagefind-body>
  <slot />
</div>

<script>
  import mediumZoom from 'medium-zoom/dist/pure'
  const zoom = mediumZoom({ background: 'hsl(var(--background) / 0.9)' })

  document.addEventListener('astro:page-load', () => {
    zoom.detach()
    zoom.attach('.markdown img:not(.no-zoom):not(a img)')

    const lqipImages = document.querySelectorAll('.markdown img[style*="--lqip:"]')
    lqipImages.forEach((img) => {
      const imageEl = img as HTMLImageElement

      function handleImageLoad() {
        imageEl.style.removeProperty('--lqip')
      }

      if (imageEl.complete && imageEl.naturalHeight !== 0) {
        handleImageLoad()
      } else {
        imageEl.addEventListener('load', handleImageLoad)
        imageEl.addEventListener('error', handleImageLoad)
      }
    })

    const lazyImages = document.querySelectorAll('.lazy-image')
    lazyImages.forEach((img) => {
      const imageEl = img as HTMLImageElement

      function handleLazyImageLoad() {
        imageEl.classList.add('lazy-image-loaded')
        window.dispatchEvent(new CustomEvent('lazyImageLoaded'))
      }

      if (imageEl.complete && imageEl.naturalHeight !== 0) {
        handleLazyImageLoad()
      } else {
        imageEl.addEventListener('load', handleLazyImageLoad)
        imageEl.addEventListener('error', handleLazyImageLoad)
      }
    })
  })
</script>

<script define:vars={{ enabled: POSTS_CONFIG.imageDarkenInDark }} is:inline>
  if (enabled) {
    const darkModeHandler = () => {
      const isDark = document.documentElement.classList.contains('dark')
      
      document.querySelectorAll('.markdown img:not(:hover):not(.medium-zoom-image--opened):not(.noDarken)').forEach((img) => {
        if (img.classList.contains('lazy-image') && !img.classList.contains('lazy-image-loaded')) {
          return
        }
        
        if (isDark) {
          img.style.setProperty('filter', 'brightness(0.8) contrast(1.1)', 'important')
        } else {
          img.style.removeProperty('filter')
        }
      })
    }

    const observer = new MutationObserver(darkModeHandler)

    document.addEventListener('astro:page-load', () => {
      observer.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['class'],
      })
      darkModeHandler()

      document.querySelectorAll('.markdown img').forEach((img) => {
        img.addEventListener('mouseenter', () => {
          if (img.classList.contains('noDarken')) return
          img.style.removeProperty('filter')
        })
        img.addEventListener('mouseleave', () => {
          if (img.classList.contains('noDarken')) return
          if (img.classList.contains('lazy-image') && !img.classList.contains('lazy-image-loaded')) return
          
          if (document.documentElement.classList.contains('dark')) {
            img.style.setProperty('filter', 'brightness(0.8) contrast(1.1)', 'important')
          }
        })
      })
    })

    window.addEventListener('lazyImageLoaded', darkModeHandler)
  }
</script>