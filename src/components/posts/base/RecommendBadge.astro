---
import { cn } from '~/lib/utils'

interface Props {
  class?: string
  variant?: 'default' | 'gradient' | 'subtle' | 'outline'
  size?: 'sm' | 'md'
  showIcon?: boolean
}

const { class: className, variant = 'gradient', size = 'sm', showIcon = true }: Props = Astro.props

const sizeClasses = {
  sm: 'text-[10px] px-2 py-0.5 gap-1',
  md: 'text-xs px-2.5 py-1 gap-1.5',
}

const variantClasses = {
  default: 'bg-primary text-primary-foreground border border-primary hover:bg-primary/90',
  gradient: 'bg-primary text-primary-foreground border border-primary hover:bg-primary/90',
  subtle: 'bg-transparent text-primary border border-primary/40 hover:border-primary',
  outline: 'bg-transparent text-foreground border border-foreground/30 hover:border-foreground',
}
---

<span
  class={cn(
    'inline-flex items-center font-mono font-semibold uppercase tracking-[0.1em] transition-colors duration-150',
    sizeClasses[size],
    variantClasses[variant],
    className
  )}
  title="Recommended post"
>
  {showIcon && <span class="icon-[ph--asterisk] opacity-80" />}
  <span class="tracking-[0.12em]">推荐</span>
</span>
