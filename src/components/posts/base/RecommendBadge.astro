---
import { cn } from '~/lib/utils'

interface Props {
  class?: string
  variant?: 'default' | 'gradient' | 'subtle' | 'outline'
  size?: 'sm' | 'md'
  showIcon?: boolean
}

const { class: className, variant = 'gradient', size = 'sm', showIcon = true }: Props = Astro.props

const sizeClasses = {
  sm: 'text-[10px] px-2.5 py-0.5 gap-1',
  md: 'text-[11px] px-3 py-1 gap-1.5',
}

const variantClasses = {
  default: 'bg-primary text-primary-foreground border border-primary hover:bg-primary/90',
  gradient: 'bg-accent-soft text-accent-foreground border border-primary/25 hover:bg-primary hover:text-primary-foreground',
  subtle: 'bg-accent-soft text-accent-foreground border border-primary/25 hover:border-primary/50',
  outline: 'bg-transparent text-foreground border border-border hover:border-primary/40',
}
---

<span
  class={cn(
    'inline-flex items-center rounded-full font-semibold tracking-[0.02em] transition-colors duration-150',
    sizeClasses[size],
    variantClasses[variant],
    className
  )}
  title="Recommended post"
>
  {showIcon && <span class="icon-[ph--asterisk] opacity-80" />}
  <span class="tracking-[0.12em]">推荐</span>
</span>
