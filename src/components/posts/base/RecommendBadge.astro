---
import { cn } from '~/lib/utils'

interface Props {
  class?: string
  variant?: 'default' | 'gradient' | 'subtle' | 'outline'
  size?: 'sm' | 'md'
  showIcon?: boolean
}

const { class: className, variant = 'gradient', size = 'sm', showIcon = true }: Props = Astro.props

const sizeClasses = {
  sm: 'text-xs px-2.5 py-1 gap-1',
  md: 'text-sm px-3 py-1.5 gap-1.5',
}

const variantClasses = {
  default: 'bg-primary/10 text-primary hover:bg-primary/20 border border-primary/20',
  gradient:
    'border border-primary/25 bg-gradient-to-r from-sky-400/20 via-blue-400/20 to-indigo-400/20 text-primary hover:from-sky-400/30 hover:via-blue-400/30 hover:to-indigo-400/30',
  subtle: 'bg-accent/60 text-primary hover:bg-accent border border-primary/20',
  outline: 'bg-background/50 text-muted-foreground border border-primary/20 hover:bg-accent hover:text-primary',
}
---

<span
  class={cn(
    'inline-flex items-center font-semibold rounded-full transition-all duration-200',
    sizeClasses[size],
    variantClasses[variant],
    className
  )}
  title="Recommended post"
>
  {showIcon && <span class="icon-[ph--sparkle-fill] opacity-80 text-sky-400" />}
  <span class="font-semibold tracking-wide">推荐</span>
</span>
