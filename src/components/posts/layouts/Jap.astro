---
import { formatDate } from '~/lib/utils'
import Prose from '~/components/posts/base/Prose.astro'

interface Props {
  frontmatter: any
  minutesRead?: string
}

const { frontmatter, minutesRead } = Astro.props
---

<article class="relative fade-up">
  <div class="px-6 sm:px-8 py-10 sm:py-12">
    <div class="max-w-4xl">
      <header class="mb-16 space-y-10">
        <div class="inline-block px-4 py-2 text-xs text-muted-foreground/70 bg-muted/50 rounded font-semibold tracking-wide">ARTICLE</div>

        <div class="space-y-8">
          <h1 class="text-3xl md:text-4xl font-semibold font-serif leading-[1.1] tracking-tight text-foreground" data-pagefind-body>
            {frontmatter.title}
          </h1>

          {frontmatter.description && <p class="text-base sm:text-lg text-muted-foreground leading-[1.7] max-w-2xl">{frontmatter.description}</p>}
        </div>

        <div class="text-xs text-muted-foreground/60 font-mono tracking-wide">
          <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-6">
            <span>{formatDate(frontmatter.pubDate)}</span>
            {frontmatter.updatedDate && <span>UPDATED {formatDate(frontmatter.updatedDate)}</span>}
            {minutesRead && <span>{minutesRead} MIN READ</span>}
          </div>
        </div>

        {
          frontmatter.tags && frontmatter.tags.length > 0 && (
            <div class="flex flex-wrap gap-3 max-w-2xl">
              {frontmatter.tags.map((tag: string) => (
                <a
                  href={`/tags/${tag}`}
                  class="px-4 py-2 text-xs font-semibold text-center 
                       text-muted-foreground/70 bg-muted/40 
                       hover:text-primary hover:bg-muted/60
                       transition-all duration-300 rounded"
                >
                  {tag.toUpperCase()}
                </a>
              ))}
            </div>
          )
        }
        <div class="border-t border-border/40 mt-10 pt-0"></div>
      </header>

      <Prose>
        <slot />
      </Prose>
    </div>
  </div>
</article>
