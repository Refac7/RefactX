---
import { formatDate } from '~/lib/utils'
import Prose from '~/components/posts/base/Prose.astro'
import TableOfContent from '~/components/posts/toc/TableOfContents.astro'

interface Props {
  frontmatter: any
  minutesRead?: string
  wordCount?: number
  headings?: any[]
}

const { frontmatter, minutesRead, wordCount, headings } = Astro.props

const meta = [
  {
    label: 'Author',
    value: frontmatter.author,
    icon: 'icon-[ph--user]',
    href: frontmatter.author ? `/authors/${frontmatter.author}` : undefined,
  },
  { label: 'Published', value: formatDate(frontmatter.pubDate), icon: 'icon-[ph--calendar-blank]' },
  { label: 'Reading', value: minutesRead || 'Unknown', icon: 'icon-[ph--clock]' },
  { label: 'Words', value: wordCount ? String(wordCount) : undefined, icon: 'icon-[ph--article]' },
  {
    label: 'Updated',
    value: frontmatter.updatedDate ? formatDate(frontmatter.updatedDate) : undefined,
    icon: 'icon-[ph--clock-clockwise]',
  },
].filter((item) => item.value)
---

<article class="relative w-full">
  <!-- Header -->
  <header class="relative w-full overflow-hidden border-b border-border">
    <span
      aria-hidden="true"
      class="pointer-events-none absolute -top-16 right-[6%] hidden font-serif text-[18rem] leading-none text-primary/[0.05] select-none lg:block"
      >✳</span
    >

    <div class="relative mx-auto w-full max-w-[1920px] px-5 pt-10 pb-12 sm:px-8 md:px-12 md:pt-16 md:pb-16">
      <!-- Top bar: back button + status -->
      <div class="flex items-center justify-between gap-4">
        <a
          href="/posts"
          class="group inline-flex items-center gap-2.5 text-[12px] font-medium text-muted-foreground transition-colors hover:text-primary"
        >
          <span
            class="inline-flex size-9 items-center justify-center rounded-full border border-border bg-card text-foreground transition-colors group-hover:border-primary/40 group-hover:text-primary"
          >
            <span class="icon-[ph--arrow-left] size-4"></span>
          </span>
          <span class="hidden sm:inline">返回文章列表</span>
        </a>

        <span
          class="inline-flex items-center gap-2 rounded-full border border-border bg-card px-3.5 py-1.5 text-[11px] font-medium text-muted-foreground select-none"
        >
          <span class="size-1.5 rounded-full bg-success"></span>
          Published
        </span>
      </div>

      <!-- Title (left) + metadata spec sheet (right) -->
      <div class="mt-12 grid grid-cols-1 items-end gap-10 md:mt-16 lg:grid-cols-12 lg:gap-14">
        <div class="lg:col-span-8">
          <div
            class="mb-5 flex items-center gap-2.5 text-[11px] font-semibold tracking-[0.14em] text-muted-foreground uppercase select-none"
          >
            <span class="size-6 rounded-lg bg-primary/10 text-center text-[10px] leading-6 text-primary">✳</span>
            <span>Article</span>
            <span class="h-px w-8 bg-border"></span>
            <span class="text-primary">{frontmatter.tags?.[0] || 'Notes'}</span>
          </div>

          <h1
            data-pagefind-body
            class="font-serif text-4xl leading-[1.02] font-medium tracking-[-0.035em] text-foreground sm:text-5xl md:text-6xl lg:text-[4.5rem]"
          >
            {frontmatter.title}
          </h1>

          {
            frontmatter.description && (
              <p class="mt-6 max-w-2xl text-base leading-relaxed text-muted-foreground sm:text-lg">{frontmatter.description}</p>
            )
          }
        </div>

        <div class="w-full lg:col-span-4">
          <dl class="overflow-hidden rounded-2xl border border-border bg-card shadow-soft">
            {
              meta.map((item) => (
                <div class="flex items-center justify-between gap-4 border-b border-border/60 px-4 py-3 last:border-b-0">
                  <dt class="flex items-center gap-2 text-[10px] font-semibold tracking-[0.1em] text-muted-foreground/70 uppercase">
                    <span class={`${item.icon} size-3.5 text-primary/70`} />
                    {item.label}
                  </dt>
                  <dd class="text-right text-[12px] font-medium tabular-nums text-foreground/90">
                    {item.href ? (
                      <a href={item.href} class="transition-colors hover:text-primary">
                        {item.value}
                      </a>
                    ) : (
                      item.value
                    )}
                  </dd>
                </div>
              ))
            }
          </dl>

          {
            frontmatter.tags && frontmatter.tags.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-2">
                {frontmatter.tags.map((tag: string) => (
                  <a
                    href={`/tags/${tag}`}
                    class="inline-flex items-center rounded-full border border-border bg-tag-bg px-3 py-1 text-[10px] font-medium text-muted-foreground transition-colors hover:border-primary/40 hover:bg-accent-soft hover:text-accent-foreground"
                  >
                    #{tag}
                  </a>
                ))}
              </div>
            )
          }
        </div>
      </div>
    </div>
  </header>

  <!-- Content area -->
  <div class="swiss-grid relative border-b border-border">
    <div class="relative mx-auto w-full max-w-[1920px] px-5 py-12 sm:px-8 md:px-12 md:py-20">
      <div class="relative flex w-full flex-col items-start justify-center gap-10 xl:flex-row xl:gap-24">
        <div class="relative mx-auto w-full max-w-3xl shrink-0">
          <Prose>
            <slot />
          </Prose>
        </div>

        {headings && headings.length > 0 && <TableOfContent headings={headings} />}
      </div>
    </div>
  </div>
</article>
