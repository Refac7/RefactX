---
import { formatDate } from '~/lib/utils'
import Prose from '~/components/posts/base/Prose.astro'
import TableOfContent from '~/components/posts/toc/TableOfContents.astro'

interface Props {
  frontmatter: any
  minutesRead?: string
  wordCount?: number
  headings?: any[]
}

const { frontmatter, minutesRead, wordCount, headings } = Astro.props
---

<article class="relative w-full">
  
  <header class="relative w-full min-h-[50vh] flex flex-col justify-center px-6 md:px-12 py-24 border-b border-border/40 bg-muted/5">
     
     <div class="absolute top-8 left-6 md:left-12 flex items-center gap-2 sm:flex">
       <a href="/posts" class="inline-flex items-center justify-center size-8 rounded-full bg-background border border-border/40 shadow-sm text-muted-foreground hover:text-foreground transition-colors">
         <span class="icon-[ph--arrow-left] size-4"></span>
       </a>
     </div>

     <div class="absolute top-8 right-6 md:right-12 text-xs font-medium text-muted-foreground">
       {formatDate(frontmatter.pubDate)}
     </div>

     <div class="absolute bottom-8 left-6 md:left-12 flex flex-wrap gap-2 max-w-[50vw]">
        {frontmatter.tags && frontmatter.tags.map((tag: string) => (
          <a href={`/tags/${tag}`} class="text-xs font-medium bg-background border border-border/40 text-muted-foreground hover:text-foreground shadow-sm px-3 py-1 rounded-full transition-colors">
            {tag}
          </a>
        ))}
     </div>

     <div class="absolute bottom-8 right-6 md:right-12 flex flex-col items-end gap-1 text-xs font-medium text-muted-foreground text-right sm:flex">
       <span>{wordCount} Words</span>
       <span>{minutesRead || 'Unknown'} Read</span>
     </div>
     
     <div class="max-w-4xl mx-auto text-center z-10 w-full">
       <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-foreground leading-tight sm:leading-[1.1]" data-pagefind-body>
         {frontmatter.title}
       </h1>
       {frontmatter.description && (
         <p class="mt-6 text-base sm:text-lg text-muted-foreground max-w-2xl mx-auto leading-relaxed">
           {frontmatter.description}
         </p>
       )}
       {frontmatter.updatedDate && (
         <p class="mt-6 text-xs font-medium text-muted-foreground/60 flex items-center justify-center gap-1.5">
           <span class="icon-[ph--clock-clockwise]"></span>
           Updated {formatDate(frontmatter.updatedDate)}
         </p>
       )}
     </div>
  </header>

  <div class="relative bg-[linear-gradient(to_right,#8080800a_1px,transparent_1px),linear-gradient(to_bottom,#8080800a_1px,transparent_1px)] bg-[size:48px_48px]">
    <div class="relative w-full max-w-[1920px] mx-auto px-6 md:px-12 py-12 md:py-20">
      <div class="relative w-full flex flex-col xl:flex-row items-start justify-center gap-10 xl:gap-24">
        
        <div class="w-full mx-auto max-w-4xl shrink-0 relative">
          <Prose>
            <slot />
          </Prose>
        </div>
        
        {headings && headings.length > 0 && (
          <TableOfContent headings={headings} />
        )}

      </div>    
    </div>   
  </div>
</article>