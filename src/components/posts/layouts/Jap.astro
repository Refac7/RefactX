---
import { formatDate } from '~/lib/utils'
import Prose from '~/components/posts/base/Prose.astro'
import TableOfContent from '~/components/posts/toc/TableOfContents.astro'

interface Props {
  frontmatter: any
  minutesRead?: string
  wordCount?: number
  headings?: any[]
}

const { frontmatter, minutesRead, wordCount, headings } = Astro.props

const meta = [
  {
    label: 'Author',
    value: frontmatter.author,
    icon: 'icon-[ph--user]',
    href: frontmatter.author ? `/authors/${frontmatter.author}` : undefined,
  },
  { label: 'Published', value: formatDate(frontmatter.pubDate), icon: 'icon-[ph--calendar-blank]' },
  { label: 'Reading', value: minutesRead || 'Unknown', icon: 'icon-[ph--clock]' },
  { label: 'Words', value: wordCount ? String(wordCount) : undefined, icon: 'icon-[ph--article]' },
  {
    label: 'Updated',
    value: frontmatter.updatedDate ? formatDate(frontmatter.updatedDate) : undefined,
    icon: 'icon-[ph--clock-clockwise]',
  },
].filter((item) => item.value)
---

<article class="relative w-full">
  <!-- Header -->
  <header class="relative w-full border-b border-border/40 overflow-hidden">
    <div class="relative w-full max-w-[1920px] mx-auto px-6 md:px-12 pt-12 md:pt-20 pb-12 md:pb-16">
      <!-- Top bar: back button + status -->
      <div class="flex items-center justify-between gap-4">
        <a
          href="/posts"
          class="group inline-flex items-center gap-2.5 text-xs font-mono text-muted-foreground hover:text-foreground transition-colors"
        >
          <span
            class="inline-flex items-center justify-center size-8 rounded-lg border border-border/40 bg-background/50 text-muted-foreground transition-all group-hover:border-primary/30 group-hover:bg-primary/5 group-hover:text-primary"
          >
            <span class="icon-[ph--arrow-left] size-4"></span>
          </span>
          <span class="hidden sm:inline uppercase tracking-widest">// Return_Index</span>
        </a>

        <span
          class="inline-flex items-center gap-1.5 rounded-full border border-border/40 bg-muted/30 px-3 py-1 text-[10px] font-mono text-muted-foreground select-none"
        >
          <span class="relative flex size-1.5">
            <span class="relative inline-flex size-1.5 rounded-full bg-success"></span>
          </span>
          Published
        </span>
      </div>

      <!-- Title (left) + metadata spec sheet (right) -->
      <div class="mt-12 md:mt-16 grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-end">
        <div class="lg:col-span-8">
          <div class="mb-5 flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.2em] text-muted-foreground/70 select-none">
            <span class="size-1.5 rounded-full bg-primary"></span>
            <span>Article</span>
            <span class="h-px w-8 bg-border"></span>
            <span>{frontmatter.tags?.[0] || 'Notes'}</span>
          </div>

          <h1
            data-pagefind-body
            class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-foreground leading-tight sm:leading-[1.08]"
          >
            {frontmatter.title}
          </h1>

          {
            frontmatter.description && (
              <p class="mt-6 max-w-2xl text-base sm:text-lg leading-relaxed text-muted-foreground">{frontmatter.description}</p>
            )
          }
        </div>

        <div class="lg:col-span-4 w-full">
          <dl class="overflow-hidden rounded-xl border border-border/40 bg-background/50 divide-y divide-border/40">
            {
              meta.map((item) => (
                <div class="flex items-center justify-between gap-4 px-4 py-3">
                  <dt class="flex items-center gap-2 font-mono text-[10px] uppercase tracking-widest text-muted-foreground/60">
                    <span class={`${item.icon} size-3.5`} />
                    {item.label}
                  </dt>
                  <dd class="text-xs font-medium text-foreground/90">
                    {item.href ? (
                      <a href={item.href} class="transition-colors hover:text-primary">
                        {item.value}
                      </a>
                    ) : (
                      item.value
                    )}
                  </dd>
                </div>
              ))
            }
          </dl>

          {
            frontmatter.tags && frontmatter.tags.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-2">
                {frontmatter.tags.map((tag: string) => (
                  <a
                    href={`/tags/${tag}`}
                    class="inline-flex items-center rounded-full border border-border/40 bg-background/50 px-3 py-1 text-[11px] font-mono font-medium text-muted-foreground backdrop-blur-sm transition-all hover:border-primary/30 hover:bg-primary/5 hover:text-primary"
                  >
                    #{tag}
                  </a>
                ))}
              </div>
            )
          }
        </div>
      </div>
    </div>
  </header>

  <!-- Content area -->
  <div
    class="relative bg-[linear-gradient(to_right,#8080800a_1px,transparent_1px),linear-gradient(to_bottom,#8080800a_1px,transparent_1px)] bg-size-[48px_48px]"
  >
    <div class="relative w-full max-w-[1920px] mx-auto px-6 md:px-12 py-12 md:py-20">
      <div class="relative w-full flex flex-col xl:flex-row items-start justify-center gap-10 xl:gap-24">
        <div class="w-full mx-auto max-w-3xl shrink-0 relative">
          <Prose>
            <slot />
          </Prose>
        </div>

        {headings && headings.length > 0 && <TableOfContent headings={headings} />}
      </div>
    </div>
  </div>
</article>
