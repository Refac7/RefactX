---
import { formatDate } from '~/lib/utils'
import Prose from '~/components/posts/base/Prose.astro'
import TableOfContent from '~/components/posts/toc/TableOfContents.astro'

interface Props {
  frontmatter: any
  minutesRead?: string
  wordCount?: number
  headings?: any[]
}

const { frontmatter, minutesRead, wordCount, headings } = Astro.props

const meta = [
  {
    label: 'Author',
    value: frontmatter.author,
    icon: 'icon-[ph--user]',
    href: frontmatter.author ? `/authors/${frontmatter.author}` : undefined,
  },
  { label: 'Published', value: formatDate(frontmatter.pubDate), icon: 'icon-[ph--calendar-blank]' },
  { label: 'Reading', value: minutesRead || 'Unknown', icon: 'icon-[ph--clock]' },
  { label: 'Words', value: wordCount ? String(wordCount) : undefined, icon: 'icon-[ph--article]' },
  {
    label: 'Updated',
    value: frontmatter.updatedDate ? formatDate(frontmatter.updatedDate) : undefined,
    icon: 'icon-[ph--clock-clockwise]',
  },
].filter((item) => item.value)
---

<article class="relative w-full">
  <!-- Header -->
  <header class="relative w-full overflow-hidden border-b-2 border-foreground">
    <div class="relative mx-auto w-full max-w-[1920px] px-5 pb-10 pt-10 sm:px-8 md:px-12 md:pb-14 md:pt-16">
      <!-- Top bar: back button + status -->
      <div class="flex items-center justify-between gap-4">
        <a
          href="/posts"
          class="group inline-flex items-center gap-2.5 font-mono text-[10px] uppercase tracking-[0.16em] text-muted-foreground transition-colors hover:text-primary"
        >
          <span
            class="inline-flex size-8 items-center justify-center border border-foreground/30 text-foreground transition-colors group-hover:border-primary group-hover:text-primary"
          >
            <span class="icon-[ph--arrow-left] size-4"></span>
          </span>
          <span class="hidden sm:inline">Return_Index</span>
        </a>

        <span
          class="inline-flex select-none items-center gap-2 border border-foreground/30 px-3 py-1.5 font-mono text-[9px] uppercase tracking-[0.18em] text-muted-foreground"
        >
          <span class="size-1.5 bg-success"></span>
          Published
        </span>
      </div>

      <!-- Title (left) + metadata spec sheet (right) -->
      <div class="mt-12 grid grid-cols-1 items-end gap-10 md:mt-16 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-8">
          <div class="mb-5 flex select-none items-center gap-3 font-mono text-[10px] uppercase tracking-[0.2em] text-muted-foreground">
            <span class="size-2 bg-primary"></span>
            <span>Article</span>
            <span class="h-px w-8 bg-foreground/30"></span>
            <span>{frontmatter.tags?.[0] || 'Notes'}</span>
          </div>

          <h1
            data-pagefind-body
            class="text-4xl font-bold leading-[0.94] tracking-[-0.05em] text-foreground sm:text-5xl md:text-6xl lg:text-7xl"
          >
            {frontmatter.title}
          </h1>

          {
            frontmatter.description && (
              <p class="mt-6 max-w-2xl text-base leading-relaxed text-muted-foreground sm:text-lg">{frontmatter.description}</p>
            )
          }
        </div>

        <div class="w-full lg:col-span-4">
          <dl class="divide-y divide-foreground/20 border border-foreground/30 bg-background">
            {
              meta.map((item) => (
                <div class="flex items-center justify-between gap-4 px-4 py-2.5">
                  <dt class="flex items-center gap-2 font-mono text-[9px] uppercase tracking-[0.16em] text-muted-foreground/70">
                    <span class={`${item.icon} size-3.5`} />
                    {item.label}
                  </dt>
                  <dd class="text-right font-mono text-[11px] font-medium tabular-nums text-foreground/90">
                    {item.href ? (
                      <a href={item.href} class="transition-colors hover:text-primary">
                        {item.value}
                      </a>
                    ) : (
                      item.value
                    )}
                  </dd>
                </div>
              ))
            }
          </dl>

          {
            frontmatter.tags && frontmatter.tags.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-1.5">
                {frontmatter.tags.map((tag: string) => (
                  <a
                    href={`/tags/${tag}`}
                    class="inline-flex items-center border border-foreground/30 bg-background px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.08em] text-muted-foreground transition-colors hover:border-primary hover:bg-primary hover:text-primary-foreground"
                  >
                    #{tag}
                  </a>
                ))}
              </div>
            )
          }
        </div>
      </div>
    </div>
  </header>

  <!-- Content area -->
  <div class="swiss-grid relative border-b-2 border-foreground">
    <div class="relative mx-auto w-full max-w-[1920px] px-5 py-12 sm:px-8 md:px-12 md:py-20">
      <div class="relative flex w-full flex-col items-start justify-center gap-10 xl:flex-row xl:gap-24">
        <div class="relative mx-auto w-full max-w-3xl shrink-0">
          <Prose>
            <slot />
          </Prose>
        </div>

        {headings && headings.length > 0 && <TableOfContent headings={headings} />}
      </div>
    </div>
  </div>
</article>
