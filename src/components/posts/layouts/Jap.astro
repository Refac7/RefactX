---
import { formatDate } from '~/lib/utils'
import Prose from '~/components/posts/base/Prose.astro'
import TableOfContent from '~/components/posts/toc/TableOfContents.astro'

interface Props {
  frontmatter: any
  minutesRead?: string
  wordCount?: number
  headings?: any[]
}

const { frontmatter, minutesRead, wordCount, headings } = Astro.props
const heroImage = frontmatter.heroImage && frontmatter.heroImage !== 'none' ? frontmatter.heroImage : null

const meta = [
  {
    label: '作者',
    value: frontmatter.author,
    icon: 'icon-[ph--user]',
    href: frontmatter.author ? `/authors/${frontmatter.author}` : undefined,
  },
  { label: '发布', value: formatDate(frontmatter.pubDate), icon: 'icon-[ph--calendar-blank]' },
  { label: '阅读', value: minutesRead || '未知', icon: 'icon-[ph--clock]' },
  { label: '字数', value: wordCount ? String(wordCount) : undefined, icon: 'icon-[ph--article]' },
  {
    label: '更新',
    value: frontmatter.updatedDate ? formatDate(frontmatter.updatedDate) : undefined,
    icon: 'icon-[ph--clock-clockwise]',
  },
].filter((item) => item.value)
---

<article class="relative w-full">
  <header class="article-header">
    <div class="article-header__glow" aria-hidden="true"></div>

    <div class="container-page relative z-10 pt-10 sm:pt-14">
      <div class="flex items-center justify-between gap-4">
        <a href="/posts" class="article-back">
          <span class="article-back__icon">
            <span class="icon-[ph--arrow-left] size-4"></span>
          </span>
          <span>返回文章</span>
        </a>

        <span class="article-status">
          <span class="size-1.5 rounded-full bg-success"></span>
          Published
        </span>
      </div>

      <div class="mx-auto mt-12 mb-12 max-w-4xl text-center sm:mt-16">
        <div class="article-eyebrow">
          <span>Article</span>
          <span class="article-eyebrow__line"></span>
          <span>{frontmatter.tags?.[0] || 'Notes'}</span>
        </div>

        <h1 data-pagefind-body class="article-title">{frontmatter.title}</h1>

        {frontmatter.description && <p class="article-desc">{frontmatter.description}</p>}

        <div class="article-meta">
          {
            meta.map((item) => (
              <span class="article-meta__item">
                <span class={`${item.icon} size-3.5`} />
                {item.href ? (
                  <a href={item.href} class="transition-colors hover:text-accent-foreground">
                    {item.value}
                  </a>
                ) : (
                  item.value
                )}
              </span>
            ))
          }
        </div>

        {
          frontmatter.tags && frontmatter.tags.length > 0 && (
            <div class="mt-5 flex flex-wrap justify-center gap-2">
              {frontmatter.tags.map((tag: string) => (
                <a href={`/tags/${tag}`} class="chip">
                  #{tag}
                </a>
              ))}
            </div>
          )
        }
      </div>
    </div>

    {
      heroImage && (
        <div class="container-page relative z-10 pb-4 pt-10 sm:pt-14">
          <div class="article-cover">
            <img
              src={heroImage}
              alt={frontmatter.title}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              onload="this.classList.add('is-loaded')"
            />
          </div>
        </div>
      )
    }
  </header>

  <div class="container-page py-12 sm:py-16">
    <div class="flex flex-col items-start gap-12 xl:flex-row xl:justify-center xl:gap-16">
      <div class="mx-auto w-full max-w-3xl min-w-0">
        <Prose>
          <slot />
        </Prose>
      </div>

      {headings && headings.length > 0 && <TableOfContent headings={headings} />}
    </div>
  </div>
</article>
