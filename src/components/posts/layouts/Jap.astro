---
import { formatDate } from '~/lib/utils'
import Prose from '~/components/posts/base/Prose.astro'
import TableOfContent from '~/components/posts/toc/TableOfContents.astro'

interface Props {
  frontmatter: any
  minutesRead?: string
  wordCount?: number
  headings?: any[]
}

const { frontmatter, minutesRead, wordCount, headings } = Astro.props
---

<article class="relative w-full">
  <!-- Header -->
  <header
    class="lg:blueprint-hatch relative w-full min-h-[50vh] flex flex-col justify-center px-6 md:px-12 py-24 border-b border-border/40 overflow-hidden"
  >
    <!-- Top bar: back button + status -->
    <div class="absolute top-8 left-6 md:left-12 right-6 md:right-12 flex items-center justify-between">
      <a
        href="/posts"
        class="group inline-flex items-center gap-2.5 text-xs font-mono text-muted-foreground hover:text-foreground transition-colors"
      >
        <span
          class="inline-flex items-center justify-center size-8 bg-background/50 border border-border/40 text-muted-foreground group-hover:text-foreground group-hover:border-primary/30 group-hover:bg-primary/5 transition-all"
        >
          <span class="icon-[ph--arrow-left] size-4"></span>
        </span>
        <span class="hidden sm:inline uppercase tracking-widest">// Return_Index</span>
      </a>

      <span
        class="inline-flex items-center gap-1.5 bg-muted/30 border border-border/40 px-3 py-1 text-[10px] font-mono text-muted-foreground select-none"
      >
        <span class="relative flex size-1.5">
          <span class="relative inline-flex rounded-full size-1.5 bg-emerald-500"></span>
        </span>
        Published
      </span>
    </div>

    <!-- Bottom bar: tags (left) + metadata (right) -->
    <div class="absolute bottom-8 left-6 md:left-12 right-6 md:right-12 flex flex-wrap items-center gap-x-4 gap-y-2 justify-between">
      <!-- Tags -->
      <div class="flex flex-wrap gap-2">
        {
          frontmatter.tags &&
            frontmatter.tags.map((tag: string) => (
              <a
                href={`/tags/${tag}`}
                class="text-[11px] font-mono font-medium bg-background/50 backdrop-blur-sm border border-border/40 text-muted-foreground hover:text-foreground hover:border-primary/30 hover:bg-primary/5 px-3 py-1 transition-all"
              >
                #{tag}
              </a>
            ))
        }
      </div>

      <!-- Metadata: compact on mobile, full on sm+ -->
      <div
        class="flex flex-wrap items-center gap-x-2 sm:gap-x-3 gap-y-1 text-[10px] font-mono text-muted-foreground uppercase tracking-widest select-none"
      >
        {
          frontmatter.author && (
            <>
              <a
                href={`/authors/${frontmatter.author}`}
                class="flex items-center gap-1.5 hover:text-foreground hover:underline transition-colors"
              >
                <span class="icon-[ph--user] size-3.5" />
                {frontmatter.author}
              </a>
              <span class="w-1 h-1 rounded-full bg-border hidden sm:inline" />
              <span class="w-1 h-1 rounded-full bg-border sm:hidden" />
            </>
          )
        }
        <span class="hidden sm:flex items-center gap-1.5">
          <span class="icon-[ph--article] size-3.5"></span>
          {wordCount} words
        </span>
        <span class="hidden sm:inline w-1 h-1 rounded-full bg-border"></span>
        <span class="flex items-center gap-1.5">
          <span class="icon-[ph--clock] size-3.5"></span>
          {minutesRead || 'Unknown'}
        </span>
        <span class="w-1 h-1 rounded-full bg-border"></span>
        <span>{formatDate(frontmatter.pubDate)}</span>
      </div>
    </div>

    <!-- Title + description -->
    <div class="max-w-4xl mx-auto z-10 w-full">
      <h1
        class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-foreground leading-tight sm:leading-[1.1]"
        data-pagefind-body
      >
        {frontmatter.title}
      </h1>
      {
        frontmatter.description && (
          <div class="mt-6 relative">
            <p class="text-base sm:text-lg text-muted-foreground max-w-2xl leading-relaxed">{frontmatter.description}</p>
          </div>
        )
      }
      {
        frontmatter.updatedDate && (
          <p class="mt-6 text-[10px] font-mono text-muted-foreground/50 uppercase tracking-widest flex items-center gap-1.5">
            <span class="icon-[ph--clock-clockwise] size-3" />
            Updated {formatDate(frontmatter.updatedDate)}
          </p>
        )
      }
    </div>
  </header>

  <!-- Content area -->
  <div
    class="relative bg-[linear-gradient(to_right,#8080800a_1px,transparent_1px),linear-gradient(to_bottom,#8080800a_1px,transparent_1px)] bg-size-[48px_48px]"
  >
    <div class="relative w-full max-w-[1920px] mx-auto px-6 md:px-12 py-12 md:py-20">
      <div class="relative w-full flex flex-col xl:flex-row items-start justify-center gap-10 xl:gap-24">
        <div class="w-full mx-auto max-w-3xl shrink-0 relative">
          <Prose>
            <slot />
          </Prose>
        </div>

        {headings && headings.length > 0 && <TableOfContent headings={headings} />}
      </div>
    </div>
  </div>
</article>
