---
import { formatDate } from '~/lib/utils'
import Prose from '~/components/posts/base/Prose.astro'
import TableOfContent from '~/components/posts/toc/TableOfContents.astro'

interface Props {
  frontmatter: any
  minutesRead?: string
  wordCount?: number
  headings?: any[]
}

const { frontmatter, minutesRead, wordCount, headings } = Astro.props
const heroImage = frontmatter.heroImage && frontmatter.heroImage !== 'none' ? frontmatter.heroImage : null

const meta = [
  {
    label: '作者',
    value: frontmatter.author,
    icon: 'icon-[ph--user]',
    href: frontmatter.author ? `/authors/${frontmatter.author}` : undefined,
  },
  { label: '发布', value: formatDate(frontmatter.pubDate), icon: 'icon-[ph--calendar-blank]' },
  { label: '阅读', value: minutesRead || '未知', icon: 'icon-[ph--clock]' },
  { label: '字数', value: wordCount ? String(wordCount) : undefined, icon: 'icon-[ph--article]' },
  {
    label: '更新',
    value: frontmatter.updatedDate ? formatDate(frontmatter.updatedDate) : undefined,
    icon: 'icon-[ph--clock-clockwise]',
  },
].filter((item) => item.value)
---

<article class="relative w-full">
  <header class="article-header">
    <div class="article-header__glow" aria-hidden="true"></div>

    <div class="container-page relative z-10 pt-10 sm:pt-14">
      <div class="flex items-center justify-between gap-4">
        <a href="/posts" class="article-back">
          <span class="article-back__icon">
            <span class="icon-[ph--arrow-left] size-4"></span>
          </span>
          <span>返回文章</span>
        </a>

        <span class="article-status">
          <span class="size-1.5 rounded-full bg-success"></span>
          Published
        </span>
      </div>

      <div class="mx-auto mt-12 mb-12 max-w-4xl text-center sm:mt-16">
        <div class="article-eyebrow">
          <span>Article</span>
          <span class="article-eyebrow__line"></span>
          <span>{frontmatter.tags?.[0] || 'Notes'}</span>
        </div>

        <h1 data-pagefind-body class="article-title">{frontmatter.title}</h1>

        {frontmatter.description && <p class="article-desc">{frontmatter.description}</p>}

        <div class="article-meta">
          {
            meta.map((item) => (
              <span class="article-meta__item">
                <span class={`${item.icon} size-3.5`} />
                {item.href ? (
                  <a href={item.href} class="transition-colors hover:text-accent-foreground">
                    {item.value}
                  </a>
                ) : (
                  item.value
                )}
              </span>
            ))
          }
        </div>

        {
          frontmatter.tags && frontmatter.tags.length > 0 && (
            <div class="mt-5 flex flex-wrap justify-center gap-2">
              {frontmatter.tags.map((tag: string) => (
                <a href={`/tags/${tag}`} class="chip">
                  #{tag}
                </a>
              ))}
            </div>
          )
        }
      </div>
    </div>

    {
      heroImage && (
        <div class="container-page relative z-10 pb-4 pt-10 sm:pt-14">
          <div class="article-cover">
            <img
              src={heroImage}
              alt={frontmatter.title}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              onload="this.classList.add('is-loaded')"
            />
          </div>
        </div>
      )
    }
  </header>

  <div class="container-page py-12 sm:py-16">
    <slot name="toc" />
    <div class="flex flex-col items-start gap-12 xl:flex-row xl:justify-center xl:gap-16">
      <div class="mx-auto w-full max-w-3xl min-w-0">
        <Prose>
          <slot />
        </Prose>
      </div>

      {headings && headings.length > 0 && <TableOfContent headings={headings} />}
    </div>
  </div>
</article>

<style>
  .article-header {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid hsl(var(--border) / 0.65);
    background:
      radial-gradient(50rem 26rem at 50% -10%, hsl(var(--primary) / 0.2), transparent 64%),
      linear-gradient(180deg, hsl(var(--card) / 0.5), transparent);
  }

  .article-header__glow {
    position: absolute;
    top: -12rem;
    left: 50%;
    width: 46rem;
    height: 26rem;
    transform: translateX(-50%);
    border-radius: 999px;
    background: hsl(var(--primary) / 0.16);
    filter: blur(80px);
    pointer-events: none;
  }

  .article-back {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.78rem;
    font-weight: 500;
    color: hsl(var(--muted-foreground));
    text-decoration: none;
    transition: color 180ms ease;
  }

  .article-back:hover {
    color: hsl(var(--foreground));
  }

  .article-back__icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    border: 1px solid hsl(var(--border) / 0.8);
    background: hsl(var(--card));
    transition:
      transform 180ms ease,
      border-color 180ms ease;
  }

  .article-back:hover .article-back__icon {
    transform: translateX(-2px);
    border-color: hsl(var(--primary) / 0.45);
  }

  .article-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.32rem 0.65rem;
    border-radius: 999px;
    border: 1px solid hsl(var(--border) / 0.8);
    background: hsl(var(--card) / 0.7);
    font-family: var(--font-geist-mono);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
  }

  .article-eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    font-family: var(--font-geist-mono);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: hsl(var(--accent-foreground));
  }

  .article-eyebrow__line {
    width: 2rem;
    height: 1px;
    background: hsl(var(--primary));
  }

  .article-title {
    margin: 1rem auto 0;
    max-width: 44rem;
    font-family: var(--font-display);
    font-size: clamp(2.05rem, 4.6vw, 3.5rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.055em;
    color: hsl(var(--foreground));
    text-wrap: balance;
    word-break: auto-phrase;
  }

  .article-desc {
    max-width: 38rem;
    margin: 1.2rem auto 0;
    font-size: clamp(0.94rem, 1.4vw, 1.06rem);
    line-height: 1.85;
    color: hsl(var(--muted-foreground));
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 0.9rem;
    margin-top: 1.6rem;
    font-family: var(--font-geist-mono);
    font-size: 0.64rem;
    letter-spacing: 0.05em;
    color: hsl(var(--muted-foreground));
  }

  .article-meta__item {
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
  }

  .article-cover {
    overflow: hidden;
    max-width: 64rem;
    margin-inline: auto;
    border-radius: 1.6rem;
    border: 1px solid hsl(var(--border) / 0.8);
    background: linear-gradient(120deg, hsl(var(--card)), hsl(var(--primary) / 0.18), hsl(var(--card)));
    background-size: 220% 100%;
    animation: coverShimmer 2.2s linear infinite;
    box-shadow: 0 30px 70px -50px hsl(218 28% 12% / 0.5);
  }

  .article-cover img {
    display: block;
    width: 100%;
    max-height: 30rem;
    object-fit: cover;
    opacity: 0;
    filter: blur(22px);
    transform: scale(1.06);
    transition:
      opacity 900ms ease,
      filter 1100ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 1200ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .article-cover img.is-loaded {
    opacity: 1;
    filter: blur(0);
    transform: scale(1);
  }

  @keyframes coverShimmer {
    0% {
      background-position: 0% 50%;
    }
    100% {
      background-position: 220% 50%;
    }
  }

  @media (max-width: 639px) {
    .article-title {
      letter-spacing: -0.04em;
    }
    .article-meta {
      gap: 0.4rem 0.7rem;
    }
  }
</style>
