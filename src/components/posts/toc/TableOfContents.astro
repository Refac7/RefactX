---
import type { MarkdownHeading } from 'astro'
import { POSTS_CONFIG } from '~/config'
import { cn } from '~/lib/utils'

interface Props {
  headings: MarkdownHeading[]
  class?: string
}

const { headings, class: className } = Astro.props

const filteredHeadings = headings.reduce(
  (acc, heading) => {
    if (heading.depth <= 4 && heading.text.trim() && heading.slug !== 'footnote-label') {
      acc.push({
        ...heading,
        text: heading.text.replace(/\s*[Hh][1-6]$/g, ''),
        order: acc.length + 1,
      })
    }
    return acc
  },
  [] as (MarkdownHeading & { order: number })[]
)

const minDepth = filteredHeadings.length > 0 ? Math.min(...filteredHeadings.map((h) => h.depth)) : 2

// 缩进不再使用 margin，改用 padding，这样侧边指示线可以统一在最左侧对齐
const getRelativeIndentClass = (depth: number) => {
  const relativeDepth = depth - minDepth
  const indentMap = ['pl-4', 'pl-7', 'pl-10', 'pl-12']
  return indentMap[relativeDepth] || 'pl-12'
}
---

<aside 
  id="desktop-toc-aside" 
  class={cn(
    "hidden xl:block sticky top-32 w-[15rem] shrink-0 z-40 transition-opacity duration-300 ease-out", 
    "opacity-80 hover:opacity-100 group", 
    className
  )}
>
  <div class="relative w-full h-full font-sans">

    <h3 class="text-sm font-semibold text-foreground tracking-tight mb-4 pl-4">
      {POSTS_CONFIG.tocText || 'On this page'}
    </h3>
    
    <nav 
      id="desktop-toc-scroll-area" 
      class="relative h-[calc(100vh-16rem)] overflow-y-auto toc-scrollbar"
    >
      <div class="absolute left-0 top-0 bottom-0 w-px bg-border/40 z-0"></div>

      <ul
        class="relative w-full pb-12 z-10 flex flex-col"
        data-desktop-toc-list
      >
        {
          filteredHeadings.map((heading) => {
            const isMain = heading.depth === minDepth;
            const depthClass = isMain 
              ? 'text-foreground font-medium' 
              : 'text-muted-foreground hover:text-foreground';

            return (
              <li class="relative flex">
                <a
                  href={`#${heading.slug}`}
                  data-desktop-heading-link
                  class="group/link relative flex items-center w-full py-1.5 transition-colors duration-200"
                >
                  {/* 当前激活的粗线指示器，覆盖在背景细线上 */}
                  <span class="absolute left-[-0.5px] top-1/2 -translate-y-1/2 w-[2px] h-[calc(100%-8px)] bg-primary opacity-0 transition-opacity duration-200 group-data-[active]/link:opacity-100"></span>
                  
                  <span class={cn("text-sm truncate transition-colors group-data-[active]/link:text-primary group-data-[active]/link:font-medium", depthClass, getRelativeIndentClass(heading.depth))} title={heading.text}>
                    {heading.text}
                  </span>
                </a>
              </li>
            )
          })
        }
      </ul>
    </nav>
  </div>
</aside>

<style>
  .toc-scrollbar {
    -ms-overflow-style: none; /* IE and Edge */
    scrollbar-width: none; /* Firefox */
  }
  .toc-scrollbar::-webkit-scrollbar {
    display: none; /* Chrome, Safari and Opera */
  }
</style>

<script>
  function initDesktopTOC() {
    const headingElements = Array.from(document.querySelectorAll('h1[id], h2[id], h3[id], h4[id]')).filter(h => h.id !== 'footnote-label')
    const headingLinks = document.querySelectorAll('[data-desktop-heading-link]')
    const scrollArea = document.getElementById('desktop-toc-scroll-area')
    
    if (!headingLinks.length || !scrollArea) return null;

    let currentActiveHeading: string | null = null
    let scrollTimeout: number | null = null

    const observer = new IntersectionObserver(
      (entries) => {
        if (scrollArea.offsetHeight === 0) return;

        entries.forEach((entry) => {
          if (entry.intersectionRatio > 0) {
            const id = entry.target.id
            if (currentActiveHeading === id) return

            currentActiveHeading = id
            headingLinks.forEach((link) => {
              if (link.getAttribute('href') === `#${id}`) {
                link.setAttribute('data-active', '')

                if (scrollTimeout) window.cancelAnimationFrame(scrollTimeout)
                scrollTimeout = window.requestAnimationFrame(() => {
                  const activeLinkElement = link as HTMLElement
                  if (activeLinkElement && scrollArea) {
                    const containerRect = scrollArea.getBoundingClientRect()
                    const linkRect = activeLinkElement.getBoundingClientRect()
                    
                    const relativeTop = linkRect.top - containerRect.top + scrollArea.scrollTop
                    const targetScrollTop = relativeTop - containerRect.height / 2 + linkRect.height / 2
                    
                    const maxScroll = scrollArea.scrollHeight - scrollArea.clientHeight
                    const targetScroll = Math.max(0, Math.min(targetScrollTop, maxScroll))

                    if (Math.abs(targetScroll - scrollArea.scrollTop) > 5) {
                      scrollArea.scrollTo({
                        top: targetScroll,
                        behavior: 'smooth'
                      })
                    }
                  }
                })
              } else {
                link.removeAttribute('data-active')
              }
            })
          }
        })
      },
      { rootMargin: '-96px 0px -85% 0px', threshold: [0, 1] }
    )

    headingElements.forEach((heading) => observer.observe(heading))

    setTimeout(() => {
      if (scrollArea.offsetHeight === 0) return;
      const visibleHeading = Array.from(headingElements).find((heading) => {
        const rect = heading.getBoundingClientRect()
        return rect.top > 10 && rect.top < window.innerHeight * 0.33
      })
      if (visibleHeading) {
        document.querySelector(`[data-desktop-heading-link][href="#${visibleHeading.id}"]`)?.setAttribute('data-active', '')
      } else {
        headingLinks[0]?.setAttribute('data-active', '')
      }
    }, 100)

    return () => observer.disconnect()
  }

  let cleanupDesktopTOC: (() => void) | null = null;
  document.addEventListener('astro:page-load', () => {
    if (cleanupDesktopTOC) cleanupDesktopTOC();
    const cleanup = initDesktopTOC();
    cleanupDesktopTOC = cleanup || null;
  })
  document.addEventListener('astro:before-swap', () => {
    if (cleanupDesktopTOC) { cleanupDesktopTOC(); cleanupDesktopTOC = null; }
  })
</script>