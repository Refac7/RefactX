---
import type { MarkdownHeading } from 'astro'
import { cn } from '~/lib/utils'

interface Props {
  headings: MarkdownHeading[]
  class?: string
}

const { headings, class: className } = Astro.props

const filteredHeadings = headings.reduce(
  (acc, heading) => {
    if (heading.depth <= 4 && heading.text.trim() && heading.slug !== 'footnote-label') {
      acc.push({
        ...heading,
        text: heading.text.replace(/\s*[Hh][1-6]$/g, ''),
        order: acc.length + 1,
      })
    }
    return acc
  },
  [] as (MarkdownHeading & { order: number })[]
)

const minDepth = filteredHeadings.length > 0 ? Math.min(...filteredHeadings.map((h) => h.depth)) : 2

const getRelativeIndentClass = (depth: number) => {
  const relativeDepth = depth - minDepth
  const indentMap = ['pl-4', 'pl-7', 'pl-10', 'pl-12']
  return indentMap[relativeDepth] || 'pl-12'
}
---

<aside
  id="desktop-toc-aside"
  class={cn(
    'hidden xl:block sticky top-32 w-60 shrink-0 z-40 transition-opacity duration-300 ease-out',
    'opacity-90 hover:opacity-100 group',
    className
  )}
>
  <div class="rounded-xl border border-border/40 bg-background/50 backdrop-blur-sm p-5">
    <!-- Mono header label -->
    <div class="flex items-center justify-between mb-4 pb-3 border-b border-border/30">
      <span class="text-[10px] font-mono text-muted-foreground uppercase tracking-widest select-none">
        // On_This_Page
      </span>
      <span class="text-[10px] font-mono text-muted-foreground/50 select-none">
        {String(filteredHeadings.length).padStart(2, '0')}
      </span>
    </div>

    <nav id="desktop-toc-scroll-area" class="relative max-h-[calc(100vh-20rem)] overflow-y-auto toc-scrollbar">
      <ul class="relative w-full pb-2 z-10 flex flex-col gap-0.5" data-desktop-toc-list>
        {
          filteredHeadings.map((heading) => {
            const isMain = heading.depth === minDepth
            const depthClass = isMain ? 'text-foreground font-medium' : 'text-muted-foreground hover:text-foreground'

            return (
              <li class="relative flex">
                <a
                  href={`#${heading.slug}`}
                  data-desktop-heading-link
                  class="group/link relative flex items-center w-full py-1.5 rounded-md transition-all duration-200 hover:bg-primary/5"
                >
                  {/* Active indicator bar */}
                  <span class="absolute left-0 top-1/2 -translate-y-1/2 w-0.5 h-[calc(100%-8px)] bg-primary rounded-full opacity-0 transition-opacity duration-200 group-data-active/link:opacity-100" />

                  <span
                    class={cn(
                      'text-[13px] truncate transition-colors group-data-active/link:text-primary group-data-active/link:font-semibold',
                      depthClass,
                      getRelativeIndentClass(heading.depth)
                    )}
                    title={heading.text}
                  >
                    {heading.text}
                  </span>
                </a>
              </li>
            )
          })
        }
      </ul>
    </nav>
  </div>
</aside>

<style>
  .toc-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .toc-scrollbar::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  function initDesktopTOC() {
    const headingElements = Array.from(document.querySelectorAll('h1[id], h2[id], h3[id], h4[id]')).filter((h) => h.id !== 'footnote-label')
    const headingLinks = document.querySelectorAll('[data-desktop-heading-link]')
    const scrollArea = document.getElementById('desktop-toc-scroll-area')

    if (!headingLinks.length || !scrollArea) return null

    let currentActiveHeading: string | null = null
    let scrollTimeout: number | null = null

    const observer = new IntersectionObserver(
      (entries) => {
        if (scrollArea.offsetHeight === 0) return

        entries.forEach((entry) => {
          if (entry.intersectionRatio > 0) {
            const id = entry.target.id
            if (currentActiveHeading === id) return

            currentActiveHeading = id
            headingLinks.forEach((link) => {
              if (link.getAttribute('href') === `#${id}`) {
                link.setAttribute('data-active', '')

                if (scrollTimeout) window.cancelAnimationFrame(scrollTimeout)
                scrollTimeout = window.requestAnimationFrame(() => {
                  const activeLinkElement = link as HTMLElement
                  if (activeLinkElement && scrollArea) {
                    const containerRect = scrollArea.getBoundingClientRect()
                    const linkRect = activeLinkElement.getBoundingClientRect()
                    const scrollTop = scrollArea.scrollTop
                    const scrollHeight = scrollArea.scrollHeight
                    const clientHeight = scrollArea.clientHeight

                    const relativeTop = linkRect.top - containerRect.top + scrollTop
                    const targetScrollTop = relativeTop - containerRect.height / 2 + linkRect.height / 2

                    const maxScroll = scrollHeight - clientHeight
                    const targetScroll = Math.max(0, Math.min(targetScrollTop, maxScroll))

                    if (Math.abs(targetScroll - scrollTop) > 5) {
                      scrollArea.scrollTo({
                        top: targetScroll,
                        behavior: 'smooth',
                      })
                    }
                  }
                })
              } else {
                link.removeAttribute('data-active')
              }
            })
          }
        })
      },
      { rootMargin: '-96px 0px -85% 0px', threshold: [0, 1] }
    )

    headingElements.forEach((heading) => observer.observe(heading))

    setTimeout(() => {
      if (scrollArea.offsetHeight === 0) return
      const visibleHeading = Array.from(headingElements).find((heading) => {
        const rect = heading.getBoundingClientRect()
        return rect.top > 10 && rect.top < window.innerHeight * 0.33
      })
      if (visibleHeading) {
        document.querySelector(`[data-desktop-heading-link][href="#${visibleHeading.id}"]`)?.setAttribute('data-active', '')
      } else {
        headingLinks[0]?.setAttribute('data-active', '')
      }
    }, 100)

    return () => observer.disconnect()
  }

  let cleanupDesktopTOC: (() => void) | null = null
  document.addEventListener('astro:page-load', () => {
    if (cleanupDesktopTOC) cleanupDesktopTOC()
    const cleanup = initDesktopTOC()
    cleanupDesktopTOC = cleanup || null
  })
  document.addEventListener('astro:before-swap', () => {
    if (cleanupDesktopTOC) {
      cleanupDesktopTOC()
      cleanupDesktopTOC = null
    }
  })
</script>
