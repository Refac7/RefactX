---
// src/components/Header.astro
import { HEADER_LINKS } from '~/config'
import ThemeToggle from '~/components/theme/ThemeToggle'
import HeaderLink from '~/components/base/HeaderLink.astro'
import SearchSwitch from '~/components/base/SearchSwitch.astro'
import { Image } from 'astro:assets'
import favicon from '../../public/favicon.webp'
import { CMS_CONFIG } from '~/config'
---

<header>
  
  <div class="mx-auto flex justify-between px-6 sm:px-8 py-6 lg:px-8">
    <div class="flex gap-3 sm:gap-6 items-center flex-shrink-0">
      <a href="/" class="pointer-events-auto select-none" transition:persist>
        <Image src={favicon} width={56} height={56} alt="Logo" class="w-8 h-8 border-2 border-transparent" loading="eager"/>
      </a>
      
      {/* 1. 移动端视图 (md:hidden)：只渲染数组的前 2 个元素 (.slice(0, 2)) */}
      <div class="flex gap-1 md:hidden">
        {
          HEADER_LINKS.slice(0, 2).map((link) => (
            <HeaderLink href={link.url} background>
              {link.name}
            </HeaderLink>
          ))
        }
      </div>

      {/* 2. 桌面端视图 (hidden md:flex)：渲染所有元素 */}
      <div class="hidden gap-1 md:flex">
        {
          HEADER_LINKS.map((link) => (
            <HeaderLink href={link.url} background>
              {link.name}
            </HeaderLink>
          ))
        }
      </div>

    </div>
    <div class="flex gap-2 items-center" transition:persist="header-theme-toggle">
      <SearchSwitch />
      <a
        href="/rss.xml"
        target="_blank"
        class="inline-flex items-center justify-center rounded-md hover:scale-105 duration-200"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <span class="icon-[material-symbols--rss-feed] size-5"></span>
      </a>

      {
        CMS_CONFIG.enableCMS && (
          <a
            href="/admin"
            class="inline-flex items-center justify-center rounded-md hover:scale-105 duration-200"
            aria-label="Admin Dashboard"
            title="Admin Panel"
          >
            <span class="icon-[material-symbols--admin-panel-settings-outline] size-5"></span>
          </a>
        )
      }


      <ThemeToggle client:load />
    </div>
  </div>
  {/* 顶部装饰条：模拟撕纸或机械分割线 */}
  <div class="absolute -bottom-px left-0 w-full h-px bg-border flex justify-between px-[10%]">
      <div class="w-20 h-px bg-primary"></div>
      <div class="w-20 h-px bg-primary"></div>
  </div>
</header>

