---
// src/components/Header.astro
import { HEADER_LINKS } from '~/config'
import ThemeToggle from '~/components/theme/ThemeToggle'
import HeaderLink from '~/components/base/HeaderLink.astro'
import SearchSwitch from '~/components/base/SearchSwitch.astro'
import { Image } from 'astro:assets'
import favicon from '../../public/favicon.webp'
import { CMS_CONFIG } from '~/config'
---

<header>
  <div class="mx-auto flex justify-between px-6 sm:px-8 border-b border-border/40 py-8 lg:px-8">
    <div class="flex gap-3 sm:gap-6 items-center shrink-0">
      <a href="/" class="pointer-events-auto select-none" transition:persist>
        <Image src={favicon} width={56} height={56} alt="Logo" class="w-8 h-8 border-2 border-transparent" loading="eager" />
      </a>

      <div class="flex gap-1 md:hidden">
        {
          HEADER_LINKS.slice(0, 2).map((link) => (
            <HeaderLink href={link.url} background>
              {link.name}
            </HeaderLink>
          ))
        }

        {/* 超过 2 个链接时，生成下拉菜单折叠按钮 */}
        {
          HEADER_LINKS.length > 2 && (
            <div class="relative flex items-center h-full -ml-1">
              <button
                id="mobile-menu-btn"
                class="flex items-center justify-center gap-1.5 px-3 h-9 border border-transparent bg-transparent text-muted-foreground transition-colors focus:outline-none hover:text-primary"
              >
                <span class="icon-[ph--caret-down-bold] size-3 transition-transform duration-300" id="mobile-menu-icon" />
              </button>

              {/* 下拉悬浮面板 */}
              <div
                id="mobile-menu-dropdown"
                class="absolute top-full left-0 mt-3 w-30 rounded-md bg-background/95 backdrop-blur-md border border-border/60 shadow-[0_10px_40px_-10px_rgba(0,0,0,0.3)] opacity-0 invisible -translate-y-2.5 transition-all duration-300 flex flex-col p-1.5 z-100"
              >
                {HEADER_LINKS.slice(2).map((link) => (
                  <a
                    href={link.url}
                    class="px-4 py-3 rounded-md text-xs font-mono font-bold uppercase tracking-widest text-muted-foreground hover:text-primary hover:bg-muted/40 hover:border-primary transition-all"
                  >
                    {link.name}
                  </a>
                ))}
              </div>
            </div>
          )
        }
      </div>

      <div class="hidden gap-1 md:flex">
        {
          HEADER_LINKS.map((link) => (
            <HeaderLink href={link.url} background>
              {link.name}
            </HeaderLink>
          ))
        }
      </div>
    </div>
    <div class="flex gap-2 items-center" transition:persist="header-theme-toggle">
      <SearchSwitch />
      <a
        href="/rss.xml"
        target="_blank"
        class="inline-flex items-center justify-center rounded-md hover:scale-105 duration-200"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <span class="icon-[material-symbols--rss-feed] size-5"></span>
      </a>

      {
        CMS_CONFIG.enableCMS && (
          <a
            href="/admin"
            class="inline-flex items-center justify-center rounded-md hover:scale-105 duration-200"
            aria-label="Admin Dashboard"
            title="Admin Panel"
          >
            <span class="icon-[material-symbols--admin-panel-settings-outline] size-5" />
          </a>
        )
      }

      <ThemeToggle client:load />
    </div>
  </div>
</header>

<script is:inline>
  // 封装下拉菜单交互逻辑，完美兼容 Astro 的 ViewTransitions
  ;(function () {
    var clickHandler = null

    function initMobileNav() {
      var btn = document.getElementById('mobile-menu-btn')
      var dropdown = document.getElementById('mobile-menu-dropdown')
      var icon = document.getElementById('mobile-menu-icon')

      if (!btn || !dropdown) return

      // 移除旧的全局点击监听器
      if (clickHandler) {
        document.removeEventListener('click', clickHandler)
      }

      var openMenu = function () {
        dropdown.classList.remove('opacity-0', 'invisible', 'translate-y-[-10px]')
        dropdown.classList.add('opacity-100', 'visible', 'translate-y-0')
        if (icon) icon.classList.add('rotate-180')
      }

      var closeMenu = function () {
        dropdown.classList.add('opacity-0', 'invisible', 'translate-y-[-10px]')
        dropdown.classList.remove('opacity-100', 'visible', 'translate-y-0')
        if (icon) icon.classList.remove('rotate-180')
      }

      // 移除旧的按钮监听器（使用事件委托）
      var newBtn = btn.cloneNode(true)
      btn.parentNode.replaceChild(newBtn, btn)

      newBtn.addEventListener('click', function (e) {
        e.stopPropagation()
        var isExpanded = dropdown.classList.contains('opacity-100')
        isExpanded ? closeMenu() : openMenu()
      })

      // 使用事件委托替代重复的监听器
      clickHandler = function (e) {
        if (!newBtn.contains(e.target) && !dropdown.contains(e.target)) {
          closeMenu()
        }
      }
      document.addEventListener('click', clickHandler)
    }

    // 监听 Astro 的页面加载事件和 ViewTransition 事件
    document.addEventListener('astro:after-swap', initMobileNav)
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMobileNav)
    } else {
      initMobileNav()
    }
  })()
</script>
