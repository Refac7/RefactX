---
// src/components/Header.astro
import { HEADER_LINKS } from '~/config'
import ThemeToggle from '~/components/theme/ThemeToggle'
import HeaderLink from '~/components/base/HeaderLink.astro'
import SearchSwitch from '~/components/base/SearchSwitch.astro'
import { Image } from 'astro:assets'
import favicon from '../../public/favicon.webp'
import { CMS_CONFIG, SITE } from '~/config'
---

<header class="fixed top-0 left-0 right-0 z-40 border-b-2 border-foreground bg-background">
  <div class="mx-auto flex items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-10 lg:py-4">
    <div class="flex min-w-0 items-center gap-4 sm:gap-8">
      <a href="/" class="pointer-events-auto flex shrink-0 select-none items-center gap-3" transition:persist aria-label={SITE.title}>
        <span class="flex size-9 items-center justify-center bg-foreground p-1.5">
          <Image src={favicon} width={56} height={56} alt="Logo" class="size-full invert object-contain dark:invert-0" loading="eager" />
        </span>
        <span class="hidden min-w-0 flex-col leading-none sm:flex">
          <span class="truncate text-[13px] font-bold uppercase tracking-[0.14em] text-foreground">{SITE.title || 'RefactX'}</span>
          <span class="mt-1.5 font-mono text-[9px] uppercase tracking-[0.24em] text-muted-foreground">Independent / Digital</span>
        </span>
      </a>

      <div class="flex items-center gap-1 md:hidden">
        {
          HEADER_LINKS.slice(0, 1).map((link) => (
            <HeaderLink href={link.url} background>
              {link.name}
            </HeaderLink>
          ))
        }

        {/* 超过 1 个链接时，生成下拉菜单折叠按钮 */}
        {
          HEADER_LINKS.length > 1 && (
            <div class="relative flex items-center">
              <button
                id="mobile-menu-btn"
                class="flex size-8 items-center justify-center border border-foreground/30 bg-transparent text-foreground transition-colors hover:border-primary hover:text-primary focus:outline-none"
                aria-label="More navigation"
              >
                <span class="icon-[ph--caret-down-bold] size-3 transition-transform duration-200" id="mobile-menu-icon" />
              </button>

              {/* 下拉悬浮面板 */}
              <div
                id="mobile-menu-dropdown"
                class="absolute top-full left-0 z-100 mt-3 flex w-44 flex-col border-2 border-foreground bg-background opacity-0 invisible -translate-y-1 transition-all duration-200"
              >
                {HEADER_LINKS.slice(1).map((link) => (
                  <a
                    href={link.url}
                    class="border-b border-foreground/15 px-4 py-3 font-mono text-[10px] font-semibold uppercase tracking-[0.16em] text-foreground last:border-b-0 hover:bg-primary hover:text-primary-foreground"
                  >
                    {link.name}
                  </a>
                ))}
              </div>
            </div>
          )
        }
      </div>

      <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
        {
          HEADER_LINKS.map((link) => (
            <HeaderLink href={link.url} background>
              {link.name}
            </HeaderLink>
          ))
        }
      </nav>
    </div>

    <div class="flex shrink-0 items-center gap-1.5 sm:gap-2" transition:persist="header-theme-toggle">
      <span class="mr-2 hidden font-mono text-[9px] uppercase tracking-[0.2em] text-muted-foreground lg:inline">Menu / 01</span>
      <SearchSwitch />
      <a
        href="/rss.xml"
        target="_blank"
        class="inline-flex size-8 items-center justify-center border border-transparent text-foreground transition-colors hover:border-foreground hover:text-primary"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <span class="icon-[material-symbols--rss-feed] size-4"></span>
      </a>

      {
        CMS_CONFIG.enableCMS && (
          <a
            href="/admin"
            class="inline-flex size-8 items-center justify-center border border-transparent text-foreground transition-colors hover:border-foreground hover:text-primary"
            aria-label="Admin Dashboard"
            title="Admin Panel"
          >
            <span class="icon-[material-symbols--admin-panel-settings-outline] size-4" />
          </a>
        )
      }

      <ThemeToggle client:load />
    </div>
  </div>
</header>

<script is:inline>
  // 封装下拉菜单交互逻辑，完美兼容 Astro 的 ViewTransitions
  ;(function () {
    var clickHandler = null

    function initMobileNav() {
      var btn = document.getElementById('mobile-menu-btn')
      var dropdown = document.getElementById('mobile-menu-dropdown')
      var icon = document.getElementById('mobile-menu-icon')

      if (!btn || !dropdown) return

      // 移除旧的全局点击监听器
      if (clickHandler) {
        document.removeEventListener('click', clickHandler)
      }

      var openMenu = function () {
        dropdown.classList.remove('opacity-0', 'invisible', '-translate-y-1')
        dropdown.classList.add('opacity-100', 'visible', 'translate-y-0')
        if (icon) icon.classList.add('rotate-180')
      }

      var closeMenu = function () {
        dropdown.classList.add('opacity-0', 'invisible', '-translate-y-1')
        dropdown.classList.remove('opacity-100', 'visible', 'translate-y-0')
        if (icon) icon.classList.remove('rotate-180')
      }

      // 移除旧的按钮监听器（使用事件委托）
      var newBtn = btn.cloneNode(true)
      btn.parentNode.replaceChild(newBtn, btn)

      newBtn.addEventListener('click', function (e) {
        e.stopPropagation()
        var isExpanded = dropdown.classList.contains('opacity-100')
        isExpanded ? closeMenu() : openMenu()
      })

      // 使用事件委托替代重复的监听器
      clickHandler = function (e) {
        if (!newBtn.contains(e.target) && !dropdown.contains(e.target)) {
          closeMenu()
        }
      }
      document.addEventListener('click', clickHandler)
    }

    // 监听 Astro 的页面加载事件和 ViewTransition 事件
    document.addEventListener('astro:after-swap', initMobileNav)
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMobileNav)
    } else {
      initMobileNav()
    }
  })()
</script>
