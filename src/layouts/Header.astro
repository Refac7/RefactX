---
import { HEADER_LINKS, SITE, SOCIAL_LINKS, CMS_CONFIG } from '~/config'
import ThemeToggle from '~/components/theme/ThemeToggle'
import SearchSwitch from '~/components/base/SearchSwitch.astro'
import { Image } from 'astro:assets'
import favicon from '../../public/favicon.webp'

interface Props {
  hero?: boolean
}

const { hero = false } = Astro.props
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/'

const isActive = (url: string) => {
  const clean = url.replace(/\/$/, '') || '/'
  if (clean === '/') return pathname === '/'
  return pathname === clean || pathname.startsWith(`${clean}/`)
}
---

<header id="site-header" class="site-header" data-hero={hero ? 'true' : 'false'} data-transparent={hero ? 'true' : 'false'}>
  <div class="site-header__inner">
    <a href="/" class="site-brand" aria-label={`${SITE.title} 首页`}>
      <span class="site-brand__mark">
        <Image src={favicon} width={44} height={44} alt="" class="size-7 object-contain" loading="eager" />
      </span>
      <span class="site-brand__text">
        <span class="site-brand__name">{SITE.title.replace(' Project', '')}</span>
        <span class="site-brand__tag">You &amp; Radiance</span>
      </span>
    </a>

    <nav class="site-nav" aria-label="主导航">
      {
        HEADER_LINKS.map((link) => (
          <a href={link.url} class:list={['site-nav__link', isActive(link.url) && 'is-active']}>
            {link.name}
          </a>
        ))
      }
    </nav>

    <div class="site-actions">
      <div class="header-action">
        <SearchSwitch />
      </div>
      <a href="/rss.xml" target="_blank" class="header-action header-action--rss" aria-label="RSS Feed" title="RSS Feed">
        <span class="icon-[ph--rss] size-5"></span>
      </a>
      {
        CMS_CONFIG.enableCMS && (
          <a href="/admin" class="header-action header-action--admin" aria-label="后台管理" title="后台管理">
            <span class="icon-[ph--sliders-horizontal] size-5" />
          </a>
        )
      }
      <div class="header-action">
        <ThemeToggle client:load />
      </div>
      <button id="mobile-menu-toggle" class="mobile-menu-toggle lg:hidden" type="button" aria-label="打开菜单" aria-expanded="false">
        <span class="icon-[ph--list] size-5 menu-icon-open"></span>
        <span class="icon-[ph--x] size-5 menu-icon-close"></span>
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" class="mobile-menu" aria-hidden="true">
  <div class="mobile-menu__inner">
    <div class="mobile-menu__top">
      <span class="eyebrow eyebrow-dot">Navigation</span>
      <span class="font-mono text-[0.6rem] uppercase tracking-[0.16em] text-muted-foreground">Menu</span>
    </div>

    <nav class="mobile-menu__nav" aria-label="移动端导航">
      {
        HEADER_LINKS.map((link, index) => (
          <a href={link.url} class:list={['mobile-menu__link', isActive(link.url) && 'is-active']}>
            <span class="mobile-menu__index">{String(index + 1).padStart(2, '0')}</span>
            <span>{link.name}</span>
            <span class="icon-[ph--arrow-up-right] mobile-menu__arrow" />
          </a>
        ))
      }
    </nav>

    <div class="mobile-menu__footer">
      <div class="flex flex-wrap gap-2">
        {
          SOCIAL_LINKS.map((item) => (
            <a href={item.url} target="_blank" rel="noopener noreferrer" class="chip">
              <span class={`${item.icon} size-3.5`} />
              {item.name}
            </a>
          ))
        }
        <a href="/rss.xml" target="_blank" class="chip">
          <span class="icon-[ph--rss] size-3.5"></span>
          RSS
        </a>
      </div>
      <p class="mt-5 text-xs leading-relaxed text-muted-foreground">{SITE.description}</p>
    </div>
  </div>
</div>
<script is:inline>
  ;(() => {
    let cleanup = null

    const initHeader = () => {
      if (cleanup) cleanup()

      const header = document.getElementById('site-header')
      const toggle = document.getElementById('mobile-menu-toggle')
      const menu = document.getElementById('mobile-menu')
      const close = document.getElementById('mobile-menu-close')
      if (!header || !toggle || !menu) return

      const setScrolled = () => {
        const scrolled = window.scrollY > 18
        if (scrolled) header.setAttribute('data-scrolled', 'true')
        else header.removeAttribute('data-scrolled')

        const transparent = header.dataset.hero === 'true' && !scrolled
        header.setAttribute('data-transparent', transparent ? 'true' : 'false')
      }

      const openMenu = () => {
        menu.setAttribute('data-open', 'true')
        menu.setAttribute('aria-hidden', 'false')
        toggle.setAttribute('aria-expanded', 'true')
        document.documentElement.style.overflow = 'hidden'
      }

      const closeMenu = () => {
        menu.setAttribute('data-open', 'false')
        menu.setAttribute('aria-hidden', 'true')
        toggle.setAttribute('aria-expanded', 'false')
        document.documentElement.style.overflow = ''
      }

      const onKeydown = (event) => {
        if (event.key === 'Escape') closeMenu()
      }

      toggle.addEventListener('click', () => {
        if (menu.getAttribute('data-open') === 'true') closeMenu()
        else openMenu()
      })
      close?.addEventListener('click', closeMenu)
      menu.addEventListener('click', (event) => {
        if (event.target === menu) closeMenu()
      })
      menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu))
      document.addEventListener('keydown', onKeydown)
      window.addEventListener('scroll', setScrolled, { passive: true })
      setScrolled()

      cleanup = () => {
        document.removeEventListener('keydown', onKeydown)
        window.removeEventListener('scroll', setScrolled)
        closeMenu()
        cleanup = null
      }
    }

    document.addEventListener('astro:after-swap', initHeader)
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initHeader)
    else initHeader()
    window.addEventListener('pagehide', () => cleanup?.())
  })()
</script>
