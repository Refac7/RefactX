---
// src/components/Header.astro
import { HEADER_LINKS } from '~/config'
import ThemeToggle from '~/components/theme/ThemeToggle'
import SectionDivider from '~/components/base/SectionDivider.astro'
import HeaderLink from '~/components/base/HeaderLink.astro'
import SearchSwitch from '~/components/base/SearchSwitch.astro'
import { Image } from 'astro:assets'
import favicon from '../../public/favicon.webp'
---

<header>
  <!-- 全局背景网格装饰 -->
  <div class="fixed inset-0 z-0 pointer-events-none bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"></div>
  <div class="mx-auto max-w-6xl flex justify-between px-6 sm:px-8 py-4 lg:px-8">
    <div class="flex gap-3 sm:gap-6 items-center flex-shrink-0">
      <a href="/" class="pointer-events-auto select-none" transition:persist>
        <Image src={favicon} width={56} height={56} alt="Logo" class="w-8 h-8 border-2 border-transparent" loading="eager"/>
      </a>
      
      {/* 1. 移动端视图 (md:hidden)：只渲染数组的前 2 个元素 (.slice(0, 2)) */}
      <div class="flex gap-1 md:hidden">
        {
          HEADER_LINKS.slice(0, 2).map((link) => (
            <HeaderLink href={link.url} background>
              {link.name}
            </HeaderLink>
          ))
        }
      </div>

      {/* 2. 桌面端视图 (hidden md:flex)：渲染所有元素 */}
      <div class="hidden gap-1 md:flex">
        {
          HEADER_LINKS.map((link) => (
            <HeaderLink href={link.url} background>
              {link.name}
            </HeaderLink>
          ))
        }
      </div>

    </div>
    <div class="flex gap-2 items-center" transition:persist="header-theme-toggle">
      <SearchSwitch />
      <a
        href="/rss.xml"
        target="_blank"
        class="inline-flex items-center justify-center rounded-md hover:scale-105 duration-200"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <span class="icon-[material-symbols--rss-feed] size-5"></span>
      </a>
      
      {/* 新增：管理员入口 */}
      <a
        href="/admin"
        class="inline-flex items-center justify-center rounded-md hover:scale-105 duration-200"
        aria-label="Admin Dashboard"
        title="Admin Panel"
      >
        <span class="icon-[material-symbols--admin-panel-settings-outline] size-5"></span>
      </a>

      <ThemeToggle client:load />
    </div>
  </div>
  <div class="relative max-w-6xl mx-auto pointer-events-none">
    <div aria-hidden="true" class="absolute inset-x-0 -top-14 bottom-0 mx-auto max-w-6xl">
      <div class="to-(--color-border)/50 absolute bottom-0 left-0 top-0 w-px bg-gradient-to-b from-transparent to-75%"></div>
      <div class="to-(--color-border)/50 absolute bottom-0 right-0 top-0 w-px bg-gradient-to-b from-transparent to-75%"></div>
    </div>
  </div>
</header>

<SectionDivider className="border-t-border dark:border-t-border/50" />