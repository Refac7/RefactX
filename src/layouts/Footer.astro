---
import { FOOTER_LINKS, SITE } from '~/config'
import ThemeToggle from '~/components/theme/ThemeToggle'
import FooterLink from '~/components/base/FooterLink.astro'

const currentYear = new Date().getFullYear()
const CONTAINER_CLASS = "mx-auto px-6 sm:px-8 py-12"
---

<footer class="relative z-10 border-t border-border/40 bg-background/50 backdrop-blur-sm mt-12">
  <div class={CONTAINER_CLASS}>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 lg:gap-12 pb-12 border-b border-border/40">
      
      <div class="md:col-span-2 space-y-4">
         <span class="text-sm font-semibold tracking-tight text-foreground block">
          {SITE.author || "Refac7"}
         </span>
         <p class="text-sm text-muted-foreground leading-relaxed max-w-sm">
            Designed and engineered for the digital void. <br/>
            Minimalist layout, maximum focus. Data persistence guaranteed.
         </p>
      </div>

      <div class="space-y-4">
        <span class="text-sm font-semibold tracking-tight text-foreground block">
          Navigation
        </span>
        <ul class="flex flex-col gap-3">
          {FOOTER_LINKS.map((link) => (
            <li>
              <FooterLink href={link.url} class="text-muted-foreground hover:text-foreground transition-colors">{link.name}</FooterLink>
            </li>
          ))}
        </ul>
      </div>

      <div class="space-y-4">
        <span class="text-sm font-semibold tracking-tight text-foreground block">
          Technology
        </span>
        <ul class="flex flex-col gap-3">
          <li><a href="https://astro.build" target="_blank" class="text-sm text-muted-foreground hover:text-foreground transition-colors flex items-center gap-2"><span class="icon-[lineicons--astro] size-4"></span>Astro</a></li>
          <li><a href="https://www.vercel.com" target="_blank" class="text-sm text-muted-foreground hover:text-foreground transition-colors flex items-center gap-2"><span class="icon-[simple-icons--vercel] size-3.5"></span>Vercel</a></li>
          <li><a href="https://github.com/Refac7/RefactX_Template" target="_blank" class="text-sm text-muted-foreground hover:text-foreground transition-colors flex items-center gap-2"><span class="icon-[mingcute--github-fill] size-4"></span>Source Code</a></li>
        </ul>
      </div>

    </div>

    <div class="pt-8 flex flex-row justify-between items-center gap-4 text-sm text-muted-foreground">
        <div class="flex flex-col sm:flex-row items-start gap-2 sm:gap-4 text-center">
            <span>© {currentYear} {SITE.author || "Refac7"}.</span>
            </a>
        </div>
        
        <div class="flex items-center gap-4">
          <div class="flex items-center gap-2 bg-muted/50 px-3 py-1.5 rounded-full">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex h-2 w-2 bg-emerald-500 rounded-full"></span>
              </span>
              <span class="text-xs font-medium">All Systems Normal</span>
          </div>
          <div class="flex items-center bg-muted/30 p-1 rounded-full" transition:persist="footer-theme-toggle">
              <ThemeToggle client:load />
          </div>
        </div>
    </div>
  </div>
</footer>