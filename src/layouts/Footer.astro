---
import { FOOTER_LINKS, SITE } from '~/config'
import ThemeToggle from '~/components/theme/ThemeToggle'
import FooterLink from '~/components/base/FooterLink.astro'

const currentYear = new Date().getFullYear()
---

<footer class="relative z-10 border-t-2 border-foreground bg-[#0a0a0a] text-white">
  <div class="mx-auto px-4 py-12 sm:px-6 lg:px-10 lg:py-16">
    <div class="grid grid-cols-1 gap-10 border-b border-white/20 pb-12 md:grid-cols-12 lg:gap-12">
      <div class="md:col-span-6">
        <div class="flex items-center gap-3">
          <span class="size-2.5 bg-primary"></span>
          <span class="font-mono text-[10px] uppercase tracking-[0.22em] text-white/55">Colophon / End_Of_Document</span>
        </div>
        <p class="mt-6 max-w-xl text-4xl font-bold leading-[0.88] tracking-[-0.055em] sm:text-5xl lg:text-6xl">
          {SITE.author || 'Refac7'}
        </p>
        <p class="mt-6 max-w-md text-sm leading-relaxed text-white/60">
          {SITE.footerText}<br />
          {SITE.footerText2 || 'Minimalist layout, maximum focus. Data persistence guaranteed.'}
        </p>
      </div>

      <div class="md:col-span-3">
        <span class="mb-5 block border-b border-white/20 pb-3 font-mono text-[10px] uppercase tracking-[0.2em] text-white/55"> Index </span>
        <ul class="flex flex-col gap-1.5">
          {
            FOOTER_LINKS.map((link) => (
              <li>
                <FooterLink href={link.url} class="text-white/75 hover:text-primary">
                  {link.name}
                </FooterLink>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="md:col-span-3">
        <span class="mb-5 block border-b border-white/20 pb-3 font-mono text-[10px] uppercase tracking-[0.2em] text-white/55"> Stack </span>
        <ul class="flex flex-col gap-3">
          <li>
            <a
              href="https://astro.build"
              target="_blank"
              class="flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.14em] text-white/70 transition-colors hover:text-primary"
              ><span class="icon-[lineicons--astro] size-3.5"></span>Astro</a
            >
          </li>
          <li>
            <a
              href="https://www.vercel.com"
              target="_blank"
              class="flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.14em] text-white/70 transition-colors hover:text-primary"
              ><span class="icon-[simple-icons--vercel] size-3"></span>Vercel</a
            >
          </li>
          <li>
            <a
              href="https://github.com/Refac7/RefactX"
              target="_blank"
              class="flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.14em] text-white/70 transition-colors hover:text-primary"
              ><span class="icon-[mingcute--github-fill] size-3"></span>Source Code</a
            >
          </li>
        </ul>
      </div>
    </div>

    <div
      class="flex flex-col justify-between gap-4 pt-6 font-mono text-[10px] uppercase tracking-[0.12em] text-white/45 md:flex-row md:items-center"
    >
      <div class="flex flex-col gap-2 sm:flex-row sm:gap-6">
        <span>© {currentYear} {SITE.author || 'Refac7'} — All Rights Reserved</span>
        <a href="https://icp.gov.moe/?keyword=20252280" target="_blank" class="transition-colors hover:text-primary">萌ICP备 20252280号</a>
      </div>

      <div class="flex w-full flex-wrap items-center gap-4 sm:w-auto">
        <div class="flex items-center gap-2">
          <span class="relative flex size-1.5"
            ><span class="absolute inline-flex size-full animate-ping bg-success/70"></span><span
              class="relative inline-flex size-1.5 bg-success"></span></span
          >
          <span>All Systems Normal</span>
        </div>
        <div class="flex items-center gap-2" data-site-age>
          <span class="text-white/25">/</span>
          <span>Site Age</span>
          <span class="tabular-nums text-white/80" data-site-age-value>calculating…</span>
        </div>
        <div class="ml-auto flex bg-[#0a0a0a] text-white sm:hidden [&_button]:!text-white [&_button:hover]:!text-primary">
          <ThemeToggle client:load />
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    ;(() => {
      const siteCreatedAt = new Date('2025-07-25T17:12:32Z').getTime()
      let intervalId

      const updateSiteAge = () => {
        const siteAge = document.querySelector('[data-site-age-value]')
        if (!siteAge) return false

        let seconds = Math.max(0, Math.floor((Date.now() - siteCreatedAt) / 1000))
        const days = Math.floor(seconds / 86400)
        seconds %= 86400
        const hours = Math.floor(seconds / 3600)
        seconds %= 3600
        const minutes = Math.floor(seconds / 60)
        siteAge.textContent = `${days}d ${String(hours).padStart(2, '0')}h ${String(minutes).padStart(2, '0')}m`
        return true
      }

      const initSiteAge = () => {
        updateSiteAge()
        if (intervalId) window.clearInterval(intervalId)
        intervalId = window.setInterval(updateSiteAge, 60000)
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSiteAge, { once: true })
      } else {
        initSiteAge()
      }

      document.addEventListener('astro:after-swap', initSiteAge)
    })()
  </script>
</footer>
