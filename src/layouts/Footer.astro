---
import { FOOTER_LINKS, SITE, SOCIAL_LINKS } from '~/config'
import { Image } from 'astro:assets'
import favicon from '../../public/favicon.webp'

const currentYear = new Date().getFullYear()
const exploreLinks = FOOTER_LINKS.filter((link) => ['/', '/posts', '/dynamic', '/projects'].includes(link.url))
const moreLinks = FOOTER_LINKS.filter((link) => !['/', '/posts', '/dynamic', '/projects'].includes(link.url))
---

<footer class="site-footer">
  <div class="container-page">
    <div class="site-footer__card">
      <div class="site-footer__halo" aria-hidden="true"></div>

      <div class="site-footer__grid">
        <div class="site-footer__brand">
          <a href="/" class="inline-flex items-center gap-3 no-underline">
            <span class="site-footer__mark">
              <Image src={favicon} width={40} height={40} alt="" class="size-6 object-contain" />
            </span>
            <span class="site-footer__name">{SITE.title}</span>
          </a>
          <p class="site-footer__desc">
            {SITE.description}
            <span class="block mt-1 opacity-70">记录代码、生活与光。</span>
          </p>
          <div class="flex flex-wrap gap-2 pt-1">
            {
              SOCIAL_LINKS.map((item) => (
                <a href={item.url} target="_blank" rel="noopener noreferrer" class="footer-social" aria-label={item.name}>
                  <span class={`${item.icon} size-[18px]`} />
                </a>
              ))
            }
            <a href="/rss.xml" target="_blank" class="footer-social" aria-label="RSS">
              <span class="icon-[ph--rss-bold] size-[18px]"></span>
            </a>
            <a href="/admin" class="footer-social" aria-label="后台管理">
              <span class="icon-[ph--sliders-horizontal] size-[18px]"></span>
            </a>
          </div>
        </div>

        <div class="site-footer__column">
          <h3>探索</h3>
          <ul>
            {
              exploreLinks.map((link) => (
                <li>
                  <a href={link.url}>{link.name}</a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="site-footer__column">
          <h3>更多</h3>
          <ul>
            {
              moreLinks.map((link) => (
                <li>
                  <a href={link.url}>{link.name}</a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="site-footer__column">
          <h3>构建</h3>
          <ul>
            <li>
              <a href="https://astro.build" target="_blank" rel="noopener noreferrer">
                <span class="icon-[lineicons--astro] size-3.5"></span> Astro
              </a>
            </li>
            <li>
              <a href="https://www.vercel.com" target="_blank" rel="noopener noreferrer">
                <span class="icon-[simple-icons--vercel] size-3"></span> Vercel
              </a>
            </li>
            <li>
              <a href="https://github.com/Refac7/RefactX" target="_blank" rel="noopener noreferrer">
                <span class="icon-[mingcute--github-fill] size-3.5"></span> Source
              </a>
            </li>
            <li>
              <a href="/rss.xml" target="_blank">RSS Feed</a>
            </li>
          </ul>
        </div>
      </div>

      <div class="site-footer__bottom">
        <div class="flex flex-col gap-1.5 sm:flex-row sm:items-center sm:gap-5">
          <span>© {currentYear} {SITE.author} · All Rights Reserved.</span>
          <a
            href="https://icp.gov.moe/?keyword=20252280"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-foreground transition-colors">萌ICP备 20252280号</a
          >
        </div>

        <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
          <span class="inline-flex items-center gap-2">
            <span class="relative flex h-1.5 w-1.5">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-success/70 opacity-75"></span>
              <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-success"></span>
            </span>
            All Systems Normal
          </span>
          <span class="inline-flex items-center gap-1.5" data-site-age>
            <span class="opacity-50">·</span>
            <span>Site Age</span>
            <span class="normal-case tabular-nums text-foreground/80" data-site-age-value>calculating…</span>
          </span>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    ;(() => {
      const siteCreatedAt = new Date('2025-07-25T17:12:32Z').getTime()
      let intervalId

      const updateSiteAge = () => {
        const siteAge = document.querySelector('[data-site-age-value]')
        if (!siteAge) return false

        let seconds = Math.max(0, Math.floor((Date.now() - siteCreatedAt) / 1000))
        const days = Math.floor(seconds / 86400)
        seconds %= 86400
        const hours = Math.floor(seconds / 3600)
        seconds %= 3600
        const minutes = Math.floor(seconds / 60)
        siteAge.textContent = `${days}d ${String(hours).padStart(2, '0')}h ${String(minutes).padStart(2, '0')}m`
        return true
      }

      const initSiteAge = () => {
        updateSiteAge()
        if (intervalId) window.clearInterval(intervalId)
        intervalId = window.setInterval(updateSiteAge, 60000)
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSiteAge, { once: true })
      } else {
        initSiteAge()
      }

      document.addEventListener('astro:after-swap', initSiteAge)
    })()
  </script>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 10;
    padding-top: 2rem;
    padding-bottom: 2rem;
  }

  .site-footer__card {
    position: relative;
    overflow: hidden;
    padding: clamp(1.6rem, 4vw, 3rem);
    border-radius: 2rem;
    border: 1px solid hsl(var(--border) / 0.8);
    background: hsl(var(--card));
    box-shadow: 0 30px 70px -50px hsl(218 26% 14% / 0.4);
  }

  .site-footer__halo {
    position: absolute;
    top: -9rem;
    left: 50%;
    width: 38rem;
    height: 20rem;
    transform: translateX(-50%);
    border-radius: 999px;
    background: hsl(var(--primary) / 0.26);
    filter: blur(70px);
    pointer-events: none;
  }

  .site-footer__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.2rem;
  }

  .site-footer__brand {
    max-width: 22rem;
  }

  .site-footer__mark {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    border: 0;
    background: transparent;
  }

  :global(.dark) .site-footer__mark img {
    filter: invert(1) brightness(1.1);
  }

  .site-footer__name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  .site-footer__desc {
    margin-top: 1rem;
    font-size: 0.86rem;
    line-height: 1.75;
    color: hsl(var(--muted-foreground));
  }

  .footer-social {
    display: inline-grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background: transparent;
    color: hsl(var(--muted-foreground));
    transition:
      color 180ms ease,
      transform 180ms ease;
  }

  .footer-social:hover {
    color: hsl(var(--primary));
    background: transparent;
    transform: translateY(-2px) scale(1.05);
  }

  .site-footer__column h3 {
    margin: 0 0 1rem;
    font-family: var(--font-geist-mono);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
  }

  .site-footer__column ul {
    display: flex;
    flex-direction: column;
    gap: 0.72rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__column a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.85rem;
    color: hsl(var(--foreground) / 0.72);
    text-decoration: none;
    transition: color 180ms ease;
  }

  .site-footer__column a:hover {
    color: hsl(var(--accent-foreground));
  }

  .site-footer__bottom {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 2.4rem;
    padding-top: 1.4rem;
    border-top: 1px solid hsl(var(--border) / 0.7);
    font-family: var(--font-geist-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
  }

  @media (min-width: 640px) {
    .site-footer__bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  @media (min-width: 768px) {
    .site-footer__grid {
      grid-template-columns: 1.6fr repeat(3, minmax(0, 0.7fr));
      gap: 2rem;
    }
  }

  @media (max-width: 767px) {
    .site-footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .site-footer__brand {
      grid-column: 1 / -1;
    }
  }
</style>
