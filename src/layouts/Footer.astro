---
import { FOOTER_LINKS, SITE } from '~/config'
import ThemeToggle from '~/components/theme/ThemeToggle'
import FooterLink from '~/components/base/FooterLink.astro'

const currentYear = new Date().getFullYear()
---

<footer class="relative z-10 mt-20 overflow-hidden rounded-t-[2.5rem] bg-[#23211d] text-[#f5f0e6]">
  <div
    class="pointer-events-none absolute -top-24 -right-16 font-serif text-[18rem] leading-none text-[#e08a6b]/10 select-none"
    aria-hidden="true"
  >
    ✳
  </div>

  <div class="relative mx-auto max-w-[1600px] px-6 py-14 sm:px-10 lg:px-14 lg:py-20">
    <div class="grid grid-cols-1 gap-12 border-b border-white/10 pb-14 md:grid-cols-12 lg:gap-16">
      <div class="md:col-span-7">
        <div class="flex items-center gap-3">
          <span class="size-2 rounded-full bg-[#e08a6b]"></span>
          <span class="text-[11px] font-semibold tracking-[0.16em] text-[#f5f0e6]/50 uppercase">Colophon</span>
        </div>
        <p class="mt-7 max-w-2xl font-serif text-5xl leading-[0.98] tracking-[-0.035em] text-[#f8f4ec] sm:text-6xl lg:text-7xl">
          {SITE.author || 'Refac7'}
        </p>
        <p class="mt-7 max-w-md text-[15px] leading-relaxed text-[#f5f0e6]/55">
          {SITE.footerText}<br />
          {SITE.footerText2 || 'Minimalist layout, maximum focus. Data persistence guaranteed.'}
        </p>
      </div>

      <div class="md:col-span-2">
        <span class="mb-5 block text-[11px] font-semibold tracking-[0.16em] text-[#f5f0e6]/40 uppercase">Index</span>
        <ul class="flex flex-col gap-2.5">
          {
            FOOTER_LINKS.map((link) => (
              <li>
                <FooterLink href={link.url} class="text-[#f5f0e6]/70 hover:text-[#e8a184]">
                  {link.name}
                </FooterLink>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="md:col-span-3">
        <span class="mb-5 block text-[11px] font-semibold tracking-[0.16em] text-[#f5f0e6]/40 uppercase">Stack</span>
        <ul class="flex flex-col gap-3.5">
          <li>
            <a
              href="https://astro.build"
              target="_blank"
              class="flex items-center gap-2.5 text-[13px] text-[#f5f0e6]/70 transition-colors hover:text-[#e8a184]"
              ><span class="icon-[lineicons--astro] size-4"></span>Astro</a
            >
          </li>
          <li>
            <a
              href="https://www.vercel.com"
              target="_blank"
              class="flex items-center gap-2.5 text-[13px] text-[#f5f0e6]/70 transition-colors hover:text-[#e8a184]"
              ><span class="icon-[simple-icons--vercel] size-3.5"></span>Vercel</a
            >
          </li>
          <li>
            <a
              href="https://github.com/Refac7/RefactX"
              target="_blank"
              class="flex items-center gap-2.5 text-[13px] text-[#f5f0e6]/70 transition-colors hover:text-[#e8a184]"
              ><span class="icon-[mingcute--github-fill] size-4"></span>Source Code</a
            >
          </li>
        </ul>
      </div>
    </div>

    <div class="flex flex-col justify-between gap-4 pt-6 text-[11px] text-[#f5f0e6]/40 md:flex-row md:items-center">
      <div class="flex flex-col gap-2 sm:flex-row sm:gap-6">
        <span>© {currentYear} {SITE.author || 'Refac7'} — All Rights Reserved</span>
        <a href="https://icp.gov.moe/?keyword=20252280" target="_blank" class="transition-colors hover:text-[#e8a184]">萌ICP备 20252280号</a
        >
      </div>

      <div class="flex w-full flex-wrap items-center gap-4 sm:w-auto">
        <div class="flex items-center gap-2">
          <span class="relative flex size-1.5"
            ><span class="absolute inline-flex size-full animate-ping rounded-full bg-success/70"></span><span
              class="relative inline-flex size-1.5 rounded-full bg-success"></span></span
          >
          <span>All Systems Normal</span>
        </div>
        <div class="flex items-center gap-2" data-site-age>
          <span class="text-[#f5f0e6]/25">/</span>
          <span>Site Age</span>
          <span class="tabular-nums text-[#f5f0e6]/75" data-site-age-value>calculating…</span>
        </div>
        <div class="ml-auto flex sm:hidden [&_button]:!text-[#f5f0e6] [&_button:hover]:!bg-white/10 [&_button:hover]:!text-[#e8a184]">
          <ThemeToggle client:load />
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    ;(() => {
      const siteCreatedAt = new Date('2025-07-25T17:12:32Z').getTime()
      let intervalId

      const updateSiteAge = () => {
        const siteAge = document.querySelector('[data-site-age-value]')
        if (!siteAge) return false

        let seconds = Math.max(0, Math.floor((Date.now() - siteCreatedAt) / 1000))
        const days = Math.floor(seconds / 86400)
        seconds %= 86400
        const hours = Math.floor(seconds / 3600)
        seconds %= 3600
        const minutes = Math.floor(seconds / 60)
        siteAge.textContent = `${days}d ${String(hours).padStart(2, '0')}h ${String(minutes).padStart(2, '0')}m`
        return true
      }

      const initSiteAge = () => {
        updateSiteAge()
        if (intervalId) window.clearInterval(intervalId)
        intervalId = window.setInterval(updateSiteAge, 60000)
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSiteAge, { once: true })
      } else {
        initSiteAge()
      }

      document.addEventListener('astro:after-swap', initSiteAge)
    })()
  </script>
</footer>
