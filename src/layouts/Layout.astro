---
import '~/styles/global.css'
import '~/styles/pro.css'
import '~/styles/picture.css'
import { SITE } from '~/config'
import Head from '~/components/base/Head.astro'
import Header from './Header.astro'
import Footer from './Footer.astro'
import Loading from '~/components/base/Loading.astro'
// 1. 引入新组件
import PageDecorations from '~/components/base/PageDecorations.astro'

type Props = {
  title: string
  description: string
  image?: string
}

const { title, description, image }: Props = Astro.props
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <Head title={`${title} | ${SITE.title}`} {description} {image} />
  </head>
  <body>
    <!-- 文字选择颜色为黑白色 -->
    <div class="select-text selection:bg-foreground/20 selection:text-foreground">
      <Loading />

      <PageDecorations />

      <Header />
      
      <main class="relative fullPage flex-auto border-x border-border/40 max-w-6xl mx-auto 2xl:ml-[15rem]">
        <slot />
      </main>
      
      <Footer />
    </div>
    
    <!-- 底部渐变遮罩 -->
    <div
      class="pointer-events-none fixed bottom-0 left-0 h-28 w-full z-50 bg-background [mask-image:linear-gradient(transparent,hsl(var(--background)))]"
    >
    </div>
  </body>
</html>