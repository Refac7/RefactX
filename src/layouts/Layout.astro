---
import '~/styles/global.css'
import '~/styles/pro.css'
import '~/styles/picture.css'
import { SITE } from '~/config'
import Head from '~/components/base/Head.astro'
import Header from './Header.astro'
import Footer from './Footer.astro'
import Loading from '~/components/base/Loading.astro'

type Props = {
  title: string
  description: string
  image?: string
}

const { title, description, image }: Props = Astro.props
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <Head title={`${title} | ${SITE.title}`} {description} {image} />
  </head>
  <body>

    <Loading />

    <!-- 文字选择颜色为黑白色 -->
    <div class="select-text selection:bg-foreground/20 selection:text-foreground">
      
      <Header />

      <!-- Main Content -->
      <main class="relative z-10 fullPage flex-auto border-x border-border/40 max-w-6xl mx-auto 2xl:ml-[15rem]">
        <slot />
      </main>

      <div class="relative z-50 bg-background">
        <Footer />
      </div>

    </div>
    
    <!-- 底部渐变遮罩 (保持在最上层) -->
    <div
      class="pointer-events-none fixed bottom-0 left-0 h-28 w-full z-[60] bg-background [mask-image:linear-gradient(transparent,hsl(var(--background)))]"
    >
    </div>
  </body>
</html>