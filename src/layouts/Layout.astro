---
import '~/styles/global.css'
import '~/styles/pro.css'
import { SITE, HOLIDAY_EFFECTS } from '~/config'
import Head from '~/components/base/Head.astro'
import Header from './Header.astro'
import Footer from './Footer.astro'
import HolidayTheme from '~/components/base/HolidayTheme.astro'

type Props = {
  title: string
  description: string
  image?: string
  author?: string
}

const { title, description, image, author } = Astro.props
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <Head title={`${title} | ${SITE.title}`} {description} {image} {author} />
    <script is:inline>
      const theme = localStorage.getItem('theme') || 'system'
      const isDark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches)
      document.documentElement.style.backgroundColor = isDark ? '#0a0a0a' : '#fafafa'
    </script>
  </head>
  <body>
    {HOLIDAY_EFFECTS.enableHolidayEffects && <HolidayTheme />}

    <div
      id="page-transition-loader"
      class="page-transition-loader"
      aria-hidden="true"
      transition:persist="page-transition-loader"
    >
      <div class="page-transition-loader__content">
        <span class="page-transition-loader__dot"></span>
        <span class="page-transition-loader__text">LOADING</span>
      </div>
    </div>

    <div class="select-text selection:bg-foreground/20 selection:text-foreground">
      <div class="relative z-10 bg-background">
        <Header />
      </div>

      <main class="relative z-5 fullPage flex-auto bg-background">
        <slot />
      </main>

      <div class="relative z-0 bg-background">
        <Footer />
      </div>
    </div>
    <div
      class="pointer-events-none fixed bottom-0 left-0 h-28 w-full z-0 bg-background mask-[linear-gradient(transparent,hsl(var(--background)))]"
    >
    </div>

    <style is:global>
      /* 统一加深可视卡片边框，同时保留主题色和原有布局。 */
      [class*="border-border/"][class*="rounded"] {
        border-color: hsl(var(--border) / 0.65) !important;
      }

      .page-transition-loader {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: grid;
        place-items: center;
        background: hsl(var(--background));
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 180ms ease;
        will-change: opacity;
        contain: strict;
      }

      /* 显示加载层时禁止任何渐变，避免 opacity 从旧状态过渡而产生一帧闪烁。 */
      .page-transition-loading .page-transition-loader {
        opacity: 1;
        visibility: visible;
        transition: none;
      }

      .page-transition-loader--done {
        opacity: 0 !important;
        visibility: hidden !important;
      }

      .page-transition-loader__content {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        color: hsl(var(--muted-foreground));
        font: 600 0.6875rem/1 var(--font-geist-mono), monospace;
        letter-spacing: 0.18em;
      }

      .page-transition-loader__dot {
        width: 0.45rem;
        height: 0.45rem;
        border-radius: 9999px;
        background: hsl(var(--primary));
        animation: pageTransitionPulse 800ms ease-in-out infinite;
      }

      @keyframes pageTransitionPulse {
        0%,
        100% { transform: scale(0.7); opacity: 0.35; }
        50% { transform: scale(1); opacity: 1; }
      }

      /* 新页面在加载层覆盖期间保持在飞入动画的第一帧，直到加载层交接。 */
      .page-transition-loading .fade-up {
        animation-play-state: paused;
      }

      .page-transition-ready .fade-up {
        animation-play-state: running;
      }

      @media (prefers-reduced-motion: reduce) {
        .page-transition-loader,
        .page-transition-loader--done {
          transition: none !important;
        }

        .page-transition-loader__dot {
          animation: none;
        }

        .page-transition-loading .fade-up {
          animation-play-state: running;
        }
      }
    </style>

    <script is:inline>
      if (!window.__refactxPageTransitionInitialized) {
        window.__refactxPageTransitionInitialized = true

        const root = document.documentElement
        let transitionTimer = 0
        let finishTimer = 0

        const clearTimers = () => {
          window.clearTimeout(transitionTimer)
          window.clearTimeout(finishTimer)
        }

        const getLoader = () => document.getElementById('page-transition-loader')

        const showPageLoader = () => {
          clearTimers()

          // 先同步锁住状态，再让 Astro 执行 DOM swap，避免 swap 前后出现一帧裸页面。
          root.classList.remove('page-transition-ready')
          root.classList.add('page-transition-loading')
          getLoader()?.classList.remove('page-transition-loader--done')
        }

        const startPageContentAnimation = () => {
          clearTimers()

          // 等待一次绘制，让新页面的 fade-up 从稳定的第一帧开始，而不是在 DOM swap 中抢跑。
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              if (!root.classList.contains('page-transition-loading')) return

              root.classList.add('page-transition-ready')

              // 给组件飞入动画留下完整的 600ms，同时让加载层在最后 180ms 平滑退出。
              finishTimer = window.setTimeout(() => {
                getLoader()?.classList.add('page-transition-loader--done')
                root.classList.remove('page-transition-loading')
              }, 620)
            })
          })
        }

        document.addEventListener('astro:before-preparation', showPageLoader)
        document.addEventListener('astro:after-swap', () => {
          window.scrollTo(0, 0)
          startPageContentAnimation()
        })
      }
    </script>
  </body>
</html>
