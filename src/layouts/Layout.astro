---
import '~/styles/global.css'
import '~/styles/pro.css'
import '~/styles/picture.css'
import { SITE } from '~/config'
import Head from '~/components/base/Head.astro'
import Header from './Header.astro'
import Footer from './Footer.astro'
import Loading from '~/components/base/Loading.astro'
import ConsolePanel from '~/components/base/ConsolePanel.astro'

type Props = {
  title: string
  description: string
  image?: string
}

const { title, description, image }: Props = Astro.props
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <Head title={`${title} | ${SITE.title}`} {description} {image} />
  </head>
  <body>

    <Loading />

    
    <div class="select-text selection:bg-foreground/20 selection:text-foreground">
      <div class="relative z-10 bg-background">
        <Header />
      </div>

      <div class="fixed inset-0 z-0 pointer-events-none bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:48px_48px]"></div>

