.656 89.089 L 646.656 240.385 Q 646.656 254.977 653.76 259.393 Q 660.864 263.809 669.312 263.809 L 662.016 290.689 Q 625.152 290.689 617.472 260.737 Q 608.64 273.025 593.472 283.201 Q 578.304 293.377 554.88 293.377 Q 529.92 293.377 509.568 280.705 Q 489.216 268.033 477.12 244.801 Q 465.024 221.569 465.024 190.081 Q 465.024 160.129 477.12 136.321 Q 489.216 112.513 510.528 98.497 Q 531.84 84.481 559.488 84.481 Q 576.768 84.481 590.784 90.433 Q 604.8 96.385 615.168 105.217 Z M 34.56 288.769 L 0 288.769 L 0 89.089 L 33.408 89.089 L 33.408 132.481 Q 38.4 119.809 46.848 108.865 Q 55.296 97.921 67.968 91.201 Q 80.64 84.481 97.536 84.481 Q 103.296 84.481 109.056 85.057 Q 114.816 85.633 118.656 86.785 L 108.288 122.497 Q 100.992 119.425 91.008 119.425 Q 76.8 119.425 63.936 127.489 Q 51.072 135.553 42.816 152.449 Q 34.56 169.345 34.56 195.457 L 34.56 288.769 Z M 612.096 237.697 Q 603.264 248.449 590.208 255.553 Q 577.152 262.657 562.56 262.657 Q 544.896 262.657 530.688 253.249 Q 516.48 243.841 508.416 227.137 Q 500.352 210.433 500.352 188.929 Q 500.352 166.657 508.416 149.953 Q 516.48 133.249 530.496 123.841 Q 544.512 114.433 562.944 114.433 Q 576.768 114.433 589.248 118.849 Q 601.728 123.265 612.096 130.561 L 612.096 237.697 Z M 163.2 175.105 Q 166.272 145.537 180.864 129.985 Q 195.456 114.433 217.728 114.433 Q 243.456 114.433 258.048 130.177 Q 272.64 145.921 272.64 175.105 L 163.2 175.105 Z M 1072.128 293.377 Q 1061.76 293.377 1054.08 285.697 Q 1046.4 278.017 1046.4 267.649 Q 1046.4 255.745 1053.312 248.833 Q 1060.224 241.921 1072.128 241.921 Q 1082.112 241.921 1089.984 249.601 Q 1097.856 257.281 1097.856 267.649 Q 1097.856 279.169 1090.56 286.273 Q 1083.264 293.377 1072.128 293.377 Z" vector-effect="non-scaling-stroke"/></g></svg>
      </div>

      <main 
        id="main-content"
        class="relative z-0 fullPage flex-auto border-x border-border/40 max-w-6xl mx-auto 2xl:ml-[15rem] bg-background/95 transition-all duration-500 ease-in-out"
      >
        <slot />
      </main>

      <div class="relative z-50 bg-background">
        <Footer />
      </div>

    </div>

    {/* 这里插入 Console 组件 */}
    <ConsolePanel />
    
    
    <div
      class="pointer-events-none fixed bottom-0 left-0 h-28 w-full z-[60] bg-background [mask-image:linear-gradient(transparent,hsl(var(--background)))]"
    >
    </div>
  </body>
</html>