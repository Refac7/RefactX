---
import '~/styles/global.css'
import '~/styles/pro.css'
import '~/styles/picture.css'
import { SITE, Holiday_Effects } from '~/config'
import Head from '~/components/base/Head.astro'
import Header from './Header.astro'
import Footer from './Footer.astro'
import HolidayTheme from '~/components/base/HolidayTheme.astro'

type Props = {
  title: string
  description: string
  image?: string
}

const { title, description, image }: Props = Astro.props
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <Head title={`${title} | ${SITE.title}`} {description} {image} />
  </head>
  <body>
    
    {Holiday_Effects.enableHolidayEffects && <HolidayTheme />}

    <div class="select-text selection:bg-foreground/20 selection:text-foreground">
      <div class="relative z-10 bg-background">
        <Header />
      </div>

      <main 
        class="relative z-0 fullPage flex-auto border-x border-border/40 bg-background transition-all duration-500 ease-in-out"
      >
        <slot />
      </main>

      <div class="relative z-70 bg-background">
        <Footer />
      </div>

    </div>
    <div
      class="pointer-events-none fixed bottom-0 left-0 h-28 w-full z-0 bg-background [mask-image:linear-gradient(transparent,hsl(var(--background)))]"
    >
    </div>
  </body>
</html>