---
import '~/styles/fonts.css'
import '~/styles/global.css'
import '~/styles/pro.css'
import '~/styles/components.css'
import { SITE, HOLIDAY_EFFECTS, PAGE_LOADER_CONFIG } from '~/config'
import Head from '~/components/base/Head.astro'
import Header from './Header.astro'
import Footer from './Footer.astro'
import HolidayTheme from '~/components/base/HolidayTheme.astro'
import SearchOverlay from '~/components/base/SearchOverlay.astro'

type Props = {
  title: string
  description: string
  image?: string
  author?: string
  /** 页面顶部是否使用通栏主视觉（透明导航） */
  hero?: boolean
}

const { title, description, image, author, hero = false } = Astro.props
---

<!doctype html>
<html lang="zh-CN" class:list={[PAGE_LOADER_CONFIG.enablePageLoader && 'page-transition-enabled']}>
  <head>
    <Head title={`${title} | ${SITE.title}`} {description} {image} {author} />
    <script is:inline>
      ;(function () {
        let theme = 'system'
        try {
          theme = localStorage.getItem('theme') || 'system'
        } catch {}

        const isDark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches)
        document.documentElement.style.backgroundColor = isDark ? '#100e0b' : '#faf6ee'
      })()
    </script>
  </head>
  <body>
    {HOLIDAY_EFFECTS.enableHolidayEffects && <HolidayTheme />}

    {
      PAGE_LOADER_CONFIG.enablePageLoader && (
        <div id="page-transition-loader" class="page-transition-loader" aria-hidden="true" transition:persist="page-transition-loader">
          <div class="page-transition-loader__content">
            <span class="page-transition-loader__dot" />
            <span class="page-transition-loader__text">LOADING</span>
          </div>
          <button id="page-transition-skip" class="page-transition-loader__skip" type="button">
            跳过
          </button>
        </div>
      )
    }

    <div class="select-text">
      <Header {hero} />
      {!hero && <div class="h-[76px]" aria-hidden="true" />}

      <main id="page-main" class:list={['relative z-5 fullPage flex-auto', !hero && 'pt-2']}>
        <slot />
      </main>

      <Footer />
    </div>

    <SearchOverlay />

    <div
      class="pointer-events-none fixed bottom-0 left-0 h-28 w-full z-0 bg-background mask-[linear-gradient(transparent,hsl(var(--background)))]"
    >
    </div>

    <style is:global>
      /* 页面切换只保留 Loader，关闭所有页面部件的飞入动画。 */
      html.page-transition-enabled .fade-up {
        opacity: 1 !important;
        transform: none !important;
        animation: none !important;
      }

      .page-transition-loader {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: grid;
        place-items: center;
        background: hsl(var(--background) / 0.6);
        -webkit-backdrop-filter: blur(10px) saturate(140%);
        backdrop-filter: blur(10px) saturate(140%);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        will-change: opacity;
        transition:
          opacity 260ms ease,
          visibility 0s linear 260ms;
      }

      .page-transition-loading .page-transition-loader {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transition:
          opacity 220ms ease,
          visibility 0s linear 0s;
      }

      .page-transition-loader--done {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition:
          opacity 320ms ease,
          visibility 0s linear 320ms;
      }

      .page-transition-loader__content {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        color: hsl(var(--muted-foreground));
        font:
          600 0.6875rem/1 var(--font-geist-mono),
          monospace;
        letter-spacing: 0.18em;
      }

      .page-transition-loader__dot {
        width: 0.45rem;
        height: 0.45rem;
        border-radius: 9999px;
        background: hsl(var(--primary));
        animation: pageTransitionPulse 800ms ease-in-out infinite;
      }

      .page-transition-loader__skip {
        position: absolute;
        bottom: 2.5rem;
        left: 50%;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.55rem 1.1rem;
        border: 1px solid hsl(var(--border) / 0.6);
        border-radius: 9999px;
        background: hsl(var(--background) / 0.7);
        color: hsl(var(--muted-foreground));
        font:
          600 0.6875rem/1 var(--font-geist-mono),
          monospace;
        letter-spacing: 0.15em;
        cursor: pointer;
        opacity: 0;
        pointer-events: none;
        transform: translateX(-50%) translateY(0.5rem);
        transition:
          opacity 200ms ease,
          transform 200ms ease,
          color 200ms ease,
          border-color 200ms ease;
      }

      .page-transition-loader--slow .page-transition-loader__skip {
        opacity: 1;
        pointer-events: auto;
        transform: translateX(-50%) translateY(0);
      }

      .page-transition-loader__skip:hover {
        color: hsl(var(--foreground));
        border-color: hsl(var(--border));
      }

      @keyframes pageTransitionPulse {
        0%,
        100% {
          transform: scale(0.7);
          opacity: 0.35;
        }
        50% {
          transform: scale(1);
          opacity: 1;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .page-transition-loader,
        .page-transition-loader--done {
          transition: none !important;
        }

        .page-transition-loader__dot {
          animation: none;
        }
      }

      html.page-enter #page-main {
        animation: pageMainEnter 420ms cubic-bezier(0.22, 1, 0.36, 1) both;
      }

      @keyframes pageMainEnter {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html.page-enter #page-main {
          animation: none !important;
        }
      }
    </style>

    <script is:inline>
      if (!window.__refactxPageTransitionInitialized) {
        window.__refactxPageTransitionInitialized = true

        const root = document.documentElement
        let transitionGeneration = 0
        let hideFrame = 0
        let slowTimer = 0
        const SLOW_THRESHOLD = 3500

        const getLoader = () => document.getElementById('page-transition-loader')

        const cancelPendingTransition = () => {
          transitionGeneration += 1
          cancelAnimationFrame(hideFrame)
        }

        const clearSlow = () => {
          window.clearTimeout(slowTimer)
          slowTimer = 0
          getLoader()?.classList.remove('page-transition-loader--slow')
        }

        const showLoader = () => {
          cancelPendingTransition()
          const loader = getLoader()
          if (!loader) return

          loader.classList.remove('page-transition-loader--done')
          root.classList.add('page-transition-loading')

          // 加载过久时提供关闭入口，避免用户被一直卡在加载态
          clearSlow()
          slowTimer = window.setTimeout(() => {
            getLoader()?.classList.add('page-transition-loader--slow')
          }, SLOW_THRESHOLD)
        }

        const hideLoader = () => {
          clearSlow()
          const generation = transitionGeneration
          hideFrame = requestAnimationFrame(() => {
            if (generation !== transitionGeneration) return

            const loader = getLoader()
            loader?.classList.add('page-transition-loader--done')
            root.classList.remove('page-transition-loading')
          })
        }

        const dismissLoader = () => {
          cancelPendingTransition()
          clearSlow()
          getLoader()?.classList.add('page-transition-loader--done')
          root.classList.remove('page-transition-loading')
        }

        document.getElementById('page-transition-skip')?.addEventListener('click', dismissLoader)

        document.addEventListener('astro:before-preparation', showLoader)
        document.addEventListener('astro:after-swap', () => {
          window.scrollTo(0, 0)
          hideLoader()
        })

        document.addEventListener('click', (event) => {
          if (event.defaultPrevented || event.button !== 0) return
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return

          const anchor = event.target instanceof Element ? event.target.closest('a[href]') : null
          if (!anchor || (anchor.target && anchor.target !== '_self')) return

          try {
            const target = new URL(anchor.href)
            if (target.origin === location.origin && target.href === location.href) {
              event.preventDefault()
              event.stopPropagation()
            }
          } catch {}
        })
      }
    </script>

    <script is:inline>
      ;(() => {
        if (window.__refactxPageEnterInitialized) return
        window.__refactxPageEnterInitialized = true

        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)')

        const playEnter = () => {
          if (reduceMotion.matches) return
          const root = document.documentElement
          const main = document.getElementById('page-main')
          if (!main) return
          root.classList.remove('page-enter')
          void main.offsetWidth
          requestAnimationFrame(() => root.classList.add('page-enter'))
        }

        const hydrateHeroImages = () => {
          document.querySelectorAll('.page-hero__media img, .article-cover img').forEach((image) => {
            if (image.complete && image.naturalWidth > 0) image.classList.add('is-loaded')
          })
        }

        document.addEventListener('astro:before-swap', () => {
          document.documentElement.classList.remove('page-enter')
        })
        document.addEventListener('astro:after-swap', () => {
          // ClientRouter 会替换 <html> 上的 SSR 属性，这里重新补上动画所需的类
          const root = document.documentElement
          root.classList.add('reveal-enabled', 'has-navigated')
          hydrateHeroImages()
          playEnter()
        })
        document.addEventListener('astro:page-load', hydrateHeroImages)

        const initPageEnter = () => {
          hydrateHeroImages()
          playEnter()
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initPageEnter, { once: true })
        } else {
          initPageEnter()
        }
      })()
    </script>

    <script is:inline>
      ;(() => {
        if (window.__refactxRevealInitialized) return
        window.__refactxRevealInitialized = true

        let observer = null
        const SELECTOR = [
          '.page-hero__status',
          '.page-hero__headline',
          '.page-hero__intro',
          '.page-hero__tags',
          '.page-hero__stats',
          '.reveal-header',
          '.post-card',
          '.explore-card',
          '.home-panel',
          '.home-cta',
          '.surface',
          '.surface-soft',
          '.article-back',
          '.article-eyebrow',
          '.article-title',
          '.article-desc',
          '.article-meta',
          '.article-cover',
          '.post-nav',
          '.pagination',
          '.site-footer__card',
        ].join(',')

        const revealAll = () => {
          document.querySelectorAll(SELECTOR).forEach((element) => element.classList.add('is-revealed'))
        }

        const initReveal = () => {
          if (observer) observer.disconnect()
          observer = null

          if (!document.documentElement.classList.contains('reveal-enabled')) return

          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
            revealAll()
            return
          }

          const targets = Array.from(document.querySelectorAll(SELECTOR)).filter((element) => !element.classList.contains('is-revealed'))
          if (targets.length === 0) return

          const targetSet = new Set(targets)
          targets.forEach((element) => {
            const parent = element.parentElement
            if (!parent) return
            const siblings = Array.from(parent.children).filter((child) => targetSet.has(child))
            const index = siblings.indexOf(element)
            if (index >= 0) element.style.setProperty('--reveal-delay', `${Math.min(index, 8) * 55}ms`)
          })

          observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return
                entry.target.classList.add('is-revealed')
                observer?.unobserve(entry.target)
              })
            },
            { rootMargin: '0px 0px -6% 0px', threshold: 0.08 }
          )

          targets.forEach((element) => observer.observe(element))
        }

        document.addEventListener('astro:page-load', initReveal)
        document.addEventListener('astro:before-swap', () => {
          if (observer) observer.disconnect()
          observer = null
        })

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initReveal, { once: true })
        } else {
          initReveal()
        }
      })()
    </script>
  </body>
</html>
