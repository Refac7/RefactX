---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { getCollection } from 'astro:content'
import { POSTS_CONFIG } from '~/config'
import { postsSort } from '~/lib/utils'
import { SECTION_HEADER_CLASS, SECTION_TITLE_CLASS, SECTION_NUM_CLASS, SECTION_META_CLASS } from '~/lib/ui'
import Layout from '~/layouts/Layout.astro'
import Pagination from '~/components/base/Pagination.astro'
import List from '~/components/posts/card/List.astro'
import PageAside from '~/components/base/PageAside.astro'

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allPosts = await getCollection('posts')
  const sortedPosts = postsSort(allPosts)
  return paginate(sortedPosts, { pageSize: POSTS_CONFIG.postPageConfig.size })
}

interface Props {
  page: Page<CollectionEntry<'posts'>>
}
const { page } = Astro.props
const { title, description, introduce } = POSTS_CONFIG
const progressPercent = Math.round((page.currentPage / page.lastPage) * 100)
---

<Layout {title} {description}>
  <div class="relative font-sans flex flex-col lg:flex-row min-h-screen max-w-[1920px] mx-auto">
    <PageAside
      statusText="Feed Live"
      statusHasPing={false}
      statusVariant="primary"
      {title}
      subtitleIcon="icon-[ph--book-open]"
      subtitleText="Directory Listing"
      identityTags={[
        { icon: 'icon-[ph--article]', label: `${page.total} Posts` },
        { icon: 'icon-[ph--rss]', label: 'RSS Feed' },
        { icon: 'icon-[ph--archive]', label: 'Archives' },
      ]}
      intro={introduce}
      statsLabel="FEED STATUS"
      statsMeta={`${page.total} TOTAL`}
      stats={[
        { value: String(page.total), label: 'Total Entries' },
        { value: `${page.currentPage} / ${page.lastPage}`, label: 'Page' },
      ]}
    />

    <main class="w-full lg:w-1/2 lg:flex-1 z-10 flex flex-col fade-up animation-delay-100">
      <div class="px-5 py-10 sm:px-8 lg:px-10 lg:py-14 xl:px-12 flex-1 flex flex-col">
        <div class={SECTION_HEADER_CLASS}>
          <div class="flex items-center"><span class={SECTION_NUM_CLASS}>01</span><h2 class={SECTION_TITLE_CLASS}>Stream Sequence</h2></div>
          <span class={SECTION_META_CLASS}>Post_Feed</span>
        </div>

        <div class="relative z-10 flex-1 min-h-100 fade-up animation-delay-200">
          <List
            posts={page.data}
            type={POSTS_CONFIG.postPageConfig.type}
            heroImageLayout={POSTS_CONFIG.postPageConfig?.heroImageLayout}
            showIndex
          />
        </div>

        <div class="mt-16 border-t-2 border-foreground pt-6">
          <div class="mb-8">
            <div class="mb-2 flex justify-between font-mono text-[9px] uppercase tracking-[0.18em] text-muted-foreground">
              <span>Reading Progress</span><span class="tabular-nums text-foreground">{progressPercent}%</span>
            </div>
            <div class="h-1.5 w-full overflow-hidden bg-muted">
              <div class="h-full bg-primary transition-all duration-500 ease-out" style={`width: ${progressPercent}%`}></div>
            </div>
          </div>
          <div class="mb-2 flex flex-col items-center justify-between gap-6 md:flex-row">
            <div class="hidden flex-col gap-1 md:flex">
              <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-foreground">Navigation</span>
              <span class="text-xs text-muted-foreground">Select a page to continue reading.</span>
            </div>
            <div class="flex w-full flex-1 justify-center md:w-auto md:justify-end"><Pagination {page} baseUrl="/posts" /></div>
          </div>
        </div>
      </div>
    </main>
  </div>
</Layout>
