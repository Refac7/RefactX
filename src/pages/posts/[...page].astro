---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { getCollection } from 'astro:content'
import { POSTS_CONFIG } from '~/config'
import { postsSort } from '~/lib/utils'
import { SECTION_HEADER_CLASS, SECTION_TITLE_CLASS, SECTION_NUM_CLASS, SECTION_META_CLASS } from '~/lib/ui'
import Layout from '~/layouts/Layout.astro'
import Pagination from '~/components/base/Pagination.astro'
import List from '~/components/posts/card/List.astro'
import PageAside from '~/components/base/PageAside.astro'

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allPosts = await getCollection('posts')
  const sortedPosts = postsSort(allPosts)
  return paginate(sortedPosts, { pageSize: POSTS_CONFIG.postPageConfig.size })
}

interface Props {
  page: Page<CollectionEntry<'posts'>>
}
const { page } = Astro.props
const { title, description, introduce } = POSTS_CONFIG
const progressPercent = Math.round((page.currentPage / page.lastPage) * 100)
---

<Layout {title} {description}>
  <div class="page-shell relative font-sans min-h-screen">
    <PageAside
      image="/photos/250524-1.webp"
      statusText="Feed Live"
      statusHasPing={false}
      statusVariant="primary"
      {title}
      subtitleIcon="icon-[ph--book-open]"
      subtitleText="Directory Listing"
      identityTags={[
        { icon: 'icon-[ph--article]', label: `${page.total} Posts` },
        { icon: 'icon-[ph--rss]', label: 'RSS Feed' },
        { icon: 'icon-[ph--archive]', label: 'Archives' },
      ]}
      intro={introduce}
      statsLabel="Article archive"
      statsMeta={`${page.total} TOTAL`}
      stats={[
        { value: String(page.total), label: 'Total Articles' },
        { value: `${page.currentPage} / ${page.lastPage}`, label: 'Current Page' },
      ]}
    />

    <main class="w-full z-10 flex flex-col fade-up animation-delay-100">
      <div class="flex-1 flex flex-col">
        <div class={SECTION_HEADER_CLASS}>
          <div class="flex items-center"><span class={SECTION_NUM_CLASS}>01</span><h2 class={SECTION_TITLE_CLASS}>全部文章</h2></div>
          <span class={SECTION_META_CLASS}>Page {page.currentPage} of {page.lastPage}</span>
        </div>

        <div class="relative z-10 flex-1 fade-up animation-delay-200">
          <List
            posts={page.data}
            type={POSTS_CONFIG.postPageConfig.type}
            heroImageLayout={POSTS_CONFIG.postPageConfig?.heroImageLayout}
            showIndex
          />
        </div>

        <div class="mt-16 pt-8 border-t border-border/50">
          <div class="flex flex-col md:flex-row items-center justify-between gap-6">
            <div class="hidden md:flex flex-col gap-1">
              <span class="text-sm font-semibold text-foreground">继续翻页</span>
              <span class="text-xs text-muted-foreground">已阅读 {progressPercent}% 的文章归档。</span>
            </div>
            <div class="flex-1 w-full md:w-auto flex justify-center md:justify-end"><Pagination {page} baseUrl="/posts" /></div>
          </div>
        </div>
      </div>
    </main>
  </div>
</Layout>
