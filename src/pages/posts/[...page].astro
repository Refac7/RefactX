---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { getCollection } from 'astro:content'
import { POSTS_CONFIG } from '~/config'
import { postsSort } from '~/lib/utils'
import Layout from '~/layouts/Layout.astro'
import Pagination from '~/components/base/Pagination.astro'
import List from '~/components/posts/card/List.astro'

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allPosts = await getCollection('posts')
  const sortedPosts = postsSort(allPosts)

  return paginate(sortedPosts, {
    pageSize: POSTS_CONFIG.postPageConfig.size,
  })
}

interface Props {
  page: Page<CollectionEntry<'posts'>>
}

const { page } = Astro.props
const { title, description, introduce } = POSTS_CONFIG

// 计算当前进度的百分比
const progressPercent = Math.round((page.currentPage / page.lastPage) * 100);
---

<Layout {title} {description}>
  <div class="relative py-12 px-6 sm:px-8 font-sans min-h-[80vh]">
    
    <!-- 1. 头部区域：Grid 布局重构 -->
    <div class="pb-10">
      
      <!-- 顶栏状态条 -->
      <div class="flex items-center justify-between mb-8 text-[10px] font-mono uppercase tracking-widest text-muted-foreground/60">
        <span>// SYSTEM_LOGS // V.2.0</span>
        <div class="flex items-center gap-2 text-primary">
             <span class="relative flex h-1.5 w-1.5">
               <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
               <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-primary"></span>
             </span>
             <span>Live Feed</span>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-end">
        <!-- 左侧：标题 -->
        <div class="lg:col-span-7">
          <h1 class="text-6xl sm:text-7xl font-bold tracking-tighter text-foreground leading-[0.9] -ml-1">
            {title}<span class="text-primary/80">.</span>
          </h1>
        </div>

        <!-- 右侧：简介与数据面板 -->
        <div class="lg:col-span-5 flex flex-col gap-6">
          <div class="border-l-2 border-primary/40 pl-5">
             <p class="text-base sm:text-lg text-muted-foreground leading-relaxed">
              {introduce}
             </p>
          </div>

          <!-- 数据网格 -->
          <div class="grid grid-cols-2 gap-px bg-border/50 border border-border/50">
            <!-- Total Posts -->
            <div class="bg-background/50 p-3 flex flex-col gap-1">
              <span class="text-[9px] uppercase tracking-widest text-muted-foreground/70 font-mono">Total_Entries</span>
              <span class="text-2xl font-mono font-bold text-foreground">{page.total}</span>
            </div>
            
            <!-- Current Page -->
            <div class="bg-background/50 p-3 flex flex-col gap-1">
              <span class="text-[9px] uppercase tracking-widest text-muted-foreground/70 font-mono">Page_Index</span>
              <div class="flex items-baseline gap-1">
                 <span class="text-2xl font-mono font-bold text-primary">{page.currentPage.toString().padStart(2, '0')}</span>
                 <span class="text-xs text-muted-foreground/40 font-mono">/ {page.lastPage.toString().padStart(2, '0')}</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. 内容区域分割线 -->
    <div class="flex items-end gap-4 mb-10 select-none">
       <span class="font-mono text-4xl font-bold text-muted-foreground/10 leading-none -mb-1">01</span>
       <span class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-muted-foreground/50 mb-1">
          Stream_Sequence
       </span>
       <div class="h-px bg-gradient-to-r from-border to-transparent flex-1 mb-1.5"></div>
    </div>

    <!-- 3. 文章列表 -->
    <div class=" min-h-[40vh] relative z-10">
      <List 
        posts={page.data} 
        type={POSTS_CONFIG.postPageConfig.type} 
        heroImageLayout={POSTS_CONFIG.postPageConfig?.heroImageLayout} 
      />
    </div>

    <!-- 4. 底部导航区：控制台风格 -->
    <div class="mt-20">
      <!-- 进度条装饰 -->
      <div class="w-full h-px bg-border relative mb-8">
        <div class="absolute top-0 left-0 h-[3px] bg-primary -mt-[1px] transition-all duration-500" style={`width: ${progressPercent}%`}>
           <div class="absolute right-0 top-1/2 -translate-y-1/2 size-2 bg-primary shadow-[0_0_10px_rgba(var(--primary),0.5)]"></div>
        </div>
      </div>

      <div class="flex flex-col md:flex-row items-center justify-between gap-6 pb-8">
         <div class="hidden md:flex flex-col gap-1">
            <span class="text-[10px] font-mono uppercase text-muted-foreground/50 tracking-widest">System Status</span>
            <span class="text-xs font-bold text-muted-foreground">Reading Buffer: {progressPercent}%</span>
         </div>

         <!-- 居中的分页组件 -->
         <div class="flex-1 w-full md:w-auto flex justify-center md:justify-end">
           <Pagination {page} baseUrl="/posts" />
         </div>
      </div>
      
      <!-- 底部版权或结束语 -->
      <div class="flex justify-center border-t border-dashed border-border/60 pt-6">
        <span class="font-mono text-[10px] text-muted-foreground/30 uppercase tracking-[0.3em]">
          End of Segment // {new Date().getFullYear()}
        </span>
      </div>
    </div>

  </div>
</Layout>