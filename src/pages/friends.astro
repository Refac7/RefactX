---
import rawFriendsList from '~/content/data/friends.json'
import { FRIENDS_CONFIG, FRIENDS_CONTACT } from '~/config'
import Layout from '~/layouts/Layout.astro'
import Comments from '~/components/posts/base/Comments.astro'
import TerminalBuffer from '~/components/base/TerminalBuffer.astro';

interface Friend { name: string; url: string; author: string; description: string; avatar: string; }
const FRIENDS_LIST = rawFriendsList as Friend[];

const shuffledFriendsList = [...FRIENDS_LIST];
for (let i = shuffledFriendsList.length - 1; i > 0; i--) {
  const j = Math.floor(Math.random() * (i + 1));
  [shuffledFriendsList[i], shuffledFriendsList[j]] = [shuffledFriendsList[j], shuffledFriendsList[i]];
}
const { title, description, introduce, enableAdd } = FRIENDS_CONFIG
const { sitename, email, author, sitelink, siteavatar, description: myDescription } = FRIENDS_CONTACT;
const totalLinks = FRIENDS_LIST.length.toString().padStart(2, '0');

const SECTION_HEADER_CLASS = "flex items-end justify-between border-b pb-4 mb-8 select-none"
const SECTION_TITLE_CLASS = "font-mono text-sm font-bold uppercase tracking-widest text-foreground/80"
const SECTION_NUM_CLASS = "font-mono text-xs text-primary mr-3"
---

<Layout title={title} description={description}>
  <div class="relative font-sans flex flex-col lg:flex-row min-h-screen max-w-[1920px] mx-auto">
    <aside class="w-full lg:w-1/3 lg:sticky lg:top-0 lg:h-screen flex flex-col lg:border-r z-20 bg-background border-b border-border/60 lg:border-none">
      
      <div class="flex flex-1 lg:overflow-y-auto scrollbar-hide flex-col">
        <div class="p-6 lg:p-8 xl:p-12 pb-0 shrink-0">
          <div class="flex flex-row justify-between items-start text-[10px] font-mono uppercase tracking-widest text-muted-foreground/60 select-none">
              <span>// SYSTEM_LINKS // NETWORK</span>
              <div class="flex items-center gap-2 text-primary">
                  <span class="relative flex h-1.5 w-1.5"><span class="animate-ping absolute inline-flex h-full w-full bg-emerald-500 opacity-75"></span><span class="relative inline-flex h-1.5 w-1.5 bg-emerald-500"></span></span>
                  <span class="font-bold text-foreground">CONN: ESTABLISHED</span>
              </div>
          </div>
        </div>
        
        <div class="flex-1 flex flex-col justify-end lg:justify-center p-6 lg:p-8 xl:p-12 min-h-[300px] lg:min-h-[250px]">
           <h1 class="text-6xl sm:text-7xl xl:text-8xl font-black tracking-tighter text-foreground leading-[0.8] mb-6 -ml-1 select-none">{title.toUpperCase()}<span class="text-primary">.</span></h1>
           <div class="h-px w-24 bg-foreground/20 mt-2 mb-4"></div>
           <div class="flex items-center gap-2 text-xs font-mono text-muted-foreground/60 uppercase"><span class="icon-[ph--planet-bold] size-4"></span><span>Signal Exchange</span></div>
        </div>
        
        <div class="shrink-0 p-6 lg:p-8 xl:p-12 bg-muted/5 border-t border-dashed border-border/40">
           <span class="block text-[10px] uppercase text-muted-foreground/60 font-mono tracking-wider mb-4">// NODE_INFO</span>
           <p class="text-sm text-muted-foreground leading-loose font-mono">{introduce}<br/><br/><span class="text-primary">> Scanning frequency...</span></p>
        </div>
      </div>

      <div class="grid grid-cols-2 bg-border/40 gap-px border-t border-border/40 shrink-0">
          <div class="group relative flex flex-col items-center justify-center p-6 bg-background hover:bg-muted/10 transition-colors h-32 lg:h-28 xl:h-32">
             <span class="text-3xl font-mono font-bold text-foreground tracking-tighter group-hover:text-primary transition-colors">{totalLinks}</span>
             <span class="text-[9px] font-mono uppercase tracking-widest text-muted-foreground mt-2">Active_Nodes</span>
             <div class="absolute top-0 right-0 p-1 opacity-0 group-hover:opacity-100 transition-opacity"><div class="w-1.5 h-1.5 bg-primary"></div></div>
          </div>
          <div class="group relative flex flex-col items-center justify-center p-6 bg-background hover:bg-muted/10 transition-colors h-32 lg:h-28 xl:h-32">
             <span class="text-lg font-mono font-bold text-foreground group-hover:text-primary transition-colors">HTTPS/2</span>
             <span class="text-[9px] font-mono uppercase tracking-widest text-muted-foreground mt-2">Protocol_Ver</span>
             <div class="absolute bottom-0 left-0 p-1 opacity-0 group-hover:opacity-100 transition-opacity"><div class="w-1.5 h-1.5 bg-primary"></div></div>
          </div>
      </div>
    </aside>

    <main class="w-full lg:w-2/3 z-10 flex flex-col">
      <div class="p-6 lg:p-10 xl:p-16 2xl:p-20 flex-1 flex flex-col">
        <div class={SECTION_HEADER_CLASS}>
            <div class="flex items-center"><span class={SECTION_NUM_CLASS}>01</span><h2 class={SECTION_TITLE_CLASS}>Node_Sequence</h2></div>
            <div class="hidden sm:block h-px flex-1 bg-border/40 ml-6 max-w-[200px]"></div>
        </div>
        <TerminalBuffer layout="grid" count={12} delay={500}>
          <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
            {/* === 修改：使用 shuffledFriendsList 替代原有的 FRIENDS_LIST 渲染 === */}
            {shuffledFriendsList.map((friend, index) => {
              const paddedIndex = (index + 1).toString().padStart(2, '0');
              return (
                <a href={friend.url} target="_blank" rel="noopener noreferrer" class="group relative flex flex-col p-6 bg-background border hover:border-primary/50 transition-all duration-300 min-h-[200px]">
                  <div class="absolute top-2 right-4 pointer-events-none select-none"><span class="font-mono text-6xl font-black text-muted-foreground/[0.03] group-hover:text-primary/[0.04] transition-colors">{paddedIndex}</span></div>
                  <div class="absolute top-0 left-0 w-2 h-2 border-t border-l border-primary/0 group-hover:border-primary/50 transition-colors"></div>
                  <div class="absolute bottom-0 right-0 w-2 h-2 border-b border-r border-primary/0 group-hover:border-primary/50 transition-colors"></div>
                  <div class="flex gap-5 relative z-10 items-start">
                    <div class="relative shrink-0">
                        <div class="size-14 p-0.5 border group-hover:border-primary/40 bg-muted/10 transition-colors"><img src={friend.avatar} alt={friend.name} class="size-full object-cover opacity-90 group-hover:opacity-100 transition-opacity" loading="lazy" /></div>
                        <div class="absolute -top-px -left-px w-1 h-1 bg-foreground/20 group-hover:bg-primary transition-colors"></div>
                        <div class="absolute -bottom-px -right-px w-1 h-1 bg-foreground/20 group-hover:bg-primary transition-colors"></div>
                    </div>
                    <div class="flex flex-col min-w-0 pt-0.5">
                      <div class="flex items-center gap-2 mb-1"><h3 class="font-bold text-lg text-foreground group-hover:text-primary transition-colors truncate tracking-tight font-sans">{friend.name}</h3><span class="icon-[ph--arrow-up-right] size-3 text-muted-foreground/30 group-hover:text-primary transition-colors shrink-0"></span></div>
                      <div class="text-[10px] font-mono text-muted-foreground/60 mb-2 truncate">AUTH: {friend.author.toUpperCase()}</div>
                    </div>
                  </div>
                  <div class="mt-4 pt-4 border-t border-dashed border-border/40 flex-1"><p class="text-xs text-muted-foreground leading-relaxed line-clamp-3 font-mono">{friend.description || "No signal detected from this sector."}</p></div>
                  <div class="mt-4 flex items-center gap-2"><div class="w-1.5 h-1.5 bg-emerald-500/80 rounded-none"></div><span class="text-[9px] font-mono text-muted-foreground/50 tracking-widest uppercase">Signal_Strong</span></div>
                </a>
              )
            })}
            
            {enableAdd ? (
              <a href="#exchange-section" class="group relative flex flex-col items-center justify-center p-6 cursor-pointer bg-muted/[0.02] border border-dashed hover:border-primary/40 hover:bg-muted/5 transition-all duration-300 min-h-[200px]">
                  <div class="size-12 flex items-center justify-center border border-border/40 bg-background group-hover:scale-110 transition-transform mb-4"><span class="icon-[ph--plus] size-5 text-muted-foreground group-hover:text-primary transition-colors"></span></div>
                  <span class="font-mono text-xs uppercase tracking-[0.2em] text-muted-foreground/70 group-hover:text-foreground transition-colors">Initialize_Link</span>
                  <div class="absolute bottom-4 right-4 font-mono text-xs text-muted-foreground/20">SLOT: {parseInt(totalLinks) + 1}</div>
              </a>
            ) : (
              <div class="relative flex flex-col items-center justify-center p-6 bg-muted/[0.02] border border-dashed border-border/20 min-h-[200px] select-none">
                  <div class="size-12 flex items-center justify-center border border-border/20 bg-background/50 mb-4"><span class="icon-[ph--lock-key] size-5 text-muted-foreground/30"></span></div>
                  <span class="font-mono text-xs uppercase tracking-[0.2em] text-muted-foreground/40">Link_Locked</span>
                  <div class="absolute bottom-4 right-4 font-mono text-xs text-muted-foreground/20">SLOT: {parseInt(totalLinks) + 1}</div>
              </div>
            )}
          </div>
        </TerminalBuffer>
        
        {enableAdd ? (
          <>
            <div id="exchange-section" class="mt-32">
              <div class={SECTION_HEADER_CLASS}>
                <div class="flex items-center"><span class={SECTION_NUM_CLASS}>02</span><h2 class={SECTION_TITLE_CLASS}>Exchange_Protocol</h2></div>
                <div class="hidden sm:block h-px flex-1 bg-border/40 ml-6 max-w-[200px]"></div>
              </div>
              <div class="grid xl:grid-cols-2 gap-12">
                  <div class="flex flex-col justify-between">
                      <div>
                          <div class="border-l-2 border-primary pl-6 py-1 mb-8"><h3 class="text-xl font-bold uppercase tracking-tight mb-2">Transmission Rules</h3><p class="text-sm text-muted-foreground font-mono">Follow protocols to establish connection.</p></div>
                          <ul class="space-y-4 text-sm text-muted-foreground/80 font-mono list-disc list-inside marker:text-primary"><li>确保内容符合行业法规。</li><li>在请求上行链接前添加本地链接。</li><li>优先考虑技术、设计和科幻节点。</li><li>不活跃的节点将定期清理。</li></ul>
                      </div>
                      <div class="mt-12 p-6 border bg-muted/[0.02]">
                          <span class="text-[9px] font-bold text-muted-foreground uppercase tracking-wider font-mono block mb-3">// Direct_Line</span>
                          <a href={`mailto:${email}`} class="flex items-center gap-3 hover:text-primary transition-colors group"><span class="icon-[ph--envelope-simple] size-5"></span><span class="text-base font-mono text-foreground break-all border-b border-transparent group-hover:border-primary transition-colors">{email}</span></a>
                      </div>
                  </div>
                  <div class="relative mt-8 xl:mt-0">
                      <div class="absolute -top-1 -left-1 size-3 border-t border-l border-primary"></div>
                      <div class="absolute -bottom-1 -right-1 size-3 border-b border-r border-primary"></div>
                      <div class="border bg-background p-6 lg:p-8">
                          <div class="flex justify-between items-end mb-8 border-b border-dashed pb-4"><span class="font-bold text-sm uppercase tracking-widest">Site_Configuration</span><span class="font-mono text-[10px] text-muted-foreground bg-muted/10 px-2 py-1">JSON_V1.0</span></div>
                          <div class="space-y-px bg-border/40 border border-border/40">
                              {[{ label: 'NAME', value: sitename },{ label: 'AUTHOR', value: author },{ label: 'URL', value: sitelink },{ label: 'AVATAR', value: siteavatar },{ label: 'DESC', value: myDescription }].map(item => (
                                  <div class="grid grid-cols-[80px_1fr] gap-4 bg-background p-3 group hover:bg-muted/[0.02] transition-colors"><span class="text-muted-foreground/50 text-[10px] font-mono pt-0.5 select-none">{item.label}</span><span class="text-foreground text-xs font-mono break-all select-all">{item.value}</span></div>
                              ))}
                          </div>
                          <button id="copy-btn" class="copy-trigger mt-6 w-full py-4 bg-foreground text-background hover:bg-primary/80 transition-all duration-200 font-mono text-xs font-bold tracking-[0.2em] rounded-none flex items-center justify-center gap-3 group active:scale-[0.99] border border-transparent" data-sitename={sitename} data-author={author} data-sitelink={sitelink} data-siteavatar={siteavatar} data-description={myDescription}>
                            <span id="copy-icon" class="icon-[ph--brackets-curly] size-4"></span><span id="copy-text">COPY_CONFIG</span>
                          </button>
                      </div>
                  </div>
              </div>
            </div>

            <div class="pb-12 mt-4 w-full"><Comments /></div>
          </>
        ) : (
          <div class="mt-32 pb-12 w-full">
            <div class="border border-border/30 bg-muted/5 p-12 text-center rounded-none flex flex-col items-center justify-center min-h-[250px]">
              <span class="icon-[ph--link-break] size-10 text-muted-foreground/40 mb-4 block mx-auto"></span>
              <span class="font-mono text-xs uppercase tracking-widest text-muted-foreground/60 block mb-2">// SYS_DISABLED</span>
              <p class="text-muted-foreground/50 text-xs">友链申请通道已离线，如有需要请通过邮件联系站长。</p>
            </div>
          </div>
        )}
      </div>
    </main>
  </div>
</Layout>
<style>.scrollbar-hide::-webkit-scrollbar{display:none;}.scrollbar-hide{-ms-overflow-style:none;scrollbar-width:none;}</style>
<script is:inline>
  function initCopy() {
    const btns = document.querySelectorAll(".copy-trigger");
    btns.forEach(btn => {
        const newBtn = btn.cloneNode(true);
        btn.parentNode.replaceChild(newBtn, btn);
        newBtn.addEventListener("click", () => {
            const icon = newBtn.querySelector("#copy-icon");
            const text = newBtn.querySelector("#copy-text");
            const myInfo = { name: newBtn.dataset.sitename, author: newBtn.dataset.author, url: newBtn.dataset.sitelink, avatar: newBtn.dataset.siteavatar, description: newBtn.dataset.description };
            navigator.clipboard.writeText(JSON.stringify(myInfo, null, 2)).then(() => {
                if(icon) icon.className = "icon-[ph--check-bold] size-4";
                if(text) text.textContent = "COPIED";
                newBtn.classList.remove('bg-foreground', 'text-background');
                newBtn.classList.add('bg-emerald-600', 'text-white');
                setTimeout(() => {
                    if(icon) icon.className = "icon-[ph--brackets-curly] size-4";
                    if(text) text.textContent = "COPY_CONFIG";
                    newBtn.classList.add('bg-foreground', 'text-background');
                    newBtn.classList.remove('bg-emerald-600', 'text-white');
                }, 2000);
            }).catch(console.error);
        });
    });
  }
  document.addEventListener('astro:page-load', initCopy);
  if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', initCopy); } else { initCopy(); }
</script>