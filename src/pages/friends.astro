---
import rawFriendsList from '~/content/data/friends.json'
import { FRIENDS_CONFIG, FRIENDS_CONTACT } from '~/config'
import { SECTION_HEADER_CLASS, SECTION_TITLE_CLASS, SECTION_NUM_CLASS, SECTION_META_CLASS } from '~/lib/ui'
import Layout from '~/layouts/Layout.astro'
import Comments from '~/components/posts/base/Comments.astro'
import PageAside from '~/components/base/PageAside.astro'

interface Friend {
  name: string
  url: string
  author: string
  description: string
  avatar: string
}
const FRIENDS_LIST = rawFriendsList as Friend[]
const { title, description, introduce, enableAdd } = FRIENDS_CONFIG
const { sitename, email, author, sitelink, siteavatar, description: myDescription } = FRIENDS_CONTACT
const totalLinks = FRIENDS_LIST.length.toString().padStart(2, '0')
---

<Layout {title} {description}>
  <div class="relative font-sans flex flex-col lg:flex-row min-h-screen max-w-[1920px] mx-auto">
    <PageAside
      statusText="Connected"
      statusVariant="emerald"
      title={title}
      subtitleIcon="icon-[ph--planet]"
      subtitleText="Network & Signals"
      identityTags={[
        { icon: 'icon-[ph--share-network]', label: `${totalLinks} Nodes` },
        { icon: 'icon-[ph--lock-key]', label: 'HTTPS' },
        { icon: 'icon-[ph--globe]', label: 'Web Ring' },
      ]}
      intro={introduce}
      statsLabel="// NETWORK STATUS"
      statsMeta={`${totalLinks} ACTIVE`}
      stats={[
        { value: totalLinks, label: 'Active Nodes' },
        { value: 'HTTPS', label: 'Protocol' },
      ]}
    />

    <main class="w-full lg:w-2/3 z-10 flex flex-col fade-up animation-delay-150">
      <div class="p-6 lg:p-10 xl:p-16 2xl:p-20 flex-1 flex flex-col">
        <div class={SECTION_HEADER_CLASS}>
          <div class="flex items-center"><span class={SECTION_NUM_CLASS}>01</span><h2 class={SECTION_TITLE_CLASS}>Directory</h2></div>
          <span class={SECTION_META_CLASS}>// Node_Registry</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4 sm:gap-6 mt-4 fade-up animation-delay-200">
          {
            FRIENDS_LIST.map((friend, index) => {
              return (
                <a
                  href={friend.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="friend-card group flex flex-col justify-between rounded-xl border border-border/40 bg-background/50 p-6 hover:bg-muted/20 hover:border-primary/30 hover:shadow-sm transition-all duration-300 min-h-40 hover:-translate-y-0.5"
                  style={`animation-delay: ${index * 50}ms`}
                >
                  <div class="friend-content flex flex-col h-full w-full">
                    <div class="flex items-start justify-between mb-3">
                      <img
                        src={friend.avatar}
                        alt={friend.name}
                        class="size-10 rounded-full object-cover ring-1 ring-border/50 bg-muted/30"
                        loading="lazy"
                      />
                      <span class="icon-[ph--arrow-up-right] size-4 text-muted-foreground/30 group-hover:text-primary transition-colors mt-1" />
                    </div>
                    <div class="flex flex-col flex-1">
                      <h3 class="font-semibold text-base text-foreground tracking-tight line-clamp-1">{friend.name}</h3>
                      <div class="text-xs font-medium text-muted-foreground line-clamp-1 mt-0.5 mb-3">{friend.author}</div>
                      <p class="text-sm text-muted-foreground leading-relaxed line-clamp-2 mt-auto">
                        {friend.description || 'No description provided.'}
                      </p>
                    </div>
                  </div>
                </a>
              )
            })
          }

          {
            enableAdd ? (
              <a
                href="#exchange-section"
                class="group flex flex-col items-center justify-center p-6 rounded-xl border border-dashed border-border/40 hover:border-primary/30 hover:bg-muted/20 transition-all duration-300 min-h-40"
              >
                <div class="size-10 flex items-center justify-center rounded-full bg-muted/50 mb-3 group-hover:bg-foreground group-hover:text-background transition-colors">
                  <span class="icon-[ph--plus] size-4 text-muted-foreground group-hover:text-background transition-colors" />
                </div>
                <span class="text-sm font-semibold text-foreground tracking-tight">Add Connection</span>
                <span class="text-xs text-muted-foreground mt-1">Submit your node</span>
              </a>
            ) : (
              <div class="flex flex-col items-center justify-center p-6 rounded-xl border border-dashed border-border/40 bg-muted/10 min-h-40 select-none">
                <div class="size-10 flex items-center justify-center rounded-full bg-background mb-3">
                  <span class="icon-[ph--lock-key] size-4 text-muted-foreground/50" />
                </div>
                <span class="text-sm font-medium text-muted-foreground/60">Link Locked</span>
              </div>
            )
          }
        </div>

        {
          enableAdd ? (
            <>
              <div id="exchange-section" class="mt-24 fade-up animation-delay-200">
                <div class={SECTION_HEADER_CLASS}>
                  <div class="flex items-center">
                    <>
                      <span class={SECTION_NUM_CLASS}>02</span>
                      <h2 class={SECTION_TITLE_CLASS}>Exchange Protocol</h2>
                    </>
                  </div>
                  <span class={SECTION_META_CLASS}>// Handshake_Config</span>
                </div>
                <div class="grid xl:grid-cols-2 gap-10 mt-6">
                  {/* 规则与联系方式 */}
                  <div class="flex flex-col">
                    <div>
                      <h3 class="text-lg font-semibold tracking-tight mb-4 text-foreground">Requirements</h3>
                      <ul class="space-y-3 text-sm text-muted-foreground">
                        <li class="flex items-start gap-2.5">
                          <span class="icon-[ph--check-circle-fill] size-4 text-primary shrink-0 mt-0.5" />
                          <span>内容必须符合行业规范，且不包含工作场合不宜的内容。</span>
                        </li>
                        <li class="flex items-start gap-2.5">
                          <span class="icon-[ph--check-circle-fill] size-4 text-primary shrink-0 mt-0.5" />
                          <span>申请友情链接前，请先将本站添加到您的网站链接中。</span>
                        </li>
                        <li class="flex items-start gap-2.5">
                          <span class="icon-[ph--check-circle-fill] size-4 text-primary shrink-0 mt-0.5" />
                          <span>优先考虑科技、设计与独立博客。</span>
                        </li>
                        <li class="flex items-start gap-2.5">
                          <span class="icon-[ph--warning-circle-fill] size-4 text-amber-500 shrink-0 mt-0.5" />
                          <span>不活跃的节点将被定期清理。</span>
                        </li>
                      </ul>
                    </div>

                    <div class="mt-8 p-6 rounded-xl border border-border/40 bg-muted/10">
                      <span class="text-xs font-semibold text-foreground block mb-2">Direct Contact</span>
                      <a
                        href={`mailto:${email}`}
                        class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground transition-colors group"
                      >
                        <span class="icon-[ph--envelope-simple] size-4 group-hover:text-primary transition-colors" />
                        <span class="font-medium">{email}</span>
                      </a>
                    </div>
                  </div>

                  {/* 右侧：站点配置信息 */}
                  <div class="relative">
                    <div class="rounded-xl border border-border/40 bg-background overflow-hidden flex flex-col h-full">
                      <div class="px-5 py-4 border-b border-border/40 bg-muted/20 flex justify-between items-center">
                        <span class="font-semibold text-sm tracking-tight">Site Configuration</span>
                        <span class="text-xs font-medium text-muted-foreground bg-background border border-border/40 px-2 py-0.5 rounded-md">
                          JSON
                        </span>
                      </div>

                      <div class="p-5 space-y-3 flex-1">
                        {[
                          { label: 'Name', value: sitename },
                          { label: 'Author', value: author },
                          { label: 'URL', value: sitelink },
                          { label: 'Avatar', value: siteavatar },
                          { label: 'Description', value: myDescription },
                        ].map((item) => (
                          <div class="flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-4 p-2 rounded-lg hover:bg-muted/30 transition-colors">
                            <span class="text-muted-foreground text-xs font-medium w-20 shrink-0 pt-0.5 select-none">{item.label}</span>
                            <span class="text-foreground text-sm font-mono break-all select-all">{item.value}</span>
                          </div>
                        ))}
                      </div>

                      <div class="p-5 pt-0 mt-auto">
                        <button
                          id="copy-btn"
                          class="copy-trigger w-full py-2.5 bg-foreground text-background hover:bg-foreground/90 transition-all rounded-md text-sm font-semibold flex items-center justify-center gap-2"
                          data-sitename={sitename}
                          data-author={author}
                          data-sitelink={sitelink}
                          data-siteavatar={siteavatar}
                          data-description={myDescription}
                        >
                          <span id="copy-icon" class="icon-[ph--copy] size-4" />
                          <span id="copy-text">Copy Configuration</span>
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="pb-12 mt-20 w-full fade-up">
                <Comments />
              </div>
            </>
          ) : (
            <div class="mt-24 pb-12 w-full fade-up">
              <div class="rounded-xl border border-border/40 bg-muted/10 p-12 text-center flex flex-col items-center justify-center min-h-62.5">
                <span class="icon-[ph--link-break] size-10 text-muted-foreground/40 mb-4 block mx-auto" />
                <p class="text-foreground font-medium mb-2">System Disabled</p>
                <p class="text-muted-foreground text-sm">友链申请通道已离线，如有需要请通过邮件联系站长。</p>
              </div>
            </div>
          )
        }
      </div>
    </main>
  </div>
</Layout>

<script is:inline>
  function initCopy() {
    const btns = document.querySelectorAll('.copy-trigger')
    btns.forEach((btn) => {
      // Clone to remove existing event listeners if any
      const newBtn = btn.cloneNode(true)
      btn.parentNode.replaceChild(newBtn, btn)

      newBtn.addEventListener('click', () => {
        const icon = newBtn.querySelector('#copy-icon')
        const text = newBtn.querySelector('#copy-text')

        const myInfo = {
          name: newBtn.dataset.sitename,
          author: newBtn.dataset.author,
          url: newBtn.dataset.sitelink,
          avatar: newBtn.dataset.siteavatar,
          description: newBtn.dataset.description,
        }

        navigator.clipboard
          .writeText(JSON.stringify(myInfo, null, 2))
          .then(() => {
            if (icon) icon.className = 'icon-[ph--check-circle-fill] size-4'
            if (text) text.textContent = 'Copied!'

            newBtn.classList.remove('bg-foreground', 'text-background')
            newBtn.classList.add('bg-emerald-500', 'text-white')

            setTimeout(() => {
              if (icon) icon.className = 'icon-[ph--copy] size-4'
              if (text) text.textContent = 'Copy Configuration'
              newBtn.classList.add('bg-foreground', 'text-background')
              newBtn.classList.remove('bg-emerald-500', 'text-white')
            }, 2000)
          })
          .catch(console.error)
      })
    })
  }

  function shuffleFriends() {
    const cards = Array.from(document.querySelectorAll('.friend-card'))
    if (cards.length === 0) return

    // Store href and innerHTML
    const cardsData = cards.map((card) => ({
      href: card.getAttribute('href'),
      contentHtml: card.querySelector('.friend-content').innerHTML,
    }))

    // Fisher-Yates shuffle
    for (let i = cardsData.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1))
      ;[cardsData[i], cardsData[j]] = [cardsData[j], cardsData[i]]
    }

    // Apply shuffled data
    cards.forEach((card, index) => {
      card.setAttribute('href', cardsData[index].href)
      card.querySelector('.friend-content').innerHTML = cardsData[index].contentHtml
    })
  }

  function initAll() {
    shuffleFriends()
    initCopy()
  }

  document.addEventListener('astro:page-load', initAll)
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll)
  } else {
    initAll()
  }
</script>
