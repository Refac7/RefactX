---
// 1. 导入 JSON 数据
import rawFriendsList from '~/content/data/friends.json'

// 2. 导入配置 (保持联系方式等静态配置不变)
import { FRIENDS_CONFIG, FRIENDS_CONTACT } from '~/config'
import Layout from '~/layouts/Layout.astro'
import SectionDivider from '~/components/base/SectionDivider.astro'
import Comments from '~/components/posts/base/Comments.astro'

// 3. 定义数据类型
interface Friend {
  name: string;
  url: string;
  author: string;
  description: string;
  avatar: string;
}

// 4. 类型转换
const FRIENDS_LIST = rawFriendsList as Friend[];

const { title, description, introduce } = FRIENDS_CONFIG
const { sitename, email, author, sitelink, siteavatar, description: myDescription } = FRIENDS_CONTACT;

// 补零处理
const totalLinks = FRIENDS_LIST.length.toString().padStart(2, '0');
// 逻辑：判断好友数量以决定占位卡显示逻辑
const isEven = FRIENDS_LIST.length % 2 === 0;
---

<Layout title={title} description={description}>
  <div class="relative py-12 px-6 sm:px-8 font-sans min-h-[60vh]">
    
    <!-- 1. 头部区域：Grid 布局重构 (保持统一) -->
    <div class="pb-10">
      
      <!-- 顶栏状态条 -->
      <div class="flex items-center justify-between mb-8 text-[10px] font-mono uppercase tracking-widest text-muted-foreground/60">
        <span>// SYSTEM_LINKS // NETWORK</span>
        <div class="flex items-center gap-2 text-primary">
             <span class="relative flex h-2 w-2">
               <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
               <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-600"></span>
             </span>
             <span class="font-bold text-foreground">CONNECTED</span>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-end">
        <!-- 左侧：标题 -->
        <div class="lg:col-span-7">
          <h1 class="text-6xl sm:text-7xl font-bold tracking-tighter text-foreground leading-[0.9] -ml-1">
            {title}<span class="text-primary">.</span>
          </h1>
        </div>

        <!-- 右侧：简介与数据面板 -->
        <div class="lg:col-span-5 flex flex-col gap-6">
          <div class="border-l-2 border-primary/40 pl-5">
             <p class="text-base sm:text-lg text-muted-foreground leading-relaxed">
              {introduce}
             </p>
          </div>

          <!-- 数据网格 -->
          <div class="grid grid-cols-2 gap-px bg-border/50 border border-border/50">
            <!-- Total Links -->
            <div class="bg-background/50 p-3 flex flex-col gap-1">
              <span class="text-[9px] uppercase tracking-widest text-muted-foreground/70 font-mono">Active_Nodes</span>
              <span class="text-2xl font-mono font-bold text-foreground">{totalLinks}</span>
            </div>
            
            <!-- Protocol -->
            <div class="bg-background/50 p-3 flex flex-col gap-1">
              <span class="text-[9px] uppercase tracking-widest text-muted-foreground/70 font-mono">Protocol_Ver</span>
              <span class="text-sm font-mono font-bold text-muted-foreground mt-1">HTTPS / 2.0</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. 内容区域标记 -->
    <div class="flex items-end gap-4 mb-10 select-none">
       <span class="font-mono text-4xl font-bold text-muted-foreground/10 leading-none -mb-1">03</span>
       <span class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-muted-foreground/50 mb-1">
          Node_Sequence
       </span>
       <div class="h-px bg-gradient-to-r from-border to-transparent flex-1 mb-1.5"></div>
    </div>

    <!-- 3. 友链列表 -->
    <div class="max-w-full mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 ">
        {FRIENDS_LIST.map((friend) => (
          <a 
            href={friend.url} 
            target="_blank" 
            rel="noopener noreferrer"
            class="group relative flex flex-col p-5 h-full
                   bg-background border border-border
                   hover:border-primary/60 transition-all duration-300 rounded-none overflow-hidden hover:shadow-sm"
          >
            <!-- 装饰：Hover时出现的四角标记 -->
            <div class="absolute top-0 right-0 w-2 h-2 border-t border-r border-primary opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <div class="absolute bottom-0 left-0 w-2 h-2 border-b border-l border-primary opacity-0 group-hover:opacity-100 transition-opacity"></div>
            
            <div class="flex items-start gap-5">
                <!-- 头像区域 -->
                <div class="relative shrink-0 mt-1">
                    <div class="size-14 p-0.5 border border-border group-hover:border-primary/50 transition-colors bg-muted/20">
                        <img
                            src={friend.avatar}
                            alt={friend.name}
                            class="size-full object-cover"
                            loading="lazy"
                        />
                    </div>
                </div>
                
                <div class="flex flex-col min-w-0 flex-1">
                    <div class="flex items-center justify-between mb-1">
                        <span class="font-bold text-lg text-foreground group-hover:text-primary transition-colors truncate tracking-tight">
                            {friend.name}
                        </span>
                        <span class="icon-[ph--arrow-up-right] size-4 text-muted-foreground/30 group-hover:text-primary transition-colors shrink-0"></span>
                    </div>
                    
                    <div class="flex items-center gap-2 mb-3">
                         <span class="text-[10px] font-mono uppercase bg-muted px-1.5 py-0.5 text-muted-foreground/70 rounded-none">Auth</span>
                         <span class="text-xs text-muted-foreground/80 font-mono truncate">{friend.author}</span>
                    </div>

                    <p class="text-sm text-muted-foreground leading-relaxed line-clamp-2">
                       {friend.description || "No signal detected."}
                    </p>
                </div>
            </div>
          </a>
        ))}

        <!-- 占位卡片 -->
        <a 
          href="#exchange-section"
          class={`group relative flex-col p-5 h-full cursor-pointer
                 bg-muted/5 border border-dashed border-border
                 hover:border-primary/50 hover:bg-muted/10 transition-all duration-300 rounded-none
                 ${isEven ? "block md:hidden lg:block" : "block"}`}
        >
            <div class="flex flex-col h-full justify-center items-center text-center py-8 opacity-60 group-hover:opacity-100 transition-opacity">
                <div class="mb-3 size-10 flex items-center justify-center border border-dashed border-foreground/30 rounded-full group-hover:scale-110 transition-transform">
                    <span class="icon-[ph--plus] size-5"></span>
                </div>
                <span class="font-mono text-xs uppercase tracking-[0.2em] text-foreground">
                    Insert_Module
                </span>
            </div>
        </a>
      </div>
    </div>

    <!-- 4. 交换友链区域 -->
    <div id="exchange-section" class="mt-24 max-w-5xl mx-auto scroll-mt-24 border-t border-dashed border-border/60 pt-16">
        <div class="grid md:grid-cols-2 gap-6">
            {/* 左侧说明 */}
            <div class="flex flex-col justify-between">
                <div>
                    <h2 class="text-2xl font-bold mb-6 flex items-center gap-3 uppercase tracking-tight">
                        <span class="size-3 bg-primary rounded-none"></span>
                        Exchange Protocol
                    </h2>
                    <div class="text-muted-foreground space-y-4 text-sm leading-relaxed border-l border-border pl-4">
                      <p>申请前请确保您的站点内容健康，且已在贵站添加本站链接。</p>
                      <p>优先接入技术、设计、生活类博客。长期失联的节点将被清理。</p>
                    </div>
                </div>
                
                <div class="mt-8">
                    <span class="text-[10px] font-bold text-muted-foreground uppercase tracking-wider font-mono block mb-2">Transmission Channel</span>
                    <a href={`mailto:${email}`} class="flex items-center gap-3 p-4 border border-border hover:border-primary/50 hover:bg-muted/5 transition-colors group">
                        <span class="icon-[ph--envelope-simple] size-5 text-muted-foreground group-hover:text-primary transition-colors"></span>
                        <span class="text-base font-mono text-foreground break-all">{email}</span>
                    </a>
                </div>
            </div>

            {/* 右侧：规格表风格信息卡片 */}
            <div class="relative bg-card border border-border p-1">
                <div class="absolute -top-1 -left-1 size-3 border-t-2 border-l-2 border-primary"></div>
                <div class="absolute -bottom-1 -right-1 size-3 border-b-2 border-r-2 border-primary"></div>

                <div class="bg-background/50 p-6 sm:p-8 h-full">
                    <div class="flex justify-between items-end mb-6 border-b-2 border-foreground pb-2">
                         <span class="font-bold text-lg uppercase">Site Configuration</span>
                         <span class="font-mono text-xs text-muted-foreground">JSON_V1.0</span>
                    </div>
                    
                    <div class="space-y-3 font-mono text-sm">
                        {[
                            { label: 'NAME', value: sitename },
                            { label: 'AUTHOR', value: author },
                            { label: 'URL', value: sitelink },
                            { label: 'AVATAR', value: siteavatar },
                            { label: 'DESC', value: myDescription },
                        ].map(item => (
                            <div class="grid grid-cols-[80px_1fr] gap-4 group/item">
                                <span class="text-muted-foreground/60 text-xs py-1 select-none">{item.label}</span>
                                <span class="text-foreground border-b border-dashed border-border group-hover/item:border-primary/50 py-1 transition-colors break-all">
                                    {item.value}
                                </span>
                            </div>
                        ))}
                    </div>

                    <button
                      id="copy-btn"
                      class="mt-8 w-full py-3 bg-primary text-primary-foreground 
                             hover:bg-primary/90 transition-all duration-200
                             font-mono text-xs font-bold tracking-widest rounded-none
                             flex items-center justify-center gap-2 group active:scale-[0.99]"
                      data-sitename={sitename}
                      data-author={author}
                      data-sitelink={sitelink}
                      data-siteavatar={siteavatar}
                      data-description={myDescription}
                    >
                      <span id="copy-icon" class="icon-[ph--brackets-curly] size-4"></span>
                      <span id="copy-text">COPY CONFIGURATION</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
  </div>
    <div class="mt-20 w-full max-w-5xl mx-auto">
        <SectionDivider />
    </div>
    
    <div class="px-4 md:px-6 pb-12 mt-4 max-w-5xl mx-auto">
        <Comments />
    </div>
</Layout>

<script>
  const btn = document.getElementById("copy-btn");
  const icon = document.getElementById("copy-icon");
  const text = document.getElementById("copy-text");

  if (btn && icon && text) {
    btn.addEventListener("click", () => {
      const myInfo = {
        name: btn.dataset.sitename,
        author: btn.dataset.author,
        url: btn.dataset.sitelink,
        avatar: btn.dataset.siteavatar,
        description: btn.dataset.description,
      };

      navigator.clipboard.writeText(JSON.stringify(myInfo, null, 2))
        .then(() => {
             // 成功状态
             icon.className = "icon-[ph--check-bold] size-4";
             text.textContent = "COPIED TO CLIPBOARD";
             btn.classList.add('bg-zinc-800', 'text-white', 'dark:bg-zinc-100', 'dark:text-black');
             btn.classList.remove('bg-primary', 'text-primary-foreground');
             
             setTimeout(() => {
                icon.className = "icon-[ph--brackets-curly] size-4";
                text.textContent = "COPY CONFIGURATION";
                btn.classList.remove('bg-zinc-800', 'text-white', 'dark:bg-zinc-100', 'dark:text-black');
                btn.classList.add('bg-primary', 'text-primary-foreground');
             }, 2000);
        })
        .catch(err => {
            console.error('Copy failed:', err);
            text.textContent = "ERROR - MANUAL COPY";
        });
    });
  }
</script>