---
import rawFriendsList from '~/content/data/friends.json'
import { FRIENDS_CONFIG, FRIENDS_CONTACT } from '~/config'
import { SECTION_HEADER_CLASS, SECTION_TITLE_CLASS, SECTION_NUM_CLASS, SECTION_META_CLASS } from '~/lib/ui'
import Layout from '~/layouts/Layout.astro'
import Comments from '~/components/posts/base/Comments.astro'
import PageAside from '~/components/base/PageAside.astro'

interface Friend {
  name: string
  url: string
  author: string
  description: string
  avatar: string
}
const FRIENDS_LIST = rawFriendsList as Friend[]
const { title, description, introduce, enableAdd } = FRIENDS_CONFIG
const { sitename, email, author, sitelink, siteavatar, description: myDescription } = FRIENDS_CONTACT
const totalLinks = FRIENDS_LIST.length.toString().padStart(2, '0')
---

<Layout {title} {description}>
  <div class="relative font-sans flex flex-col lg:flex-row min-h-screen max-w-[1920px] mx-auto">
    <PageAside
      statusText="Connected"
      statusVariant="success"
      {title}
      subtitleIcon="icon-[ph--planet]"
      subtitleText="Network & Signals"
      identityTags={[
        { icon: 'icon-[ph--share-network]', label: `${totalLinks} Nodes` },
        { icon: 'icon-[ph--lock-key]', label: 'HTTPS' },
        { icon: 'icon-[ph--globe]', label: 'Web Ring' },
      ]}
      intro={introduce}
      statsLabel="NETWORK STATUS"
      statsMeta={`${totalLinks} ACTIVE`}
      stats={[
        { value: totalLinks, label: 'Active Nodes' },
        { value: 'HTTPS', label: 'Protocol' },
      ]}
    />

    <main class="w-full lg:w-1/2 lg:flex-1 z-10 flex flex-col fade-up animation-delay-150">
      <div class="px-5 py-10 sm:px-8 lg:px-10 lg:py-14 xl:px-12 flex-1 flex flex-col">
        <div class={SECTION_HEADER_CLASS}>
          <div class="flex items-center"><span class={SECTION_NUM_CLASS}>01</span><h2 class={SECTION_TITLE_CLASS}>Directory</h2></div>
          <span class={SECTION_META_CLASS}>Node_Registry</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 2xl:grid-cols-3 gap-3 sm:gap-4 fade-up animation-delay-200">
          {
            FRIENDS_LIST.map((friend, index) => {
              return (
                <a
                  href={friend.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="friend-card group relative block min-h-[104px] overflow-hidden rounded-2xl border border-border bg-card p-4 shadow-soft transition-all duration-300 hover:-translate-y-0.5 hover:border-primary/35 hover:shadow-lift sm:p-5"
                  style={`animation-delay: ${index * 40}ms`}
                >
                  <span
                    aria-hidden="true"
                    class="pointer-events-none absolute -right-1 -bottom-4 hidden font-serif text-6xl leading-none font-medium tracking-[-0.06em] text-primary/[0.07] select-none md:block"
                  >
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <div class="friend-content relative z-10 flex h-full items-center gap-4">
                    <img
                      src={friend.avatar}
                      alt={friend.name}
                      class="size-12 shrink-0 rounded-xl border border-border bg-muted object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                      loading="lazy"
                    />
                    <div class="flex min-w-0 flex-1 flex-col">
                      <div class="flex items-center justify-between gap-2">
                        <h3 class="line-clamp-1 font-serif text-base font-medium tracking-[-0.01em] text-foreground transition-colors group-hover:text-primary">
                          {friend.name}
                        </h3>
                        <span class="icon-[ph--arrow-up-right] size-4 shrink-0 text-muted-foreground/30 transition-colors group-hover:text-primary" />
                      </div>
                      <div class="mt-1 text-[10px] font-medium tracking-[0.08em] text-muted-foreground">{friend.author}</div>
                      <p class="mt-1.5 line-clamp-2 text-xs leading-relaxed text-muted-foreground">
                        {friend.description || 'No description provided.'}
                      </p>
                    </div>
                  </div>
                </a>
              )
            })
          }

          {
            enableAdd ? (
              <a
                href="#exchange-section"
                class="group flex min-h-[104px] flex-col items-center justify-center rounded-2xl border border-dashed border-border bg-card/50 p-4 transition-all duration-300 hover:-translate-y-0.5 hover:border-primary/35 hover:bg-accent-soft/50 sm:p-5"
              >
                <div class="mb-3 flex size-10 items-center justify-center rounded-xl border border-border bg-card transition-colors group-hover:border-primary/40 group-hover:bg-primary group-hover:text-primary-foreground">
                  <span class="icon-[ph--plus] size-4" />
                </div>
                <span class="font-serif text-base font-medium tracking-[-0.01em] text-foreground">Add Connection</span>
                <span class="mt-1 text-[10px] font-medium tracking-[0.08em] text-muted-foreground">Submit your node</span>
              </a>
            ) : (
              <div class="flex min-h-[104px] flex-col items-center justify-center rounded-2xl border border-dashed border-border/70 bg-card/30 p-4 select-none sm:p-5">
                <div class="mb-3 flex size-10 items-center justify-center rounded-xl border border-border/70">
                  <span class="icon-[ph--lock-key] size-4 text-muted-foreground/50" />
                </div>
                <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-muted-foreground/60">Link Locked</span>
              </div>
            )
          }
        </div>

        {
          enableAdd ? (
            <>
              <div id="exchange-section" class="mt-24 fade-up animation-delay-200">
                <div class={SECTION_HEADER_CLASS}>
                  <div class="flex items-center">
                    <>
                      <span class={SECTION_NUM_CLASS}>02</span>
                      <h2 class={SECTION_TITLE_CLASS}>Exchange Protocol</h2>
                    </>
                  </div>
                  <span class={SECTION_META_CLASS}>Handshake_Config</span>
                </div>
                <div class="grid xl:grid-cols-2 gap-10 mt-6">
                  {/* 规则与联系方式 */}
                  <div class="flex flex-col">
                    <div>
                      <h3 class="text-lg font-semibold tracking-tight mb-4 text-foreground">Requirements</h3>
                      <ul class="space-y-3 text-sm text-muted-foreground">
                        <li class="flex items-start gap-2.5">
                          <span class="icon-[ph--check-circle-fill] size-4 text-primary shrink-0 mt-0.5" />
                          <span>内容必须符合行业规范，且不包含工作场合不宜的内容。</span>
                        </li>
                        <li class="flex items-start gap-2.5">
                          <span class="icon-[ph--check-circle-fill] size-4 text-primary shrink-0 mt-0.5" />
                          <span>申请友情链接前，请先将本站添加到您的网站链接中。</span>
                        </li>
                        <li class="flex items-start gap-2.5">
                          <span class="icon-[ph--check-circle-fill] size-4 text-primary shrink-0 mt-0.5" />
                          <span>优先考虑科技、设计与独立博客。</span>
                        </li>
                        <li class="flex items-start gap-2.5">
                          <span class="icon-[ph--warning-circle-fill] size-4 text-warning shrink-0 mt-0.5" />
                          <span>不活跃的节点将被定期清理。</span>
                        </li>
                      </ul>
                    </div>

                    <div class="mt-8 rounded-2xl border border-border bg-card p-5 shadow-soft">
                      <span class="mb-3 block text-[10px] font-semibold tracking-[0.14em] text-muted-foreground uppercase">
                        Direct Contact
                      </span>
                      <a
                        href={`mailto:${email}`}
                        class="group inline-flex items-center gap-2 text-sm text-foreground transition-colors hover:text-primary"
                      >
                        <span class="icon-[ph--envelope-simple] size-4 text-primary" />
                        <span class="font-mono text-xs">{email}</span>
                      </a>
                    </div>
                  </div>

                  {/* 右侧：站点配置信息 */}
                  <div class="relative">
                    <div class="flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-card shadow-soft">
                      <div class="flex items-center justify-between border-b border-border/70 bg-muted/30 px-5 py-3.5">
                        <span class="font-serif text-base font-medium tracking-[-0.01em]">Site Configuration</span>
                        <span class="rounded-full border border-border bg-background px-2.5 py-0.5 text-[9px] font-medium tracking-[0.1em] text-muted-foreground uppercase">
                          JSON
                        </span>
                      </div>

                      <div class="flex-1">
                        {[
                          { label: 'Name', value: sitename },
                          { label: 'Author', value: author },
                          { label: 'URL', value: sitelink },
                          { label: 'Avatar', value: siteavatar },
                          { label: 'Description', value: myDescription },
                        ].map((item) => (
                          <div class="flex flex-col gap-1 border-b border-border/60 px-5 py-3 transition-colors last:border-b-0 hover:bg-muted/40 sm:flex-row sm:items-start sm:gap-4">
                            <span class="w-20 shrink-0 select-none pt-0.5 font-mono text-[9px] uppercase tracking-[0.14em] text-muted-foreground">
                              {item.label}
                            </span>
                            <span class="select-all break-all font-mono text-xs text-foreground">{item.value}</span>
                          </div>
                        ))}
                      </div>

                      <div class="mt-auto border-t border-border p-4">
                        <button
                          id="copy-btn"
                          class="copy-trigger flex w-full cursor-pointer items-center justify-center gap-2 rounded-full bg-foreground py-3 text-sm font-medium text-background transition-colors hover:bg-primary hover:text-primary-foreground"
                          data-sitename={sitename}
                          data-author={author}
                          data-sitelink={sitelink}
                          data-siteavatar={siteavatar}
                          data-description={myDescription}
                        >
                          <span id="copy-icon" class="icon-[ph--copy] size-4" />
                          <span id="copy-text">Copy Configuration</span>
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="pb-12 mt-20 w-full fade-up">
                <Comments />
              </div>
            </>
          ) : (
            <div class="mt-24 pb-12 w-full fade-up">
              <div class="flex min-h-62.5 flex-col items-center justify-center rounded-2xl border border-dashed border-border bg-card/60 p-12 text-center">
                <span class="icon-[ph--link-break] size-10 text-muted-foreground/40 mb-4 block mx-auto" />
                <p class="mb-2 font-serif text-lg font-medium text-foreground">System Disabled</p>
                <p class="text-muted-foreground text-sm">友链申请通道已离线，如有需要请通过邮件联系站长。</p>
              </div>
            </div>
          )
        }
      </div>
    </main>
  </div>
</Layout>

<script is:inline>
  function initCopy() {
    const btns = document.querySelectorAll('.copy-trigger')
    btns.forEach((btn) => {
      // Clone to remove existing event listeners if any
      const newBtn = btn.cloneNode(true)
      btn.parentNode.replaceChild(newBtn, btn)

      newBtn.addEventListener('click', () => {
        const icon = newBtn.querySelector('#copy-icon')
        const text = newBtn.querySelector('#copy-text')

        const myInfo = {
          name: newBtn.dataset.sitename,
          author: newBtn.dataset.author,
          url: newBtn.dataset.sitelink,
          avatar: newBtn.dataset.siteavatar,
          description: newBtn.dataset.description,
        }

        navigator.clipboard
          .writeText(JSON.stringify(myInfo, null, 2))
          .then(() => {
            if (icon) icon.className = 'icon-[ph--check-circle-fill] size-4'
            if (text) text.textContent = 'Copied!'

            newBtn.classList.remove('bg-foreground', 'text-background')
            newBtn.classList.add('bg-success', 'text-success-foreground')

            setTimeout(() => {
              if (icon) icon.className = 'icon-[ph--copy] size-4'
              if (text) text.textContent = 'Copy Configuration'
              newBtn.classList.add('bg-foreground', 'text-background')
              newBtn.classList.remove('bg-success', 'text-success-foreground')
            }, 2000)
          })
          .catch(console.error)
      })
    })
  }

  function shuffleFriends() {
    const cards = Array.from(document.querySelectorAll('.friend-card'))
    if (cards.length === 0) return

    // Store href and innerHTML
    const cardsData = cards.map((card) => ({
      href: card.getAttribute('href'),
      contentHtml: card.querySelector('.friend-content').innerHTML,
    }))

    // Fisher-Yates shuffle
    for (let i = cardsData.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1))
      ;[cardsData[i], cardsData[j]] = [cardsData[j], cardsData[i]]
    }

    // Apply shuffled data
    cards.forEach((card, index) => {
      card.setAttribute('href', cardsData[index].href)
      card.querySelector('.friend-content').innerHTML = cardsData[index].contentHtml
    })
  }

  function initAll() {
    shuffleFriends()
    initCopy()
  }

  document.addEventListener('astro:page-load', initAll)
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll)
  } else {
    initAll()
  }
</script>
