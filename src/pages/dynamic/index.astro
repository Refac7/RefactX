---
import Layout from '~/layouts/Layout.astro'
import DynamicFeed from '~/components/dynamic/DynamicFeed'
import { DYNAMIC_CONFIG } from '~/config'
import { SECTION_HEADER_CLASS, SECTION_TITLE_CLASS, SECTION_NUM_CLASS, SECTION_META_CLASS } from '~/lib/ui'
import PageAside from '~/components/base/PageAside.astro'
---

<Layout title={DYNAMIC_CONFIG.title} description={DYNAMIC_CONFIG.introduce}>
  <div class="page-shell relative font-sans min-h-screen">
    <PageAside
      image="/photos/250711-2.webp"
      statusText="Live Sync"
      statusVariant="success"
      title={DYNAMIC_CONFIG.title}
      subtitleIcon="icon-[ph--activity]"
      subtitleText="Signal Stream"
      identityTags={[
        { icon: 'icon-[ph--broadcast]', label: 'Notion' },
        { icon: 'icon-[ph--timer]', label: '30m Cache' },
        { icon: 'icon-[ph--shield-check]', label: 'Verified' },
      ]}
      intro={DYNAMIC_CONFIG.introduce}
      statsLabel="同步状态"
      statsMeta="2 METRICS"
      stats={[
        { value: 'API', label: 'Data Source' },
        { value: '30m', label: 'Edge Cache' },
      ]}
    />

    <main class="w-full lg:w-2/3 z-10 flex flex-col fade-up animation-delay-100">
      <div class="px-6 lg:px-8 xl:px-12 lg:py-20 flex-1">
        <div class={SECTION_HEADER_CLASS}>
          <div class="flex items-center">
            <span class={SECTION_NUM_CLASS}>01</span>
            <h2 class={SECTION_TITLE_CLASS}>时间线</h2>
          </div>
          <span class={SECTION_META_CLASS}>动态流</span>
        </div>

        <DynamicFeed client:load />
      </div>
    </main>
  </div>
</Layout>
