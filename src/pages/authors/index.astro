---
import { AUTHORS_CONFIG } from '~/config'
import Layout from '~/layouts/Layout.astro'
import { getCollection } from 'astro:content'
import { SECTION_HEADER_CLASS, SECTION_TITLE_CLASS, SECTION_NUM_CLASS, SECTION_META_CLASS } from '~/lib/ui'
import PageAside from '~/components/base/PageAside.astro'

const allPosts = await getCollection('posts')
const authors = [...new Set(allPosts.map((post) => post.data.author).filter(Boolean))]
const sortedAuthors = authors
  .map((author) => ({ name: author, count: allPosts.filter((post) => post.data.author === author).length }))
  .sort((a, b) => b.count - a.count)
const { title, description, introduce } = AUTHORS_CONFIG
const maxCount = Math.max(...(sortedAuthors.map((a) => a.count).length > 0 ? sortedAuthors.map((a) => a.count) : [0]))
const totalAuthors = authors.length.toString().padStart(2, '0')
const totalPosts = allPosts.length.toString().padStart(2, '0')
const lastUpdate = new Date().toLocaleDateString('en-US', { month: 'short', day: '2-digit' })
---

<Layout {title} {description}>
  <div class="relative font-sans flex flex-col lg:flex-row min-h-screen max-w-[1920px] mx-auto">
    <PageAside
      statusText="Indexing"
      statusHasPing={false}
      statusVariant="primary"
      {title}
      subtitleIcon="icon-[ph--user]"
      subtitleText="Authors Index"
      identityTags={[
        { icon: 'icon-[ph--user]', label: `${totalAuthors} Authors` },
        { icon: 'icon-[ph--article]', label: `${totalPosts} Posts` },
        { icon: 'icon-[ph--arrows-clockwise]', label: lastUpdate },
      ]}
      intro={introduce}
      statsLabel="INDEX STATUS"
      statsMeta={`${totalAuthors} AUTHORS`}
      stats={[
        { value: totalAuthors, label: 'Authors' },
        { value: totalPosts, label: 'Posts' },
        { value: lastUpdate, label: 'Last Rebuild' },
      ]}
    />

    <main class="w-full lg:w-1/2 lg:flex-1 z-10 flex flex-col fade-up animation-delay-150">
      <div class="px-5 py-10 sm:px-8 lg:px-10 lg:py-14 xl:px-12 flex-1">
        <div class={SECTION_HEADER_CLASS}>
          <div class="flex items-center"><span class={SECTION_NUM_CLASS}>01</span><h2 class={SECTION_TITLE_CLASS}>All Authors</h2></div>
          <span class={SECTION_META_CLASS}>Author_Cloud</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6 mt-8 fade-up animation-delay-200">
          {
            sortedAuthors.map((author, index) => {
              const percent = sortedAuthors.length > 0 ? Math.min((author.count / maxCount) * 100, 100) : 0
              return (
                <a
                  href={`/authors/${encodeURIComponent(author.name)}`}
                  class="fade-up group relative flex h-32 flex-col justify-between overflow-hidden rounded-2xl border border-border bg-card p-5 shadow-soft transition-all duration-300 hover:-translate-y-0.5 hover:border-primary/35 hover:shadow-lift"
                  style={`animation-delay: ${index * 40}ms`}
                  rel="noopener noreferrer"
                >
                  <div class="z-10 flex items-start justify-between">
                    <h3 class="font-serif text-xl font-medium tracking-[-0.02em] text-foreground transition-colors group-hover:text-primary">
                      {author.name}
                    </h3>
                    <span class="inline-flex items-center justify-center rounded-full border border-border bg-muted/50 px-2.5 py-0.5 text-[10px] font-medium tabular-nums text-muted-foreground">
                      {author.count}
                    </span>
                  </div>
                  <div class="mt-4 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                    <div class="h-full rounded-full bg-primary transition-all duration-500 ease-out" style={`width: ${percent}%`} />
                  </div>
                </a>
              )
            })
          }
        </div>

        {
          authors.length === 0 && (
            <div class="mt-8 flex flex-col items-center justify-center rounded-2xl border border-dashed border-border bg-card/60 py-24">
              <span class="icon-[ph--warning-circle] mb-4 size-8 text-muted-foreground/40" />
              <p class="text-[11px] font-medium tracking-[0.12em] text-muted-foreground uppercase">No authors found.</p>
            </div>
          )
        }
      </div>
    </main>
  </div>
</Layout>
