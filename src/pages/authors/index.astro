---
import { AUTHORS_CONFIG } from '~/config'
import Layout from '~/layouts/Layout.astro'
import { getCollection } from 'astro:content'
import { SECTION_HEADER_CLASS, SECTION_TITLE_CLASS, SECTION_NUM_CLASS, SECTION_META_CLASS } from '~/lib/ui'
import PageAside from '~/components/base/PageAside.astro'

const allPosts = await getCollection('posts')
const authors = [...new Set(allPosts.map((post) => post.data.author).filter(Boolean))]
const sortedAuthors = authors
  .map((author) => ({ name: author, count: allPosts.filter((post) => post.data.author === author).length }))
  .sort((a, b) => b.count - a.count)
const { title, description, introduce } = AUTHORS_CONFIG
const maxCount = Math.max(...(sortedAuthors.map((a) => a.count).length > 0 ? sortedAuthors.map((a) => a.count) : [0]))
const totalAuthors = authors.length.toString().padStart(2, '0')
const totalPosts = allPosts.length.toString().padStart(2, '0')
const lastUpdate = new Date().toLocaleDateString('en-US', { month: 'short', day: '2-digit' })
---

<Layout {title} {description}>
  <div class="relative font-sans flex flex-col lg:flex-row min-h-screen max-w-[1920px] mx-auto">
    <PageAside
      statusText="索引中 ✨"
      statusHasPing={false}
      statusVariant="primary"
      {title}
      subtitleIcon="icon-[ph--user]"
      subtitleText="作者索引"
      identityTags={[
        { icon: 'icon-[ph--user]', label: `${totalAuthors} 位作者` },
        { icon: 'icon-[ph--article]', label: `${totalPosts} 篇文章` },
        { icon: 'icon-[ph--arrows-clockwise]', label: lastUpdate },
      ]}
      intro={introduce}
      statsLabel="// 索引状态"
      statsMeta={`${totalAuthors} 位作者`}
      stats={[
        { value: totalAuthors, label: '作者数' },
        { value: totalPosts, label: '文章数' },
        { value: lastUpdate, label: '最近重建' },
      ]}
    />

    <main class="w-full lg:w-2/3 z-10 flex flex-col fade-up animation-delay-150">
      <div class="px-6 lg:px-8 xl:px-12 lg:py-20 flex-1">
        <div class={SECTION_HEADER_CLASS}>
          <div class="flex items-center"><span class={SECTION_NUM_CLASS}>01</span><h2 class={SECTION_TITLE_CLASS}>All Authors</h2></div>
          <span class={SECTION_META_CLASS}>// 作者云</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6 mt-8 fade-up animation-delay-200">
          {
            sortedAuthors.map((author, index) => {
              const percent = sortedAuthors.length > 0 ? Math.min((author.count / maxCount) * 100, 100) : 0
              return (
                <a
                  href={`/authors/${encodeURIComponent(author.name)}`}
                  class="group relative flex flex-col justify-between p-6 bg-background/60 border border-primary/15 rounded-3xl  hover:bg-accent/50 hover:border-primary/40  transition-all duration-300 h-32 fade-up hover:-translate-y-1"
                  style={`animation-delay: ${index * 50}ms`}
                  rel="noopener noreferrer"
                >
                  <div class="flex justify-between items-start z-10">
                    <h3 class="font-bold text-lg text-foreground group-hover:text-primary transition-colors tracking-tight">
                      {author.name}
                    </h3>
                    <span class="inline-flex items-center justify-center bg-accent rounded-full px-2.5 py-0.5 text-xs font-bold text-primary">
                      {author.count}
                    </span>
                  </div>
                  <div class="w-full h-2 bg-accent rounded-full overflow-hidden mt-4">
                    <div
                      class="h-full bg-gradient-to-r from-primary to-sky-400 group-hover:bg-primary transition-all duration-500 ease-out rounded-full"
                      style={`width: ${percent}%`}
                    />
                  </div>
                </a>
              )
            })
          }
        </div>

        {
          authors.length === 0 && (
            <div class="flex flex-col items-center justify-center py-24 border border-primary/15 bg-accent/40 rounded-3xl mt-8">
              <span class="icon-[ph--warning-circle] size-10 text-primary/40 mb-4" />
              <p class="text-sm text-muted-foreground">还没有作者喵～</p>
            </div>
          )
        }
      </div>
    </main>
  </div>
</Layout>
