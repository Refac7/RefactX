---
import { cn } from '~/lib/utils'
import { SECTION_HEADER_CLASS, SECTION_TITLE_CLASS, SECTION_NUM_CLASS, SECTION_META_CLASS } from '~/lib/ui'
import { PROJECTS_CONFIG } from '~/config'
import Layout from '~/layouts/Layout.astro'
import ProjectStats from '~/components/projects/ProjectStats'
import rawProjectList from '~/content/data/projects.json'
import PageAside from '~/components/base/PageAside.astro'

interface Project {
  name: string
  description: string
  githubUrl: string | null
  website: string | null
  type: string
  icon: string
  imageClass?: string
  star?: number
  fork?: number
}

const ProjectList = rawProjectList.map((project) => ({
  ...project,
  star: typeof project.star === 'number' ? project.star : Number(project.star) || 0,
  fork: typeof project.fork === 'number' ? project.fork : Number(project.fork) || 0,
})) as Project[]
const { title, description, introduce } = PROJECTS_CONFIG
const totalCount = ProjectList.length.toString().padStart(2, '0')
---

<Layout {title} {description}>
  <div class="relative font-sans flex flex-col lg:flex-row min-h-screen max-w-[1920px] mx-auto">
    <PageAside
      statusText="Online"
      statusVariant="success"
      {title}
      subtitleIcon="icon-[ph--stack]"
      subtitleText="Module Registry"
      identityTags={[
        { icon: 'icon-[ph--cube]', label: `${totalCount} Modules` },
        { icon: 'icon-[mdi--github]', label: 'GitHub' },
        { icon: 'icon-[ph--arrow-up-right]', label: 'Deployed' },
      ]}
      intro={introduce}
      statsLabel="REGISTRY STATUS"
      statsMeta={`${totalCount} TOTAL`}
      stats={[
        { value: totalCount, label: 'Total Modules' },
        { value: new Date().toLocaleDateString('en-US', { month: 'short', day: '2-digit' }), label: 'Last Update' },
      ]}
    />

    <main class="w-full lg:w-1/2 lg:flex-1 z-10 flex flex-col fade-up animation-delay-100">
      <div class="px-5 py-10 sm:px-8 lg:px-10 lg:py-14 xl:px-12 flex-1">
        <div class={SECTION_HEADER_CLASS}>
          <div class="flex items-center">
            <span class={SECTION_NUM_CLASS}>01</span><h2 class={SECTION_TITLE_CLASS}>Component Sequence</h2>
          </div>
          <span class={SECTION_META_CLASS}>Module_Registry</span>
        </div>

        <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2">
          {
            ProjectList.map((project, index) => {
              return (
                <div
                  class="group relative flex flex-col border border-foreground/25 bg-background transition-colors duration-200 fade-up hover:border-primary"
                  style={`animation-delay: ${index * 70}ms`}
                >
                  <span
                    aria-hidden="true"
                    class="pointer-events-none absolute right-4 top-3 select-none font-mono text-5xl font-bold leading-none tracking-[-0.08em] text-foreground/[0.06]"
                  >
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <div class="relative z-10 flex items-start justify-between p-5 pb-0">
                    <div class="flex size-11 items-center justify-center border border-foreground/30 bg-muted/40">
                      {project.type === 'icon' && <span class={cn('size-6 text-foreground/80', project.icon)} />}
                      {project.type === 'image' && (
                        <img
                          src={project.icon}
                          alt={project.name}
                          class={cn('size-full object-cover grayscale transition-all group-hover:grayscale-0', project.imageClass)}
                        />
                      )}
                    </div>
                    <div class="flex gap-1.5">
                      {project.githubUrl && (
                        <a
                          href={project.githubUrl}
                          target="_blank"
                          class="flex size-8 items-center justify-center border border-foreground/25 text-muted-foreground transition-colors hover:border-foreground hover:text-foreground"
                        >
                          <span class="icon-[mdi--github] size-4" />
                        </a>
                      )}
                      {project.website && (
                        <a
                          href={project.website}
                          target="_blank"
                          class="flex size-8 items-center justify-center border border-foreground/25 text-muted-foreground transition-colors hover:border-primary hover:text-primary"
                        >
                          <span class="icon-[ph--arrow-up-right] size-4" />
                        </a>
                      )}
                    </div>
                  </div>
                  <div class="relative z-10 flex-1 p-5 pt-4">
                    <a href={project.website || project.githubUrl} target="_blank" class="block">
                      <h3 class="text-lg font-bold tracking-[-0.03em] text-foreground transition-colors group-hover:text-primary">
                        {project.name}
                      </h3>
                    </a>
                    <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-muted-foreground">{project.description}</p>
                  </div>
                  <div class="mt-auto flex items-center justify-between border-t border-foreground/20 px-5 py-2.5">
                    <span class="inline-flex items-center gap-1.5 font-mono text-[9px] uppercase tracking-[0.16em] text-muted-foreground">
                      <span class="size-1.5 bg-success" />
                      Stable
                    </span>
                    {project.githubUrl && (
                      <div class="origin-right scale-95">
                        <ProjectStats client:visible repoUrl={project.githubUrl} initialStar={project.star} initialFork={project.fork} />
                      </div>
                    )}
                  </div>
                </div>
              )
            })
          }
        </div>
      </div>
    </main>
  </div>
</Layout>
