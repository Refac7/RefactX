---
import { cn } from '~/lib/utils'
import { SECTION_HEADER_CLASS, SECTION_TITLE_CLASS, SECTION_NUM_CLASS, SECTION_META_CLASS } from '~/lib/ui'
import { PROJECTS_CONFIG } from '~/config'
import Layout from '~/layouts/Layout.astro'
import ProjectStats from '~/components/projects/ProjectStats'
import rawProjectList from '~/content/data/projects.json'
import PageAside from '~/components/base/PageAside.astro'

interface Project {
  name: string
  description: string
  githubUrl: string | null
  website: string | null
  type: string
  icon: string
  imageClass?: string
  star?: number
  fork?: number
}

const ProjectList = rawProjectList.map((project) => ({
  ...project,
  star: typeof project.star === 'number' ? project.star : Number(project.star) || 0,
  fork: typeof project.fork === 'number' ? project.fork : Number(project.fork) || 0,
})) as Project[]
const { title, description, introduce } = PROJECTS_CONFIG
const totalCount = ProjectList.length.toString().padStart(2, '0')
---

<Layout {title} {description}>
  <div class="relative font-sans flex flex-col lg:flex-row min-h-screen max-w-[1920px] mx-auto">
    <PageAside
      statusText="Online"
      statusVariant="emerald"
      {title}
      subtitleIcon="icon-[ph--stack]"
      subtitleText="Module Registry"
      identityTags={[
        { icon: 'icon-[ph--cube]', label: `${totalCount} Modules` },
        { icon: 'icon-[mdi--github]', label: 'GitHub' },
        { icon: 'icon-[ph--arrow-up-right]', label: 'Deployed' },
      ]}
      intro={introduce}
      statsLabel="// REGISTRY STATUS"
      statsMeta={`${totalCount} TOTAL`}
      stats={[
        { value: totalCount, label: 'Total Modules' },
        { value: new Date().toLocaleDateString('en-US', { month: 'short', day: '2-digit' }), label: 'Last Update' },
      ]}
    />

    <main class="w-full lg:w-2/3 z-10 flex flex-col fade-up animation-delay-100">
      <div class="px-6 lg:px-8 xl:px-12 lg:py-20 flex-1">
        <div class={SECTION_HEADER_CLASS}>
          <div class="flex items-center">
            <span class={SECTION_NUM_CLASS}>01</span><h2 class={SECTION_TITLE_CLASS}>Component Sequence</h2>
          </div>
          <span class={SECTION_META_CLASS}>// Module_Registry</span>
        </div>

        <div class="grid grid-cols-1 gap-6 mt-8">
          {
            ProjectList.map((project, index) => {
              return (
                <div
                  class="group relative flex flex-col bg-background/50 border border-border/40 rounded-xl hover:bg-muted/20 hover:border-primary/30 hover:shadow-sm transition-all duration-300 fade-up hover:-translate-y-0.5"
                  style={`animation-delay: ${index * 100}ms`}
                >
                  <div class="p-6 pb-2 relative z-10 flex justify-between items-start">
                    <div class="size-12 flex items-center justify-center rounded-md bg-muted/30 border border-border/40">
                      {project.type === 'icon' && <span class={cn('size-6 text-foreground/80', project.icon)} />}
                      {project.type === 'image' && (
                        <img
                          src={project.icon}
                          alt={project.name}
                          class={cn(
                            'size-full object-cover rounded-md opacity-90 group-hover:opacity-100 transition-opacity',
                            project.imageClass
                          )}
                        />
                      )}
                    </div>
                    <div class="flex gap-2">
                      {project.githubUrl && (
                        <a
                          href={project.githubUrl}
                          target="_blank"
                          class="flex items-center justify-center size-8 rounded-full bg-muted/50 hover:bg-muted text-muted-foreground hover:text-foreground transition-all"
                        >
                          <span class="icon-[mdi--github] size-4" />
                        </a>
                      )}
                      {project.website && (
                        <a
                          href={project.website}
                          target="_blank"
                          class="flex items-center justify-center size-8 rounded-full bg-muted/50 hover:bg-muted text-muted-foreground hover:text-foreground transition-all"
                        >
                          <span class="icon-[ph--arrow-up-right] size-4" />
                        </a>
                      )}
                    </div>
                  </div>
                  <div class="p-6 pt-2 flex-1 relative z-10">
                    <a href={project.website || project.githubUrl} target="_blank" class="block">
                      <h3 class="text-base font-semibold text-foreground tracking-tight">{project.name}</h3>
                    </a>
                    <p class="text-xs text-muted-foreground leading-relaxed line-clamp-3">{project.description}</p>
                  </div>
                  <div class="mt-auto border-t border-border/40 px-6 py-2 bg-muted/10 rounded-b-xl flex items-center justify-between">
                    <span class="inline-flex items-center gap-1.5 text-xs font-medium text-muted-foreground">
                      <span class="size-1.5 rounded-full bg-emerald-500" />
                      Stable
                    </span>
                    {project.githubUrl && (
                      <div class="scale-95 origin-right">
                        <ProjectStats client:visible repoUrl={project.githubUrl} initialStar={project.star} initialFork={project.fork} />
                      </div>
                    )}
                  </div>
                </div>
              )
            })
          }
        </div>
      </div>
    </main>
  </div>
</Layout>
