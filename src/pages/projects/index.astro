---
import { cn } from '~/lib/utils'
import { PROJECTS_CONFIG } from '~/config'
import Layout from '~/layouts/Layout.astro'
import ProjectStats from '~/components/projects/ProjectStats'

// 导入 JSON 数据
import rawProjectList from '~/content/data/projects.json'

// 定义并转换类型
interface Project {
  name: string;
  description: string;
  githubUrl: string | null;
  website: string | null;
  type: string;
  icon: string;
  imageClass?: string;
  star?: number;
  fork?: number;
}
const ProjectList = rawProjectList as Project[];

const { title, description, introduce } = PROJECTS_CONFIG

// 计算总数
const totalCount = ProjectList.length.toString().padStart(2, '0');

// 样式常量
const SECTION_HEADER_CLASS = "flex items-end justify-between border-b border-border/60 pb-4 mb-8 select-none"
const SECTION_TITLE_CLASS = "font-mono text-sm font-bold uppercase tracking-widest text-foreground/80"
const SECTION_NUM_CLASS = "font-mono text-xs text-primary mr-3"
---

<Layout {title} {description}>
  <div class="relative font-sans min-h-[80vh]">

    {/* ================= HERO SECTION ================= */}
    <div class="relative z-10 border-b border-border/60">
      <div class="p-6 sm:p-8 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-0">
        
        {/* Left: Title Area */}
        <div class="lg:col-span-8 flex flex-col justify-between min-h-[300px] lg:border-r border-border/60 lg:pr-12">
            
            {/* Top Status Bar */}
            <div class="flex flex-row justify-between items-start text-[10px] font-mono uppercase tracking-widest text-muted-foreground/60 select-none mb-8">
                <span>// SYSTEM_MANIFEST // {new Date().getFullYear()}</span>
                <div class="flex items-center gap-2 text-primary">
                    <span class="relative flex h-1.5 w-1.5">
                      {/* 去圆角，变方块 */}
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-none bg-primary opacity-75"></span>
                      <span class="relative inline-flex rounded-none h-1.5 w-1.5 bg-primary"></span>
                    </span>
                    <span>SYS: ONLINE</span>
                </div>
            </div>

            {/* Main Title */}
            <div>
               <h1 class="text-6xl sm:text-8xl font-black tracking-tighter text-foreground leading-[0.8] mb-6 -ml-1 select-none">
                {title.toUpperCase()}<span class="text-primary">.</span>
               </h1>
               
               {/* 装饰性的箭头 */}
               <div class="h-px w-24 bg-foreground/20 mt-8 mb-4"></div>
               <div class="flex items-center gap-2 text-xs font-mono text-muted-foreground/60 uppercase">
                  <span class="icon-[ph--stack-bold] size-4"></span>
                  <span>Module Registry</span>
               </div>
            </div>
        </div>

        {/* Right: Stats Grid (Boxy Style) */}
        <div class="lg:col-span-4 flex flex-col h-full border-t lg:border-t-0 border-border/60 lg:pl-0">
          
          {/* Description Box */}
          <div class="flex-1 p-6 sm:p-8 bg-muted/5 border-b border-border/60 lg:border-b xl:border-dashed">
             <span class="block text-[10px] uppercase text-muted-foreground/60 font-mono tracking-wider mb-4">// DEPLOY_LOGS</span>
             <p class="text-sm text-muted-foreground leading-loose font-mono">
               {introduce}
               <br/><br/>
               <span class="text-primary">> Initializing grid...</span>
             </p>
          </div>

          {/* Stats Grid - Rigid Box Style */}
          <div class="grid grid-cols-2 bg-border/60 gap-px border-t border-border/60 lg:border-t-0">
              
              {/* Total Modules */}
              <div class="group relative flex flex-col items-center justify-center p-6 bg-background hover:bg-muted/10 transition-colors h-32">
                 <span class="text-3xl font-mono font-bold text-foreground tracking-tighter group-hover:text-primary transition-colors">
                    {totalCount}
                 </span>
                 <span class="text-[9px] font-mono uppercase tracking-widest text-muted-foreground mt-2">
                    Total_Modules
                 </span>
                 {/* Corner Accent */}
                 <div class="absolute top-0 right-0 p-1 opacity-0 group-hover:opacity-100 transition-opacity">
                    <div class="w-1.5 h-1.5 bg-primary"></div>
                 </div>
              </div>

              {/* Last Update */}
              <div class="group relative flex flex-col items-center justify-center p-6 bg-background hover:bg-muted/10 transition-colors h-32">
                 <span class="text-lg font-mono font-bold text-foreground group-hover:text-primary transition-colors">
                    {new Date().toLocaleDateString('en-US', {month: 'short', day: '2-digit'})}
                 </span>
                 <span class="text-[9px] font-mono uppercase tracking-widest text-muted-foreground mt-2">
                    Last_Update
                 </span>
                 {/* Corner Accent */}
                 <div class="absolute bottom-0 left-0 p-1 opacity-0 group-hover:opacity-100 transition-opacity">
                    <div class="w-1.5 h-1.5 bg-primary"></div>
                 </div>
              </div>

          </div>
        </div>
      </div>
    </div>

    
    {/* ================= PROJECT GRID ================= */}
    <div class="p-6 sm:p-8">
        
        <div class={SECTION_HEADER_CLASS}>
            <div class="flex items-center">
                <span class={SECTION_NUM_CLASS}>01</span>
                <h2 class={SECTION_TITLE_CLASS}>Component_Sequence</h2>
            </div>
            <div class="hidden sm:block h-px flex-1 bg-border/40 ml-6 max-w-[100px]"></div>
        </div>
    
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
        {
            ProjectList.map((project, index) => {
            const serialId = `0${index + 1}`.slice(-2);
            
            return (
                <div class="group relative flex flex-col bg-background border border-border/60 hover:border-primary/50 transition-all duration-300 min-h-[220px]">
                
                {/* Background Index (Watermark style) */}
                <span class="absolute right-4 top-2 text-6xl font-black text-muted-foreground/[0.03] group-hover:text-primary/[0.04] transition-colors pointer-events-none select-none font-mono">
                    {serialId}
                </span>
                
                {/* Card Header: Icon & Actions */}
                <div class="p-6 pb-2 relative z-10 flex justify-between items-start">
                    <div class="size-12 flex items-center justify-center bg-muted/5 border border-border/40 group-hover:border-primary/30 transition-colors">
                        {project.type === 'icon' && <span class={cn('size-6 text-foreground/80 group-hover:text-primary transition-colors', project.icon)} />}
                        {project.type === 'image' && <img src={project.icon} alt={project.name} class={cn('size-full object-cover opacity-80 group-hover:opacity-100 transition-opacity', project.imageClass)} />}
                    </div>

                    <div class="flex gap-2">
                        {project.githubUrl && (
                            <a href={project.githubUrl} target="_blank" class="flex items-center justify-center size-8 border border-transparent hover:border-border/60 hover:bg-muted/10 text-muted-foreground hover:text-primary transition-all" aria-label="Github">
                                <span class="icon-[mdi--github] size-4"></span>
                            </a>
                        )}
                        {project.website && (
                            <a href={project.website} target="_blank" class="flex items-center justify-center size-8 border border-transparent hover:border-border/60 hover:bg-muted/10 text-muted-foreground hover:text-primary transition-all" aria-label="Demo">
                                <span class="icon-[ph--arrow-up-right-bold] size-4"></span>
                            </a>
                        )}
                    </div>
                </div>

                {/* Card Body */}
                <div class="p-6 pt-2 flex-1 relative z-10">
                    <a href={project.website || project.githubUrl} target="_blank" class="block group-hover:translate-x-1 transition-transform duration-300">
                        <h3 class="text-xl font-bold text-foreground tracking-tight mb-3 group-hover:text-primary transition-colors font-sans">
                        {project.name}
                        </h3>
                    </a>
                    <p class="text-sm text-muted-foreground leading-relaxed line-clamp-3 font-mono">
                    {project.description}
                    </p>
                </div>

                {/* Card Footer: Status & Stats */}
                <div class="mt-auto border-t border-dashed border-border/40 p-3 bg-muted/[0.02] flex items-center justify-between">
                    <span class="text-[9px] font-mono text-muted-foreground/60 uppercase tracking-wider">
                        STATUS: <span class="text-emerald-500/80">STABLE</span>
                    </span>
                    
                    {/* Project Stats Component */}
                    {project.githubUrl && (
                        <div class="scale-90 origin-right">
                            <ProjectStats 
                                client:visible 
                                repoUrl={project.githubUrl} 
                                initialStar={project.star} 
                                initialFork={project.fork} 
                            />
                        </div>
                    )}
                </div>

                {/* Corner Accents (Hover Effects) */}
                <div class="absolute top-0 left-0 w-2 h-2 border-t border-l border-primary/0 group-hover:border-primary/50 transition-colors"></div>
                <div class="absolute bottom-0 right-0 w-2 h-2 border-b border-r border-primary/0 group-hover:border-primary/50 transition-colors"></div>

                </div>
            )
            })
        }
        </div>
    </div>
  </div>
</Layout>