---
import Layout from '~/layouts/Layout.astro'
import PhotoTimeline from '~/components/photos/PhotoTimeline.astro'
import rawPhotosList from '~/content/data/photos.json'
import TerminalBuffer from '~/components/base/TerminalBuffer.astro';

const PhotosList = rawPhotosList as any;
const PHOTOS_CONFIG = { title: 'Photos', description: '浮光掠影处，皆是生活馈赠的吉光片羽', introduce: '方寸镜头间，镌刻着时光走过的痕迹' }
const { title, description, introduce } = PHOTOS_CONFIG
const totalCollections = PhotosList.length.toString().padStart(2, '0')

const SECTION_HEADER_CLASS = "flex items-end justify-between border-b pb-4 mb-8 select-none"
const SECTION_TITLE_CLASS = "font-mono text-sm font-bold uppercase tracking-widest text-foreground/80"
const SECTION_NUM_CLASS = "font-mono text-xs text-primary mr-3"
---

<Layout title={title} description={description}>
  <div class="relative font-sans flex flex-col lg:flex-row min-h-screen max-w-[1920px] mx-auto">
    <aside class="w-full lg:w-1/3 lg:sticky lg:top-0 lg:h-screen flex flex-col lg:border-r z-20 bg-background lg:shadow-[4px_0_24px_-12px_rgba(0,0,0,0.1)] dark:shadow-none border-b border-border/60 lg:border-none">
      
      <div class="flex flex-1 lg:overflow-y-auto scrollbar-hide flex-col">
        <div class="p-6 lg:p-8 xl:p-12 pb-0 shrink-0">
          <div class="flex flex-row justify-between items-start text-[10px] font-mono uppercase tracking-widest text-muted-foreground/60 select-none">
            <span>// SYSTEM_VISUALS // ARCHIVE</span>
            <div class="flex items-center gap-2 text-primary">
              <span class="relative flex h-1.5 w-1.5"><span class="animate-ping absolute inline-flex h-full w-full bg-red-500 opacity-75"></span><span class="relative inline-flex h-1.5 w-1.5 bg-red-600"></span></span>
              <span class="font-bold text-foreground">REC</span>
            </div>
          </div>
        </div>
        
        <div class="flex-1 flex flex-col justify-end lg:justify-center p-6 lg:p-8 xl:p-12 min-h-[300px] lg:min-h-[250px]">
          <h1 class="text-6xl sm:text-7xl lg:text-8xl font-black tracking-tighter text-foreground leading-[0.8] mb-6 -ml-1 select-none">{title.toUpperCase()}<span class="text-primary">.</span></h1>
          <div class="h-px w-24 bg-foreground/20 mt-2 mb-4"></div>
          <div class="flex items-center gap-2 text-xs font-mono text-muted-foreground/60 uppercase"><span class="icon-[ph--camera-bold] size-4"></span><span>Visual Capture</span></div>
        </div>
        
        <div class="shrink-0 p-6 lg:p-8 xl:p-12 bg-muted/5 border-t border-dashed border-border/40">
          <span class="block text-[10px] uppercase text-muted-foreground/60 font-mono tracking-wider mb-4">// FRAME_INFO</span>
          <p class="text-sm text-muted-foreground leading-loose font-mono">{introduce}<br/><br/><span class="text-primary">> Framing in progress...</span></p>
        </div>
      </div>
      
      <div class="grid grid-cols-2 bg-border/40 gap-px border-t border-border/40 shrink-0">
        <div class="group relative flex flex-col items-center justify-center p-6 bg-background hover:bg-muted/10 transition-colors h-32 lg:h-28 xl:h-32">
          <span class="text-3xl font-mono font-bold text-foreground tracking-tighter group-hover:text-primary transition-colors">{totalCollections}</span>
          <span class="text-[9px] font-mono uppercase tracking-widest text-muted-foreground mt-2">Total_Frames</span>
          <div class="absolute top-0 right-0 p-1 opacity-0 group-hover:opacity-100 transition-opacity"><div class="w-1.5 h-1.5 bg-primary"></div></div>
        </div>
        <div class="group relative flex flex-col items-center justify-center p-6 bg-background hover:bg-muted/10 transition-colors h-32 lg:h-28 xl:h-32">
          <span class="text-lg font-mono font-bold text-foreground group-hover:text-primary transition-colors">JPG/RAW</span>
          <span class="text-[9px] font-mono uppercase tracking-widest text-muted-foreground mt-2">File_Format</span>
          <div class="absolute bottom-0 left-0 p-1 opacity-0 group-hover:opacity-100 transition-opacity"><div class="w-1.5 h-1.5 bg-primary"></div></div>
        </div>
      </div>
    </aside>

    <main class="w-full lg:w-2/3 z-10 flex flex-col">
      <div class="p-6 lg:p-10 xl:p-16 2xl:p-20 flex-1">
        <div class={SECTION_HEADER_CLASS}>
          <div class="flex items-center"><span class={SECTION_NUM_CLASS}>01</span><h2 class={SECTION_TITLE_CLASS}>Visual_Feed</h2></div>
          <div class="hidden sm:block h-px flex-1 bg-border/40 ml-6 max-w-[200px]"></div>
        </div>
        <TerminalBuffer layout="list" count={6} delay={500}>
          <div class="mt-8 min-h-[40vh]">
            {PhotosList.length > 0 ? (
                <div class="relative"><PhotoTimeline photoData={PhotosList} /></div>
              ) : (
                <div class="flex flex-col items-center justify-center py-20 border border-dashed bg-muted/5">
                  <span class="icon-[ph--camera-slash] text-4xl text-muted-foreground/30 mb-4"></span>
                  <p class="font-mono text-sm text-muted-foreground/60 uppercase tracking-widest">Signal Lost // No Frames</p>
                </div>
            )}
          </div>
        </TerminalBuffer>
        <div class="mt-16 flex justify-center"><span class="font-mono text-[10px] text-muted-foreground/30 uppercase tracking-[0.5em]">// End of Reel //</span></div>
      </div>
    </main>
  </div>
</Layout>
<style>.scrollbar-hide::-webkit-scrollbar{display:none;}.scrollbar-hide{-ms-overflow-style:none;scrollbar-width:none;}</style>