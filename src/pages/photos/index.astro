---
import Layout from '~/layouts/Layout.astro'
import PhotoTimeline from '~/components/photos/PhotoTimeline.astro'

// 1. 导入 JSON 数据
import rawPhotosList from '~/content/data/photos.json'

// 2. [关键修改] 直接断言为 any，彻底绕过类型检查
const PhotosList = rawPhotosList as any;

// 3. 页面配置
const PHOTOS_CONFIG = {
  title: 'Photos',
  description: '浮光掠影处，皆是生活馈赠的吉光片羽',
  introduce: '方寸镜头间，镌刻着时光走过的痕迹',
}
const { title, description, introduce } = PHOTOS_CONFIG

// 补零处理（和模板一致的规范）
const totalCollections = PhotosList.length.toString().padStart(2, '0')

// 样式常量（完全复用模板的样式类，保证风格统一）
const SECTION_HEADER_CLASS = "flex items-end justify-between border-b border-border/60 pb-4 mb-8 select-none"
const SECTION_TITLE_CLASS = "font-mono text-sm font-bold uppercase tracking-widest text-foreground/80"
const SECTION_NUM_CLASS = "font-mono text-xs text-primary mr-3"
---

<Layout title={title} description={description}>
  <div class="relative font-sans min-h-[80vh]">
    {/* ================= HERO SECTION 完全复刻模板布局，保留照片页核心标识 ================= */}
    <div class="relative z-10 border-b border-border/60">
      <div class="p-6 sm:p-8 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-0">
        {/* Left: Title Area 左侧8列，保留REC录制状态、大标题 */}
        <div class="lg:col-span-8 flex flex-col justify-between min-h-[300px] lg:border-r border-border/60 lg:pr-12">
          {/* Top Status Bar 状态条，替换为照片页的SYSTEM_VISUALS，保留REC动效 */}
          <div class="flex flex-row justify-between items-start text-[10px] font-mono uppercase tracking-widest text-muted-foreground/60 select-none mb-8">
            <span>// SYSTEM_VISUALS // ARCHIVE</span>
            <div class="flex items-center gap-2 text-primary">
              <span class="relative flex h-1.5 w-1.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-none bg-red-500 opacity-75"></span>
                <span class="relative inline-flex rounded-none h-1.5 w-1.5 bg-red-600"></span>
              </span>
              <span class="font-bold text-foreground">REC</span>
            </div>
          </div>

          {/* Main Title 大标题，贴合模板样式（uppercase、font-black、leading-[0.8]） */}
          <div>
            <h1 class="text-6xl sm:text-8xl font-black tracking-tighter text-foreground leading-[0.8] mb-6 -ml-1 select-none">
              {title.toUpperCase()}<span class="text-primary">.</span>
            </h1>
            {/* 装饰性的箭头，贴合模板 */}
            <div class="h-px w-24 bg-foreground/20 mt-8 mb-4"></div>
            <div class="flex items-center gap-2 text-xs font-mono text-muted-foreground/60 uppercase">
              <span class="icon-[ph--camera-bold] size-4"></span>
              <span>Visual Capture</span>
            </div>
          </div>
        </div>

        {/* Right: Stats Grid 右侧4列，复刻模板的Description Box + 双格Stats */}
        <div class="lg:col-span-4 flex flex-col h-full border-t lg:border-t-0 border-border/60 lg:pl-0">
          {/* Description Box 描述框，放照片页的introduce */}
          <div class="flex-1 p-6 sm:p-8 bg-muted lg:bg-muted/5 border-b border-border/60 lg:border-b xl:border-dashed">
            <span class="block text-[10px] uppercase text-muted-foreground/60 font-mono tracking-wider mb-4">// FRAME_INFO</span>
            <p class="text-sm text-muted-foreground leading-loose font-mono">
              {introduce}
              <br/><br/>
              <span class="text-primary">> Framing in progress...</span>
            </p>
          </div>

          {/* Stats Grid 统计格，替换为照片页的Total_Frames + 格式标识 */}
          <div class="grid grid-cols-2 bg-border/60 gap-px border-t border-border/60 lg:border-t-0">
            {/* Total Frames 照片总数，替换原Active_Nodes */}
            <div class="group relative flex flex-col items-center justify-center p-6 bg-background hover:bg-muted/10 transition-colors h-32">
              <span class="text-3xl font-mono font-bold text-foreground tracking-tighter group-hover:text-primary transition-colors">
                {totalCollections}
              </span>
              <span class="text-[9px] font-mono uppercase tracking-widest text-muted-foreground mt-2">
                Total_Frames
              </span>
              {/* Corner Accent 模板经典角落小方块 */}
              <div class="absolute top-0 right-0 p-1 opacity-0 group-hover:opacity-100 transition-opacity">
                <div class="w-1.5 h-1.5 bg-primary"></div>
              </div>
            </div>

            {/* File Format 格式标识，替换原Protocol_Ver，贴合照片主题 */}
            <div class="group relative flex flex-col items-center justify-center p-6 bg-background hover:bg-muted/10 transition-colors h-32">
              <span class="text-lg font-mono font-bold text-foreground group-hover:text-primary transition-colors">
                JPG/RAW
              </span>
              <span class="text-[9px] font-mono uppercase tracking-widest text-muted-foreground mt-2">
                File_Format
              </span>
              {/* Corner Accent 模板经典角落小方块 */}
              <div class="absolute bottom-0 left-0 p-1 opacity-0 group-hover:opacity-100 transition-opacity">
                <div class="w-1.5 h-1.5 bg-primary"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* ================= 主内容区 复刻模板的板块头，保留PhotoTimeline核心功能 ================= */}
    <div class="p-6 sm:p-8">
      {/* Visual_Feed 板块，复刻模板的编号板块头（01） */}
      <div class={SECTION_HEADER_CLASS}>
        <div class="flex items-center">
          <span class={SECTION_NUM_CLASS}>01</span>
          <h2 class={SECTION_TITLE_CLASS}>Visual_Feed</h2>
        </div>
        <div class="hidden sm:block h-px flex-1 bg-border/40 ml-6 max-w-[100px]"></div>
      </div>

      {/* 照片时间线核心区域，保留原功能+空状态，样式贴合模板 */}
      <div class="mt-8 min-h-[40vh]">
        {
          PhotosList.length > 0 ? (
            <div class="relative">
              <PhotoTimeline photoData={PhotosList} />
            </div>
          ) : (
            <div class="flex flex-col items-center justify-center py-20 border border-dashed border-border/60 bg-muted/5">
              <span class="icon-[ph--camera-slash] text-4xl text-muted-foreground/30 mb-4"></span>
              <p class="font-mono text-sm text-muted-foreground/60 uppercase tracking-widest">Signal Lost // No Frames</p>
            </div>
          )
        }
      </div>

      {/* 保留原页面的片尾提示，样式微调贴合模板 */}
      <div class="mt-16 flex justify-center">
        <span class="font-mono text-[10px] text-muted-foreground/30 uppercase tracking-[0.5em]">
          // End of Reel //
        </span>
      </div>
    </div>
  </div>
</Layout>
