---
import Layout from '~/layouts/Layout.astro'
import PhotoTimeline from '~/components/photos/PhotoTimeline.astro'
import rawPhotosList from '~/content/data/photos.json'

const PhotosList = rawPhotosList as any;
const PHOTOS_CONFIG = { title: 'Photos', description: '浮光掠影处，皆是生活馈赠的吉光片羽', introduce: '方寸镜头间，镌刻着时光走过的痕迹' }
const { title, description, introduce } = PHOTOS_CONFIG
const totalCollections = PhotosList.length.toString().padStart(2, '0')

const SECTION_HEADER_CLASS = "flex items-center justify-between border-b border-border/40 pb-4 mb-8 select-none"
const SECTION_TITLE_CLASS = "text-lg font-semibold tracking-tight text-foreground"
const SECTION_NUM_CLASS = "inline-flex items-center justify-center rounded-full bg-muted/60 px-2.5 py-0.5 text-xs font-medium text-muted-foreground mr-3"
---

<Layout title={title} description={description}>
  <div class="relative font-sans flex flex-col lg:flex-row min-h-screen max-w-[1920px] mx-auto">
    <aside class="w-full lg:w-1/3 lg:sticky lg:top-0 lg:h-screen flex flex-col lg:border-r border-border/40 z-20 bg-background border-b lg:border-none">
      
      <div class="flex flex-1 lg:overflow-y-auto scrollbar-hide flex-col">
        <div class="p-6 lg:p-8 xl:p-12 pb-0 shrink-0 fade-up">
          <span class="inline-flex items-center rounded-full bg-muted/50 px-3 py-1 text-xs font-medium text-muted-foreground select-none">
            Archive
          </span>
        </div>
        
        <div class="flex-1 flex flex-col justify-end lg:justify-center p-6 lg:p-8 xl:p-12 min-h-[300px] lg:min-h-[250px] fade-up animation-delay-100">
          <h1 class="text-5xl sm:text-6xl xl:text-7xl font-bold tracking-tight text-foreground leading-[1.1] mb-6 select-none">{title}</h1>
          <div class="flex items-center gap-2 text-sm text-muted-foreground"><span class="icon-[ph--camera] size-4"></span><span>Visual Capture</span></div>
        </div>
        
        <div class="shrink-0 p-6 lg:p-8 xl:p-12 fade-up animation-delay-150">
          <p class="text-sm text-muted-foreground leading-relaxed">{introduce}</p>
        </div>
      </div>
      
      <div class="flex border-t border-border/40 shrink-0 fade-up animation-delay-200">
        <div class="flex-1 flex flex-col items-start justify-center p-8 lg:p-10 xl:p-14 bg-background border-r border-border/40 hover:bg-muted/30 transition-colors">
          <span class="text-2xl font-semibold text-foreground tracking-tight">{totalCollections}</span>
          <span class="text-xs text-muted-foreground mt-1">Collections</span>
        </div>
        <div class="flex-1 flex flex-col items-start justify-center p-8 lg:p-10 xl:p-14 bg-background hover:bg-muted/30 transition-colors">
          <span class="text-2xl font-semibold text-foreground tracking-tight">RAW</span>
          <span class="text-xs text-muted-foreground mt-1">Format</span>
        </div>
      </div>
    </aside>

    <main class="w-full lg:w-2/3 z-10 flex flex-col fade-up animation-delay-150">
      <div class="p-6 lg:p-10 xl:p-16 2xl:p-20 flex-1">
        <div class={SECTION_HEADER_CLASS}>
          <div class="flex items-center"><span class={SECTION_NUM_CLASS}>01</span><h2 class={SECTION_TITLE_CLASS}>Visual Feed</h2></div>
        </div>
        
        <div class="mt-8 min-h-[40vh] fade-up animation-delay-200">
          {PhotosList.length > 0 ? (
              <div class="relative"><PhotoTimeline photoData={PhotosList} /></div>
            ) : (
              <div class="flex flex-col items-center justify-center py-20 rounded-xl border border-border/40 bg-muted/10">
                <span class="icon-[ph--camera-slash] text-4xl text-muted-foreground/30 mb-4"></span>
                <p class="text-sm text-muted-foreground">No photos available yet.</p>
              </div>
          )}
        </div>
        
        <div class="mt-16 flex justify-center"><span class="text-xs text-muted-foreground/40 select-none">End of Reel</span></div>
      </div>
    </main>
  </div>
</Layout>
<style>.scrollbar-hide::-webkit-scrollbar{display:none;}.scrollbar-hide{-ms-overflow-style:none;scrollbar-width:none;}</style>