---
import { getCollection } from 'astro:content'
import { SITE, SKILLSSHOWCASE_CONFIG, GITHUB_CONFIG, POSTS_CONFIG, BUILD_INFO_CONFIG } from '~/config.ts'
import { getWordCount, postsSort } from '~/lib/utils'
import { SECTION_HEADER_CLASS, SECTION_TITLE_CLASS, SECTION_NUM_CLASS, SECTION_META_CLASS } from '~/lib/ui'

import Layout from '~/layouts/Layout.astro'
import PageAside from '~/components/base/PageAside.astro'
import GithubContributions from '~/components/base/GithubContributions.tsx'
import List from '~/components/posts/card/List.astro'
import SkillsShowcase from '~/components/base/SkillsShowcase.astro'
import BuildInfo from '~/components/base/BuildInfo.astro'

const { ENABLED, GITHUB_USERNAME, TOOLTIP_ENABLED } = GITHUB_CONFIG
const { size, heroImageLayout } = POSTS_CONFIG.homePageConfig
const { SKILLS_ENABLED, SKILLS_DATA } = SKILLSSHOWCASE_CONFIG
const { ENABLED: BUILD_INFO_ENABLED, COMPONENTS: BUILD_COMPONENTS } = BUILD_INFO_CONFIG

const allPosts = await getCollection('posts')
const sortedPosts = postsSort(allPosts)
const posts = sortedPosts.slice(0, Math.max(size, 4))
const totalWords = allPosts.reduce((sum, post) => sum + getWordCount(post.body || ''), 0)
const tags = [...new Set(allPosts.flatMap((post) => post.data.tags || []))]

const EXPLORE_CARDS = [
  {
    title: '动态',
    en: 'Moments',
    desc: '碎片、灵感与开发日常',
    href: '/dynamic',
    icon: 'icon-[ph--sparkle]',
    tone: 'blue',
  },
  {
    title: '项目',
    en: 'Projects',
    desc: '正在构建与已经上线的东西',
    href: '/projects',
    icon: 'icon-[ph--stack]',
    tone: 'cyan',
  },
  {
    title: '友链',
    en: 'Friends',
    desc: '互联网上值得拜访的邻居',
    href: '/friends',
    icon: 'icon-[ph--planet]',
    tone: 'indigo',
  },
  {
    title: '标签',
    en: 'Topics',
    desc: '按主题漫游全部文章',
    href: '/tags',
    icon: 'icon-[ph--tag]',
    tone: 'slate',
  },
] as const
---

<Layout title="Overview" description={SITE.description}>
  <div class="page-shell relative min-h-screen">
    <PageAside
      image="/photos/250711-2.webp"
      statusText="Welcome"
      statusVariant="primary"
      title="Overview"
      subtitleIcon="icon-[ph--house]"
      subtitleText="Home Overview"
      identityTags={[
        { icon: 'icon-[ph--code]', label: 'Developer' },
        { icon: 'icon-[ph--pen-nib]', label: 'Creator' },
        { icon: 'icon-[ph--globe-hemisphere-west]', label: 'Earth' },
      ]}
      intro="你与光芒 / You & Radiance。这里记录构建网站的过程、日常的片段，以及那些值得被留住的光。"
      statsLabel="Site overview"
      statsMeta={`${allPosts.length} ARTICLES`}
      stats={[
        { value: allPosts.length.toString().padStart(2, '0'), label: 'Articles' },
        { value: `${Math.round(totalWords / 1000)}k`, label: 'Words' },
        { value: tags.length.toString().padStart(2, '0'), label: 'Topics' },
      ]}
    />

    <main class="w-full z-10 flex flex-col fade-up animation-delay-100">
      <div class="flex-1 flex flex-col">
        <section>
          <div class={SECTION_HEADER_CLASS}>
            <div class="flex items-center">
              <span class={SECTION_NUM_CLASS}>01</span>
              <h2 class={SECTION_TITLE_CLASS}>最近写下的</h2>
            </div>
            <a
              href="/posts"
              class="group inline-flex items-center gap-1.5 text-xs font-medium text-muted-foreground transition-colors hover:text-foreground"
            >
              查看全部
              <span class="icon-[ph--arrow-right] transition-transform group-hover:translate-x-1"></span>
            </a>
          </div>

          <div class="fade-up animation-delay-200">
            <List {posts} type="image" {heroImageLayout} showIndex />
          </div>
        </section>

        <section class="mt-20">
          <div class={SECTION_HEADER_CLASS}>
            <div class="flex items-center">
              <span class={SECTION_NUM_CLASS}>02</span>
              <h2 class={SECTION_TITLE_CLASS}>去别处逛逛</h2>
            </div>
            <span class={SECTION_META_CLASS}>Explore the site</span>
          </div>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {
              EXPLORE_CARDS.map((card, index) => (
                <a href={card.href} class:list={['explore-card', `explore-card--${card.tone}`]}>
                  <span class="explore-card__index">{String(index + 1).padStart(2, '0')}</span>
                  <span class="explore-card__icon">
                    <span class={`${card.icon} size-6`} />
                  </span>
                  <span class="explore-card__title">{card.title}</span>
                  <span class="explore-card__en">{card.en}</span>
                  <span class="explore-card__desc">{card.desc}</span>
                  <span class="explore-card__arrow">
                    <span class="icon-[ph--arrow-up-right] size-4" />
                  </span>
                </a>
              ))
            }
          </div>
        </section>

        {
          ENABLED && (
            <section class="mt-20">
              <div class={SECTION_HEADER_CLASS}>
                <div class="flex items-center">
                  <span class={SECTION_NUM_CLASS}>03</span>
                  <h2 class={SECTION_TITLE_CLASS}>最近在敲什么</h2>
                </div>
                <a
                  href={`https://github.com/${GITHUB_USERNAME}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-xs font-medium text-muted-foreground transition-colors hover:text-foreground"
                >
                  @{GITHUB_USERNAME}
                  <span class="icon-[ph--arrow-up-right]" />
                </a>
              </div>
              <div class="home-panel">
                <GithubContributions username={GITHUB_USERNAME} tooltipEnabled={TOOLTIP_ENABLED} client:visible transition:animate="none" />
              </div>
            </section>
          )
        }

        <section class="mt-20">
          <div class={SECTION_HEADER_CLASS}>
            <div class="flex items-center">
              <span class={SECTION_NUM_CLASS}>04</span>
              <h2 class={SECTION_TITLE_CLASS}>这个站点</h2>
            </div>
            <span class={SECTION_META_CLASS}>Behind the scenes</span>
          </div>

          <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
            {
              SKILLS_ENABLED && SKILLS_DATA.length > 0 && (
                <div class="home-panel home-panel--skills">
                  <div class="home-panel__head">
                    <div>
                      <span class="eyebrow">Tech stack</span>
                      <h3 class="mt-2 font-display text-2xl font-bold tracking-tight">工具箱</h3>
                    </div>
                    <span class="icon-[ph--wrench] size-5 text-muted-foreground/50" />
                  </div>
                  <SkillsShowcase skillsData={SKILLS_DATA} />
                </div>
              )
            }

            {
              BUILD_INFO_ENABLED && BUILD_COMPONENTS.length > 0 && (
                <div class="home-panel">
                  <div class="home-panel__head">
                    <div>
                      <span class="eyebrow">Build info</span>
                      <h3 class="mt-2 font-display text-2xl font-bold tracking-tight">构建信息</h3>
                    </div>
                    <span class="icon-[ph--cube] size-5 text-muted-foreground/50" />
                  </div>
                  <BuildInfo components={BUILD_COMPONENTS} totalWords={totalWords} />
                </div>
              )
            }
          </div>
        </section>

        <section class="mt-20">
          <div class="home-cta">
            <div class="home-cta__glow" aria-hidden="true"></div>
            <span class="eyebrow">Say hello</span>
            <h2 class="mt-3 font-display text-3xl font-bold tracking-tight sm:text-4xl">有想说的话，随时留下。</h2>
            <p class="mt-3 max-w-md text-sm leading-relaxed text-muted-foreground">
              留言板一直开着。哪怕只是一句简单的问候，也会让这里更热闹一点。
            </p>
            <div class="mt-6 flex flex-wrap gap-3">
              <a href="/messageboard" class="btn btn-primary">去留言板 <span class="icon-[ph--chat-teardrop-dots] size-4"></span></a>
              <a href="/about" class="btn btn-ghost">关于我 <span class="icon-[ph--user] size-4"></span></a>
            </div>
          </div>
        </section>
      </div>
    </main>
  </div>
</Layout>

<style>
  .explore-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 13rem;
    overflow: hidden;
    padding: 1.3rem;
    border-radius: 1.4rem;
    border: 1px solid hsl(var(--border) / 0.7);
    background: hsl(var(--card));
    text-decoration: none;
    transition:
      transform 300ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 300ms ease,
      border-color 300ms ease;
  }

  .explore-card:hover {
    transform: translateY(-4px);
    border-color: hsl(var(--primary) / 0.4);
    box-shadow: 0 24px 40px -30px hsl(218 24% 14% / 0.35);
  }

  .explore-card__index {
    position: absolute;
    right: 1rem;
    top: 0.8rem;
    font-family: var(--font-geist-mono);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    color: hsl(var(--muted-foreground) / 0.6);
  }

  .explore-card__icon {
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border-radius: 1rem;
    background: hsl(var(--muted) / 0.7);
    color: hsl(var(--accent-foreground));
    transition:
      transform 300ms ease,
      background-color 300ms ease;
  }

  .explore-card:hover .explore-card__icon {
    transform: rotate(-6deg) scale(1.05);
    background: hsl(var(--primary) / 0.22);
  }

  .explore-card__title {
    margin-top: 1.6rem;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: hsl(var(--foreground));
  }

  .explore-card__en {
    margin-top: 0.1rem;
    font-family: var(--font-geist-mono);
    font-size: 0.55rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
  }

  .explore-card__desc {
    margin-top: 0.6rem;
    font-size: 0.78rem;
    line-height: 1.6;
    color: hsl(var(--muted-foreground));
  }

  .explore-card__arrow {
    position: absolute;
    right: 1.1rem;
    bottom: 1.1rem;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: hsl(var(--muted) / 0.7);
    color: hsl(var(--muted-foreground));
    transition:
      background-color 300ms ease,
      color 300ms ease,
      transform 300ms ease;
  }

  .explore-card:hover .explore-card__arrow {
    background: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
    transform: translate(2px, -2px);
  }

  .home-panel {
    border-radius: 1.6rem;
    border: 1px solid hsl(var(--border) / 0.78);
    background: hsl(var(--card));
    padding: 1.4rem;
    overflow: hidden;
  }

  .home-panel__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid hsl(var(--border) / 0.6);
  }

  .home-cta {
    position: relative;
    overflow: hidden;
    padding: clamp(1.8rem, 4vw, 3rem);
    border-radius: 2rem;
    border: 1px solid hsl(var(--border) / 0.75);
    background: hsl(var(--card));
  }

  .home-cta__glow {
    position: absolute;
    top: -6rem;
    right: -4rem;
    width: 20rem;
    height: 20rem;
    border-radius: 999px;
    background: hsl(var(--primary) / 0.22);
    filter: blur(60px);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .explore-card,
    .explore-card__icon,
    .explore-card__arrow {
      transition: none;
    }
  }
</style>
