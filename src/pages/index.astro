---
import { SITE, SKILLSSHOWCASE_CONFIG, SOCIAL_LINKS } from '~/config.ts'
import { GITHUB_CONFIG, POSTS_CONFIG } from '~/config.ts'
import { postsSort } from '~/lib/utils'
import { getCollection } from 'astro:content'
import Layout from '~/layouts/Layout.astro'
import SectionDivider from '~/components/base/SectionDivider.astro'
import GithubContributions from '~/components/base/GithubContributions.tsx'
import SocialLink from '~/components/base/SocialLink.astro'
import List from '~/components/posts/card/List.astro'
import SkillsShowcase from '~/components/base/SkillsShowcase.astro'
import Snowfall from '~/components/base/Snowfall.astro'

const { ENABLED, GITHUB_USERNAME, TOOLTIP_ENABLED } = GITHUB_CONFIG
const { size, type } = POSTS_CONFIG.homePageConfig
const { SKILLS_ENABLED, SKILLS_DATA } = SKILLSSHOWCASE_CONFIG

const allPosts = await getCollection('posts')
const posts = postsSort(allPosts).slice(0, size)
---

<Layout title="主页" description={SITE.description}>
  <!-- 添加 overflow-x-hidden 防止任何绝对定位元素导致横向滚动条 -->
  <div class="relative min-h-screen w-full overflow-x-hidden font-sans">
    
    <Snowfall />

    <!-- 1. Hero 区域 -->
    <div class="relative z-10 px-6 sm:px-8 py-16 max-w-5xl mx-auto border-r border-border/40 bg-background/50 backdrop-blur-[2px]">
      
      <!-- 状态栏 Badge -->
      <div class="mb-12 fade-up">
        <div class="inline-flex items-center gap-4 px-4 py-2 border border-foreground/80 bg-background rounded-none font-mono text-xs tracking-wider text-foreground shadow-[4px_4px_0_0_rgba(0,0,0,0.1)] dark:shadow-[4px_4px_0_0_rgba(255,255,255,0.1)]">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full bg-red-500 opacity-75 rounded-none"></span>
            <span class="relative inline-flex h-2 w-2 bg-red-500 rounded-none"></span>
          </span>
          <span class="font-bold">SYSTEM: ONLINE</span>
          <span class="w-px h-3 bg-border"></span>
          <span class="text-muted-foreground">V1.6.0_BETA</span>
        </div>
      </div>

      <h1 class="space-y-3 sm:space-y-5 mb-20 fade-up" style="animation-delay: 100ms;">
        <span class="text-5xl sm:text-7xl font-bold tracking-tighter text-foreground leading-[1.1]">
          Welcome to
        </span>

        <span class="block text-5xl sm:text-7xl font-light tracking-tighter text-muted-foreground leading-[1.2] pt-0.5">
          the galaxy of <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-primary/60 font-medium">RefactX.</span>
        </span>
      </h1>

      <!-- 简介 -->
      <div class="mt-16 mb-12 max-w-2xl fade-up border-l-2 border-border pl-6" style="animation-delay: 200ms;">
        <p class="text-base sm:text-lg text-muted-foreground leading-relaxed font-mono">
          我是 <span class="text-foreground font-semibold">Refactored</span>，一名前端开发者和开源爱好者。<br class="hidden sm:block" />
          专注于探索各种技术栈，并将它们应用于实际项目中。<br class="hidden sm:block" />
          这里是我的数字花园，记录技术探索与思考。
        </p>
      </div>

      <!-- 按钮区：直角与高对比 -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6 fade-up" style="animation-delay: 300ms;">
        <div class="flex flex-wrap gap-4 w-full sm:w-auto">
          <a
            href="/posts"
            class="flex-1 sm:flex-none inline-flex items-center justify-center px-8 py-3 bg-foreground text-background hover:bg-muted/20 hover:text-black transition-colors font-bold uppercase tracking-widest text-sm rounded-none border border-transparent min-w-[140px]"
          >
            <span class="icon-[mdi--book-open] size-5 mr-2"></span>
            探索文章
          </a>
          <a
            href="/friends"
            class="flex-1 sm:flex-none inline-flex items-center justify-center px-8 py-3 border border-border text-foreground hover:border-primary hover:bg-muted/10 transition-colors duration-200 font-bold uppercase tracking-widest text-sm rounded-none min-w-[140px]"
          >
            <span class="icon-[mdi--rocket-launch] size-5 mr-2"></span>
            加入星海
          </a>
        </div>

        <div class="hidden sm:block w-px h-8 bg-border"></div>

        <div class="flex items-center gap-3">
          {SOCIAL_LINKS.map((item) => (
            <SocialLink
              href={item.url}
              icon={item.icon}
              aria-label={`${item.name}`}
              count={item.count}
              label="Follow"
              class="hover:bg-muted/20 transition-all"
            />
          ))}
        </div>
      </div>
    </div>

    <SectionDivider />

    <!-- 2. Github 贡献图 (修复溢出问题) -->
    {ENABLED && (
      <div class="py-12 px-6 sm:px-8 border-b border-border/40">
        <div class="max-w-5xl mx-auto">
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 border-l-4 border-primary pl-4">
            <h2 class="font-bold text-3xl tracking-tight uppercase">Activity Graph</h2>
            <p class="text-xs text-muted-foreground font-mono uppercase tracking-widest mb-1">// Commit History Visualization</p>
          </div>
          
          <!-- 关键修复：添加 overflow-x-auto 和 w-full 防止图表撑破布局 -->
          <div class="w-full overflow-x-auto pb-4 border border-dashed border-border p-2 bg-muted/5">
            <div class="min-w-[700px] md:min-w-full">
                <GithubContributions
                  username={GITHUB_USERNAME}
                  tooltipEnabled={TOOLTIP_ENABLED}
                  client:load
                  transition:animate="none"
                />
            </div>
          </div>
        </div>
      </div>
    )}

    <!-- 3. 技术栈 -->
    {SKILLS_ENABLED && SKILLS_DATA.length > 0 && (
      <div class="py-12 px-6 sm:px-8 border-b border-border/40">
        <div class="max-w-5xl mx-auto">
             <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 border-l-4 border-primary pl-4">
                <h2 class="font-bold text-3xl tracking-tight uppercase">Arsenal</h2>
                <p class="text-xs text-muted-foreground font-mono uppercase tracking-widest mb-1">// Tools & Frameworks</p>
            </div>
            <SkillsShowcase skillsData={SKILLS_DATA} />
          </div>
        </div>
    )}

    <!-- 4. 文章列表 -->
    <div class="py-12 pb-12 px-6 sm:px-8">
      <div class="max-w-5xl mx-auto">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10 border-b border-foreground pb-4">
            <h2 class="font-bold text-3xl tracking-tight uppercase">Recent Logs</h2>
            <a href="/posts" class="text-xs font-bold font-mono uppercase tracking-widest hover:text-primary transition-colors flex items-center gap-2 group">
               View All Transmissions 
               <span class="icon-[ph--arrow-right] group-hover:translate-x-1 transition-transform"></span>
            </a>
        </div>
        
        <!-- List 组件调用，确保传入正确的 props -->
        <List {posts} {type} heroImageLayout={POSTS_CONFIG.homePageConfig?.heroImageLayout} />
      </div>
    </div>
  </div>
</Layout>