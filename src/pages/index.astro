---
import { getCollection } from 'astro:content'
import { 
  SITE, 
  SKILLSSHOWCASE_CONFIG, 
  SOCIAL_LINKS, 
  GITHUB_CONFIG, 
  POSTS_CONFIG 
} from '~/config.ts'
import { postsSort } from '~/lib/utils'
import Layout from '~/layouts/Layout.astro'
import SectionDivider from '~/components/base/SectionDivider.astro'
import GithubContributions from '~/components/base/GithubContributions.tsx'
import List from '~/components/posts/card/List.astro'
import SkillsShowcase from '~/components/base/SkillsShowcase.astro'
import Snowfall from '~/components/base/Snowfall.astro'

// 解构配置
const { ENABLED, GITHUB_USERNAME, TOOLTIP_ENABLED } = GITHUB_CONFIG
const { size, type, heroImageLayout } = POSTS_CONFIG.homePageConfig
const { SKILLS_ENABLED, SKILLS_DATA } = SKILLSSHOWCASE_CONFIG

// 数据获取
const allPosts = await getCollection('posts')
const posts = postsSort(allPosts).slice(0, size)

// 样式常量 (统一页面边距)
const LAYOUT_CONTAINER = "mx-auto px-6 sm:px-8"
---

<Layout title="主页" description={SITE.description}>
  <!-- 背景特效 (添加 ID 和 过渡效果) -->
  <div id="snowfall-container" class="fixed inset-0 pointer-events-none z-[1] transition-opacity duration-700 ease-in-out">
    <Snowfall />
  </div>

  <div class="relative z-10">
    <!-- 1. Hero 区域 -->
    <div class={`${LAYOUT_CONTAINER} py-12 relative overflow-hidden`}>
      
      <!-- 背景 -->
      <div class="absolute -right-4 top-0 -z-10 hidden lg:flex flex-col items-end select-none pointer-events-none opacity-20 dark:opacity-25">
        <!-- 装饰编号 -->
        <span class="font-mono text-xs font-bold tracking-[1em] text-foreground/80 mb-2 mr-2">SYS.01</span>
        
        <!-- RX: 镂空描边层 -->
        <span class="mt-16 text-[13rem] xl:text-[17rem] font-black text-foreground leading-[0.75] tracking-tighter"
              style="-webkit-text-fill-color: transparent; -webkit-text-stroke: 2px currentColor;">
          RX
        </span>
        
        <!-- 7.SYS: 实心错位层 -->
        <span class="text-[13rem] xl:text-[17rem] font-black text-foreground/20 dark:text-foreground/10 leading-[0.75] tracking-tighter -mt-12 backdrop-blur-[1px]">
          7.SYS
        </span>
      </div>

      <!-- 顶部状态栏 -->
      <!-- 修改 1: 外层改为 flex-row justify-between items-start，确保左右两部分始终在同一行，且顶部对齐 -->
      <div class="flex flex-row justify-between items-start text-[10px] mb-16 sm:mb-24 lg:mb-72 font-mono uppercase tracking-widest text-muted-foreground/60 select-none">
        
        <!-- 左侧版本信息 -->
        <span>// IDENTITY_CORE // V.1.6</span>
        
        <!-- 右侧状态组 -->
        <!-- 修改 2: 
             - flex-col-reverse: 保持移动端上下堆叠，且 Online(DOM中在后) 显示在上方
             - items-end: 移动端靠右对齐
             - sm:items-center: 大屏恢复垂直居中
        -->
        <div class="flex flex-col-reverse items-end gap-2 sm:flex-row sm:items-center sm:gap-6">
            <!-- 特效开关按钮 (在 flex-col-reverse 下显示在底部) -->
            <button id="snow-toggle" class="group flex items-center gap-1.5 hover:text-primary transition-colors cursor-pointer focus:outline-none" aria-label="Toggle Effects">
                <span class="icon-[ph--snowflake] w-3 h-3 group-hover:text-primary transition-colors"></span>
                <span>FX: <span id="snow-status">ON</span></span>
            </button>

            <!-- 在线状态 (在 flex-col-reverse 下显示在顶部，与左侧对齐) -->
            <div class="flex items-center gap-2 text-primary">
                <span class="relative flex h-2 w-2">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-600"></span>
                </span>
                <span>SYS: ONLINE</span>
            </div>
        </div>
      </div>

      <!-- 主体内容 Grid -->
      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-12 items-end">
        
        <!-- 左侧：核心标题 -->
        <div class="lg:col-span-7">
          <div class="mb-3 sm:mb-4">
            <span class="font-mono text-[10px] sm:text-xs font-bold uppercase tracking-[0.2em] text-primary/80">
              :: Identify User
            </span>
          </div>
          
          <h1 class="relative inline-block text-7xl md:text-8xl font-bold tracking-tighter text-foreground leading-[0.9] -ml-1">
            <span class="relative z-10">Refac<span class="text-primary">7</span>.</span>
            <span class="absolute bottom-2 left-0 w-full h-4 bg-red-600/80 -z-0 opacity-80 -skew-x-6"></span>
          </h1>

          <h2 class="py-4 text-lg sm:text-2xl font-light tracking-tight text-muted-foreground">
            Architect of the Digital Void.
          </h2>
          <!-- 社交链接 -->
          <div class="flex items-center justify-between border-t border-border/40 pt-4">
            <span class="text-[10px] font-mono text-muted-foreground/40 uppercase tracking-widest">
              Connect_Protocol
            </span>
            <div class="flex items-center gap-3">
                {SOCIAL_LINKS.map((item) => (
                  <a href={item.url} target="_blank" class="text-muted-foreground hover:text-primary transition-colors" aria-label={item.name}>
                    <span class={`${item.icon} size-5`}></span>
                  </a>
                ))}
            </div>
          </div>
        </div>

        <!-- 右侧：信息面板 -->
        <div class="lg:col-span-5 flex flex-col gap-6">
          <!-- 简介 -->
          <div class="border-l-2 border-primary/40 pl-5">
            <p class="text-base text-muted-foreground leading-relaxed">
              你好，我是 Refac7。一名试图在代码的混沌中寻找秩序的时空修剪者。
              <span class="block mt-2 text-xs font-mono text-muted-foreground/60">
                > TARGET: Transparency, Clarity, Reality.
              </span>
            </p>
          </div>

          <!-- 功能导航 -->
          <div class="grid grid-cols-2 gap-px bg-border/50 border border-border/50 mt-2 backdrop-blur-sm">
            {[
              { label: 'Function_01', title: 'READ_LOGS', href: '/posts', icon: 'icon-[ph--read-cv-logo]' },
              { label: 'Function_02', title: 'THE_LINKS', href: '/friends', icon: 'icon-[ph--planet]' }
            ].map(btn => (
              <a href={btn.href} class="group bg-background/50 hover:bg-primary/5 p-4 flex flex-col gap-1 transition-colors duration-300">
                <div class="flex justify-between items-start">
                  <span class="text-[9px] uppercase tracking-widest text-muted-foreground/70 font-mono group-hover:text-primary">{btn.label}</span>
                  <span class={`${btn.icon} size-4 text-muted-foreground group-hover:text-primary transition-colors`}></span>
                </div>
                <span class="text-lg font-mono font-bold text-foreground mt-1 group-hover:translate-x-1 transition-transform">
                  {btn.title}
                </span>
              </a>
            ))}
          </div>

        </div>
      </div>

      <!-- 装饰分割线 -->
      <div class="flex items-end gap-4 mt-12 select-none opacity-60">
         <span class="font-mono text-4xl font-bold text-muted-foreground/10 leading-none -mb-1">00</span>
         <span class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-muted-foreground/50 mb-1">Start_Sequence</span>
         <div class="h-px bg-gradient-to-r from-border to-transparent flex-1 mb-1.5"></div>
      </div>
    </div>

    <!-- Github 贡献图 -->
    {ENABLED && (
      <div class={`${LAYOUT_CONTAINER} mb-8`}>
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 border-l-2 border-primary/40 pl-4">
          <h2 class="font-normal text-3xl md:text-4xl tracking-tighter text-foreground">Activity_Graph</h2>
          <p class="text-[10px] text-muted-foreground font-mono uppercase tracking-widest mb-1.5">// Commit History Visualization</p>
        </div>
        
        <GithubContributions
          username={GITHUB_USERNAME}
          tooltipEnabled={TOOLTIP_ENABLED}
          client:visible
          transition:animate="none"
        />
        
        <div class="mt-4 flex justify-between text-[10px] font-mono text-muted-foreground/40 pt-2 border-t border-dashed border-primary/20"></div>
      </div>
    )}

    <SectionDivider />

    {SKILLS_ENABLED && SKILLS_DATA.length > 0 && (
      <div class={`${LAYOUT_CONTAINER} py-8`}>
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 border-l-2 border-primary/40 pl-4">
            <h2 class="font-normal text-3xl md:text-4xl tracking-tighter text-foreground">Arsenal</h2>
            <p class="text-[10px] text-muted-foreground font-mono uppercase tracking-widest mb-1.5">// Tools & Frameworks</p>
        </div>
        <SkillsShowcase skillsData={SKILLS_DATA} />
      </div>
    )}

    <SectionDivider />

    <div class={`${LAYOUT_CONTAINER} py-12`}>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 mb-12 border-l-2 border-primary/40 pl-4">
          <div>
              <h2 class="font-normal text-3xl md:text-4xl tracking-tighter text-foreground">Recent Logs</h2>
              <p class="mt-1 text-[10px] text-muted-foreground font-mono tracking-widest">:: Latest Data Transmissions</p>
          </div>

          <a href="/posts" class="group flex items-center gap-3 px-6 py-3 border border-border bg-background hover:border-primary/50 hover:bg-primary/5 transition-all duration-300">
             <span class="text-xs font-bold font-mono uppercase tracking-widest group-hover:text-primary transition-colors">View_All_Archives</span>
             <span class="icon-[ph--caret-right-bold] w-3 h-3 text-muted-foreground group-hover:text-primary group-hover:translate-x-1 transition-transform"></span>
          </a>
      </div>
      
      <div class="relative">
          <List {posts} {type} heroImageLayout={heroImageLayout} />
      </div>
    </div>
  </div>
</Layout>

<!-- 控制 Snowfall 的脚本 -->
<script is:inline>
  function initSnowToggle() {
    // 1. 获取关键元素
    const oldBtn = document.getElementById('snow-toggle');
    const snowContainer = document.getElementById('snowfall-container');

    if (!oldBtn || !snowContainer) return;

    // 2. 克隆按钮 (这是为了清除之前可能存在的旧事件监听器，防止重复点击)
    const newBtn = oldBtn.cloneNode(true);
    oldBtn.parentNode.replaceChild(newBtn, oldBtn);

    // 3. 【关键修正】从“新按钮”中重新获取 statusSpan
    // 之前的问题出在这里：旧变量指向了被删掉的 DOM 节点
    const statusSpan = newBtn.querySelector('#snow-status');

    // 4. 读取本地存储状态 (默认为 'true' 开启)
    const storedState = localStorage.getItem('snowfall_enabled');
    // 如果没有存过，默认是 true；否则按存储的值
    const isEnabled = storedState === null ? true : storedState === 'true';

    // 5. 定义更新 UI 的函数
    const updateUI = (active) => {
      if (active) {
        snowContainer.style.opacity = '1';
        statusSpan.innerText = 'ON';
        // 移除灰度样式，恢复高亮或默认色
        statusSpan.classList.remove('text-muted-foreground/50');
      } else {
        snowContainer.style.opacity = '0';
        statusSpan.innerText = 'OFF';
        // 添加灰度样式，让 OFF 看起来暗一点
        statusSpan.classList.add('text-muted-foreground/50');
      }
    };

    // 初始化：根据状态设置一次 UI
    updateUI(isEnabled);

    // 6. 绑定点击事件
    newBtn.addEventListener('click', (e) => {
      e.preventDefault();
      
      // 判断当前是不是 ON
      const isCurrentlyOn = statusSpan.innerText === 'ON';
      const newState = !isCurrentlyOn; // 取反
      
      console.log(`切换状态: ${isCurrentlyOn ? 'ON' : 'OFF'} -> ${newState ? 'ON' : 'OFF'}`);

      updateUI(newState);
      localStorage.setItem('snowfall_enabled', String(newState));
    });
  }

  // 确保 DOM 加载完成后运行
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSnowToggle);
  } else {
    initSnowToggle();
  }

  // 兼容 Astro 的 View Transitions 页面切换
  document.addEventListener('astro:page-load', initSnowToggle);
</script>