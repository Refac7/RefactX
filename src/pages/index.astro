---
import { getCollection } from 'astro:content'
import { SITE, SKILLSSHOWCASE_CONFIG, SOCIAL_LINKS, GITHUB_CONFIG, POSTS_CONFIG } from '~/config.ts'
import { cn, postsSort } from '~/lib/utils'

import Layout from '~/layouts/Layout.astro'
import PageAside from '~/components/base/PageAside.astro'
import GithubContributions from '~/components/base/GithubContributions.tsx'
import List from '~/components/posts/card/List.astro'
import SkillsShowcase from '~/components/base/SkillsShowcase.astro'

const { ENABLED, GITHUB_USERNAME, TOOLTIP_ENABLED } = GITHUB_CONFIG
const { size, type, heroImageLayout } = POSTS_CONFIG.homePageConfig
const { SKILLS_ENABLED, SKILLS_DATA } = SKILLSSHOWCASE_CONFIG
const allPosts = await getCollection('posts')
const posts = postsSort(allPosts).slice(0, size)

const NAV_CARDS = [
  { id: '01', title: '文章 Logs', desc: '技术归档小仓库', href: '/posts', icon: 'icon-[ph--read-cv-logo]', status: '🟢 活跃中' },
  { id: '02', title: '友链 Links', desc: '信号小宇宙', href: '/friends', icon: 'icon-[ph--planet]', status: '🔗 已连接' },
  { id: '03', title: '项目 Projects', desc: '已部署的小模块', href: '/projects', icon: 'icon-[ph--stack]', status: '🟢 稳定' },
  { id: '04', title: '标签 Tags', desc: '内容小索引', href: '/tags', icon: 'icon-[ph--tag]', status: '✅ 已验证' },
]
---

<Layout title="Overview" description={SITE.description}>
  <div class="relative font-sans flex flex-col lg:flex-row min-h-screen max-w-[1920px] mx-auto">
    <PageAside
      statusText="建设中 · 摸鱼中 🐾"
      statusHasPing
      statusVariant="emerald"
      title="Overview"
      subtitleIcon="icon-[ph--house]"
      subtitleText="Overview"
      identityTags={[
        { icon: 'icon-[ph--code]', label: 'Developer' },
        { icon: 'icon-[ph--pen-nib]', label: 'Creator' },
      ]}
      intro="欢迎光临喵～ (・ω・)ノ
基于 Astro v6 构建，记录技术、分享生活。"
      statsLabel="// 连接入口"
      statsMeta={`${SOCIAL_LINKS.length} 个活跃`}
      stats={[]}
    >
      <div slot="bottom" class="grid grid-cols-1 gap-px bg-primary/15">
        {
          SOCIAL_LINKS.map((item) => (
            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center gap-4 h-14 px-6 lg:px-8 xl:px-12 bg-background hover:bg-accent transition-all duration-300 text-left rounded-none"
            >
              <span
                class={`${item.icon} size-5 shrink-0 text-muted-foreground group-hover:text-primary group-hover:scale-125 transition-all`}
              />
              <span class="text-[10px] font-semibold text-muted-foreground group-hover:text-primary tracking-wider transition-colors">
                {item.name || 'Link'}
              </span>
            </a>
          ))
        }
      </div>
    </PageAside>
    <main class="w-full lg:w-2/3 z-10 flex flex-col">
      <div class="px-6 lg:px-8 xl:px-12 lg:py-20 flex-1 flex flex-col gap-20 xl:gap-24 mt-4 lg:mt-0">
        <div>
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 border-b border-primary/20 pb-4">
            <div class="flex items-center gap-3">
              <span class="inline-flex items-center justify-center size-7 rounded-full bg-primary text-primary-foreground font-bold"
                >01</span
              ><h2 class="text-xl md:text-2xl font-bold text-foreground tracking-tight">Navigation</h2>
            </div>
            <span class="text-[10px] font-medium text-primary/60 tracking-widest hidden sm:inline-block">// 快乐入口</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
            {
              NAV_CARDS.map((card, i) => (
                <a
                  href={card.href}
                  class="group relative flex flex-col justify-between border border-primary/15 bg-background/60 p-6 rounded-3xl   hover:border-primary/40 hover:-translate-y-1 transition-all duration-300"
                  style={`animation-delay: ${i * 50}ms`}
                >
                  <>
                    <div class="absolute right-4 top-4 flex items-center gap-1.5 opacity-70 group-hover:opacity-100 transition-opacity">
                      <>
                        <span class="relative flex size-1.5">
                          {card.status === '🟢 活跃中' && (
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75" />
                          )}
                          <span
                            class={`relative inline-flex rounded-full size-1.5 ${card.status === '🟢 活跃中' ? 'bg-emerald-500' : 'bg-primary/50'}`}
                          />
                        </span>
                        <span class="text-[10px] font-semibold tracking-wider text-muted-foreground group-hover:text-foreground transition-colors">
                          {card.status}
                        </span>
                      </>
                    </div>
                    <div class="size-12 flex items-center justify-center bg-accent/70 border border-primary/20 rounded-2xl group-hover:bg-accent group-hover:scale-110 group-hover:rotate-3 transition-all duration-300 mb-8">
                      <span class={cn('size-6 text-primary group-hover:text-primary transition-colors', card.icon)} />
                    </div>
                    <div>
                      <>
                        <div class="flex items-center justify-between mb-1">
                          <>
                            <h3 class="text-base font-bold text-foreground tracking-tight">{card.title}</h3>
                            <span class="icon-[ph--arrow-up-right] size-4 text-muted-foreground/30 group-hover:text-primary transition-all group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
                          </>
                        </div>
                        <p class="text-sm text-muted-foreground leading-relaxed line-clamp-1">{card.desc}</p>
                      </>
                    </div>
                  </>
                </a>
              ))
            }
          </div>
        </div>
        <div class="fade-up" style="animation-delay: 200ms">
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 border-b border-primary/20 pb-4">
            <div class="flex items-center gap-3">
              <span class="inline-flex items-center justify-center size-7 rounded-full bg-primary text-primary-foreground font-bold"
                >02</span
              ><h2 class="text-xl md:text-2xl font-bold text-foreground tracking-tight">Recent Logs</h2>
            </div><a
              href="/posts"
              class="group hidden lg:flex items-center gap-1.5 text-xs font-semibold text-muted-foreground hover:text-primary transition-colors"
              ><span class="tracking-wider">查看全部 →</span><span
                class="icon-[ph--arrow-right] group-hover:translate-x-1 transition-transform"></span></a
            >
          </div>
          <div><List {posts} {type} {heroImageLayout} /></div>
        </div>
        {
          ENABLED && (
            <div class="fade-up" style="animation-delay: 300ms">
              <>
                <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 border-b border-primary/20 pb-4">
                  <>
                    <div class="flex items-center gap-3">
                      <>
                        <span class="inline-flex items-center justify-center size-7 rounded-full bg-primary text-primary-foreground font-bold  ">
                          03
                        </span>
                        <h2 class="text-xl md:text-2xl font-bold text-foreground tracking-tight">Activity</h2>
                      </>
                    </div>
                    <span class="text-[10px] font-medium text-primary/60 tracking-widest hidden sm:inline-block">// GitHub 足迹</span>
                  </>
                </div>
                <div class="p-6 sm:p-8 border border-primary/15 bg-background/60 rounded-3xl  ">
                  <GithubContributions
                    username={GITHUB_USERNAME}
                    tooltipEnabled={TOOLTIP_ENABLED}
                    client:visible
                    transition:animate="none"
                  />
                </div>
              </>
            </div>
          )
        }
        {
          SKILLS_ENABLED && SKILLS_DATA.length > 0 && (
            <div class="fade-up" style="animation-delay: 400ms">
              <>
                <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 border-b border-primary/20 pb-4">
                  <>
                    <div class="flex items-center gap-3">
                      <>
                        <span class="inline-flex items-center justify-center size-7 rounded-full bg-primary text-primary-foreground font-bold  ">
                          04
                        </span>
                        <h2 class="text-xl md:text-2xl font-bold text-foreground tracking-tight">Tech Stack</h2>
                      </>
                    </div>
                    <span class="text-[10px] font-medium text-primary/60 tracking-widest hidden sm:inline-block">// 技能清单</span>
                  </>
                </div>
                <div class="[&_.skill-card]:border-primary/15 [&_.skill-card]:bg-background/60 hover:[&_.skill-card]:bg-accent hover:[&_.skill-card]:border-primary/30 [&_.skill-card] [&_.skill-card]:transition-all duration-300">
                  <SkillsShowcase skillsData={SKILLS_DATA} />
                </div>
              </>
            </div>
          )
        }
      </div>
    </main>
  </div>
</Layout>
