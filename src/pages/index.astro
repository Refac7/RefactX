---
import { getCollection } from 'astro:content'
import { SITE, SKILLSSHOWCASE_CONFIG, SOCIAL_LINKS, GITHUB_CONFIG, POSTS_CONFIG, BUILD_INFO_CONFIG } from '~/config.ts'
import { cn, postsSort } from '~/lib/utils'

import Layout from '~/layouts/Layout.astro'
import PageAside from '~/components/base/PageAside.astro'
import GithubContributions from '~/components/base/GithubContributions.tsx'
import List from '~/components/posts/card/List.astro'
import SkillsShowcase from '~/components/base/SkillsShowcase.astro'
import BuildInfo from '~/components/base/BuildInfo.astro'

const { ENABLED, GITHUB_USERNAME, TOOLTIP_ENABLED } = GITHUB_CONFIG
const { size, type, heroImageLayout } = POSTS_CONFIG.homePageConfig
const { SKILLS_ENABLED, SKILLS_DATA } = SKILLSSHOWCASE_CONFIG
const { ENABLED: BUILD_INFO_ENABLED, COMPONENTS: BUILD_COMPONENTS } = BUILD_INFO_CONFIG
const allPosts = await getCollection('posts')
const posts = postsSort(allPosts).slice(0, size)

const NAV_CARDS = [
  { id: '01', title: 'Logs', desc: 'Technical archives', href: '/posts', icon: 'icon-[ph--read-cv-logo]', status: 'Active' },
  { id: '02', title: 'Links', desc: 'Signal network', href: '/friends', icon: 'icon-[ph--planet]', status: 'Connected' },
  { id: '03', title: 'Projects', desc: 'Deployed modules', href: '/projects', icon: 'icon-[ph--stack]', status: 'Stable' },
  { id: '04', title: 'Tags', desc: 'Core filters', href: '/tags', icon: 'icon-[ph--tag]', status: 'Verified' },
]
---

<Layout title="Overview" description={SITE.description}>
  <div class="relative font-sans flex flex-col lg:flex-row min-h-screen max-w-[1920px] mx-auto">
    <PageAside
      statusText="Building & Exploring"
      statusHasPing
      statusVariant="primary"
      title="Overview"
      subtitleIcon="icon-[ph--house]"
      subtitleText="Home Overview"
      identityTags={[
        { icon: 'icon-[ph--code]', label: 'Developer' },
        { icon: 'icon-[ph--pen-nib]', label: 'Creator' },
      ]}
      intro="欢迎光临喵～ (・ω・)ノ
基于 Astro v6 构建，记录技术、分享生活。"
      statsLabel="// CONNECT PORTALS"
      statsMeta={`${SOCIAL_LINKS.length} ACTIVE`}
      stats={[]}
    >
      <div slot="bottom" class="grid grid-cols-1 gap-px bg-border/40">
        {
          SOCIAL_LINKS.map((item) => (
            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center gap-4 h-14 px-6 lg:px-8 xl:px-12 rounded-none bg-background hover:bg-primary/5 transition-all duration-300 text-left"
            >
              <span class={`${item.icon} size-5 shrink-0 text-muted-foreground group-hover:text-primary transition-colors`} />
              <span class="text-[10px] font-mono font-medium text-muted-foreground group-hover:text-primary uppercase tracking-wider transition-colors">
                {item.name || 'Link'}
              </span>
            </a>
          ))
        }
      </div>

      <div slot="mobile" class="p-6">
        <div class="flex items-center justify-between font-mono text-[10px] uppercase tracking-widest text-muted-foreground/70">
          <span>// Connect Portals</span>
          <span>{SOCIAL_LINKS.length} Active</span>
        </div>
        <div class="mt-4 grid grid-cols-2 gap-3">
          {
            SOCIAL_LINKS.map((item) => (
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center gap-2.5 border border-border/40 bg-background/50 px-4 py-3 transition-all duration-300 hover:border-primary/30 hover:bg-primary/5"
              >
                <span class={`${item.icon} size-5 shrink-0 text-muted-foreground transition-colors group-hover:text-primary`} />
                <span class="truncate text-xs font-medium tracking-tight text-foreground">{item.name}</span>
                <span class="icon-[ph--arrow-up-right] ml-auto size-3.5 shrink-0 text-muted-foreground/30 transition-all group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-primary" />
              </a>
            ))
          }
        </div>
      </div>
    </PageAside>
    <main class="w-full lg:w-2/3 z-10 flex flex-col">
      <div class="px-6 lg:px-8 xl:px-12 lg:py-20 flex-1 flex flex-col gap-20 xl:gap-24 mt-4 lg:mt-0">
        <div>
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 border-b border-border/40 pb-4">
            <div class="flex items-center gap-3">
              <span class="inline-flex items-center justify-center rounded-md size-7 bg-primary/10 text-primary font-mono text-xs font-bold"
                >01</span
              ><h2 class="text-xl md:text-2xl font-bold text-foreground tracking-tight">Navigation</h2>
            </div>
            <span class="text-[10px] font-mono text-muted-foreground/50 uppercase tracking-widest hidden sm:inline-block"
              >// System_Modules</span
            >
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
            {
              NAV_CARDS.map((card) => (
                <>
                  {/* Mobile · original card design */}
                  <a
                    href={card.href}
                    class="group relative flex sm:hidden flex-col justify-between border border-border/40 bg-background/50 p-6 transition-all duration-300 hover:bg-muted/20 hover:border-primary/30 hover:shadow-sm"
                  >
                    <div class="absolute right-4 top-4 flex items-center gap-1.5 opacity-60 transition-opacity group-hover:opacity-100">
                      <span class="relative flex size-1.5">
                        {card.status === 'Active' && (
                          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-success/70 opacity-75" />
                        )}
                        <span
                          class={`relative inline-flex rounded-full size-1.5 ${card.status === 'Active' ? 'bg-success' : 'bg-primary/50'}`}
                        />
                      </span>
                      <span class="text-[10px] font-mono uppercase tracking-wider text-muted-foreground transition-colors group-hover:text-foreground">
                        {card.status}
                      </span>
                    </div>
                    <div class="mb-8 flex size-12 items-center justify-center border border-primary/10 bg-primary/5 transition-all duration-300 group-hover:scale-110 group-hover:bg-primary/10">
                      <span class={cn('size-6 text-primary/80 transition-colors group-hover:text-primary', card.icon)} />
                    </div>
                    <div>
                      <div class="mb-1 flex items-center justify-between">
                        <h3 class="text-base font-semibold tracking-tight text-foreground">{card.title}</h3>
                        <span class="icon-[ph--arrow-up-right] size-4 text-muted-foreground/30 transition-all group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-primary" />
                      </div>
                      <p class="line-clamp-1 text-sm leading-relaxed text-muted-foreground">{card.desc}</p>
                    </div>
                  </a>

                  {/* Desktop · redesigned card, original subtle hover */}
                  <a
                    href={card.href}
                    class="group relative hidden min-h-[200px] flex-col overflow-hidden rounded-xl border border-border/40 bg-background/50 p-6 transition-all duration-300 hover:border-primary/30 hover:bg-muted/20 hover:shadow-sm sm:flex"
                  >
                    {/* Ghost index watermark */}
                    <span
                      aria-hidden="true"
                      class="pointer-events-none absolute -bottom-8 -right-2 select-none text-[8rem] font-black leading-none tracking-tighter text-foreground/[0.04]"
                    >
                      {card.id}
                    </span>

                    {/* Top meta row */}
                    <div class="relative z-10 flex items-center justify-between">
                      <span class="font-mono text-[10px] tracking-widest text-muted-foreground/60">/{card.id}</span>
                      <span class="inline-flex items-center gap-1.5">
                        <span class="relative flex size-1.5">
                          {card.status === 'Active' && (
                            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-success/70 opacity-75" />
                          )}
                          <span
                            class={`relative inline-flex size-1.5 rounded-full ${card.status === 'Active' ? 'bg-success' : 'bg-primary/50'}`}
                          />
                        </span>
                        <span class="font-mono text-[10px] uppercase tracking-widest text-muted-foreground/70">{card.status}</span>
                      </span>
                    </div>

                    <div class="flex-1" />

                    {/* Icon plate */}
                    <div class="relative z-10 mb-6 flex size-12 items-center justify-center rounded-lg border border-primary/15 bg-primary/[0.06] transition-all duration-300 group-hover:scale-110 group-hover:bg-primary/10">
                      <span class={cn('size-6 text-primary/80 transition-colors group-hover:text-primary', card.icon)} />
                    </div>

                    {/* Title + description */}
                    <div class="relative z-10">
                      <div class="flex items-center justify-between gap-3">
                        <h3 class="text-lg font-semibold tracking-tight text-foreground">{card.title}</h3>
                        <span class="icon-[ph--arrow-up-right] size-4 text-muted-foreground/30 transition-all group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-primary" />
                      </div>
                      <p class="mt-1.5 font-mono text-[11px] uppercase tracking-wider text-muted-foreground/60">{card.desc}</p>
                    </div>
                  </a>
                </>
              ))
            }
          </div>
        </div>
        <div class="fade-up" style="animation-delay: 200ms">
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 border-b border-border/40 pb-4">
            <div class="flex items-center gap-3">
              <span class="inline-flex items-center justify-center rounded-md size-7 bg-primary/10 text-primary font-mono text-xs font-bold"
                >02</span
              ><h2 class="text-xl md:text-2xl font-bold text-foreground tracking-tight">Recent Logs</h2>
            </div><a
              href="/posts"
              class="group hidden lg:flex items-center gap-1.5 text-xs font-mono font-medium text-muted-foreground hover:text-primary transition-colors"
              ><span class="uppercase tracking-wider">View_All</span><span
                class="icon-[ph--arrow-right] group-hover:translate-x-1 transition-transform"></span></a
            >
          </div>
          <div><List {posts} {type} {heroImageLayout} /></div>
        </div>
        {
          ENABLED && (
            <div class="fade-up" style="animation-delay: 300ms">
              <>
                <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 border-b border-border/40 pb-4">
                  <>
                    <div class="flex items-center gap-3">
                      <>
                        <span class="inline-flex items-center justify-center rounded-md size-7 bg-primary/10 text-primary font-mono text-xs font-bold">
                          03
                        </span>
                        <h2 class="text-xl md:text-2xl font-bold text-foreground tracking-tight">Activity</h2>
                      </>
                    </div>
                    <span class="text-[10px] font-mono text-muted-foreground/50 uppercase tracking-widest hidden sm:inline-block">
                      // GitHub_Trace
                    </span>
                  </>
                </div>
                <div class="p-6 sm:p-8 border border-border/40 bg-background/50 hover:bg-muted/10 transition-colors">
                  <GithubContributions
                    username={GITHUB_USERNAME}
                    tooltipEnabled={TOOLTIP_ENABLED}
                    client:visible
                    transition:animate="none"
                  />
                </div>
              </>
            </div>
          )
        }
        {
          SKILLS_ENABLED && SKILLS_DATA.length > 0 && (
            <div class="fade-up" style="animation-delay: 400ms">
              <>
                <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 border-b border-border/40 pb-4">
                  <>
                    <div class="flex items-center gap-3">
                      <>
                        <span class="inline-flex items-center justify-center rounded-md size-7 bg-primary/10 text-primary font-mono text-xs font-bold">
                          04
                        </span>
                        <h2 class="text-xl md:text-2xl font-bold text-foreground tracking-tight">Tech Stack</h2>
                      </>
                    </div>
                    <span class="text-[10px] font-mono text-muted-foreground/50 uppercase tracking-widest hidden sm:inline-block">
                      // Skill_Radar
                    </span>
                  </>
                </div>
                <div class="[&_.skill-card]:border-border/40 [&_.skill-card]:bg-background/50 hover:[&_.skill-card]:bg-primary/5 hover:[&_.skill-card]:border-primary/20 [&_.skill-card]:shadow-sm [&_.skill-card]:transition-all duration-300">
                  <SkillsShowcase skillsData={SKILLS_DATA} />
                </div>
              </>
            </div>
          )
        }
        {
          BUILD_INFO_ENABLED && BUILD_COMPONENTS.length > 0 && (
            <div class="fade-up" style="animation-delay: 500ms">
              <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 border-b border-border/40 pb-4">
                <div class="flex items-center gap-3">
                  <span class="inline-flex items-center justify-center rounded-md size-7 bg-primary/10 text-primary font-mono text-xs font-bold">
                    05
                  </span>
                  <h2 class="text-xl md:text-2xl font-bold text-foreground tracking-tight">Build Info</h2>
                </div>
                <span class="text-[10px] font-mono text-muted-foreground/50 uppercase tracking-widest hidden sm:inline-block">
                  // Component_Manifest
                </span>
              </div>
              <BuildInfo components={BUILD_COMPONENTS} />
            </div>
          )
        }
      </div>
    </main>
  </div>
</Layout>
