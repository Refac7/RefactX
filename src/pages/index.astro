---
import { getCollection } from 'astro:content'
import { 
  SITE, 
  SKILLSSHOWCASE_CONFIG, 
  SOCIAL_LINKS, 
  GITHUB_CONFIG, 
  POSTS_CONFIG 
} from '~/config.ts'
import { cn, postsSort } from '~/lib/utils'
import Layout from '~/layouts/Layout.astro'
import GithubContributions from '~/components/base/GithubContributions.tsx'
import List from '~/components/posts/card/List.astro'
import SkillsShowcase from '~/components/base/SkillsShowcase.astro'
import Snowfall from '~/components/base/Snowfall.astro'

// 解构配置
const { ENABLED, GITHUB_USERNAME, TOOLTIP_ENABLED } = GITHUB_CONFIG
const { size, type, heroImageLayout } = POSTS_CONFIG.homePageConfig
const { SKILLS_ENABLED, SKILLS_DATA } = SKILLSSHOWCASE_CONFIG

// 数据获取
const allPosts = await getCollection('posts')
const posts = postsSort(allPosts).slice(0, size)

// 导航卡片数据
const NAV_CARDS = [
  { id: '01', title: 'READ_LOGS', desc: 'Technical archives', href: '/posts', icon: 'icon-[ph--read-cv-logo-bold]', status: 'Active' },
  { id: '02', title: 'FRIEND_LINKS', desc: 'Signal network', href: '/friends', icon: 'icon-[ph--planet-bold]', status: 'Connected' },
  { id: '03', title: 'PROJECTS', desc: 'Deployed modules', href: '/projects', icon: 'icon-[ph--stack-bold]', status: 'Stable' },
  { id: '04', title: 'TAGS', desc: 'Core filters', href: '/tags', icon: 'icon-[ph--tag-bold]', status: 'Verified' }
]

const SECTION_HEADER_CLASS = "flex items-end justify-between border-b border-border/60 pb-4 mb-8 select-none"
const SECTION_TITLE_CLASS = "font-mono text-sm font-bold uppercase tracking-widest text-foreground/80"
const SECTION_NUM_CLASS = "font-mono text-xs text-primary mr-3"
---

<Layout title="主页" description={SITE.description}>
  
  <div id="snowfall-container" class="fixed inset-0 pointer-events-none z-[1] transition-opacity duration-700 ease-in-out opacity-0">
    <Snowfall />
  </div>

  <div class="relative font-sans">
    
    {/* ================= HERO SECTION ================= */}
    <div class="relative z-10 border-b border-border/60">
      <div class="p-6 sm:p-8 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-0">
        
        {/* Left: Branding */}
        <div class="lg:col-span-8 flex flex-col justify-between min-h-[400px] lg:border-r border-border/60 lg:pr-12">
            
            {/* Top Status Bar */}
            <div class="flex flex-row justify-between items-start text-[10px] font-mono uppercase tracking-widest text-muted-foreground/60 select-none mb-12">
                <span>// REF_CORE_V1.7</span>
                
                <div class="flex items-center gap-6">
                    <button id="snow-toggle" class="group flex items-center gap-2 hover:text-foreground transition-colors cursor-pointer focus:outline-none" aria-label="Toggle Effects">
                        <div class="w-2 h-2 border border-current group-hover:bg-primary transition-colors"></div>
                        <span>FX: <span id="snow-status">ON</span></span>
                    </button>

                    <div class="flex items-center gap-2 text-primary">
                        <span class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-none bg-emerald-500 opacity-75"></span>
                        <span class="relative inline-flex rounded-none h-2 w-2 bg-emerald-600"></span>
                        </span>
                        <span>SYS: ONLINE</span>
                    </div>
                </div>
            </div>

            {/* Main Title */}
            <div>
                <h1 class="text-7xl sm:text-9xl font-black tracking-tighter text-foreground leading-[0.8] mb-6 -ml-1 select-none">
                    REFAC<span class="text-transparent bg-clip-text bg-gradient-to-br from-primary to-foreground/50">7</span><span class="text-primary">.</span>
                </h1>
                <p class="text-xl sm:text-2xl text-muted-foreground font-light max-w-2xl leading-relaxed">
                    Architect of the <span class="text-foreground font-medium">Digital Void</span>. <br/>
                    Trying to find order in the chaos of code.
                </p>
            </div>
        </div>

        {/* Right: Social Grid & Info (Imitating Footer Grid) */}
        <div class="lg:col-span-4 flex flex-col border-l-2 lg:border-l-0 border-l-foreground border-foreground">
           {/* Intro Box */}
           <div class="flex-1 p-6 sm:p-8 bg-muted/5 border-b border-border/60 lg:border-b xl:border-dashed">
              <span class="block text-[10px] uppercase text-muted-foreground/60 font-mono tracking-wider mb-4">// BIO_SUMMARY</span>
              <p class="text-sm text-muted-foreground leading-loose font-mono">
                你好，我是 Refac7。一名时空修剪者。<br/>
                此站点是我的数字世界，用于存档技术日志、交换信号与部署模块。
                <br/><br/>
                <span class="text-primary">> Protocol initialized...</span>
              </p>
           </div>

           {/* Social Grid - Rigid Box Style */}
           <div class="grid grid-cols-2 bg-border/60 gap-px border-t border-border/60 lg:border-t-0">
              {SOCIAL_LINKS.map((item) => (
                <a href={item.url} target="_blank" class="group relative flex flex-col items-center justify-center p-6 bg-background hover:bg-muted/10 transition-colors h-32">
                    <span class={`${item.icon} size-6 text-foreground/70 group-hover:text-primary transition-colors mb-3`}></span>
                    <span class="text-[10px] font-mono uppercase tracking-widest text-muted-foreground group-hover:text-foreground">
                        {item.name || 'LINK'}
                    </span>
                    {/* Corner Accent */}
                    <div class="absolute top-0 right-0 p-1 opacity-0 group-hover:opacity-100 transition-opacity">
                        <div class="w-1.5 h-1.5 bg-primary"></div>
                    </div>
                </a>
              ))}
           </div>
        </div>

      </div>
    </div>

    <div class="p-6 sm:p-8">
        
        {/* ================= NAVIGATION GRID ================= */}
        <div class="mb-20">
            <div class={SECTION_HEADER_CLASS}>
               <div class="flex items-center">
                   <span class={SECTION_NUM_CLASS}>01</span>
                   <h2 class={SECTION_TITLE_CLASS}>Navigation Hub</h2>
               </div>
               <div class="hidden sm:block h-px flex-1 bg-border/40 ml-6 max-w-[100px]"></div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                {NAV_CARDS.map((card) => (
                    <a href={card.href} class="group relative flex flex-col justify-between bg-background border border-border/60 hover:border-primary/50 transition-all duration-300 min-h-[200px]">
                        
                        {/* Background Number */}
                        <span class="absolute right-4 top-2 text-6xl font-black text-muted-foreground/[0.03] group-hover:text-primary/[0.04] transition-colors pointer-events-none font-mono select-none">
                            {card.id}
                        </span>
                        
                        <div class="p-5 relative z-10">
                            <div class="flex justify-between items-start mb-4">
                                <span class={cn('size-6 text-foreground/80 group-hover:text-primary transition-colors', card.icon)}></span>
                                <span class="icon-[ph--arrow-up-right] size-4 text-muted-foreground/40 group-hover:text-primary transition-colors"></span>
                            </div>
                            <h3 class="text-lg font-bold text-foreground mb-1 group-hover:text-primary transition-colors font-mono tracking-tighter">
                                {card.title}
                            </h3>
                            <p class="text-xs text-muted-foreground/70 leading-relaxed font-sans">
                                {card.desc}
                            </p>
                        </div>

                        {/* Footer of Card */}
                        <div class="mt-auto border-t border-dashed border-border/40 p-3 bg-muted/[0.02]">
                            <div class="flex items-center justify-between text-[9px] font-mono uppercase tracking-wider text-muted-foreground/60">
                                <span>STATUS:</span>
                                <span class="text-primary/80">{card.status}</span>
                            </div>
                        </div>

                        {/* Corner Accent (Top Right) */}
                        <div class="absolute top-0 right-0 w-2 h-2 border-t border-r border-primary/0 group-hover:border-primary/50 transition-colors"></div>
                        {/* Corner Accent (Bottom Left) */}
                        <div class="absolute bottom-0 left-0 w-2 h-2 border-b border-l border-primary/0 group-hover:border-primary/50 transition-colors"></div>
                    </a>
                ))}
            </div>
        </div>

        {/* ================= GITHUB ================= */}
        {ENABLED && (
          <div class="mb-20">
             <div class={SECTION_HEADER_CLASS}>
               <div class="flex items-center">
                   <span class={SECTION_NUM_CLASS}>02</span>
                   <h2 class={SECTION_TITLE_CLASS}>Activity Stream</h2>
               </div>
            </div>
            
            <GithubContributions
            username={GITHUB_USERNAME}
            tooltipEnabled={TOOLTIP_ENABLED}
            client:visible
            transition:animate="none"
            />
            <div class="mt-4 flex justify-between text-[10px] font-mono text-muted-foreground/40 pt-2 border-t border-dashed border-primary/20"></div>
          </div>
        )}

        {/* ================= SKILLS ================= */}
        {SKILLS_ENABLED && SKILLS_DATA.length > 0 && (
          <div class="mb-20">
             <div class={SECTION_HEADER_CLASS}>
               <div class="flex items-center">
                   <span class={SECTION_NUM_CLASS}>03</span>
                   <h2 class={SECTION_TITLE_CLASS}>Arsenal Matrix</h2>
               </div>
            </div>
            {/* 强制覆盖 Skill 组件的圆角，使其变方 */}
            <div class="[&_.skill-card]:rounded-none [&_.skill-card]:border-border/60 [&_.skill-card]:shadow-none hover:[&_.skill-card]:border-primary/40">
                <SkillsShowcase skillsData={SKILLS_DATA} />
            </div>
          </div>
        )}

        {/* ================= POSTS ================= */}
        <div class="mb-8">
            <div class={SECTION_HEADER_CLASS}>
               <div class="flex items-center">
                   <span class={SECTION_NUM_CLASS}>04</span>
                   <h2 class={SECTION_TITLE_CLASS}>Transmissions</h2>
               </div>
               <a href="/posts" class="hidden sm:flex items-center gap-2 text-[10px] font-mono uppercase tracking-widest text-muted-foreground hover:text-primary transition-colors">
                  <span>View All Logs</span>
                  <span class="icon-[ph--arrow-right]"></span>
               </a>
            </div>

            <List {posts} {type} heroImageLayout={heroImageLayout} />
            
            <div class="mt-8 flex sm:hidden justify-center">
                 <a href="/posts" class="flex items-center gap-2 px-6 py-3 border border-border text-xs font-mono uppercase hover:bg-muted/10 transition-colors w-full justify-center">
                  <span>View All Logs</span>
               </a>
            </div>
        </div>

    </div>
  </div>
</Layout>

<script is:inline>
  function initSnowToggle() {
    const oldBtn = document.getElementById('snow-toggle');
    const snowContainer = document.getElementById('snowfall-container');
    const statusSpan = document.getElementById('snow-status');

    if (!oldBtn || !snowContainer || !statusSpan) return;

    const newBtn = oldBtn.cloneNode(true);
    oldBtn.parentNode.replaceChild(newBtn, oldBtn);
    const newStatusSpan = newBtn.querySelector('#snow-status');

    const storedState = localStorage.getItem('snowfall_enabled');
    const isEnabled = storedState === 'true';

    const updateUI = (active) => {
      if (active) {
        snowContainer.style.opacity = '1';
        newStatusSpan.innerText = 'ON';
        newStatusSpan.classList.add('text-primary');
      } else {
        snowContainer.style.opacity = '0';
        newStatusSpan.innerText = 'OFF';
        newStatusSpan.classList.remove('text-primary');
      }
    };

    updateUI(isEnabled);

    newBtn.addEventListener('click', (e) => {
      e.preventDefault();
      const isCurrentlyOn = newStatusSpan.innerText === 'ON';
      const newState = !isCurrentlyOn;
      updateUI(newState);
      localStorage.setItem('snowfall_enabled', String(newState));
    });
  }

  document.addEventListener('astro:page-load', initSnowToggle);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSnowToggle);
  } else {
    initSnowToggle();
  }
</script>