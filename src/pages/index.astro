---
import { getCollection } from 'astro:content'
import { SITE, SKILLSSHOWCASE_CONFIG, GITHUB_CONFIG, POSTS_CONFIG, BUILD_INFO_CONFIG } from '~/config.ts'
import { getWordCount, postsSort } from '~/lib/utils'

import Layout from '~/layouts/Layout.astro'
import PageAside from '~/components/base/PageAside.astro'
import GithubContributions from '~/components/base/GithubContributions.tsx'
import List from '~/components/posts/card/List.astro'
import SkillsShowcase from '~/components/base/SkillsShowcase.astro'
import BuildInfo from '~/components/base/BuildInfo.astro'

const { ENABLED, GITHUB_USERNAME, TOOLTIP_ENABLED } = GITHUB_CONFIG
const { size, type, heroImageLayout } = POSTS_CONFIG.homePageConfig
const { SKILLS_ENABLED, SKILLS_DATA } = SKILLSSHOWCASE_CONFIG
const { ENABLED: BUILD_INFO_ENABLED, COMPONENTS: BUILD_COMPONENTS } = BUILD_INFO_CONFIG
const allPosts = await getCollection('posts')
const posts = postsSort(allPosts).slice(0, size)
const totalWords = allPosts.reduce((sum, post) => sum + getWordCount(post.body || ''), 0)

const NAV_CARDS = [
  {
    id: '01',
    title: 'Logs',
    desc: 'Technical archives',
    href: '/posts',
    icon: 'icon-[ph--read-cv-logo]',
    status: 'Active',
    featured: true,
  },
  { id: '02', title: 'Links', desc: 'Signal network', href: '/friends', icon: 'icon-[ph--planet]', status: 'Connected' },
  { id: '03', title: 'Projects', desc: 'Deployed modules', href: '/projects', icon: 'icon-[ph--stack]', status: 'Stable' },
  { id: '04', title: 'Tags', desc: 'Core filters', href: '/tags', icon: 'icon-[ph--tag]', status: 'Verified', wide: true },
]
---

<Layout title="Overview" description={SITE.description}>
  <div class="relative mx-auto flex min-h-screen max-w-[1920px] flex-col font-sans lg:flex-row lg:flex-nowrap">
    <PageAside showSocialLinks />
    <main class="z-10 flex w-full min-w-0 flex-col lg:w-1/2 lg:basis-1/2 lg:shrink-0 lg:grow-0">
      <div class="flex flex-1 flex-col gap-14 px-5 py-10 sm:px-8 lg:gap-16 lg:px-10 lg:py-14 xl:px-12">
        <!-- 01 / Navigation -->
        <section>
          <div class="mb-6 flex flex-col justify-between gap-3 border-b-2 border-foreground pb-3 sm:flex-row sm:items-end">
            <div class="flex items-center">
              <span class="swiss-index mr-3">01</span>
              <h2 class="text-xl font-bold tracking-[-0.04em] text-foreground md:text-2xl">Navigation</h2>
            </div>
            <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-muted-foreground">Index / System_Modules</span>
          </div>

          <div class="grid grid-cols-1 gap-px border border-foreground/25 bg-foreground/25 sm:grid-cols-2 lg:grid-cols-3">
            {
              NAV_CARDS.map((card) => (
                <a
                  href={card.href}
                  class={`group relative flex min-h-[180px] flex-col justify-between bg-background p-5 transition-colors duration-200 hover:bg-foreground hover:text-background ${
                    card.featured ? 'sm:col-span-2 lg:min-h-[230px]' : ''
                  } ${card.wide ? 'sm:col-span-2' : ''}`}
                >
                  <div class="flex items-start justify-between">
                    <span class="flex size-9 items-center justify-center border border-current/25 text-current transition-colors group-hover:border-primary group-hover:text-primary">
                      <span class={`${card.icon} size-5`} />
                    </span>
                    <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-muted-foreground transition-colors group-hover:text-background/50">
                      {card.status}
                    </span>
                  </div>

                  <div class="mt-8">
                    <div class="mb-2 font-mono text-[10px] tracking-[0.18em] text-primary">/{card.id}</div>
                    <div class="flex items-end justify-between gap-3">
                      <h3
                        class={`font-bold leading-none tracking-[-0.05em] text-current ${card.featured ? 'text-3xl lg:text-4xl' : 'text-2xl'}`}
                      >
                        {card.title}
                      </h3>
                      <span class="icon-[ph--arrow-up-right] mb-0.5 size-5 shrink-0 text-current opacity-50 transition-all group-hover:opacity-100" />
                    </div>
                    <p class="mt-3 font-mono text-[10px] uppercase tracking-[0.16em] text-muted-foreground transition-colors group-hover:text-background/55">
                      {card.desc}
                    </p>
                  </div>
                </a>
              ))
            }
          </div>
        </section>

        <!-- 02 / Recent Logs -->
        <section class="fade-up" style="animation-delay: 150ms">
          <div class="mb-6 flex flex-col justify-between gap-3 border-b-2 border-foreground pb-3 sm:flex-row sm:items-end">
            <div class="flex items-center">
              <span class="swiss-index mr-3">02</span>
              <h2 class="text-xl font-bold tracking-[-0.04em] text-foreground md:text-2xl">Recent Logs</h2>
            </div>
            <a
              href="/posts"
              class="group hidden items-center gap-1.5 font-mono text-[10px] uppercase tracking-[0.18em] text-muted-foreground transition-colors hover:text-primary lg:flex"
              >View_All<span class="icon-[ph--arrow-right] transition-transform group-hover:translate-x-1"></span></a
            >
          </div>
          <div><List {posts} {type} {heroImageLayout} /></div>
        </section>

        {
          ENABLED && (
            <section class="fade-up" style="animation-delay: 250ms">
              <div class="mb-6 flex flex-col justify-between gap-3 border-b-2 border-foreground pb-3 sm:flex-row sm:items-end">
                <div class="flex items-center">
                  <span class="swiss-index mr-3">03</span>
                  <h2 class="text-xl font-bold tracking-[-0.04em] text-foreground md:text-2xl">Activity</h2>
                </div>
                <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-muted-foreground">GitHub / Contribution_Trace</span>
              </div>
              <div class="border border-foreground/25">
                <GithubContributions username={GITHUB_USERNAME} tooltipEnabled={TOOLTIP_ENABLED} client:visible transition:animate="none" />
              </div>
            </section>
          )
        }

        {
          SKILLS_ENABLED && SKILLS_DATA.length > 0 && (
            <section class="fade-up" style="animation-delay: 350ms">
              <div class="mb-6 flex flex-col justify-between gap-3 border-b-2 border-foreground pb-3 sm:flex-row sm:items-end">
                <div class="flex items-center">
                  <span class="swiss-index mr-3">04</span>
                  <h2 class="text-xl font-bold tracking-[-0.04em] text-foreground md:text-2xl">Tech Stack</h2>
                </div>
                <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-muted-foreground">Capability / Skill_Radar</span>
              </div>
              <div class="[&_.skill-card]:border-foreground/25 [&_.skill-card]:bg-background">
                <SkillsShowcase skillsData={SKILLS_DATA} />
              </div>
            </section>
          )
        }

        {
          BUILD_INFO_ENABLED && BUILD_COMPONENTS.length > 0 && (
            <section class="fade-up" style="animation-delay: 450ms">
              <div class="mb-6 flex flex-col justify-between gap-3 border-b-2 border-foreground pb-3 sm:flex-row sm:items-end">
                <div class="flex items-center">
                  <span class="swiss-index mr-3">05</span>
                  <h2 class="text-xl font-bold tracking-[-0.04em] text-foreground md:text-2xl">Build Info</h2>
                </div>
                <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-muted-foreground">System / Component_Manifest</span>
              </div>
              <BuildInfo components={BUILD_COMPONENTS} totalWords={totalWords} />
            </section>
          )
        }
      </div>
    </main>
  </div>
</Layout>
