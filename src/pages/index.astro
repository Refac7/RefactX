---
import { getCollection } from 'astro:content'
import { SITE, SKILLSSHOWCASE_CONFIG, GITHUB_CONFIG, POSTS_CONFIG, BUILD_INFO_CONFIG } from '~/config.ts'
import { getWordCount, postsSort } from '~/lib/utils'
import { SECTION_HEADER_CLASS, SECTION_TITLE_CLASS, SECTION_NUM_CLASS, SECTION_META_CLASS } from '~/lib/ui'

import Layout from '~/layouts/Layout.astro'
import PageAside from '~/components/base/PageAside.astro'
import GithubContributions from '~/components/base/GithubContributions.tsx'
import List from '~/components/posts/card/List.astro'
import SkillsShowcase from '~/components/base/SkillsShowcase.astro'
import BuildInfo from '~/components/base/BuildInfo.astro'

const { ENABLED, GITHUB_USERNAME, TOOLTIP_ENABLED } = GITHUB_CONFIG
const { size, type, heroImageLayout } = POSTS_CONFIG.homePageConfig
const { SKILLS_ENABLED, SKILLS_DATA } = SKILLSSHOWCASE_CONFIG
const { ENABLED: BUILD_INFO_ENABLED, COMPONENTS: BUILD_COMPONENTS } = BUILD_INFO_CONFIG
const allPosts = await getCollection('posts')
const posts = postsSort(allPosts).slice(0, size)
const totalWords = allPosts.reduce((sum, post) => sum + getWordCount(post.body || ''), 0)

const NAV_CARDS = [
  {
    id: '01',
    title: 'Logs',
    desc: 'Technical archives',
    href: '/posts',
    icon: 'icon-[ph--read-cv-logo]',
    status: 'Active',
    featured: true,
  },
  { id: '02', title: 'Links', desc: 'Signal network', href: '/friends', icon: 'icon-[ph--planet]', status: 'Connected' },
  { id: '03', title: 'Projects', desc: 'Deployed modules', href: '/projects', icon: 'icon-[ph--stack]', status: 'Stable' },
  { id: '04', title: 'Tags', desc: 'Core filters', href: '/tags', icon: 'icon-[ph--tag]', status: 'Verified', wide: true },
]
---

<Layout title="Overview" description={SITE.description}>
  <div class="relative mx-auto flex min-h-screen max-w-[1920px] flex-col font-sans lg:flex-row lg:flex-nowrap">
    <PageAside showSocialLinks />
    <main class="z-10 flex w-full min-w-0 flex-col lg:w-1/2 lg:basis-1/2 lg:shrink-0 lg:grow-0">
      <div class="flex flex-1 flex-col gap-16 px-5 py-10 sm:px-8 lg:gap-20 lg:px-10 lg:py-14 xl:px-12">
        <!-- 01 / Navigation -->
        <section>
          <div class={SECTION_HEADER_CLASS}>
            <div class="flex items-center">
              <span class={SECTION_NUM_CLASS}>01</span>
              <h2 class={SECTION_TITLE_CLASS}>Navigation</h2>
            </div>
            <span class={SECTION_META_CLASS}>Index / System_Modules</span>
          </div>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {
              NAV_CARDS.map((card) => (
                <a
                  href={card.href}
                  class={`group relative flex min-h-[180px] flex-col justify-between overflow-hidden rounded-2xl border border-border p-6 shadow-soft transition-all duration-300 hover:-translate-y-0.5 hover:border-primary/35 hover:shadow-lift ${
                    card.featured ? 'bg-accent-soft/70 sm:col-span-2 lg:min-h-[230px]' : 'bg-card'
                  } ${card.wide ? 'sm:col-span-2' : ''}`}
                >
                  {card.featured && (
                    <span
                      aria-hidden="true"
                      class="pointer-events-none absolute -right-6 -bottom-10 font-serif text-[11rem] leading-none text-primary/[0.08] transition-transform duration-500 group-hover:-translate-y-2 group-hover:rotate-6 select-none"
                    >
                      ✳
                    </span>
                  )}

                  <div class="relative flex items-start justify-between">
                    <span class="flex size-10 items-center justify-center rounded-xl border border-primary/15 bg-primary/10 text-primary transition-colors group-hover:bg-primary group-hover:text-primary-foreground">
                      <span class={`${card.icon} size-5`} />
                    </span>
                    <span class="rounded-full border border-border/80 bg-card/70 px-2.5 py-1 text-[10px] font-medium text-muted-foreground">
                      {card.status}
                    </span>
                  </div>

                  <div class="relative mt-8">
                    <div class="mb-2 font-mono text-[10px] tracking-[0.16em] text-primary">/{card.id}</div>
                    <div class="flex items-end justify-between gap-3">
                      <h3
                        class={`font-serif leading-none font-medium tracking-[-0.03em] text-foreground ${card.featured ? 'text-3xl lg:text-4xl' : 'text-2xl'}`}
                      >
                        {card.title}
                      </h3>
                      <span class="icon-[ph--arrow-up-right] mb-0.5 size-5 shrink-0 text-muted-foreground/50 transition-all duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-primary" />
                    </div>
                    <p class="mt-3 text-[12px] text-muted-foreground">{card.desc}</p>
                  </div>
                </a>
              ))
            }
          </div>
        </section>

        <!-- 02 / Recent Logs -->
        <section class="fade-up" style="animation-delay: 150ms">
          <div class={SECTION_HEADER_CLASS}>
            <div class="flex items-center">
              <span class={SECTION_NUM_CLASS}>02</span>
              <h2 class={SECTION_TITLE_CLASS}>Recent Logs</h2>
            </div>
            <a
              href="/posts"
              class="group hidden items-center gap-1.5 text-[11px] font-semibold tracking-[0.1em] text-primary uppercase transition-colors hover:text-accent-foreground lg:flex"
              >View all<span class="icon-[ph--arrow-right] transition-transform group-hover:translate-x-1"></span></a
            >
          </div>
          <div><List {posts} {type} {heroImageLayout} /></div>
        </section>

        {
          ENABLED && (
            <section class="fade-up" style="animation-delay: 250ms">
              <div class={SECTION_HEADER_CLASS}>
                <div class="flex items-center">
                  <span class={SECTION_NUM_CLASS}>03</span>
                  <h2 class={SECTION_TITLE_CLASS}>Activity</h2>
                </div>
                <span class={SECTION_META_CLASS}>GitHub / Contribution_Trace</span>
              </div>
              <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-soft">
                <GithubContributions username={GITHUB_USERNAME} tooltipEnabled={TOOLTIP_ENABLED} client:visible transition:animate="none" />
              </div>
            </section>
          )
        }

        {
          SKILLS_ENABLED && SKILLS_DATA.length > 0 && (
            <section class="fade-up" style="animation-delay: 350ms">
              <div class={SECTION_HEADER_CLASS}>
                <div class="flex items-center">
                  <span class={SECTION_NUM_CLASS}>04</span>
                  <h2 class={SECTION_TITLE_CLASS}>Tech Stack</h2>
                </div>
                <span class={SECTION_META_CLASS}>Capability / Skill_Radar</span>
              </div>
              <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-soft [&_.skill-card]:border-border [&_.skill-card]:bg-card">
                <SkillsShowcase skillsData={SKILLS_DATA} />
              </div>
            </section>
          )
        }

        {
          BUILD_INFO_ENABLED && BUILD_COMPONENTS.length > 0 && (
            <section class="fade-up" style="animation-delay: 450ms">
              <div class={SECTION_HEADER_CLASS}>
                <div class="flex items-center">
                  <span class={SECTION_NUM_CLASS}>05</span>
                  <h2 class={SECTION_TITLE_CLASS}>Build Info</h2>
                </div>
                <span class={SECTION_META_CLASS}>System / Component_Manifest</span>
              </div>
              <BuildInfo components={BUILD_COMPONENTS} totalWords={totalWords} />
            </section>
          )
        }
      </div>
    </main>
  </div>
</Layout>
