---
import { SITE, SKILLSSHOWCASE_CONFIG, SOCIAL_LINKS } from '~/config.ts'
import { GITHUB_CONFIG, POSTS_CONFIG } from '~/config.ts'
import { postsSort } from '~/lib/utils'
import { getCollection } from 'astro:content'
import Layout from '~/layouts/Layout.astro'
import SectionDivider from '~/components/base/SectionDivider.astro'
import GithubContributions from '~/components/base/GithubContributions.tsx'
import SocialLink from '~/components/base/SocialLink.astro'
import List from '~/components/posts/card/List.astro'
import SkillsShowcase from '~/components/base/SkillsShowcase.astro'

const { ENABLED, GITHUB_USERNAME, TOOLTIP_ENABLED } = GITHUB_CONFIG
const { size, type } = POSTS_CONFIG.homePageConfig
const { SKILLS_ENABLED, SKILLS_DATA } = SKILLSSHOWCASE_CONFIG

const allPosts = await getCollection('posts')
const posts = postsSort(allPosts).slice(0, size)
---

<Layout title="主页" description={SITE.description}>
  <div class="relative z-[1]">
    <div class="px-6 sm:px-6 md:px-8 py-16">
      <div class="max-w-4xl mx-auto">
        <!-- 简洁的版本标签 -->
        <div class="mb-8 sm:mb-12 font-mono">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded bg-gray-100 dark:bg-gray-900">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
            </span>
            <span class="text-xs font-medium text-gray-700 dark:text-gray-300">
              <span class="text-red-600 dark:text-red-500">RefactX v1.6.0</span>
              <span class="text-gray-400 mx-1">•</span>
              <span>INDEV</span>
            </span>
          </div>
        </div>

        <!-- 标题 -->
        <h1 class="space-y-4 mb-8">
          <span class="block text-5xl sm:text-6xl font-semibold text-gray-900 dark:text-white tracking-tight leading-tight">
            Welcome to<br>
            <span class="text-5xl sm:text-6xl font-light">the galaxy of RefactX.</span>
          </span>
        </h1>

        <div class="flex items-start gap-6 mt-16 md:mt-24 mb-12">
          <div class="flex-1">
            <div class="font-normal text-black dark:text-white">
              <div class="space-y-4">
                <p class="text-gray-700 dark:text-gray-300 text-sm md:text-base font-mono tracking-normal leading-relaxed">
                  我是 Refactored，一名前端开发者和开源爱好者。<br>
                  专注于探索各种技术栈，并将它们应用于实际项目中。<br>
                  这个网站是我的技术博客和作品集，分享我的开发经验和见解。
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- 按钮（大于md） -->
        <div class="items-center gap-4 mt-8 mb-12 hidden md:block">
          <a
            href="/posts"
            class="inline-flex items-center justify-center px-6 py-3 mr-6 transition-all bg-black hover:bg-gray-600 dark:bg-white dark:hover:bg-gray-700 text-white dark:text-black dark:hover:text-white font-medium"
          >
            <span class="icon-[mdi--book-open] size-5 mr-2"></span>
            探索文章
          </a>
          <a
            href="/friends"
            class="inline-flex items-center justify-center px-6 py-3 border-1 border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:border-red-300 dark:hover:border-red-500 hover:text-red-600 dark:hover:text-red-400 font-medium transition-all duration-200"
          >
            <span class="icon-[mdi--link] size-5 mr-2"></span>
            加入星海
          </a>
        </div>

        <!-- 社交链接 -->
        <div class="flex items-center justify-between gap-4">
          <div class="flex gap-4">
            {SOCIAL_LINKS.map((item) => (
              <SocialLink
                href={item.url}
                icon={item.icon}
                aria-label={`${item.name} 的链接`}
                count={item.count}
                label="关注者"
              />
            ))}
          </div>

          <a
            href="/friends"
            class="inline-flex text-sm items-centertext-sm text-muted-foreground hover:text-primary transition-colors"
          >
            <span class="flex icon-[mdi--link] size-6 mr-2" />
            <span class="mt-0.5">友链 / Links</span>
          </a>
        </div>
      </div>
    </div>

    {ENABLED && (
      <>
        <SectionDivider />
        <div class="py-8 pb-10 px-6 max-md:px-6">
          <div class="max-w-4xl mx-auto px-2 max-md:px-0">
            <h2 class="font-bold text-2xl sm:text-3xl mb-4">动态聚焦 / Spotlight</h2>
            <p class="text-muted-foreground mb-6 mt-1">近期代码贡献记录 / Most recent contributions.</p>
            <GithubContributions
              username={GITHUB_USERNAME}
              tooltipEnabled={TOOLTIP_ENABLED}
              client:load
              transition:animate="none"
            />
          </div>
        </div>
      </>
    )}

    {SKILLS_ENABLED && SKILLS_DATA.length > 0 && (
      <>
        <SectionDivider />
        <div class="py-8 pb-10 px-6 max-md:px-6">
          <div class="max-w-4xl mx-auto px-2 max-md:px-0">
            <h2 class="font-bold text-2xl sm:text-3xl mb-4">技术栈 / Skills</h2>
            <p class="text-muted-foreground mb-6 mt-1">以下是我常用的技术： / Here are some skills I have used:</p>
            <SkillsShowcase skillsData={SKILLS_DATA} />
          </div>
        </div>
      </>
    )}

    <SectionDivider />
    <div class="py-10 pb-12 px-6 sm:px-8">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-bold text-2xl sm:text-3xl">文章 / Posts</h2>
        <p class="text-muted-foreground mb-8 mt-2 text-sm sm:text-base">
          最近更新的 {posts.length} 篇文章 / Recent {posts.length} posts, worth a look.
        </p>
        <List {posts} {type} heroImageLayout={POSTS_CONFIG.homePageConfig?.heroImageLayout} />
      </div>
    </div>
  </div>
</Layout>