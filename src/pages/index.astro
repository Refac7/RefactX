---
import { getCollection } from 'astro:content'
import { SITE, SKILLSSHOWCASE_CONFIG, SOCIAL_LINKS, GITHUB_CONFIG, POSTS_CONFIG } from '~/config.ts'
import { cn, postsSort } from '~/lib/utils'

import Layout from '~/layouts/Layout.astro'
import GithubContributions from '~/components/base/GithubContributions.tsx'
import List from '~/components/posts/card/List.astro'
import SkillsShowcase from '~/components/base/SkillsShowcase.astro'

const { ENABLED, GITHUB_USERNAME, TOOLTIP_ENABLED } = GITHUB_CONFIG
const { size, type, heroImageLayout } = POSTS_CONFIG.homePageConfig
const { SKILLS_ENABLED, SKILLS_DATA } = SKILLSSHOWCASE_CONFIG
const allPosts = await getCollection('posts')
const posts = postsSort(allPosts).slice(0, size)

const NAV_CARDS = [
  { id: '01', title: 'Logs', desc: 'Technical archives', href: '/posts', icon: 'icon-[ph--read-cv-logo]', status: 'Active' },
  { id: '02', title: 'Links', desc: 'Signal network', href: '/friends', icon: 'icon-[ph--planet]', status: 'Connected' },
  { id: '03', title: 'Projects', desc: 'Deployed modules', href: '/projects', icon: 'icon-[ph--stack]', status: 'Stable' },
  { id: '04', title: 'Tags', desc: 'Core filters', href: '/tags', icon: 'icon-[ph--tag]', status: 'Verified' },
]
---

<Layout title="Home" description={SITE.description}>
  <div class="relative font-sans flex flex-col lg:flex-row min-h-screen max-w-[1920px] mx-auto">
    <aside
      class="lg:md3-surface-tint w-full lg:w-1/3 lg:sticky lg:top-0 lg:h-screen flex flex-col lg:border-r border-outline-variant z-20 bg-surface-container-lowest/70 backdrop-blur-sm relative overflow-hidden"
    >
      <div class="flex flex-1 lg:overflow-y-auto scrollbar-hide flex-col relative z-10">
        <div
          class="p-6 lg:p-8 xl:p-12 pb-0 lg:pb-4 shrink-0 fade-up flex justify-between items-start lg:border-b lg:border-outline-variant"
        >
          <div class="flex items-center gap-3 select-none">
            <div class="size-10 rounded-xl bg-primary-container flex items-center justify-center text-on-primary-container">
              <span class="icon-[ph--terminal-window-duotone] size-6"></span>
            </div>
            <div>
              <div class="text-sm font-bold tracking-tight">{SITE.title || 'Digital Hub'}</div><div
                class="text-[10px] text-on-surface-variant uppercase tracking-widest font-mono"
              >
                System Online
              </div>
            </div>
          </div>
          <span
            class="inline-flex items-center rounded-full bg-secondary-container text-on-secondary-container px-2.5 py-1 text-[10px] font-mono select-none"
            >v{SITE.version} / Astro</span
          >
        </div>
        <div class="flex-1 flex flex-col justify-center p-6 lg:p-8 xl:p-12 min-h-[50vh] lg:min-h-0 fade-up animation-delay-100">
          <!-- Status badge -->
          <div
            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface-container-high text-xs font-medium text-on-surface-variant mb-8 w-fit select-none"
          >
            <span class="relative flex size-2"
              ><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span><span
                class="relative inline-flex rounded-full size-2 bg-emerald-500"></span></span
            >
            Building & Exploring
          </div>

          <!-- Main title -->
          <h1
            class="text-4xl sm:text-5xl xl:text-6xl max-[639px]:text-[2.5rem] font-semibold tracking-tight text-foreground leading-[1.15] mb-4 select-none"
          >
            Home
          </h1>

          <!-- Subtitle -->
          <div class="flex items-center gap-2 text-sm text-on-surface-variant mb-4">
            <span class="icon-[ph--house] size-4"></span><span>Home Overview</span>
          </div>

          <!-- Identity tags -->
          <div class="flex flex-wrap items-center gap-4 text-sm text-on-surface-variant mb-8 font-mono">
            <span class="flex items-center gap-1.5"><span class="icon-[ph--code] size-4"></span> Developer</span><span
              class="w-1 h-1 rounded-full bg-outline-variant"></span><span class="flex items-center gap-1.5"
              ><span class="icon-[ph--pen-nib] size-4"></span> Creator</span
            >
          </div>

          <!-- Intro text with left border accent -->
          <div class="relative pl-4 border-l-2 border-primary/40 fade-up animation-delay-150">
            <p class="text-sm md:text-base text-on-surface-variant leading-relaxed">
              欢迎访问此站点，<br />基于 Astro v6 构建，记录技术、分享生活。
            </p>
          </div>
        </div>
      </div>
      <div class="hidden lg:block shrink-0 border-t border-outline-variant select-none fade-up animation-delay-200 relative">
        <div
          class="p-4 flex items-center justify-between text-xs text-on-surface-variant font-mono border-b border-outline-variant px-6 lg:px-8 xl:px-12 bg-surface-container-low/60"
        >
          <span>// CONNECT PORTALS</span><span>{SOCIAL_LINKS.length} ACTIVE</span>
        </div>
        <div class="grid grid-cols-1 gap-px bg-outline-variant/40">
          {
            SOCIAL_LINKS.map((item) => (
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center gap-4 h-14 px-6 lg:px-8 xl:px-12 bg-surface-container-low hover:bg-surface-container transition-all duration-300 text-left"
              >
                <span class={`${item.icon} size-5 shrink-0 text-on-surface-variant group-hover:text-primary transition-colors`} />
                <span class="text-[10px] font-mono font-medium text-on-surface-variant group-hover:text-primary uppercase tracking-wider transition-colors">
                  {item.name || 'Link'}
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </aside>
    <main class="w-full lg:w-2/3 z-10 flex flex-col">
      <div class="px-6 lg:px-8 xl:px-12 lg:py-20 flex-1 flex flex-col gap-20 xl:gap-24 mt-4 lg:mt-0">
        <div>
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 border-b border-outline-variant pb-4">
            <div class="flex items-center gap-3">
              <span
                class="inline-flex items-center justify-center size-8 rounded-full bg-primary-container text-on-primary-container font-mono text-xs font-bold"
                >01</span
              ><h2 class="text-xl md:text-2xl font-bold text-foreground tracking-tight">Navigation</h2>
            </div>
            <span class="text-[10px] font-mono text-on-surface-variant/60 uppercase tracking-widest hidden sm:inline-block"
              >// System_Modules</span
            >
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
            {
              NAV_CARDS.map((card, i) => (
                <a
                  href={card.href}
                  class="group relative flex flex-col justify-between rounded-2xl border border-outline-variant bg-surface-container-low p-6 hover:bg-surface-container hover:border-primary/40 hover:shadow-md transition-all duration-300"
                  style={`animation-delay: ${i * 50}ms`}
                >
                  <>
                    <div class="absolute right-4 top-4 flex items-center gap-1.5 opacity-60 group-hover:opacity-100 transition-opacity">
                      <>
                        <span class="relative flex size-1.5">
                          {card.status === 'Active' && (
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75" />
                          )}
                          <span
                            class={`relative inline-flex rounded-full size-1.5 ${card.status === 'Active' ? 'bg-emerald-500' : 'bg-primary/50'}`}
                          />
                        </span>
                        <span class="text-[10px] font-mono uppercase tracking-wider text-muted-foreground group-hover:text-foreground transition-colors">
                          {card.status}
                        </span>
                      </>
                    </div>
                    <div class="size-12 rounded-xl flex items-center justify-center bg-primary-container/60 group-hover:bg-primary-container group-hover:scale-110 transition-all duration-300 mb-8">
                      <span
                        class={cn('size-6 text-on-primary-container/80 group-hover:text-on-primary-container transition-colors', card.icon)}
                      />
                    </div>
                    <div>
                      <>
                        <div class="flex items-center justify-between mb-1">
                          <>
                            <h3 class="text-base font-semibold text-foreground tracking-tight">{card.title}</h3>
                            <span class="icon-[ph--arrow-up-right] size-4 text-muted-foreground/30 group-hover:text-primary transition-all group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
                          </>
                        </div>
                        <p class="text-sm text-muted-foreground leading-relaxed line-clamp-1">{card.desc}</p>
                      </>
                    </div>
                  </>
                </a>
              ))
            }
          </div>
        </div>
        <div class="fade-up" style="animation-delay: 200ms">
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 border-b border-outline-variant pb-4">
            <div class="flex items-center gap-3">
              <span
                class="inline-flex items-center justify-center size-8 rounded-full bg-primary-container text-on-primary-container font-mono text-xs font-bold"
                >02</span
              ><h2 class="text-xl md:text-2xl font-bold text-foreground tracking-tight">Recent Logs</h2>
            </div><a
              href="/posts"
              class="group hidden lg:flex items-center gap-1.5 text-xs font-mono font-medium text-muted-foreground hover:text-primary transition-colors"
              ><span class="uppercase tracking-wider">View_All</span><span
                class="icon-[ph--arrow-right] group-hover:translate-x-1 transition-transform"></span></a
            >
          </div>
          <div><List {posts} {type} {heroImageLayout} /></div>
        </div>
        {
          ENABLED && (
            <div class="fade-up" style="animation-delay: 300ms">
              <>
                <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 border-b border-outline-variant pb-4">
                  <>
                    <div class="flex items-center gap-3">
                      <>
                        <span class="inline-flex items-center justify-center size-8 rounded-full bg-primary-container text-on-primary-container font-mono text-xs font-bold">
                          03
                        </span>
                        <h2 class="text-xl md:text-2xl font-bold text-foreground tracking-tight">Activity</h2>
                      </>
                    </div>
                    <span class="text-[10px] font-mono text-on-surface-variant/60 uppercase tracking-widest hidden sm:inline-block">
                      // GitHub_Trace
                    </span>
                  </>
                </div>
                <div class="p-6 sm:p-8 rounded-2xl border border-outline-variant bg-surface-container-low hover:bg-surface-container transition-colors">
                  <GithubContributions
                    username={GITHUB_USERNAME}
                    tooltipEnabled={TOOLTIP_ENABLED}
                    client:visible
                    transition:animate="none"
                  />
                </div>
              </>
            </div>
          )
        }
        {
          SKILLS_ENABLED && SKILLS_DATA.length > 0 && (
            <div class="fade-up" style="animation-delay: 400ms">
              <>
                <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 border-b border-outline-variant pb-4">
                  <>
                    <div class="flex items-center gap-3">
                      <>
                        <span class="inline-flex items-center justify-center size-8 rounded-full bg-primary-container text-on-primary-container font-mono text-xs font-bold">
                          04
                        </span>
                        <h2 class="text-xl md:text-2xl font-bold text-foreground tracking-tight">Tech Stack</h2>
                      </>
                    </div>
                    <span class="text-[10px] font-mono text-on-surface-variant/60 uppercase tracking-widest hidden sm:inline-block">
                      // Skill_Radar
                    </span>
                  </>
                </div>
                <div class="[&_.skill-card]:border-outline-variant [&_.skill-card]:bg-surface-container-low [&_.skill-card]:rounded-full hover:[&_.skill-card]:bg-surface-container-high hover:[&_.skill-card]:border-primary/30 [&_.skill-card]:shadow-sm [&_.skill-card]:transition-all duration-300">
                  <SkillsShowcase skillsData={SKILLS_DATA} />
                </div>
              </>
            </div>
          )
        }
      </div>
    </main>
  </div>
</Layout>
