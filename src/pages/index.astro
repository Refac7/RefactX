---
import { getCollection } from 'astro:content'
import { 
  SITE, 
  SKILLSSHOWCASE_CONFIG, 
  SOCIAL_LINKS, 
  GITHUB_CONFIG, 
  POSTS_CONFIG 
} from '~/config.ts'
import { cn, postsSort } from '~/lib/utils'
import Layout from '~/layouts/Layout.astro'
import GithubContributions from '~/components/base/GithubContributions.tsx'
import List from '~/components/posts/card/List.astro'
import SkillsShowcase from '~/components/base/SkillsShowcase.astro'
import Snowfall from '~/components/base/Snowfall.astro'

// 解构配置
const { ENABLED, GITHUB_USERNAME, TOOLTIP_ENABLED } = GITHUB_CONFIG
const { size, type, heroImageLayout } = POSTS_CONFIG.homePageConfig
const { SKILLS_ENABLED, SKILLS_DATA } = SKILLSSHOWCASE_CONFIG

// 数据获取
const allPosts = await getCollection('posts')
const posts = postsSort(allPosts).slice(0, size)

// 导航卡片数据
const NAV_CARDS = [
  { id: '01', title: 'READ_LOGS', desc: 'Technical archives & thoughts', href: '/posts', icon: 'icon-[ph--read-cv-logo-bold]', status: 'Active' },
  { id: '02', title: 'FRIEND_LINKS', desc: 'Signal exchange network', href: '/friends', icon: 'icon-[ph--planet-bold]', status: 'Connected' },
  { id: '03', title: 'PROJECTS', desc: 'Deployed modules & apps', href: '/projects', icon: 'icon-[ph--stack-bold]', status: 'Stable' },
  { id: '04', title: 'TAGS', desc: 'Core filters', href: '/tags', icon: 'icon-[ph--tag-bold]', status: 'Verified' }
]

const CONTAINER_CLASS = "max-w-[1400px] mx-auto px-6 sm:px-8"
---

<Layout title="主页" description={SITE.description}>
  <!-- 背景特效 -->
  <div id="snowfall-container" class="fixed inset-0 pointer-events-none z-[1] transition-opacity duration-700 ease-in-out opacity-0">
    <Snowfall />
  </div>

  <div class={`min-h-screen relative py-12 font-sans overflow-hidden ${CONTAINER_CLASS}`}>
    
    <div class="mb-8 relative z-10">
      <!-- Top Bar -->
      <div class="flex flex-row justify-between items-start text-[10px] mb-8 md:mb-16 font-mono uppercase tracking-widest text-muted-foreground/60 select-none">
        <span>// IDENTITY_CORE // V.1.6.1 SP</span>
        
        <div class="flex flex-col-reverse items-end gap-2 sm:flex-row sm:items-center sm:gap-6">
            <button id="snow-toggle" class="group flex items-center gap-1.5 hover:text-primary transition-colors cursor-pointer focus:outline-none" aria-label="Toggle Effects">
                <span class="icon-[ph--snowflake] w-3 h-3 group-hover:text-primary transition-colors"></span>
                <span>FX: <span id="snow-status">ON</span></span>
            </button>

            <div class="flex items-center gap-2 text-primary">
                <span class="relative flex h-2 w-2">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-500 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-600"></span>
                </span>
                <span>SYS: ONLINE</span>
            </div>
        </div>
      </div>

      <!-- Hero Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 pt-6 items-end">
        <div class="lg:col-span-7">
          <h1 class="text-7xl sm:text-8xl font-bold tracking-tighter text-foreground">
            Refac<span class="text-primary">7</span><span class="text-foreground/20">.</span>
          </h1>
          <h2 class="font-normal text-2xl md:text-3xl text-primary/40 mt-3">
            Architect of the Digital Void 
          </h2>
        </div>

        <div class="lg:col-span-5 flex flex-col justify-end pb-2">
          <div class="border-l border-primary/40 pl-6 flex flex-col gap-6">
             <p class="text-base sm:text-lg text-muted-foreground leading-relaxed">
              你好，我是 Refac7。一名试图在代码的混沌中寻找秩序的时空修剪者。
             </p>
             
             <!-- 统计数据栏 -->
             <div class="flex items-center gap-8 pt-4 border-t border-dashed border-border/40">
                <div class="flex flex-col">
                    <span class="text-[10px] uppercase text-muted-foreground/60 font-mono tracking-wider">Connect Protocol</span>
                    <div class="flex gap-3 mt-1">
                        {SOCIAL_LINKS.map((item) => (
                          <a href={item.url} target="_blank" class="text-foreground/80 hover:text-primary transition-colors">
                            <span class={`${item.icon} size-5`}></span>
                          </a>
                        ))}
                    </div>
                </div>
                <div class="h-8 w-px bg-border/60"></div>
                <div class="flex flex-col">
                    <span class="text-[10px] uppercase text-muted-foreground/60 font-mono tracking-wider">Role</span>
                    <span class="text-sm font-mono font-bold text-foreground mt-0.5">
                        Developer
                    </span>
                </div>
             </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. 导航 Hub -->
    <div class="mb-10">
        <div class="flex items-end gap-4 mb-8 select-none">
           <span class="font-mono text-4xl font-black text-muted-foreground/10 leading-none -mb-1">01</span>
           <span class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-muted-foreground/50 mb-1">
              Navigation_Hub
           </span>
           <div class="h-px bg-gradient-to-r from-border to-transparent flex-1 mb-1.5"></div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            {NAV_CARDS.map((card) => (
                <a href={card.href} class="group relative flex flex-col bg-background border border-border/40 hover:border-primary/50 transition-all duration-300 p-5 overflow-hidden hover:shadow-lg hover:shadow-primary/5 min-h-[180px] xl:min-h-[240px]">
                    <!-- 背景大数字 -->
                    <span class="absolute -right-2 -top-4 text-[80px] font-black text-muted-foreground/[0.03] group-hover:text-primary/[0.05] transition-colors pointer-events-none select-none font-mono">
                        {card.id}
                    </span>
                    
                    <div class="flex justify-between items-start mb-4 relative z-10">
                        <div class="size-10 flex items-center justify-center bg-muted/10 border border-border/40 group-hover:border-primary/30 transition-colors">
                            <span class={cn('size-5 text-foreground/80 group-hover:text-primary transition-colors', card.icon)}></span>
                        </div>
                        <span class="icon-[ph--arrow-right] size-4 text-muted-foreground/50 group-hover:text-primary group-hover:translate-x-1 transition-transform"></span>
                    </div>

                    <div class="flex-1 relative z-10">
                        <h3 class="text-lg font-bold text-foreground tracking-tight mb-1 group-hover:text-primary transition-all font-monoblock group-hover:translate-x-1 duration-300">
                            {card.title}
                        </h3>
                        <p class="text-xs text-muted-foreground leading-relaxed">
                            {card.desc}
                        </p>
                    </div>

                    <div class="mt-4 pt-3 border-t border-dashed border-border/40 flex items-center justify-between text-[9px] font-mono text-muted-foreground/60 uppercase tracking-wider relative z-10">
                        <span>Status: {card.status}</span>
                    </div>
                </a>
            ))}
        </div>
    </div>

    <!-- 3. 活动日志 (GitHub) -->
    {ENABLED && (
      <div class="mb-10">
         <div class="flex items-end gap-4 mb-8 select-none">
           <span class="font-mono text-4xl font-black text-muted-foreground/10 leading-none -mb-1">02</span>
           <span class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-muted-foreground/50 mb-1">
              Activity_Stream
           </span>
           <div class="h-px bg-gradient-to-r from-border to-transparent flex-1 mb-1.5"></div>
        </div>
        
        <GithubContributions
          username={GITHUB_USERNAME}
          tooltipEnabled={TOOLTIP_ENABLED}
          client:visible
          transition:animate="none"
        />
        
        <div class="mt-4 flex justify-between text-[10px] font-mono text-muted-foreground/40 pt-2 border-t border-dashed border-primary/20"></div>
      </div>
    )}

    <!-- 4. 技能栈 -->
    {SKILLS_ENABLED && SKILLS_DATA.length > 0 && (
      <div class="mb-10">
         <div class="flex items-end gap-4 mb-8 select-none">
           <span class="font-mono text-4xl font-black text-muted-foreground/10 leading-none -mb-1">03</span>
           <span class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-muted-foreground/50 mb-1">
              Arsenal_Matrix
           </span>
           <div class="h-px bg-gradient-to-r from-border to-transparent flex-1 mb-1.5"></div>
        </div>
        <SkillsShowcase skillsData={SKILLS_DATA} />
      </div>
    )}

    <!-- 5. 最新文章 -->
    <div class="mb-12">
      <div class="flex items-end justify-between gap-4 mb-10 select-none">
         <div class="flex items-end gap-4 flex-1">
            <span class="font-mono text-4xl font-black text-muted-foreground/10 leading-none -mb-1">04</span>
            <span class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-muted-foreground/50 mb-1">
                Latest_Transmissions
            </span>
            <div class="h-px bg-gradient-to-r from-border to-transparent flex-1 mb-1.5 hidden sm:block"></div>
         </div>
      </div>

      <List {posts} {type} heroImageLayout={heroImageLayout} />
    </div>

  </div>
</Layout>

<script is:inline>
  function initSnowToggle() {
    const oldBtn = document.getElementById('snow-toggle');
    const snowContainer = document.getElementById('snowfall-container');
    const statusSpan = document.getElementById('snow-status');

    if (!oldBtn || !snowContainer || !statusSpan) return;

    const newBtn = oldBtn.cloneNode(true);
    oldBtn.parentNode.replaceChild(newBtn, oldBtn);
    const newStatusSpan = newBtn.querySelector('#snow-status');

    const storedState = localStorage.getItem('snowfall_enabled');
    const isEnabled = storedState === 'true';

    const updateUI = (active) => {
      if (active) {
        snowContainer.style.opacity = '1';
        newStatusSpan.innerText = 'ON';
        newStatusSpan.classList.add('text-primary');
      } else {
        snowContainer.style.opacity = '0';
        newStatusSpan.innerText = 'OFF';
        newStatusSpan.classList.remove('text-primary');
      }
    };

    updateUI(isEnabled);

    newBtn.addEventListener('click', (e) => {
      e.preventDefault();
      const isCurrentlyOn = newStatusSpan.innerText === 'ON';
      const newState = !isCurrentlyOn;
      updateUI(newState);
      localStorage.setItem('snowfall_enabled', String(newState));
    });
  }

  document.addEventListener('astro:page-load', initSnowToggle);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSnowToggle);
  } else {
    initSnowToggle();
  }
</script>