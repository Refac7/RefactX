---
import { getCollection } from 'astro:content'
import { SITE, SKILLSSHOWCASE_CONFIG, SOCIAL_LINKS, GITHUB_CONFIG, POSTS_CONFIG } from '~/config.ts'
import { cn, postsSort } from '~/lib/utils'
import Layout from '~/layouts/Layout.astro'
import GithubContributions from '~/components/base/GithubContributions.tsx'
import List from '~/components/posts/card/List.astro'
import SkillsShowcase from '~/components/base/SkillsShowcase.astro'
import Snowfall from '~/components/base/Snowfall.astro'

const { ENABLED, GITHUB_USERNAME, TOOLTIP_ENABLED } = GITHUB_CONFIG
const { size, type, heroImageLayout } = POSTS_CONFIG.homePageConfig
const { SKILLS_ENABLED, SKILLS_DATA } = SKILLSSHOWCASE_CONFIG
const allPosts = await getCollection('posts')
const posts = postsSort(allPosts).slice(0, size)

const NAV_CARDS =[
  { id: '01', title: 'Logs', desc: 'Technical archives', href: '/posts', icon: 'icon-[ph--read-cv-logo]', status: 'Active' },
  { id: '02', title: 'Links', desc: 'Signal network', href: '/friends', icon: 'icon-[ph--planet]', status: 'Connected' },
  { id: '03', title: 'Projects', desc: 'Deployed modules', href: '/projects', icon: 'icon-[ph--stack]', status: 'Stable' },
  { id: '04', title: 'Tags', desc: 'Core filters', href: '/tags', icon: 'icon-[ph--tag]', status: 'Verified' }
]

const SECTION_HEADER_CLASS = "flex items-center justify-between border-b border-border/40 pb-4 mb-8 select-none"
const SECTION_TITLE_CLASS = "text-lg font-semibold tracking-tight text-foreground"
const SECTION_NUM_CLASS = "inline-flex items-center justify-center rounded-full bg-muted/60 px-2.5 py-0.5 text-xs font-medium text-muted-foreground mr-3"
---

<Layout title="Home" description={SITE.description}>
  <div id="snowfall-container" class="fixed inset-0 pointer-events-none z-[1] transition-opacity duration-700 ease-in-out opacity-0">
    <Snowfall />
  </div>

  <div class="relative font-sans flex flex-col lg:flex-row min-h-screen max-w-[1920px] mx-auto">
    <aside class="w-full lg:w-1/3 lg:sticky lg:top-0 lg:h-screen flex flex-col lg:border-r border-border/40 z-20 bg-background border-b lg:border-none">
      <div class="flex flex-1 lg:overflow-y-auto scrollbar-hide flex-col">
        <div class="p-6 lg:p-8 xl:p-12 pb-0 shrink-0 fade-up flex justify-between items-center">
            <span class="inline-flex items-center rounded-full bg-muted/50 px-3 py-1 text-xs font-medium text-muted-foreground select-none">
              V{SITE.version}
            </span>
            <button class="snow-toggle-btn group hidden sm:flex items-center gap-2 hover:bg-muted/50 px-3 py-1 rounded-full transition-colors cursor-pointer focus:outline-none">
                <span class="text-xs font-medium text-muted-foreground">Snow <span class="snow-status-text">On</span></span>
            </button>
        </div>
        
        <div class="flex-1 flex flex-col justify-end lg:justify-center p-6 lg:p-8 xl:p-12 min-h-[300px] lg:min-h-[250px] fade-up animation-delay-100">
           <h1 class="text-5xl sm:text-6xl xl:text-7xl font-bold tracking-tight text-foreground leading-[1.1] mb-6 select-none">{SITE.author}</h1>
           <div class="flex items-center gap-2 text-sm text-muted-foreground"><span class="icon-[ph--user] size-4"></span><span>Function Panel</span></div>
        </div>
        
        <div class="shrink-0 p-6 lg:p-8 xl:p-12 fade-up animation-delay-150">
           <p class="text-sm text-muted-foreground leading-relaxed">
              > {SITE.indexIntro1}<br/>
              {SITE.indexIntro2}
           </p>
        </div>
      </div>
      
      <div class="flex border-t border-border/40 shrink-0 select-none fade-up animation-delay-200">
        {SOCIAL_LINKS.map((item) => (
          <a href={item.url} target="_blank" class="flex-1 flex flex-col items-start lg:items-center justify-center p-6 lg:p-8 bg-background hover:bg-muted/30 border-r border-border/40 last:border-r-0 transition-colors">
              <span class={`${item.icon} size-5 text-muted-foreground group-hover:text-foreground transition-colors mb-2`}></span>
              <span class="text-sm font-medium text-muted-foreground">{item.name || 'Link'}</span>
          </a>
        ))}
      </div>
    </aside>

    <main class="w-full lg:w-2/3 z-10 flex flex-col fade-up animation-delay-150">
      <div class="p-6 lg:p-10 xl:p-16 2xl:p-20 flex-1 flex flex-col">
          <div class="mb-20 fade-up mt-4">
              <div class={SECTION_HEADER_CLASS}>
                <div class="flex items-center"><span class={SECTION_NUM_CLASS}>01</span><h2 class={SECTION_TITLE_CLASS}>Navigation</h2></div>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mt-8">
                  {NAV_CARDS.map((card, i) => (
                      <a href={card.href} class="group relative flex flex-col justify-between rounded-md border border-border/40 bg-background/50 p-6 hover:bg-muted/20 hover:shadow-xs transition-all duration-300 min-h-[160px] hover:-translate-y-0.5" style={`animation-delay: ${i * 50}ms`}>
                          <div class="relative z-10">
                              <div class="flex justify-between items-start mb-4">
                                <div class="size-10 flex items-center justify-center rounded-xs bg-background border border-border/40 group-hover:border-border/60 transition-colors">
                                  <span class={cn('size-5 text-foreground/80', card.icon)}></span>
                                </div>
                                <span class="icon-[ph--arrow-up-right] size-4 text-muted-foreground/40 group-hover:text-foreground transition-colors"></span>
                              </div>
                              <h3 class="text-lg font-semibold text-foreground mb-1 tracking-tight">{card.title}</h3>
                              <p class="text-sm text-muted-foreground leading-relaxed">{card.desc}</p>
                          </div>
                      </a>
                  ))}
              </div>
          </div>

          <div class="mb-20 fade-up" style="animation-delay: 200ms">
              <div class={SECTION_HEADER_CLASS}>
                <div class="flex items-center"><span class={SECTION_NUM_CLASS}>02</span><h2 class={SECTION_TITLE_CLASS}>Recent Logs</h2></div>
                <a href="/posts" class="flex items-center gap-1.5 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors"><span>View All</span><span class="icon-[ph--arrow-right]"></span></a>
              </div>
              <div class="mt-8">
                <List {posts} {type} heroImageLayout={heroImageLayout} />
              </div>
          </div>

          {ENABLED && (
            <div class="mb-20 fade-up" style="animation-delay: 300ms">
              <div class={SECTION_HEADER_CLASS}>
                <div class="flex items-center"><span class={SECTION_NUM_CLASS}>03</span><h2 class={SECTION_TITLE_CLASS}>Activity</h2></div>
              </div>
              <div class="mt-8 rounded-md border border-border/40 bg-background/50 p-6 overflow-x-auto">
                <GithubContributions username={GITHUB_USERNAME} tooltipEnabled={TOOLTIP_ENABLED} client:visible transition:animate="none" />
              </div>
            </div>
          )}

          {SKILLS_ENABLED && SKILLS_DATA.length > 0 && (
            <div class="mb-12 fade-up" style="animation-delay: 400ms">
              <div class={SECTION_HEADER_CLASS}>
                <div class="flex items-center"><span class={SECTION_NUM_CLASS}>04</span><h2 class={SECTION_TITLE_CLASS}>Tech Stack</h2></div>
              </div>
              <div class="mt-8 [&_.skill-card]:rounded-md [&_.skill-card]:border-border/40 [&_.skill-card]:bg-background/50 hover:[&_.skill-card]:bg-muted/20 [&_.skill-card]:shadow-xs">
                  <SkillsShowcase skillsData={SKILLS_DATA} />
              </div>
            </div>
          )}
          
          <div class="mt-20 pt-8 border-t border-border/40 flex justify-center">
              <span class="text-xs text-muted-foreground/30 select-none">End of Page</span>
          </div>

      </div>
    </main>
  </div>
</Layout>

<style>.scrollbar-hide::-webkit-scrollbar{display:none;}.scrollbar-hide{-ms-overflow-style:none;scrollbar-width:none;}</style>

<script is:inline>
  function initSnowToggle() {
    const btns = document.querySelectorAll('.snow-toggle-btn');
    const snowContainer = document.getElementById('snowfall-container');
    if (!btns.length || !snowContainer) return;

    const isEnabled = localStorage.getItem('snowfall_enabled') === 'true';
    
    const updateUI = (active) => {
      snowContainer.style.opacity = active ? '1' : '0';
      document.querySelectorAll('.snow-status-text').forEach(span => {
        span.innerText = active ? 'On' : 'Off';
        active ? span.classList.add('text-foreground') : span.classList.remove('text-foreground');
      });
    };

    updateUI(isEnabled);

    btns.forEach(oldBtn => {
      const newBtn = oldBtn.cloneNode(true);
      oldBtn.parentNode.replaceChild(newBtn, oldBtn);
      newBtn.addEventListener('click', (e) => {
        e.preventDefault();
        const currentState = localStorage.getItem('snowfall_enabled') === 'true';
        const newState = !currentState;
        updateUI(newState);
        localStorage.setItem('snowfall_enabled', String(newState));
      });
    });
  }

  document.addEventListener('astro:page-load', initSnowToggle);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSnowToggle);
  } else {
    initSnowToggle();
  }
</script>