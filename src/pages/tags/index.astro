---
import { TAGS_CONFIG } from '~/config'
import Layout from '~/layouts/Layout.astro'
import { getCollection } from 'astro:content'

const allPosts = await getCollection('posts')
const tags = [...new Set(allPosts.flatMap((post) => post.data.tags || []))]

// 按文章数量排序标签
const sortedTags = tags
  .map((tag) => ({
    name: tag,
    count: allPosts.filter((post) => post.data.tags?.includes(tag)).length,
  }))
  .sort((a, b) => b.count - a.count)

const { title, description, introduce } = TAGS_CONFIG

const maxCount = Math.max(...sortedTags.map((t) => t.count))
---

<Layout {title} {description}>
  <div class="relative z-[1] py-14 px-6 sm:px-8 min-h-[70vh] font-sans">
    
    <!-- 头部区域：工业铭牌风格 -->
    <div class="mb-12 border-b-2 border-foreground/10 pb-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="max-w-2xl">
          <h1 class="text-5xl sm:text-6xl font-bold tracking-tight text-foreground">
            <span class="relative inline-flex h-4 w-4 bg-red-600 rounded-none"></span>
            {title}
          </h1>
          <p class="mt-6 text-base sm:text-lg text-muted-foreground leading-relaxed border-l-4 border-primary/60 pl-4">
            {introduce}
          </p>
        </div>

        <!-- 数据仪表盘 -->
        <div class="flex flex-row md:flex-col gap-4 md:gap-2 text-right font-mono text-sm shrink-0">
          <div class="flex items-center justify-end gap-3 px-3 py-1 bg-muted/30 border border-border">
            <span class="text-muted-foreground uppercase text-xs tracking-wider">Total Tags</span>
            <span class="font-bold text-primary">{tags.length.toString().padStart(3, '0')}</span>
            <span class="icon-[ph--hash] text-foreground/50"></span>
          </div>
          <div class="flex items-center justify-end gap-3 px-3 py-1 bg-muted/30 border border-border">
            <span class="text-muted-foreground uppercase text-xs tracking-wider">Total Posts</span>
            <span class="font-bold text-primary">{allPosts.length.toString().padStart(3, '0')}</span>
            <span class="icon-[ph--article] text-foreground/50"></span>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. 内容区域标记 -->
    <div class="flex items-center gap-4 mb-8">
       <span class="icon-[ph--caret-double-down] text-primary"></span>
       <span class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-muted-foreground/50">
          Feed Sequence // {new Date().getFullYear()}
       </span>
       <div class="h-px bg-border/40 flex-1"></div>
    </div>

    <!-- 标签矩阵：方正网格 -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" data-astro-transition="animate">
      {
        sortedTags.map((tag, index) => {
          // 计算占比，用于硬朗的进度条
          const percent = Math.min((tag.count / maxCount) * 100, 100)
          const indexStr = (index + 1).toString().padStart(2, '0')
          
          return (
            <a
              href={`/tags/${tag.name}`}
              class="group relative flex flex-col justify-between p-5 bg-background border border-border hover:border-primary/60 transition-colors duration-200 rounded-none overflow-hidden"
            >
              <!-- 装饰性角标 -->
              <div class="absolute top-0 right-0 size-3 border-t border-r border-primary/30 group-hover:border-primary transition-colors"></div>
              <div class="absolute bottom-0 left-0 size-3 border-b border-l border-primary/30 group-hover:border-primary transition-colors"></div>

              <div class="flex items-start justify-between mb-6">
                <div class="flex flex-col">
                  <!-- 序号 -->
                  <span class="text-[10px] font-mono text-muted-foreground/60 mb-1">NO.{indexStr}</span>
                  <!-- 标签名 -->
                  <div class="flex items-center gap-2">
                    <span class="icon-[ph--hash] text-primary/70"></span>
                    <span class="font-bold text-lg text-foreground group-hover:text-primary transition-colors tracking-tight">
                      {tag.name}
                    </span>
                  </div>
                </div>
                <!-- 数量Badge -->
                <div class="font-mono text-sm bg-muted px-2 py-0.5 border border-border text-foreground group-hover:bg-primary group-hover:text-primary-foreground transition-colors">
                  {tag.count}
                </div>
              </div>

              <!-- 工业风进度条：实心硬朗线条 -->
              <div class="w-full relative">
                 <div class="flex justify-between text-[10px] text-muted-foreground/50 font-mono mb-1">
                    <span>REQ</span>
                    <span>{percent.toFixed(0)}%</span>
                 </div>
                 <div class="h-1.5 w-full bg-muted overflow-hidden">
                    <div
                      class="h-full bg-primary transition-all duration-300 ease-out"
                      style={`width: ${percent}%`}
                    />
                 </div>
              </div>
              
              <!-- Hover时的背景微弱扫描效果 -->
              <div class="absolute inset-0 bg-primary/5 opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none" />
            </a>
          )
        })
      }
    </div>

    {
      tags.length === 0 && (
        <div class="flex flex-col items-center justify-center py-20 border border-dashed border-border mt-8">
          <span class="icon-[ph--warning-octagon] size-12 text-muted-foreground/30 mb-4" />
          <p class="font-mono text-muted-foreground uppercase tracking-widest">Data Not Found</p>
        </div>
      )
    }
  </div>
</Layout>