---
import { TAGS_CONFIG } from '~/config'
import Layout from '~/layouts/Layout.astro'
import { getCollection } from 'astro:content'
import { SECTION_HEADER_CLASS, SECTION_TITLE_CLASS, SECTION_NUM_CLASS, SECTION_META_CLASS } from '~/lib/ui'
import PageAside from '~/components/base/PageAside.astro'

const allPosts = await getCollection('posts')
const tags = [...new Set(allPosts.flatMap((post) => post.data.tags || []))]
const sortedTags = tags
  .map((tag) => ({ name: tag, count: allPosts.filter((post) => post.data.tags?.includes(tag)).length }))
  .sort((a, b) => b.count - a.count)
const { title, description, introduce } = TAGS_CONFIG
const maxCount = Math.max(...(sortedTags.map((t) => t.count).length > 0 ? sortedTags.map((t) => t.count) : [0]))
const totalTags = tags.length.toString().padStart(2, '0')
const totalPosts = allPosts.length.toString().padStart(2, '0')
const lastUpdate = new Date().toLocaleDateString('en-US', { month: 'short', day: '2-digit' })
---

<Layout {title} {description}>
  <div class="relative font-sans flex flex-col lg:flex-row min-h-screen max-w-[1920px] mx-auto">
    <PageAside
      statusText="Indexing"
      statusHasPing={false}
      statusVariant="primary"
      {title}
      subtitleIcon="icon-[ph--tag]"
      subtitleText="Tags Index"
      identityTags={[
        { icon: 'icon-[ph--tag]', label: `${totalTags} Tags` },
        { icon: 'icon-[ph--article]', label: `${totalPosts} Posts` },
        { icon: 'icon-[ph--arrows-clockwise]', label: lastUpdate },
      ]}
      intro={introduce}
      statsLabel="INDEX STATUS"
      statsMeta={`${totalTags} TAGS`}
      stats={[
        { value: totalTags, label: 'Tags' },
        { value: totalPosts, label: 'Posts' },
        { value: lastUpdate, label: 'Last Rebuild' },
      ]}
    />

    <main class="w-full lg:w-1/2 lg:flex-1 z-10 flex flex-col fade-up animation-delay-150">
      <div class="px-5 py-10 sm:px-8 lg:px-10 lg:py-14 xl:px-12 flex-1">
        <div class={SECTION_HEADER_CLASS}>
          <div class="flex items-center"><span class={SECTION_NUM_CLASS}>01</span><h2 class={SECTION_TITLE_CLASS}>All Tags</h2></div>
          <span class={SECTION_META_CLASS}>Tag_Cloud</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6 mt-8 fade-up animation-delay-200">
          {
            sortedTags.map((tag, index) => {
              const percent = sortedTags.length > 0 ? Math.min((tag.count / maxCount) * 100, 100) : 0
              return (
                <a
                  href={`/tags/${tag.name}`}
                  class="group relative flex h-32 flex-col justify-between border border-foreground/25 bg-background p-5 transition-colors duration-200 fade-up hover:bg-foreground hover:text-background"
                  style={`animation-delay: ${index * 40}ms`}
                  rel="noopener noreferrer"
                >
                  <div class="z-10 flex items-start justify-between">
                    <h3 class="text-lg font-bold capitalize tracking-[-0.03em] text-current transition-colors group-hover:text-primary">
                      {tag.name}
                    </h3>
                    <span class="inline-flex items-center justify-center border border-current/30 px-2 py-0.5 font-mono text-[10px] tabular-nums text-current">
                      {tag.count}
                    </span>
                  </div>
                  <div class="mt-4 h-1 w-full overflow-hidden bg-muted group-hover:bg-background/15">
                    <div class="h-full bg-primary transition-all duration-500 ease-out" style={`width: ${percent}%`} />
                  </div>
                </a>
              )
            })
          }
        </div>

        {
          tags.length === 0 && (
            <div class="mt-8 flex flex-col items-center justify-center border border-foreground/25 bg-transparent py-24">
              <span class="icon-[ph--warning-circle] mb-4 size-8 text-muted-foreground/40" />
              <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-muted-foreground">No tags found.</p>
            </div>
          )
        }
      </div>
    </main>
  </div>
</Layout>
