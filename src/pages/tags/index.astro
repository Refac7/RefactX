---
import { TAGS_CONFIG } from '~/config'
import Layout from '~/layouts/Layout.astro'
import { getCollection } from 'astro:content'

const allPosts = await getCollection('posts')
const tags =[...new Set(allPosts.flatMap((post) => post.data.tags || []))]
const sortedTags = tags.map((tag) => ({ name: tag, count: allPosts.filter((post) => post.data.tags?.includes(tag)).length })).sort((a, b) => b.count - a.count)
const { title, description, introduce } = TAGS_CONFIG
const maxCount = Math.max(...(sortedTags.map((t) => t.count).length > 0 ? sortedTags.map((t) => t.count) :[0]))
const totalTags = tags.length.toString().padStart(2, '0')
const totalPosts = allPosts.length.toString().padStart(2, '0')
const lastUpdate = new Date().toLocaleDateString('en-US', { month: 'short', day: '2-digit' })

const SECTION_HEADER_CLASS = "flex items-center justify-between border-b border-border/40 pb-4 mb-8 select-none"
const SECTION_TITLE_CLASS = "text-lg font-semibold tracking-tight text-foreground"
const SECTION_NUM_CLASS = "inline-flex items-center justify-center rounded-full bg-muted/60 px-2.5 py-0.5 text-xs font-medium text-muted-foreground mr-3"
---

<Layout title={title} description={description}>
  <div class="relative font-sans flex flex-col lg:flex-row min-h-screen max-w-[1920px] mx-auto">
    <aside class="w-full lg:w-1/3 lg:sticky lg:top-0 lg:h-screen flex flex-col xl:border-r border-border/40 z-20 bg-background">
      
      <div class="flex flex-1 lg:overflow-y-auto scrollbar-hide flex-col">
        <div class="p-6 lg:p-8 xl:p-12 pb-0 shrink-0 fade-up">
          <span class="inline-flex items-center rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary select-none">
            Indexing
          </span>
        </div>
        
        <div class="flex-1 flex flex-col justify-end lg:justify-center p-6 lg:p-8 xl:p-12 min-h-[300px] lg:min-h-[250px] fade-up animation-delay-100">
          <h1 class="text-5xl sm:text-6xl xl:text-7xl font-bold tracking-tight text-foreground leading-[1.1] mb-6 select-none">{title}</h1>
          <div class="flex items-center gap-2 text-sm text-muted-foreground"><span class="icon-[ph--tag] size-4"></span><span>Tags Index</span></div>
        </div>
        
        <div class="shrink-0 p-6 lg:p-8 xl:p-12 fade-up animation-delay-150">
          <p class="text-sm text-muted-foreground leading-relaxed">{introduce}</p>
        </div>
      </div>
      
      <div class="flex flex-col border-t border-border/40 shrink-0 fade-up animation-delay-200">
        <div class="flex">
          <div class="flex-1 flex flex-col items-start justify-center p-8 lg:p-10 xl:p-14 bg-background border-r border-b border-border/40 hover:bg-muted/30 transition-colors">
            <span class="text-2xl font-semibold text-foreground tracking-tight">{totalTags}</span>
            <span class="text-xs text-muted-foreground mt-1">Tags</span>
          </div>
          <div class="flex-1 flex flex-col items-start justify-center p-8 lg:p-10 xl:p-14 bg-background border-b border-border/40 hover:bg-muted/30 transition-colors">
            <span class="text-2xl font-semibold text-foreground tracking-tight">{totalPosts}</span>
            <span class="text-xs text-muted-foreground mt-1">Posts</span>
          </div>
        </div>
        <div class="flex items-center justify-between p-6 lg:p-8 bg-background hover:bg-muted/30 transition-colors">
          <span class="text-xs text-muted-foreground font-medium">Last Rebuild</span>
          <span class="text-sm font-semibold text-foreground">{lastUpdate}</span>
        </div>
      </div>
    </aside>

    <main class="w-full lg:w-2/3 z-10 flex flex-col fade-up animation-delay-150">
      <div class="p-6 lg:p-10 xl:p-16 2xl:p-20 flex-1">
        <div class={SECTION_HEADER_CLASS}>
          <div class="flex items-center"><span class={SECTION_NUM_CLASS}>01</span><h2 class={SECTION_TITLE_CLASS}>All Tags</h2></div>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6 mt-8 fade-up animation-delay-200">
          {sortedTags.map((tag, index) => {
            const percent = sortedTags.length > 0 ? Math.min((tag.count / maxCount) * 100, 100) : 0
            return (
              <a 
                href={`/tags/${tag.name}`} 
                class="group relative flex flex-col justify-between p-6 bg-background/50 border border-border/40 rounded-lg hover:bg-muted/30 hover:shadow-xs transition-all duration-300 h-32 fade-up hover:-translate-y-0.5" 
                style={`animation-delay: ${index * 50}ms`}
                rel="noopener noreferrer"
              >
                <div class="flex justify-between items-start z-10">
                  <h3 class="font-semibold text-lg text-foreground group-hover:text-primary transition-colors tracking-tight capitalize">{tag.name}</h3>
                  <span class="inline-flex items-center justify-center rounded-full bg-muted/60 px-2.5 py-0.5 text-xs font-medium text-muted-foreground">{tag.count}</span>
                </div>
                <div class="w-full h-1.5 bg-muted/50 rounded-full overflow-hidden mt-4">
                  <div class="h-full bg-primary/60 group-hover:bg-primary transition-all duration-500 ease-out rounded-full" style={`width: ${percent}%`}></div>
                </div>
              </a>
            )
          })}
        </div>
        
        {tags.length === 0 && (
          <div class="flex flex-col items-center justify-center py-24 rounded-xl border border-border/40 bg-muted/10 mt-8">
            <span class="icon-[ph--warning-circle] size-10 text-muted-foreground/40 mb-4" />
            <p class="text-sm text-muted-foreground">No tags found.</p>
          </div>
        )}
      </div>
    </main>
  </div>
</Layout>
<style>.scrollbar-hide::-webkit-scrollbar{display:none;}.scrollbar-hide{-ms-overflow-style:none;scrollbar-width:none;}</style>