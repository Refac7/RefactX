---
import { TAGS_CONFIG } from '~/config'
import Layout from '~/layouts/Layout.astro'
import { getCollection } from 'astro:content'

const allPosts = await getCollection('posts')
const tags = [...new Set(allPosts.flatMap((post) => post.data.tags || []))]

// 按文章数量排序标签
const sortedTags = tags
  .map((tag) => ({
    name: tag,
    count: allPosts.filter((post) => post.data.tags?.includes(tag)).length,
  }))
  .sort((a, b) => b.count - a.count)

const { title, description, introduce } = TAGS_CONFIG

// 统计数据计算
const maxCount = Math.max(...sortedTags.map((t) => t.count))
const totalTags = tags.length.toString().padStart(3, '0');
const totalPosts = allPosts.length.toString().padStart(3, '0');
const lastUpdate = new Date().toLocaleDateString('en-US', { month: 'short', day: '2-digit' });
---

<Layout {title} {description}>
  <div class="relative z-[1] py-12 px-6 sm:px-8 min-h-[70vh] font-sans">
    
    
    <div class="pb-10">
      
      
      <div class="flex items-center justify-between mb-8 text-[10px] font-mono uppercase tracking-widest text-muted-foreground/60">
        <span>// SYSTEM_INDEX // KEYWORDS</span>
        <div class="flex items-center gap-2 text-primary">
             <span class="relative flex h-2 w-2">
               <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-500 opacity-75"></span>
               <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-600"></span>
             </span>
             <span class="font-bold text-foreground">INDEXING</span>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-end">
        
        <div class="lg:col-span-7">
          <h1 class="text-7xl md:text-8xl font-bold tracking-tighter text-foreground leading-[0.9] -ml-1">
            {title}<span class="text-primary">.</span>
          </h1>
        </div>

        
        <div class="lg:col-span-5 flex flex-col gap-6">
          <div class="border-l border-primary/40 pl-5">
             <p class="text-base sm:text-lg text-muted-foreground leading-relaxed">
              {introduce}
             </p>
          </div>

          
          <div class="grid grid-cols-2 gap-px bg-border/50 border border-border">
            
            <div class="bg-background/50 p-3 flex flex-col gap-1">
              <span class="text-[9px] uppercase tracking-widest text-muted-foreground/70 font-mono">Index_Count</span>
              <span class="text-2xl font-mono font-bold text-foreground">{totalTags}</span>
            </div>
            
            
            <div class="bg-background/50 p-3 flex flex-col gap-1">
              <span class="text-[9px] uppercase tracking-widest text-muted-foreground/70 font-mono">Linked_Files</span>
              <span class="text-2xl font-mono font-bold text-foreground">{totalPosts}</span>
            </div>
            
            
            <div class="col-span-2 bg-background/50 p-2 flex items-center justify-between border-t border-border/40">
               <span class="text-[9px] uppercase tracking-widest text-muted-foreground/70 font-mono">Last_Rebuild</span>
               <span class="text-xs font-mono font-bold text-primary">{lastUpdate}</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    
    <div class="flex items-end gap-4 mb-10 select-none">
       <span class="font-mono text-4xl font-bold text-muted-foreground/10 leading-none -mb-1">04</span>
       <span class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-muted-foreground/50 mb-1">
          Memory_Blocks
       </span>
       <div class="h-px bg-gradient-to-r from-border to-transparent flex-1 mb-1.5"></div>
    </div>

    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 " data-astro-transition="animate">
      {
        sortedTags.map((tag, index) => {
          // 计算占比
          const percent = Math.min((tag.count / maxCount) * 100, 100)
          const indexStr = `IDX-${(index + 1).toString().padStart(2, '0')}`;
          
          return (
            <a
              href={`/tags/${tag.name}`}
              class="group relative flex flex-col justify-between p-5 h-32
                     bg-background border border-border/40 hover:border-primary/50
                     transition-all duration-300 rounded-none overflow-hidden"
            >
              
              <div class="absolute top-0 right-0 size-2 border-t border-r border-primary/20 group-hover:border-primary transition-colors"></div>
              <div class="absolute bottom-0 left-0 size-2 border-b border-l border-primary/20 group-hover:border-primary transition-colors"></div>

              
              <div class="flex justify-between items-start z-10">
                 <span class="text-[10px] font-mono text-muted-foreground/40 tracking-widest group-hover:text-primary/70 transition-colors">
                    {indexStr}
                 </span>
                 <span class="icon-[ph--arrow-up-right] size-3 text-muted-foreground/20 group-hover:text-primary transition-colors"></span>
              </div>

              
              <div class="relative z-10 flex items-baseline gap-2 mt-auto mb-3">
                 <h3 class="font-bold text-xl text-foreground group-hover:text-primary transition-colors tracking-tight">
                    {tag.name}
                 </h3>
                 <span class="text-xs font-mono text-muted-foreground/50">
                    ({tag.count})
                 </span>
              </div>

              
              <div class="w-full h-1 bg-muted relative z-10 overflow-hidden">
                 <div 
                   class="h-full bg-primary/80 group-hover:bg-primary transition-all duration-500 ease-out" 
                   style={`width: ${percent}%`}
                 ></div>
              </div>
              
              
              <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none" />
            </a>
          )
        })
      }
    </div>

    
    {
      tags.length === 0 && (
        <div class="flex flex-col items-center justify-center py-24 border border-dashed border-border/40 mt-8 bg-muted/5">
          <span class="icon-[ph--warning-octagon] size-10 text-muted-foreground/30 mb-4" />
          <p class="font-mono text-sm text-muted-foreground/50 uppercase tracking-widest">Database Empty // No Keywords</p>
        </div>
      )
    }

    
    <div class="mt-16 flex justify-center border-t border-dashed border-border/40 pt-6">
        <span class="font-mono text-[10px] text-muted-foreground/30 uppercase tracking-[0.5em]">
            End of Index
        </span>
    </div>

  </div>
</Layout>