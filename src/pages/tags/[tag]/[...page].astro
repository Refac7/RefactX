---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { getCollection } from 'astro:content'
import { POSTS_CONFIG } from '~/config'
import { postsSort } from '~/lib/utils'
import Layout from '~/layouts/Layout.astro'
import Pagination from '~/components/base/Pagination.astro'
import List from '~/components/posts/card/List.astro'
import TerminalBuffer from '~/components/base/TerminalBuffer.astro'

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allPosts = await getCollection('posts')
  const sortedPosts = postsSort(allPosts)
  const uniqueTags =[...new Set(sortedPosts.flatMap((post) => post.data.tags || []))]
  return uniqueTags.map((tag) => {
      const tagPosts = sortedPosts.filter((post) => post.data.tags?.includes(tag))
      return paginate(tagPosts, { params: { tag }, props: { tag }, pageSize: POSTS_CONFIG.tagsPageConfig.size })
  }).flat()
}

interface Props { page: Page<CollectionEntry<'posts'>>; tag: string; }
const { page, tag } = Astro.props
const description = `Archive filtered by tag: #${tag}`
const progressPercent = Math.round((page.currentPage / page.lastPage) * 100)

const SECTION_HEADER_CLASS = "flex items-end justify-between border-b pb-4 mb-8 select-none"
const SECTION_TITLE_CLASS = "font-mono text-sm font-bold uppercase tracking-widest text-foreground/80"
const SECTION_NUM_CLASS = "font-mono text-xs text-primary mr-3"
---

<Layout title={`#${tag}`} {description}>
  <div class="relative font-sans flex flex-col lg:flex-row min-h-screen max-w-[1920px] mx-auto">
    <aside class="w-full lg:w-1/3 lg:sticky lg:top-0 lg:h-screen flex flex-col lg:border-r z-20 bg-background lg:shadow-[4px_0_24px_-12px_rgba(0,0,0,0.1)] dark:shadow-none border-b border-border/60 lg:border-none">
      
      <div class="flex flex-1 lg:overflow-y-auto scrollbar-hide flex-col">
        <div class="p-6 lg:p-8 xl:p-12 pb-0 shrink-0">
          <div class="flex flex-row justify-between items-start text-[10px] font-mono uppercase tracking-widest text-muted-foreground/60 select-none">
            <span>// SYSTEM_QUERY // FILTER_MODE</span>
            <div class="flex items-center gap-2 text-primary">
              <span class="size-1.5 bg-primary rounded-none animate-pulse"></span>
              <span class="font-bold text-foreground">FILTER_ACTIVE</span>
            </div>
          </div>
        </div>
        
        <div class="flex-1 flex flex-col justify-end lg:justify-center p-6 lg:p-8 xl:p-12 min-h-[300px] lg:min-h-[250px]">
          <div class="flex items-center gap-3 text-muted-foreground/50 mb-4"><span class="icon-[ph--folder-open-bold] text-xl"></span><span class="font-mono text-sm tracking-wider">DIRECTORY</span></div>
          <h1 class="text-6xl sm:text-7xl lg:text-8xl font-black tracking-tighter text-foreground leading-[0.8] mb-6 -ml-1 select-none break-all"><span class="text-primary/40 mr-2">#</span>{tag.toUpperCase()}<span class="text-primary">.</span></h1>
          <div class="h-px w-24 bg-foreground/20 mt-2 mb-4"></div>
          <div class="flex items-center gap-2 text-xs font-mono text-muted-foreground/60 uppercase"><span class="icon-[ph--funnel-bold] size-4"></span><span>Query Results</span></div>
        </div>
        
        <div class="shrink-0 p-6 lg:p-8 xl:p-12 bg-muted/5 border-t border-dashed border-border/40">
          <span class="block text-[10px] uppercase text-muted-foreground/60 font-mono tracking-wider mb-4">// CURRENT_PATH</span>
          <div class="font-mono text-sm text-muted-foreground flex items-center gap-2 flex-wrap leading-loose">
            <a href="/" class="hover:text-primary transition-colors">root</a><span class="text-muted-foreground/30">/</span><a href="/tags" class="hover:text-primary transition-colors">tags</a><span class="text-muted-foreground/30">/</span><span class="text-foreground font-bold bg-muted px-1">{tag}</span>
          </div>
          <a href="/tags" class="group flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-muted-foreground hover:text-primary transition-colors mt-6 w-fit"><span class="icon-[ph--arrow-u-up-left] size-4"></span><span class="border-b border-transparent group-hover:border-primary">Return_Index</span></a>
        </div>
      </div>
      
      <div class="grid grid-cols-2 bg-border/40 gap-px border-t border-border/40 shrink-0">
        <div class="group relative flex flex-col items-center justify-center p-6 bg-background hover:bg-muted/10 transition-colors h-32 lg:h-28 xl:h-32">
          <span class="text-3xl font-mono font-bold text-foreground tracking-tighter group-hover:text-primary transition-colors">{page.total}</span>
          <span class="text-[9px] font-mono uppercase tracking-widest text-muted-foreground mt-2">Hits_Found</span>
          <div class="absolute top-0 right-0 p-1 opacity-0 group-hover:opacity-100 transition-opacity"><div class="w-1.5 h-1.5 bg-primary"></div></div>
        </div>
        <div class="group relative flex flex-col items-center justify-center p-6 bg-background hover:bg-muted/10 transition-colors h-32 lg:h-28 xl:h-32">
          <div class="flex items-baseline gap-1 text-2xl font-mono font-bold text-foreground group-hover:text-primary transition-colors"><span>{page.currentPage.toString().padStart(2, '0')}</span><span class="text-xs text-muted-foreground/40 font-mono">/ {page.lastPage.toString().padStart(2, '0')}</span></div>
          <span class="text-[9px] font-mono uppercase tracking-widest text-muted-foreground mt-2">Page_View</span>
          <div class="absolute bottom-0 left-0 p-1 opacity-0 group-hover:opacity-100 transition-opacity"><div class="w-1.5 h-1.5 bg-primary"></div></div>
        </div>
      </div>
    </aside>

    <main class="w-full lg:w-2/3 z-10 flex flex-col">
      <div class="p-6 lg:p-10 xl:p-16 2xl:p-20 flex-1 flex flex-col">
        <div class={SECTION_HEADER_CLASS}>
          <div class="flex items-center"><span class={SECTION_NUM_CLASS}>01</span><h2 class={SECTION_TITLE_CLASS}>Filtered_Results</h2></div>
          <div class="hidden sm:block h-px flex-1 bg-border/40 ml-6 max-w-[200px]"></div>
        </div>
        <TerminalBuffer layout='list' count={6} delay={500}>
          <div class="space-y-8 min-h-[40vh] mt-8 flex-1">
            <List posts={page.data} type={POSTS_CONFIG.tagsPageConfig.type} heroImageLayout={POSTS_CONFIG.tagsPageConfig?.heroImageLayout} />
          </div>
        </TerminalBuffer>

        <div class="mt-20 pt-8 border-t border-dashed">
          <div class="mb-8">
              <div class="flex justify-between text-[10px] font-mono uppercase text-muted-foreground/50 mb-2"><span>Reading_Buffer</span><span>{progressPercent}%</span></div>
              <div class="w-full h-2 bg-muted/20 border border-border/40 relative overflow-hidden">
                <div class="absolute top-0 left-0 h-full bg-primary transition-all duration-500 ease-out" style={`width: ${progressPercent}%`}><div class="w-full h-full bg-[linear-gradient(45deg,transparent_25%,rgba(255,255,255,0.2)_50%,transparent_75%,transparent_100%)] bg-[size:10px_10px]"></div></div>
              </div>
          </div>
          <div class="flex flex-col md:flex-row items-center justify-between gap-6">
              <div class="hidden md:flex flex-col gap-1"><span class="text-[10px] font-mono uppercase text-muted-foreground/50 tracking-widest">Status: Ready</span><span class="text-xs font-bold text-muted-foreground font-mono">Awaiting Input...</span></div>
              <div class="flex-1 w-full md:w-auto flex justify-center md:justify-end"><Pagination {page} baseUrl="/posts" /></div>
          </div>
          <div class="flex justify-center mt-12"><span class="font-mono text-[10px] text-muted-foreground/20 uppercase tracking-[0.5em] select-none">// End of Segment //</span></div>
        </div>
      </div>
    </main>
  </div>
</Layout>
<style>.scrollbar-hide::-webkit-scrollbar{display:none;}.scrollbar-hide{-ms-overflow-style:none;scrollbar-width:none;}</style>