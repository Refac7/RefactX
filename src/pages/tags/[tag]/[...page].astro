---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { getCollection } from 'astro:content'
import { POSTS_CONFIG } from '~/config'
import { postsSort } from '~/lib/utils'
import { SECTION_HEADER_CLASS, SECTION_TITLE_CLASS, SECTION_NUM_CLASS, SECTION_META_CLASS } from '~/lib/ui'
import Layout from '~/layouts/Layout.astro'
import Pagination from '~/components/base/Pagination.astro'
import List from '~/components/posts/card/List.astro'
import PageAside from '~/components/base/PageAside.astro'

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allPosts = await getCollection('posts')
  const sortedPosts = postsSort(allPosts)
  const uniqueTags = [...new Set(sortedPosts.flatMap((post) => post.data.tags || []))]
  return uniqueTags
    .map((tag) => {
      const tagPosts = sortedPosts.filter((post) => post.data.tags?.includes(tag))
      return paginate(tagPosts, { params: { tag }, props: { tag }, pageSize: POSTS_CONFIG.tagsPageConfig.size })
    })
    .flat()
}

interface Props {
  page: Page<CollectionEntry<'posts'>>
  tag: string
}
const { page, tag } = Astro.props
const description = `Archive filtered by tag: #${tag}`
const progressPercent = Math.round((page.currentPage / page.lastPage) * 100)
---

<Layout title={`#${tag}`} {description}>
  <div class="relative font-sans flex flex-col lg:flex-row min-h-screen max-w-[1920px] mx-auto">
    <PageAside
      statusText="Filter Active"
      statusHasPing={false}
      statusVariant="primary"
      title={tag}
      subtitleIcon="icon-[ph--funnel]"
      subtitleText="Query Results"
      identityTags={[
        { icon: 'icon-[ph--folder]', label: 'Directory' },
        { icon: 'icon-[ph--hash]', label: `#${tag}` },
        { icon: 'icon-[ph--article]', label: `${page.total} Found` },
      ]}
      statsLabel="FILTER STATUS"
      statsMeta={`${page.total} FOUND`}
      stats={[
        { value: String(page.total), label: 'Found' },
        { value: `${page.currentPage} / ${page.lastPage}`, label: 'Page' },
      ]}
    />

    <main class="w-full lg:w-1/2 lg:flex-1 z-10 flex flex-col fade-up animation-delay-100">
      <div class="px-5 py-10 sm:px-8 lg:px-10 lg:py-14 xl:px-12 flex-1 flex flex-col">
        <div class={SECTION_HEADER_CLASS}>
          <div class="flex items-center">
            <span class={SECTION_NUM_CLASS}>01</span><h2 class={SECTION_TITLE_CLASS}>Filtered Results</h2>
          </div>
          <span class={SECTION_META_CLASS}>Query_Output</span>
        </div>

        <!-- Breadcrumb -->
        <div class="-mt-4 mb-6 flex flex-wrap items-center gap-2 font-mono text-[10px] uppercase tracking-[0.12em] text-muted-foreground">
          <a href="/" class="transition-colors hover:text-primary">home</a>
          <span class="text-foreground/25">/</span>
          <a href="/tags" class="transition-colors hover:text-primary">tags</a>
          <span class="text-foreground/25">/</span>
          <span class="bg-primary px-2 py-0.5 font-medium text-primary-foreground">{tag}</span>
        </div>

        <div class="space-y-8 min-h-[40vh] flex-1 fade-up animation-delay-200">
          <List posts={page.data} type={POSTS_CONFIG.tagsPageConfig.type} heroImageLayout={POSTS_CONFIG.tagsPageConfig?.heroImageLayout} />
        </div>

        <div class="border-t-2 border-foreground pt-6">
          <div class="mb-2 flex justify-between font-mono text-[9px] uppercase tracking-[0.18em] text-muted-foreground">
            <span>Reading Progress</span><span class="tabular-nums text-foreground">{progressPercent}%</span>
          </div>
          <div class="mb-8 h-1.5 w-full overflow-hidden bg-muted">
            <div class="h-full bg-primary transition-all duration-500 ease-out" style={`width: ${progressPercent}%`}></div>
          </div>
          <div class="flex flex-col items-center justify-between gap-6 md:flex-row">
            <div class="hidden flex-col gap-1 md:flex">
              <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-foreground">Navigation</span>
              <span class="text-xs text-muted-foreground">Select a page to continue.</span>
            </div>
            <div class="flex w-full flex-1 justify-center md:w-auto md:justify-end"><Pagination {page} baseUrl={`/tags/${tag}`} /></div>
          </div>
        </div>
      </div>
    </main>
  </div>
</Layout>
