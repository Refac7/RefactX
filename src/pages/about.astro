---
import Layout from '~/layouts/Layout.astro'
import aboutData from '~/content/data/about.json'
import { SECTION_HEADER_CLASS, SECTION_TITLE_CLASS, SECTION_NUM_CLASS, SECTION_META_CLASS } from '~/lib/ui'
import PageAside from '~/components/base/PageAside.astro'

interface AttrItem {
  label: string
  value: string
  icon: string
}
interface SkillGroup {
  category: string
  items: string[]
}
interface EquipItem {
  type: string
  name: string
  desc: string
}
interface GameItem {
  title: string
  platform: string
  status: string
  hours: string
  color: string
}
interface CourseItem {
  time: string
  name: string
  location: string
}
interface ScheduleDay {
  day: string
  label: string
  courses: CourseItem[]
}
interface TodoItem {
  task: string
  completed: boolean
}

const { title, description, introduce } = aboutData

const profile = {
  name: aboutData.profileName,
  avatar: aboutData.profileAvatar,
  role: aboutData.profileRole,
  bio: aboutData.profileBio,
}
const physicalAttributes: AttrItem[] = aboutData.physicalAttributes
const skills: SkillGroup[] = aboutData.skills
const equipment: EquipItem[] = aboutData.equipment
const games: GameItem[] = aboutData.games
const courseSchedule: ScheduleDay[] = aboutData.courseSchedule
const todos: TodoItem[] = aboutData.todos
---

<Layout {title} {description}>
  <div class="relative font-sans flex flex-col lg:flex-row min-h-screen max-w-[1920px] mx-auto">
    <PageAside
      statusText="Alive"
      statusVariant="success"
      {title}
      subtitleIcon="icon-[ph--user]"
      subtitleText="Profile Overview"
      identityTags={[
        { icon: 'icon-[ph--code]', label: 'Developer' },
        { icon: 'icon-[ph--pen-nib]', label: 'Creator' },
        { icon: 'icon-[ph--map-pin]', label: 'Earth' },
      ]}
      intro={introduce}
      statsLabel="OPERATOR STATUS"
      statsMeta="2 FIELDS"
      stats={[
        { value: 'Carbon-based', label: 'Form' },
        { value: 'Earth / UTC+8', label: 'Location' },
      ]}
    />

    <main class="w-full lg:w-1/2 lg:flex-1 z-10 flex flex-col fade-up animation-delay-100">
      <div class="px-5 py-10 sm:px-8 lg:px-10 lg:py-14 xl:px-12 flex-1 flex flex-col">
        <div class="mb-20 fade-up animation-delay-150">
          <div class={SECTION_HEADER_CLASS}>
            <div class="flex items-center"><span class={SECTION_NUM_CLASS}>01</span><h2 class={SECTION_TITLE_CLASS}>The Operator</h2></div>
            <span class={SECTION_META_CLASS}>Identity_Module</span>
          </div>

          <div class="flex flex-col items-start gap-8 border border-foreground/25 bg-background p-5 md:flex-row lg:gap-12 lg:p-8">
            <div class="group relative shrink-0">
              <img
                src={profile.avatar}
                alt={profile.name}
                class="size-24 border border-foreground/20 object-cover grayscale transition-all duration-300 group-hover:grayscale-0"
              />
            </div>

            <div class="w-full flex-1">
              <div class="mb-2 flex items-center gap-3">
                <h3 class="text-2xl font-bold tracking-[-0.04em] text-foreground">{profile.name}</h3>
                <span
                  class="hidden items-center border border-foreground/25 px-2 py-0.5 font-mono text-[9px] uppercase tracking-[0.14em] text-muted-foreground sm:inline-flex"
                  >Admin</span
                >
              </div>
              <p class="mb-4 font-mono text-[10px] uppercase tracking-[0.16em] text-muted-foreground">{profile.role}</p>
              <div
                class="prose prose-sm dark:prose-invert prose-p:leading-relaxed prose-p:text-muted-foreground max-w-none font-sans whitespace-pre-wrap"
              >
                {profile.bio}
              </div>

              <div class="mt-8 grid grid-cols-2 gap-px border-t border-foreground/20 bg-foreground/20 pt-px sm:grid-cols-4">
                {
                  physicalAttributes.map((attr) => (
                    <div class="flex flex-col bg-background p-3 transition-colors hover:bg-muted/40">
                      <span class="mb-1.5 flex items-center gap-1.5 font-mono text-[9px] uppercase tracking-[0.14em] text-muted-foreground select-none">
                        <span class={`${attr.icon} size-3.5`} />
                        {attr.label}
                      </span>
                      <span class="text-sm font-semibold text-foreground">{attr.value}</span>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>

        <div class="mb-20 fade-up animation-delay-200">
          <div class={SECTION_HEADER_CLASS}>
            <div class="flex items-center"><span class={SECTION_NUM_CLASS}>02</span><h2 class={SECTION_TITLE_CLASS}>Skill Matrix</h2></div>
            <span class={SECTION_META_CLASS}>Capability_Scan</span>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
            {
              skills.map((skillGroup) => (
                <div class="group border border-foreground/25 bg-background p-5 transition-colors hover:border-primary">
                  <h4 class="mb-4 flex items-center gap-2 text-sm font-bold tracking-[-0.02em] text-foreground">
                    <span class="size-1.5 bg-primary" />
                    {skillGroup.category}
                  </h4>
                  <div class="flex flex-wrap gap-1.5">
                    {skillGroup.items.map((item) => (
                      <span class="inline-flex cursor-default items-center border border-foreground/20 bg-transparent px-2 py-1 font-mono text-[10px] uppercase tracking-[0.08em] text-muted-foreground transition-colors group-hover:border-foreground/35 group-hover:text-foreground">
                        {item}
                      </span>
                    ))}
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <div class="mb-20 fade-up" style="animation-delay: 250ms">
          <div class={SECTION_HEADER_CLASS}>
            <div class="flex items-center">
              <span class={SECTION_NUM_CLASS}>03</span><h2 class={SECTION_TITLE_CLASS}>Hardware Loadout</h2>
            </div>
            <span class={SECTION_META_CLASS}>Device_Registry</span>
          </div>
          <div class="overflow-hidden border border-foreground/25 bg-background">
            {
              equipment.map((item, index) => (
                <div
                  class={`flex flex-col justify-between px-4 py-3 transition-colors hover:bg-muted/40 sm:flex-row sm:items-center ${index !== equipment.length - 1 ? 'border-b border-foreground/15' : ''}`}
                >
                  <div class="mb-2 flex shrink-0 items-center gap-4 sm:mb-0">
                    <span class="w-6 font-mono text-[10px] tabular-nums text-primary">{String(index + 1).padStart(2, '0')}</span>
                    <span class="w-24 font-mono text-[10px] uppercase tracking-[0.14em] text-muted-foreground">{item.type}</span>
                  </div>
                  <div class="flex shrink-0 flex-col pl-10 sm:items-end sm:pl-0 sm:text-right">
                    <span class="text-sm font-bold tracking-[-0.01em] text-foreground">{item.name}</span>
                    <span class="text-xs text-muted-foreground">{item.desc}</span>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <div class="mb-20 fade-up" style="animation-delay: 300ms">
          <div class={SECTION_HEADER_CLASS}>
            <div class="flex items-center"><span class={SECTION_NUM_CLASS}>04</span><h2 class={SECTION_TITLE_CLASS}>Gaming Log</h2></div>
            <span class={SECTION_META_CLASS}>Playback_Archive</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {
              games.map((game) => (
                <div class="flex min-h-30 flex-col justify-between border border-foreground/25 bg-background p-5 transition-colors hover:border-primary">
                  <div class="mb-4 flex items-start justify-between">
                    <span class="text-base font-bold tracking-[-0.02em] text-foreground">{game.title}</span>
                    <span class="border border-foreground/25 px-2 py-0.5 font-mono text-[9px] tabular-nums text-muted-foreground">
                      {game.hours}
                    </span>
                  </div>
                  <div class="mt-auto flex items-center justify-between">
                    <span class="font-mono text-[10px] uppercase tracking-[0.12em] text-muted-foreground">{game.platform}</span>
                    <div class="flex items-center gap-1.5">
                      <div class={`size-1.5 ${game.color} ${game.status === 'Playing' ? 'animate-pulse' : ''}`} />
                      <span class="font-mono text-[9px] uppercase tracking-[0.12em] text-muted-foreground">{game.status}</span>
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <div class="mb-20 fade-up" style="animation-delay: 350ms">
          <div class={SECTION_HEADER_CLASS}>
            <div class="flex items-center"><span class={SECTION_NUM_CLASS}>05</span><h2 class={SECTION_TITLE_CLASS}>Schedule</h2></div>
            <span class={SECTION_META_CLASS}>Time_Allocation</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-5 gap-4">
            {
              courseSchedule.map((dayData) => (
                <div class="flex flex-col overflow-hidden border border-foreground/25 bg-background transition-colors hover:border-primary">
                  <div class="flex items-center justify-between border-b border-foreground/20 bg-muted/30 px-4 py-2.5">
                    <span class="text-sm font-bold text-foreground">{dayData.day}</span>
                    <span class="font-mono text-[9px] uppercase tracking-[0.12em] text-muted-foreground">{dayData.label}</span>
                  </div>
                  <div class="flex flex-1 flex-col gap-4 p-4">
                    {dayData.courses.length > 0 ? (
                      dayData.courses.map((course) => (
                        <div class="relative border-l-2 border-foreground/20 pl-3 transition-colors hover:border-primary">
                          <span class="mb-1 inline-block font-mono text-[9px] uppercase tracking-[0.12em] text-primary">{course.time}</span>
                          <span class="mb-1 block text-sm font-bold leading-tight tracking-[-0.01em] text-foreground">{course.name}</span>
                          <span class="flex items-center gap-1 text-[11px] text-muted-foreground">
                            <span class="icon-[ph--map-pin] size-3" />
                            {course.location}
                          </span>
                        </div>
                      ))
                    ) : (
                      <div class="flex flex-1 flex-col items-center justify-center py-6 select-none">
                        <span class="icon-[ph--coffee] mb-2 size-5 text-muted-foreground/40" />
                        <span class="font-mono text-[9px] uppercase tracking-[0.14em] text-muted-foreground">Free Time</span>
                      </div>
                    )}
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <div class="mb-12 fade-up" style="animation-delay: 400ms">
          <div class={SECTION_HEADER_CLASS}>
            <div class="flex items-center">
              <span class={SECTION_NUM_CLASS}>06</span><h2 class={SECTION_TITLE_CLASS}>Active Threads</h2>
            </div>
            <span class={SECTION_META_CLASS}>Task_Queue</span>
          </div>
          <div class="border border-foreground/25 bg-background p-3">
            <div class="space-y-0">
              {
                todos.map((todo) => (
                  <div class="group/todo flex items-center justify-between border-b border-foreground/10 p-2 transition-colors last:border-b-0 hover:bg-muted/40">
                    <div class="flex items-center gap-3">
                      <div class="flex w-5 shrink-0 items-center justify-center text-muted-foreground transition-colors group-hover/todo:text-foreground">
                        {todo.completed ? (
                          <span class="icon-[ph--check-square-fill] size-4 text-primary" />
                        ) : (
                          <span class="icon-[ph--square] size-4 text-muted-foreground/40" />
                        )}
                      </div>
                      <span
                        class={`text-sm ${todo.completed ? 'text-muted-foreground/50 line-through' : 'font-medium text-foreground'} transition-colors`}
                      >
                        {todo.task}
                      </span>
                    </div>
                    <div class="ml-4 hidden shrink-0 font-mono text-[9px] uppercase tracking-[0.14em] sm:block">
                      {todo.completed ? <span class="text-muted-foreground/50">Done</span> : <span class="text-primary">Pending</span>}
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</Layout>
