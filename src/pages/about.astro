---
import Layout from '~/layouts/Layout.astro'
import { SITE, SOCIAL_LINKS } from '~/config'

// 个人数据配置 (可以在这里直接修改，或者抽离到 config.ts)
const PROFILE = {
  name: "REFAC7", // 你的名字/ID
  role: "Rubbish Developer",
  location: "Digital Void / Earth",
  status: "Available for hire to eat sth.",
  bio: `你好，我是 Refac7（也可能不是）。

我喜欢探索 React、Astro 等现代前端技术，同时也对服务端架构和交互设计保持着浓厚的兴趣。在这里，我记录技术笔记，分享开发心得，偶尔也发发牢骚。（这部分是AI生成的，跟我没关系）`
}

// 经历数据
const EXPERIENCE = [
  {
    time: "PAST - PRESENT",
    title: "废物 (Rubbish) Engineer",
    company: "Home .Inc",
    desc: "负责核心作息业务系统的架构重构与性能优化，推动自己采用现代化前端技术栈。"
  },
]

// 更多信息 (Q&A 风格)
const QNA = [
  { q: "Tech Stack preference? (Spell)", a: "React, TypeScript, TailwindCSS, Astro, Node.js." },
  { q: "Current focus? (Spell)", a: "Performance optimization & Generative UI." },
  { q: "Hobbies?", a: "Photography, Sleep, Coffee." }
]

const CONTAINER_CLASS = "max-w-[1400px] mx-auto px-6 sm:px-8"
---

<Layout title="关于我" description={`About ${SITE.title}`}>
  <div class={`min-h-screen relative py-12 font-sans overflow-hidden ${CONTAINER_CLASS}`}>
    
    {/* 顶部标题区 */}
    <div class="mb-16 border-b border-dashed border-border/40 pb-6">
        <div class="flex items-center gap-2 mb-2">
            <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
            </span>
            <span class="font-mono text-[10px] uppercase text-primary font-bold tracking-widest">System_User_Profile</span>
        </div>
        <h1 class="text-4xl md:text-6xl font-black tracking-tighter text-foreground uppercase">
            Identity<span class="text-primary">.</span>Check
        </h1>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20">
        
        {/* 左侧：个人档案卡片 */}
        <div class="lg:col-span-4">
            <div class="sticky top-24">
                <div class="relative group">
                    {/* 装饰框 */}
                    <div class="absolute -inset-0.5 bg-gradient-to-br from-primary/50 to-transparent opacity-30 blur-sm group-hover:opacity-60 transition-opacity duration-500 rounded-sm"></div>
                    
                    <div class="relative bg-background border border-border/50 p-2 rounded-sm overflow-hidden">
                        {/* 角落装饰 */}
                        <div class="absolute top-0 left-0 w-8 h-8 border-t-2 border-l-2 border-primary/50 z-20"></div>
                        <div class="absolute bottom-0 right-0 w-8 h-8 border-b-2 border-r-2 border-primary/50 z-20"></div>
                        
                        {/* 头像 */}
                        <div class="relative aspect-square overflow-hidden bg-muted/20">
                            <img 
                                src="/universal.png" 
                                alt="Avatar" 
                                class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700 scale-105 group-hover:scale-100"
                            />
                            
                            {/* 扫描线特效层 */}
                            <div class="absolute inset-0 bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.1)_50%),linear-gradient(90deg,rgba(255,0,0,0.06),rgba(0,255,0,0.02),rgba(0,0,255,0.06))] z-10 bg-[length:100%_2px,3px_100%] pointer-events-none"></div>
                        </div>

                        {/* 底部信息条 */}
                        <div class="mt-2 flex justify-between items-center px-1">
                            <span class="font-mono text-xs font-bold text-foreground">{PROFILE.name}</span>
                            <span class="font-mono text-[10px] text-muted-foreground uppercase">ID: 007-SYS</span>
                        </div>
                    </div>
                </div>

                {/* 属性列表 */}
                <div class="mt-8 space-y-4 font-mono text-xs sm:text-sm">
                    <div class="flex justify-between border-b border-dashed border-border/40 pb-2">
                        <span class="text-muted-foreground uppercase">Role</span>
                        <span class="text-foreground font-bold">{PROFILE.role}</span>
                    </div>
                    <div class="flex justify-between border-b border-dashed border-border/40 pb-2">
                        <span class="text-muted-foreground uppercase">Location</span>
                        <span class="text-foreground">{PROFILE.location}</span>
                    </div>
                    <div class="flex justify-between border-b border-dashed border-border/40 pb-2">
                        <span class="text-muted-foreground uppercase">Status</span>
                        <span class="text-emerald-500">{PROFILE.status}</span>
                    </div>
                </div>

                {/* 社交链接 */}
                <div class="mt-8 pt-6 border-t border-border/40">
                    <p class="font-mono text-[10px] text-muted-foreground/60 uppercase tracking-widest mb-4">Encrypted_Channel</p>
                    <div class="flex gap-4">
                        {SOCIAL_LINKS.map((item) => (
                            <a href={item.url} target="_blank" class="group flex items-center justify-center w-10 h-10 border border-border/60 hover:border-primary/60 hover:bg-primary/5 transition-all duration-300 rounded-sm">
                                <span class={`${item.icon} text-muted-foreground group-hover:text-primary transition-colors text-lg`}></span>
                            </a>
                        ))}
                    </div>
                </div>
            </div>
        </div>

        {/* 右侧：详细内容 */}
        <div class="lg:col-span-8 flex flex-col gap-16 md:pt-4">
            
            {/* 01. Bio */}
            <section>
                 <div class="flex items-end gap-3 mb-6 select-none">
                    <span class="font-mono text-3xl font-black text-muted-foreground/10 leading-none">01</span>
                    <span class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-primary mb-1">
                        System_Log
                    </span>
                 </div>
                 <div class="prose prose-neutral dark:prose-invert max-w-none text-muted-foreground leading-relaxed">
                    <p class="whitespace-pre-line">{PROFILE.bio}</p>
                 </div>
            </section>

            {/* 02. Experience */}
            <section>
                 <div class="flex items-end gap-3 mb-8 select-none">
                    <span class="font-mono text-3xl font-black text-muted-foreground/10 leading-none">02</span>
                    <span class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-primary mb-1">
                        Chronicle_Data
                    </span>
                 </div>
                 
                 <div class="relative border-l border-dashed border-border/60 ml-3 space-y-12">
                    {EXPERIENCE.map((exp) => (
                        <div class="relative pl-8 group">
                            {/* 节点点 */}
                            <div class="absolute -left-[5px] top-1.5 w-2.5 h-2.5 bg-background border border-muted-foreground group-hover:border-primary group-hover:bg-primary transition-colors duration-300 rounded-full"></div>
                            
                            <span class="font-mono text-[10px] text-primary/70 uppercase tracking-wider mb-1 block">
                                {exp.time}
                            </span>
                            <h3 class="text-xl font-bold text-foreground tracking-tight group-hover:text-primary transition-colors">
                                {exp.title}
                            </h3>
                            <div class="text-sm font-mono text-muted-foreground/80 mb-2">@ {exp.company}</div>
                            <p class="text-sm text-muted-foreground leading-relaxed">
                                {exp.desc}
                            </p>
                        </div>
                    ))}
                 </div>
            </section>

             {/* 03. Q&A / Attributes */}
             <section>
                <div class="flex items-end gap-3 mb-6 select-none">
                   <span class="font-mono text-3xl font-black text-muted-foreground/10 leading-none">03</span>
                   <span class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-primary mb-1">
                       Parameters
                   </span>
                </div>
                
                <div class="bg-muted/10 border border-border/40 p-6 rounded-sm font-mono text-sm">
                    {QNA.map((item) => (
                        <div class="mb-4 last:mb-0">
                            <div class="flex text-muted-foreground/70 mb-1">
                                <span class="mr-2 opacity-50">&gt;</span>
                                <span>{item.q}</span>
                            </div>
                            <div class="text-foreground pl-4 border-l-2 border-primary/20">
                                {item.a}
                            </div>
                        </div>
                    ))}
                    <div class="animate-pulse text-primary mt-4">_</div>
                </div>
           </section>

        </div>
    </div>

  </div>
</Layout>