---
import { MESSAGEBOARD_CONFIG } from '~/config'
import { SECTION_HEADER_CLASS, SECTION_TITLE_CLASS, SECTION_NUM_CLASS, SECTION_META_CLASS } from '~/lib/ui'
import Layout from '~/layouts/Layout.astro'
import Comments from '~/components/posts/base/Comments.astro'
import PageAside from '~/components/base/PageAside.astro'

const { title, description, introduce } = MESSAGEBOARD_CONFIG
---

<Layout {title} {description}>
  <div class="relative font-sans flex flex-col lg:flex-row min-h-screen max-w-[1920px] mx-auto">
    <PageAside
      statusText="Online"
      statusVariant="success"
      {title}
      subtitleIcon="icon-[ph--chat-circle-dots]"
      subtitleText="Open Channel"
      identityTags={[
        { icon: 'icon-[ph--chats-teardrop]', label: 'Guestbook' },
        { icon: 'icon-[ph--globe-hemisphere-west]', label: 'Public' },
      ]}
      intro={introduce}
      statsLabel="TRANSMISSION"
      statsMeta="OPEN"
      stats={[
        { value: '24/7', label: 'Uptime' },
        { value: 'Public', label: 'Access' },
      ]}
    />

    <main class="w-full lg:w-1/2 lg:flex-1 z-10 flex flex-col fade-up animation-delay-150">
      <div class="px-5 py-10 sm:px-8 lg:px-10 lg:py-14 xl:px-12 flex-1 flex flex-col">
        <div class={SECTION_HEADER_CLASS}>
          <div class="flex items-center"><span class={SECTION_NUM_CLASS}>01</span><h2 class={SECTION_TITLE_CLASS}>Leave a Message</h2></div>
          <span class={SECTION_META_CLASS}>Guest_Signals</span>
        </div>

        <p
          class="mb-10 max-w-2xl border-l-2 border-primary pl-4 text-sm leading-relaxed text-muted-foreground fade-up animation-delay-200 md:text-base"
        >
          {introduce}
        </p>

        <div class="w-full fade-up animation-delay-200 mt-4">
          <Comments />
        </div>
      </div>
    </main>
  </div>
</Layout>
