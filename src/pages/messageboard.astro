---
import { MESSAGEBOARD_CONFIG } from '~/config'
import { SECTION_HEADER_CLASS, SECTION_TITLE_CLASS, SECTION_NUM_CLASS, SECTION_META_CLASS } from '~/lib/ui'
import Layout from '~/layouts/Layout.astro'
import Comments from '~/components/posts/base/Comments.astro'
import PageAside from '~/components/base/PageAside.astro'

const { title, description, introduce } = MESSAGEBOARD_CONFIG
---

<Layout {title} {description}>
  <div class="page-shell relative font-sans min-h-screen">
    <PageAside
      image="/photos/240809-3.webp"
      statusText="Online"
      statusVariant="success"
      {title}
      subtitleIcon="icon-[ph--chat-circle-dots]"
      subtitleText="Open Channel"
      identityTags={[
        { icon: 'icon-[ph--chats-teardrop]', label: 'Guestbook' },
        { icon: 'icon-[ph--globe-hemisphere-west]', label: 'Public' },
      ]}
      intro={introduce}
      statsLabel="// TRANSMISSION"
      statsMeta="OPEN"
      stats={[
        { value: '24/7', label: 'Uptime' },
        { value: 'Public', label: 'Access' },
      ]}
    />

    <main class="w-full lg:w-2/3 z-10 flex flex-col fade-up animation-delay-150">
      <div class="px-6 lg:px-8 xl:px-12 lg:py-20 flex-1 flex flex-col">
        <div class={SECTION_HEADER_CLASS}>
          <div class="flex items-center"><span class={SECTION_NUM_CLASS}>01</span><h2 class={SECTION_TITLE_CLASS}>留下你的话</h2></div>
          <span class={SECTION_META_CLASS}>访客留言</span>
        </div>

        <p class="text-sm md:text-base text-muted-foreground leading-relaxed max-w-2xl mb-10 fade-up animation-delay-200">
          {introduce}
        </p>

        <div class="w-full fade-up animation-delay-200 mt-4">
          <Comments />
        </div>
      </div>
    </main>
  </div>
</Layout>
